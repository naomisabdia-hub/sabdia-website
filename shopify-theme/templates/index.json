    "about": {
      "type": "home-about",
      "blocks": {
        "image-1": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/sierra-living-kitchen-01.jpg",
            "ext": "/images/home-hero-1.jpg",
            "alt": "Detail of a Sabdia home",
            "focus": "center"
          }
        },
        "image-2": {
          "type": "image",
          "settings": {
            "ext": "/images/home-hero-2.jpg",
            "alt": "Sabdia detail",
            "focus": "center",
            "image": "shopify://shop_images/solace-kitchen-01.jpg"
          }
        },
        "paragraph-3": {
          "type": "paragraph",
          "settings": {
            "text": "Sabdia has designed and built award-winning residences across inner Brisbane since 2013. Every home is drawn, developed and constructed by the one team, so the decisions made on paper are the decisions that get built."
          }
        },
        "paragraph-4": {
          "type": "paragraph",
          "settings": {
            "text": "Each residence begins with its site and the way a family will actually live in it. From there the work is patient: proportion, light, and a palette of natural materials chosen for that house alone."
          }
        },
        "paragraph-5": {
          "type": "paragraph",
          "settings": {
            "text": "What reads as simplicity is the result of repetition, refinement, and time spent getting every detail right."
          }
        },
        "value-6": {
          "type": "value",
          "settings": {
            "n": "i.",
            "title": "Integrated Delivery",
            "desc": "Design, development and construction under one roof, from the first sketch to handover."
          }
        },
        "value-7": {
          "type": "value",
          "settings": {
            "n": "ii.",
            "title": "Material Honesty",
            "desc": "Natural stone, warm timber and light, chosen for the house and left to speak for themselves."
          }
        },
        "value-8": {
          "type": "value",
          "settings": {
            "n": "iii.",
            "title": "Boutique by Design",
            "desc": "A few residences a year, each given the full attention of the studio."
          }
        },
        "image-9": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/sierra-living-view-01.jpg",
            "ext": "",
            "alt": "Sabdia living room with a city view",
            "focus": "center"
          }
        },
        "image-10": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/sierra-aerial-dusk-01.jpg",
            "ext": "",
            "alt": "A Sabdia residence at dusk, from above",
            "focus": "center"
          }
        }
