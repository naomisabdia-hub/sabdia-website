    "services": {
      "type": "services-dark",
      "settings": {
        "label": "What We Do",
        "heading_html": "Full-spectrum<br><em>development</em><br>expertise.",
        "text": "From site acquisition through to final handover, Sabdia manages every element in-house — ensuring seamless delivery and uncompromising quality at every stage.",
        "cta_label": "Explore Services",
        "cta_link": "/pages/services"
      },
      "blocks": {
        "service-1": {
          "type": "service",
          "settings": {
            "number": "01",
            "title": "Luxury Residential Design",
            "description": "Single homes and small developments, designed from the first sketch to the last finish.",
            "icon": "home"
          }
        },
        "service-2": {
          "type": "service",
          "settings": {
            "number": "02",
            "title": "Development Management",
            "description": "We manage the whole development ourselves, from site to handover, so quality and timing stay in our hands.",
            "icon": "case"
          }
        },
        "service-3": {
          "type": "service",
          "settings": {
            "number": "03",
            "title": "Interior Architecture",
            "description": "Our interior team works alongside the builders from day one, so what was drawn is what gets built.",
            "icon": "clock"
          }
        },
        "service-4": {
          "type": "service",
          "settings": {
            "number": "04",
            "title": "Expert Construction",
            "description": "Built by our own trades, with good materials and no shortcuts. You see every stage.",
            "icon": "grid"
          }
        }
      },
