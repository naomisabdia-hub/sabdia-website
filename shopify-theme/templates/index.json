        "label": "How We Work",
        "heading_html": "Every discipline,<br><em>under one roof</em>.",
        "text": "Sabdia designs, develops and constructs every residence in-house. One team carries the project from site to handover, so nothing is lost between disciplines and the standard holds.",
        "cta_label": "Our Process",
        "cta_link": "/pages/services"
      }
