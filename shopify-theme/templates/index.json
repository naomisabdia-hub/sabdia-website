        },
        "paragraph-4": {
          "type": "paragraph",
          "settings": {
            "text": "Every project starts with the site and the people who will live there. We take time to understand both before a line is drawn."
          }
        },
        "paragraph-5": {
          "type": "paragraph",
          "settings": {
            "text": "We build homes people keep. Each one is designed for its street and its owners, and finished to a standard that does not date."
          }
        },
        "value-6": {
          "type": "value",
          "settings": {
            "n": "i.",
            "title": "Integrated Delivery",
            "desc": "We design the home and build it ourselves, under one roof."
          }
        },
        "value-7": {
          "type": "value",
          "settings": {
            "n": "ii.",
            "title": "Quality without shortcuts",
            "desc": "The best materials, the best trades, and attention to every detail."
