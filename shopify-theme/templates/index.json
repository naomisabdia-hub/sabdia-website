    "process": {
      "type": "process-steps",
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "title": "Design",
            "description": "Every residence begins with its site, its street and the people who will live there."
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "title": "Develop",
            "description": "Approvals, planning and engineering, resolved in-house so each decision stays with the team that made it."
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "title": "Construct",
            "description": "Built by our own team, to the drawings and the materials specified, with a check at every stage."
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "title": "Deliver",
            "description": "Handover is not the end of the relationship. The team stays close to the home and to its owners."
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3",
        "step-4"
      ],
      "settings": {
        "label": "Our Process"
      }
