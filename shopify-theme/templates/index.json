      },
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "title": "Design",
            "description": "Design that works as well as it looks. We start with the site, the street and the people."
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "title": "Develop",
            "description": "Approvals, planning and engineering are handled in-house, so every decision is ours."
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "title": "Construct",
            "description": "Our own team builds it, with the materials we specified and a check at every stage."
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "title": "Deliver",
            "description": "After handover we stay in touch. If something needs attention, we come back."
          }
        }
      },
