    "about": {
      "type": "home-about",
      "settings": {
        "label": "About Sabdia",
        "heading_html": "Crafting <em>Exquisite</em><br>Living Spaces.",
        "sig_name": "Sabdia",
        "sig_title": "Founder & Principal",
        "cta_label": "Our Full Story",
        "cta_link": "/pages/about"
      },
      "blocks": {
        "image-1": {
          "type": "image",
          "settings": {
            "ext": "/images/home-hero-1.jpg",
            "alt": "Sabdia craftsmanship"
          }
        },
        "image-2": {
          "type": "image",
          "settings": {
            "ext": "/images/home-hero-2.jpg",
            "alt": "Sabdia detail"
          }
        },
        "paragraph-3": {
          "type": "paragraph",
          "settings": {
            "text": "At Sabdia, we manage every step of the residential development journey in-house — from visionary design through to expert construction. This integrated approach allows us to maintain meticulous control over quality, timing, and innovation, delivering homes that stand the test of time."
          }
        },
        "paragraph-4": {
          "type": "paragraph",
          "settings": {
            "text": "With a focus on creating exceptional living spaces, Sabdia Constructions is dedicated to shaping the future of residential developments through innovation, quality, and unparalleled craftsmanship. Every project begins with a deep understanding of both the site and the clients who will call it home."
          }
        },
        "paragraph-5": {
          "type": "paragraph",
          "settings": {
            "text": "We are not merely builders — we are creators of legacy. Each residence we deliver is conceived as a singular work of architecture, thoughtfully designed to complement its surroundings and exceed every expectation of luxury living."
          }
        },
        "value-6": {
          "type": "value",
          "settings": {
            "n": "i.",
            "title": "Integrated Delivery",
            "desc": "Design, develop, and construct under one roof — seamless from concept to keys."
          }
        },
        "value-7": {
          "type": "value",
          "settings": {
            "n": "ii.",
            "title": "Uncompromising Quality",
            "desc": "Only the finest materials, master tradespeople, and meticulous attention to detail."
          }
        },
        "value-8": {
          "type": "value",
          "settings": {
            "n": "iii.",
            "title": "Boutique & Personal",
            "desc": "A few projects a year, so each one gets our full attention."
          }
        }
      },
      "block_order": [
        "image-1",
        "image-2",
        "paragraph-3",
        "paragraph-4",
        "paragraph-5",
        "value-6",
        "value-7",
        "value-8"
      ]
    },
