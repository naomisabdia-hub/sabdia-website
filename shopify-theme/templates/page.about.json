{
  "sections": {
    "hero": {
      "type": "page-hero",
      "settings": {
        "label": "Our Story",
        "title_html": "About<br><em>Sabdia</em>",
        "sub": "Designed and built in-house, in inner Brisbane, since 2013.",
        "image_ext": "/images/home-hero-1.jpg",
        "image_alt": "Sabdia living room with city view",
        "image": "shopify://shop_images/sierra-living-view-01.jpg"
      }
    },
    "mission": {
      "type": "about-mission",
      "settings": {
        "label": "Mission",
        "heading_html": "Designed with <em>care</em>, built with precision.",
        "sig_name": "Sabdia",
        "sig_title": "Founder & Principal"
      },
      "blocks": {
        "paragraph-1": {
          "type": "paragraph",
          "settings": {
            "text": "Sabdia Constructions started in 2013 because Brisbane needed a boutique developer that would not cut corners, one that would do the design and the development itself and then build the house with its own team."
          }
        },
        "paragraph-2": {
          "type": "paragraph",
          "settings": {
            "text": "More than 100 homes later, that is still how we work."
          }
        },
        "paragraph-3": {
          "type": "paragraph",
          "settings": {
            "text": "We stay small on purpose. We take on a few projects a year so each one gets our full attention. We do not build in volume. We build in detail."
          }
        }
      },
      "block_order": [
        "paragraph-1",
        "paragraph-2",
        "paragraph-3"
      ]
    },
    "values": {
      "type": "about-values",
      "settings": {
        "label": "Our Values"
      },
      "blocks": {
        "value-1": {
          "type": "value",
          "settings": {
            "numeral": "i.",
            "title": "Integrity",
            "desc": "We say what we do, and we do what we say. Clients hear the truth about cost and timing at every stage."
          }
        },
        "value-2": {
          "type": "value",
          "settings": {
            "numeral": "ii.",
            "title": "Innovation",
            "desc": "We keep looking for better ways to design and build, so the homes last."
          }
        },
        "value-3": {
          "type": "value",
          "settings": {
            "numeral": "iii.",
            "title": "Excellence",
            "desc": "We do not accept 'good enough'. Every detail, the roofline down to the door handles, has to be right."
          }
        }
      },
      "block_order": [
        "value-1",
        "value-2",
        "value-3"
      ]
    },
    "journey": {
      "type": "about-timeline",
      "settings": {
        "label": "Our Journey",
        "heading_html": "A decade of<br><em>milestones</em>.",
        "text": "The company started with one project. It has now completed more than 100 homes, and each year the standard has gone up."
      },
      "blocks": {
        "milestone-1": {
          "type": "milestone",
          "settings": {
            "year": "2013",
            "title": "Founded",
            "desc": "Sabdia Constructions opens in Brisbane, designing and building its own homes."
          }
        },
        "milestone-2": {
          "type": "milestone",
          "settings": {
            "year": "2015",
