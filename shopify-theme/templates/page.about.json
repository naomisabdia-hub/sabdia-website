        },
        "milestone-4": {
          "type": "milestone",
          "settings": {
            "year": "2020",
            "title": "Interior Architecture Division",
            "desc": "An in-house interior architecture team joins the studio."
          }
        },
        "milestone-5": {
          "type": "milestone",
          "settings": {
            "year": "2023",
            "title": "100+ Residences",
            "desc": "More than 100 residences completed, ten years in, with the same team and the same standard."
          }
        },
        "milestone-6": {
          "type": "milestone",
          "settings": {
            "year": "2025",
            "title": "QASR — Flagship Release",
            "desc": "QASR launches in Coorparoo, the largest home Sabdia has built."
          }
        }
      },
