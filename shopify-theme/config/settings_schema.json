[
  {
    "name": "theme_info",
    "theme_name": "Sabdia",
    "theme_version": "1.0.0",
    "theme_author": "Sabdia Constructions",
    "theme_documentation_url": "https://www.sabdiaconstructions.com.au",
    "theme_support_url": "https://www.sabdiaconstructions.com.au"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "The wordmark used in the nav, loader and footer. Leave empty to use the built-in logo."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo size",
        "min": 20,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 28,
        "info": "Height of the SABDIA wordmark in the nav (32px reads proportionate against the 80px bar; the site's earlier review used 38px). Mobile scales in step."
      },
      {
        "type": "text",
        "id": "site_name",
        "label": "Site name",
        "default": "Sabdia Constructions"
      },
      {
        "type": "text",
        "id": "legal_name",
        "label": "Legal name",
        "default": "Sabdia Constructions Pty Ltd",
        "info": "Shown in the footer copyright."
      },
      {
        "type": "text",
        "id": "location",
        "label": "Location line",
        "default": "Brisbane, Queensland, Australia"
      }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email",
        "default": "sales@sabdia.com.au"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Phone",
        "info": "Leave empty to hide."
      }
    ]
  },
  {
    "name": "Social links",
    "settings": [
      {
        "type": "text",
        "id": "instagram_url",
        "label": "Instagram URL",
        "default": "https://www.instagram.com/_sabdia/"
      },
      {
        "type": "text",
        "id": "instagram_label",
        "label": "Instagram display name",
        "default": "@_sabdia"
      },
      {
        "type": "text",
        "id": "facebook_url",
        "label": "Facebook URL",
        "default": "https://www.facebook.com/sabdiaconstructions/"
      },
      {
        "type": "text",
        "id": "linkedin_url",
        "label": "LinkedIn URL",
        "default": "https://www.linkedin.com/company/sabdia-constructions/"
      }
    ]
  },
  {
    "name": "Search & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social share image",
        "info": "Shown when pages are shared \u2014 1200\u00d7630 works best."
      },
      {
        "type": "textarea",
        "id": "seo_home_description",
        "label": "Homepage meta description",
        "default": "Boutique luxury home builder and developer delivering award-winning residences across inner Brisbane since 2013. Design. Develop. Construct.",
        "info": "Shown in search results for the homepage."
      }
    ]
  },
  {
    "name": "Site plumbing",
    "settings": [
      {
        "type": "select",
        "id": "form_backend",
        "label": "Enquiry handling",
        "options": [
          {
            "value": "shopify",
            "label": "Shopify \u2014 email notifications + customer records"
          },
          {
            "value": "vercel",
            "label": "Sabdia API \u2014 existing leads inbox (Supabase)"
          }
        ],
        "default": "shopify",
        "info": "Shopify mode emails each enquiry to the store's sender email (Settings \u2192 Notifications) and files the person under Customers. Sabdia API mode posts to the existing Vercel endpoint instead."
      },
      {
        "type": "paragraph",
        "content": "Advanced \u2014 these keep the enquiry forms and walkthroughs working. Only change them with your developer."
      },
      {
        "type": "text",
        "id": "forms_endpoint",
        "label": "Forms endpoint",
        "default": "https://sabdia-website.vercel.app",
        "info": "Enquiries and subscriptions post here, into the Sabdia leads inbox."
      },
      {
        "type": "text",
        "id": "media_base",
        "label": "Media library base URL",
        "default": "https://fvczsjcrvwzqtcbforgo.supabase.co/storage/v1/object/public/media",
        "info": "Where walkthrough frames and clips are stored."
      },
      {
        "type": "text",
        "id": "domain_display",
        "label": "Domain display text",
        "default": "sabdiaconstructions.com.au"
      },
      {
        "type": "text",
        "id": "domain_url",
        "label": "Domain URL",
        "default": "https://www.sabdiaconstructions.com.au"
      }
    ]
  }
]
