{%- comment -%}
  Port of the property page (properties/[slug].astro) fed by a product:
  photographic hero, sold notice, specs bar, description + enquiry form,
  count-adaptive gallery with lightbox, and the residence film. The
  scroll walkthrough renders from its own section beneath this one.

  Product fields used: title, description (paragraphs), featured image
  (hero), remaining images (gallery), Status (custom.status, see the
  residence-status snippet - the old "sold" tag still works), and metafields
  custom.suburb / state / beds / baths / cars / land / land_over /
  headline / features / enquiry_heading / enquiry_text / enquiry_button /
  brochure_url / film_video / film_poster / scrollwalk_folder.
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  # The {name} token editors write in the shared framing copy. Built with
  # append because Shopify's Liquid parser rejects literal braces inside
  # an output tag's string arguments.
  assign name_token = '{' | append: 'name' | append: '}'
  capture pstatus
    render 'residence-status', product: product
  endcapture
  assign sold = false
  if pstatus contains 'Sold'
    assign sold = true
  endif
  assign state = mf.state.value | default: 'QLD'
  assign tiles = section.settings.gallery_tiles | default: 9
-%}

<section class="prop-hero">
  {%- if product.featured_image -%}
    <img src="{{ product.featured_image | image_url: width: 1920, height: 1080, crop: 'center' }}" alt="{{ product.title | escape }}" width="1920" height="1080" loading="eager" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:{% if sold %}brightness(.72) saturate(.9){% else %}brightness(.78) saturate(.96){% endif %}">
  {%- endif -%}
  <div class="prop-hero-ov"></div>
  <div class="prop-hero-content inner">
    <div class="prop-status" {% if sold %}style="margin-bottom:14px"{% endif %}>
      <div class="prop-status-dot {% if sold %}sold{% elsif pstatus == 'For Sale' %}active{% endif %}"></div>
      <span style="color:rgba(253,251,246,.88)">{{ pstatus }}</span>
    </div>
    <div class="prop-name">{{ product.title }}</div>
    <div class="prop-loc">{{ mf.suburb.value }}, {{ state }}</div>
  </div>
</section>

{%- if sold -%}
  <div style="background:var(--bg2);border-bottom:1px solid var(--border);padding:22px clamp(22px,5vw,80px)">
    <div class="inner" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <div style="padding:7px 16px;background:rgba(168,135,74,.14);border:1px solid rgba(168,135,74,.4);font-size:10px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:var(--ink)">{{ pstatus }}</div>
      <span style="font-size:13.5px;font-weight:400;color:var(--ink3)">{{ section.settings.sold_notice }}</span>
      <a href="{{ section.settings.sold_banner_link | default: '/collections/for-sale' }}" class="btn-g btn-g-gold" style="margin-left:auto;padding:9px 20px;font-size:10px">{{ section.settings.sold_banner_label }} &rarr;</a>
    </div>
  </div>
{%- endif -%}

{%- unless section.settings.hide_specs -%}
<div class="prop-specs-bar">
  <div class="prop-specs-inner">
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_location | default: "Location" }}</div>
      <div class="prop-spec-v" style="font-size:16px">{{ mf.suburb.value }}</div>
    </div>
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_beds | default: "Bedrooms" }}</div>
      <div class="prop-spec-v">{{ mf.beds.value }}</div>
    </div>
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_baths | default: "Bathrooms" }}</div>
      <div class="prop-spec-v">{{ mf.baths.value }}</div>
    </div>
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_cars | default: "Garages" }}</div>
      <div class="prop-spec-v">{{ mf.cars.value }}</div>
    </div>
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_land | default: "Land Size" }}</div>
      <div class="prop-spec-v">{{ mf.land.value }}<em>m&sup2;{% if mf.land_over.value %}+{% endif %}</em></div>
    </div>
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_status | default: "Status" }}</div>
      <div class="prop-spec-v" style="font-size:16px;color:{% if sold %}var(--taupe-d){% else %}var(--ink){% endif %}">{{ pstatus }}</div>
    </div>
  </div>
</div>

{%- endunless -%}

<div class="prop-body">
  <div class="prop-layout inner">
    <div class="prop-desc">
      <div class="slabel prop-desc-slabel reveal">{{ section.settings.about_label | replace: name_token, product.title }}</div>
      <h1 class="prop-body-h reveal d1">{{ mf.headline.value }}</h1>
      {{ product.description | replace: '<p>', '<p class="prop-body-p reveal d2">' }}

      {%- if mf.features.value.size > 0 -%}
        <div class="prop-features reveal d3">
          <div class="prop-features-h">{{ section.settings.features_heading }}</div>
          <div class="prop-feat-grid">
            {%- for f in mf.features.value -%}
              <div class="prop-feat">{{ f }}</div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="reveal d2">
      <div class="prop-enquire">
        <div class="prop-enquire-h">{{ mf.enquiry_heading.value | default: 'Enquire Now' }}</div>
        <p style="font-size:13px;font-weight:300;color:var(--ink3);line-height:1.75;margin-bottom:24px">{{ mf.enquiry_text.value }}</p>
        {%- if settings.form_backend == 'vercel' -%}
        <form class="cform" id="cform" name="property-enquiry" method="POST" action="{{ settings.forms_endpoint }}/api/contact">
          <input type="hidden" name="form-name" value="property-enquiry">
          <input type="hidden" name="property" value="{{ product.title | escape }}">
          <p class="hidden" style="display:none" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
          <div class="frow">
            <div class="fg"><label class="fl" for="pe-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="pe-first" name="first-name" class="fi" placeholder="First name" autocomplete="given-name" required></div>
            <div class="fg"><label class="fl" for="pe-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="pe-last" name="last-name" class="fi" placeholder="Last name" autocomplete="family-name" required></div>
          </div>
          <div class="fg"><label class="fl" for="pe-email">{{ section.settings.f_email | default: "Email*" }}</label><input type="email" id="pe-email" name="email" class="fi" placeholder="Email address" autocomplete="email" required></div>
          <div class="fg"><label class="fl" for="pe-phone">{{ section.settings.f_phone | default: "Phone" }}</label><input type="tel" id="pe-phone" name="phone" class="fi" placeholder="Phone number" autocomplete="tel"></div>
          {%- unless sold -%}
            <div class="fg">
              <label class="fl" for="pe-type">{{ section.settings.f_interest | default: "Enquiry Type" }}</label>
              <select class="fsel" id="pe-type" name="enquiry-type">
                {%- assign etypes = section.settings.enquiry_types | newline_to_br | split: '<br />' -%}
                {%- for t in etypes -%}
                  {%- assign tt = t | strip -%}
                  {%- if tt != blank -%}<option>{{ tt }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </div>
          {%- endunless -%}
          <div class="fg"><label class="fl" for="pe-message">{{ section.settings.f_message | default: "Message" }}</label><textarea class="fta" id="pe-message" name="message" placeholder="Tell us about your requirements or any questions you have…"></textarea></div>
          <p class="form-note">{% render 'privacy-link', note: section.settings.privacy_note %}</p>
          <button type="submit" class="fsub" id="fsub">{{ mf.enquiry_button.value | default: 'Submit Enquiry' }} &rarr;</button>
          <p class="sr-status" role="status" aria-live="polite" data-form-status></p>
        </form>
        {%- else -%}
        {% form 'contact', id: 'cform', class: 'cform' %}
          <span hidden data-thanks>{{ section.settings.success_text }}</span>
          {%- if form.posted_successfully? -%}
            {% render 'form-thanks', text: section.settings.success_text %}
          {%- else -%}
          {%- if form.errors -%}
            <p class="form-note" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[Property]" value="{{ product.title | escape }}">
          <div class="frow">
            <div class="fg"><label class="fl" for="pe-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="pe-first" name="contact[First name]" class="fi" placeholder="First name" autocomplete="given-name" required></div>
            <div class="fg"><label class="fl" for="pe-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="pe-last" name="contact[Last name]" class="fi" placeholder="Last name" autocomplete="family-name" required></div>
          </div>
          <div class="fg"><label class="fl" for="pe-email">{{ section.settings.f_email | default: "Email*" }}</label><input type="email" id="pe-email" name="contact[email]" class="fi" placeholder="Email address" autocomplete="email" required></div>
          <div class="fg"><label class="fl" for="pe-phone">{{ section.settings.f_phone | default: "Phone" }}</label><input type="tel" id="pe-phone" name="contact[Phone]" class="fi" placeholder="Phone number" autocomplete="tel"></div>
          {%- unless sold -%}
            <div class="fg">
              <label class="fl" for="pe-type">{{ section.settings.f_interest | default: "Enquiry Type" }}</label>
              <select class="fsel" id="pe-type" name="contact[Enquiry type]">
                {%- assign etypes = section.settings.enquiry_types | newline_to_br | split: '<br />' -%}
                {%- for t in etypes -%}
                  {%- assign tt = t | strip -%}
                  {%- if tt != blank -%}<option>{{ tt }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </div>
          {%- endunless -%}
          <div class="fg"><label class="fl" for="pe-message">{{ section.settings.f_message | default: "Message" }}</label><textarea class="fta" id="pe-message" name="contact[body]" placeholder="Tell us about your requirements or any questions you have…"></textarea></div>
          <p class="form-note">{% render 'privacy-link', note: section.settings.privacy_note %}</p>
          <button type="submit" class="fsub" id="fsub">{{ mf.enquiry_button.value | default: 'Submit Enquiry' }} &rarr;</button>
        {%- endif -%}
          {% endform %}
        {%- endif -%}
      </div>
      <div style="margin-top:16px;display:flex;flex-direction:column;gap:10px">
        {%- if mf.brochure_url.value != blank -%}
          <a href="{{ mf.brochure_url.value }}" target="_blank" rel="noopener" class="btn-g btn-g-gold" style="justify-content:center" download>{{ section.settings.brochure_label }} &darr;</a>
        {%- endif -%}
        {%- if sold -%}
          <a href="{{ section.settings.sold_banner_link | default: '/collections/for-sale' }}" class="btn-p" style="justify-content:center">{{ section.settings.sold_cta_label }}</a>
        {%- endif -%}
        <a href="{{ section.settings.general_link | default: '/pages/contact' }}" class="btn-g {% unless sold %}btn-g-gold{% endunless %}" style="justify-content:center">{{ section.settings.general_label }}</a>
      </div>
    </div>
  </div>
</div>

{%- liquid
  # Gallery source: Photo / Video blocks picked in Customize (this residence's
  # own template), or, when none are added, the residence's photos from
  # Products › Media in order. Either way the grid shows the first few and
  # the viewer carries the lot.
  assign use_blocks = false
  if section.blocks.size > 0
    assign use_blocks = true
    assign all_count = section.blocks.size
  else
    assign all_count = product.images.size | minus: 1
  endif
  assign gallery_count = all_count
  if gallery_count > tiles
    assign gallery_count = tiles
  endif
-%}
{%- if gallery_count > 0 -%}
  <div class="prop-gallery inner">
    <div class="slabel reveal">{{ section.settings.gallery_label }}</div>
    <h2 class="prop-gallery-h reveal d1">{{ section.settings.gallery_heading_html | replace: name_token, product.title }}</h2>
    <div class="prop-gallery-grid gn-{{ gallery_count }}" id="galleryGrid">
      {%- assign gdelays = ',d1,d2' | split: ',' -%}
      {%- if use_blocks -%}
        {%- for block in section.blocks -%}
          {%- assign i = forloop.index0 | modulo: 3 -%}
          {%- assign in_grid = true -%}
          {%- if forloop.index > tiles -%}{%- assign in_grid = false -%}{%- endif -%}
          {%- liquid
            assign cap = block.settings.caption
            assign vid = ''
            assign pic = block.settings.image
            if block.type == 'video'
              assign pic = block.settings.poster
              if block.settings.video != blank
                for src in block.settings.video.sources
                  if src.format == 'mp4'
                    assign vid = src.url
                  endif
                endfor
                if pic == blank
                  assign pic = block.settings.video.preview_image
                endif
              elsif block.settings.video_url != blank
                assign vid = block.settings.video_url
              endif
            endif
            if cap == blank
              if pic != blank and pic.alt != blank
                assign cap = pic.alt
              else
                assign cap = product.title
              endif
            endif
          -%}
          {%- if pic == blank and vid == blank -%}{%- continue -%}{%- endif -%}
          {%- if in_grid -%}
            <div class="gallery-item gallery-tile reveal-wipe {{ gdelays[i] }}{% if vid != blank %} gallery-video{% endif %}" data-lb-item {% if vid != blank %}data-video="{{ vid }}"{% endif %} data-src="{% if pic != blank %}{{ pic | image_url: width: 1800, height: 1350, crop: 'center' }}{% endif %}" data-alt="{{ cap | escape }}" role="button" tabindex="0" aria-label="{% if vid != blank %}Play video{% else %}View photo{% endif %}: {{ cap | escape }}" {{ block.shopify_attributes }}>
              {%- if pic != blank -%}
                <img class="gallery-img" src="{{ pic | image_url: width: 900, height: 675, crop: 'center' }}" alt="{{ cap | escape }}" width="900" height="675" loading="lazy" decoding="async">
              {%- else -%}
                <video class="gallery-img" src="{{ vid }}" muted playsinline preload="metadata"></video>
              {%- endif -%}
            </div>
          {%- else -%}
            <span hidden data-lb-item {% if vid != blank %}data-video="{{ vid }}"{% endif %} data-src="{% if pic != blank %}{{ pic | image_url: width: 2000, height: 1400, crop: 'center' }}{% endif %}" data-alt="{{ cap | escape }}"></span>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for image in product.images offset: 1 limit: tiles -%}
          {%- assign i = forloop.index0 | modulo: 3 -%}
          <div class="gallery-item gallery-tile reveal-wipe {{ gdelays[i] }}" data-lb-item data-src="{{ image | image_url: width: 1800, height: 1350, crop: 'center' }}" data-alt="{{ image.alt | default: product.title | escape }}" role="button" tabindex="0" aria-label="View photo: {{ image.alt | default: product.title | escape }}">
            <img class="gallery-img" src="{{ image | image_url: width: 900, height: 675, crop: 'center' }}" alt="{{ image.alt | default: product.title | escape }}" width="900" height="675" loading="lazy" decoding="async">
          </div>
        {%- endfor -%}
        {%- if all_count > tiles -%}
          <div hidden>
            {%- assign extra_offset = tiles | plus: 1 -%}
            {%- for image in product.images offset: extra_offset -%}
              <span data-lb-item data-src="{{ image | image_url: width: 2000, height: 1400, crop: 'center' }}" data-alt="{{ image.alt | default: product.title | escape }}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if all_count > 1 -%}
      <div class="gallery-more reveal d2">
        <button type="button" class="btn-g" id="galleryAll">{{ section.settings.gallery_all_label | default: "View all photos" }} ({{ all_count }}) &rarr;</button>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <img id="lbImg" src="" alt="">
  <video id="lbVideo" controls playsinline hidden></video>
  <button class="lb-btn lb-prev" id="lbPrev" aria-label="Previous photo">&larr;</button>
  <button class="lb-btn lb-next" id="lbNext" aria-label="Next photo">&rarr;</button>
  <button class="lb-close" id="lbClose" aria-label="Close">&#10005;</button>
  <div class="lb-meta"><span class="lb-cap" id="lbCap"></span><span id="lbCount"></span></div>
</div>
<script>
  (function () {
    var lb = document.getElementById('lb');
    if (!lb || lb.dataset.lbInit) return;
    lb.dataset.lbInit = '1';
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-lb-item]')).filter(function (el) { return !el.closest('[id^="pg-"]'); });
    if (!items.length) return;
    var img = document.getElementById('lbImg'), cap = document.getElementById('lbCap'), count = document.getElementById('lbCount');
    var i = 0, lastFocus = null;
    var house = {{ product.handle | json }};
    /* Photos are named house-room-NN; alt text arrives as "SOLACE - solace-kitchen-01"
       or "SOLACE - Kitchen 01". Show just the room, and say when it is a render. */
    function caption(alt) {
      var s = (alt || '').split(' - ').pop().toLowerCase().replace(/\.[a-z]+$/, '');
      if (s.indexOf(house + '-') === 0) s = s.slice(house.length + 1);
      var render = /(^|-)render(-|$)/.test(s);
      s = s.replace(/(^|-)render(-|$)/, '$1').replace(/[-_]?\d+$/, '').replace(/[-_]+/g, ' ').trim();
      if (!s || s === house) s = {{ product.title | json }};
      s = s.replace(/\b\w/g, function (c) { return c.toUpperCase(); });
      return render ? s + ' \u00b7 Artist impression' : s;
    }
    function show(n) {
      i = (n + items.length) % items.length;
      var it = items[i];
      var vid = document.getElementById('lbVideo'), vsrc = it.getAttribute('data-video');
      if (vsrc) {
        img.hidden = true; img.removeAttribute('src');
        vid.hidden = false; if (vid.getAttribute('src') !== vsrc) vid.src = vsrc; vid.play().catch(function () {});
      } else {
        vid.pause(); vid.hidden = true;
        img.hidden = false; img.src = it.getAttribute('data-src');
      }
      img.alt = it.getAttribute('data-alt') || '';
      cap.textContent = caption(it.getAttribute('data-alt'));
      count.textContent = (i + 1) + ' / ' + items.length;
      [i + 1, i - 1].forEach(function (k) { var n = items[(k + items.length) % items.length]; if (!n.getAttribute('data-video') && n.getAttribute('data-src')) { var p = new Image(); p.src = n.getAttribute('data-src'); } });
    }
    function open(n) {
      lastFocus = document.activeElement;
      lb.hidden = false;
      requestAnimationFrame(function () { lb.classList.add('open'); });
      document.documentElement.style.overflow = 'hidden';
      show(n);
      document.getElementById('lbClose').focus();
    }
    function close() {
      document.getElementById('lbVideo').pause();
      lb.classList.remove('open');
      document.documentElement.style.overflow = '';
      setTimeout(function () { lb.hidden = true; }, 350);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    items.forEach(function (it, n) {
      it.addEventListener('click', function () { open(n); });
      it.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(n); } });
    });
    var allBtn = document.getElementById('galleryAll');
    if (allBtn) allBtn.addEventListener('click', function () { open(0); });
    /* Swipe to page on touch screens */
    var tx = null;
    lb.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', function (e) {
      if (tx === null) return;
      var dx = e.changedTouches[0].clientX - tx; tx = null;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
    }, { passive: true });
    document.getElementById('lbPrev').addEventListener('click', function () { show(i - 1); });
    document.getElementById('lbNext').addEventListener('click', function () { show(i + 1); });
    document.getElementById('lbClose').addEventListener('click', close);
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(i + 1);
      else if (e.key === 'ArrowLeft') show(i - 1);
    });
  })();
</script>

{%- if mf.film_video.value != blank -%}
  <section class="film-band" id="film">
    <div class="film-grid">
      <div class="film-copy">
        <div class="slabel slabel-dark reveal">{{ section.settings.film_label }}</div>
        <h2 class="film-h reveal d1">Experience <em>{{ product.title }}</em>.</h2>
        {%- liquid
          assign film_text = section.settings.film_text
          if film_text == blank
            assign film_text = 'A walk through ' | append: name_token | append: ', on film.'
          endif
        -%}
        <p class="film-p reveal d2">{{ film_text | replace: name_token, product.title }}</p>
      </div>
      <div class="reveal d2">
        <div class="film-frame" data-film>
          <video src="{{ mf.film_video.value }}" {% if mf.film_poster.value != blank %}poster="{{ mf.film_poster.value }}"{% endif %} muted loop playsinline preload="none"></video>
          <button class="film-sound" type="button" aria-label="Toggle sound" data-sound>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            <span data-sound-label>{{ section.settings.sound_label | default: "Sound On" }}</span>
          </button>
        </div>
        <div class="film-caption">
          <span><b>{{ product.title }} - On Film</b></span>
          <span>{{ mf.suburb.value }}, {{ state }}</span>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{%- unless sold -%}
  <section class="prop-cta">
    <div class="inner prop-cta-inner">
      <div class="slabel reveal" style="justify-content:center">{{ section.settings.cta_label }}</div>
      <h2 class="prop-cta-h reveal d1">{{ section.settings.cta_heading_html | replace: name_token, product.title }}</h2>
      <p class="prop-cta-p reveal d2">{{ section.settings.cta_text | replace: name_token, product.title }}</p>
      <a href="#cform" class="btn-p reveal d3">{{ section.settings.cta_button | replace: name_token, product.title }} &rarr;</a>
    </div>
  </section>
{%- endunless -%}

<section style="padding:0 clamp(22px,5vw,80px) clamp(48px,6vw,72px)">
  <div class="inner" style="display:flex;justify-content:center">
    {%- assign share_url = shop.url | append: product.url -%}
    {%- assign share_title = product.title | append: ' - ' | append: mf.suburb.value | append: ' | Sabdia Constructions' -%}
    {%- assign eu = share_url | url_encode -%}
    {%- assign et = share_title | url_encode -%}
    <div class="share-row" aria-label="Share this page">
      <span class="share-l">{{ section.settings.share_label }}</span>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ eu }}" target="_blank" rel="noopener" class="share-a">Facebook</a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ eu }}" target="_blank" rel="noopener" class="share-a">LinkedIn</a>
      <a href="https://twitter.com/intent/tweet?url={{ eu }}&text={{ et }}" target="_blank" rel="noopener" class="share-a">X</a>
      <a href="mailto:?subject={{ et }}&body={{ et }}%0A{{ eu }}" class="share-a">Email</a>
      <button type="button" class="share-a share-copy" data-share-url="{{ share_url }}">{{ section.settings.copy_link_label | default: "Copy link" }}</button>
    </div>
  </div>
</section>

{%- unless sold -%}
  <div class="prop-sticky-bar" id="stickyEnquire">
    <div class="psb-name">{{ product.title }} <span class="psb-loc">- {{ mf.suburb.value }}</span></div>
    <a href="#cform" class="psb-btn">{{ section.settings.sticky_label }} &rarr;</a>
  </div>
  <script>
    (function () {
      var bar = document.getElementById('stickyEnquire');
      var form = document.getElementById('cform');
      if (!bar || bar.dataset.stickyInit || !form || !('IntersectionObserver' in window)) return;
      bar.dataset.stickyInit = '1';
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          bar.classList.toggle('psb-hidden', e.isIntersecting);
        });
      }, { threshold: 0.15 });
      obs.observe(form);
    })();
  </script>
{%- endunless -%}

<style>
  .share-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:36px}
  .share-l{font-size:10px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:var(--ink3)}
  .share-a{background:none;border:none;cursor:pointer;padding:4px 0;font-family:var(--font-u);font-size:11px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:var(--ink2);border-bottom:1px solid rgba(168,135,74,.35);transition:color .25s,border-color .25s;text-decoration:none}
  .share-a:hover{color:var(--ink);border-color:var(--gold)}
</style>

