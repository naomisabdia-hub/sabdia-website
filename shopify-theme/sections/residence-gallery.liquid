{%- comment -%}
  Gallery - the residence's photos and clips

  Stage + filmstrip (or a grid of tiles) with the full-screen viewer.
  Photo / Video blocks hand-pick the set; with none, the residence's
  photos from Products › Media in order.

  Split out of the all-in-one Property page section on 14 Sep 2026 so each
  part of the residence page has its own panel in the customizer. Real
  photographs and real footage only, never generated.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  # The residence being shown: its product, or its page (15 Sep 2026: the
  # residences moved from $0 products to pages - same fields, same design).
  assign res = product
  if res == blank and page != blank
    assign res = page
  endif
  assign mf = res.metafields.custom
  # The {name} token editors write in the shared framing copy. Built with
  # append because Shopify's Liquid parser rejects literal braces inside
  # an output tag's string arguments.
  assign name_token = '{' | append: 'name' | append: '}'
  capture pstatus
    render 'residence-status', product: res
  endcapture
  assign sold = false
  if pstatus contains 'Sold'
    assign sold = true
  endif
  assign state = mf.state.value | default: 'QLD'
  # The residence's name in its own brochure face (Products › the residence
  # › Metafields › Residence name font …), for headings that carry it.
  capture name_span
    render 'residence-name', product: res
  endcapture
  # The name as the brochure writes it (Sierra, not SIERRA) where it is
  # printed as plain text.
  assign prop_name = res.title
  assign nf_any = mf.name_font.value | strip | append: mf.name_font_file.value
  if nf_any != blank
    unless mf.name_font_caps.value
      assign prop_name = res.title | downcase | capitalize
    endunless
  endif
-%}
{%- assign tiles = s.gallery_tiles | default: 9 -%}
{% render 'section-look', section: section %}
{%- liquid
  # Gallery source: Photo / Video blocks picked in Customize (this residence's
  # own template), or, when none are added, the residence's photos from
  # Products › Media in order. Either way the grid shows the first few and
  # the viewer carries the lot.
  assign use_blocks = false
  if section.blocks.size > 0
    assign use_blocks = true
    # Only blocks that still hold a photo or a film count (15 Sep 2026): a
    # block left in place after its photo is removed is skipped below, so it
    # adds no tile, no grid slot and nothing to "View all photos".
    assign all_count = 0
    for block in section.blocks
      if block.type == 'video'
        if block.settings.video != blank
          assign bmp4 = block.settings.video.sources | where: 'format', 'mp4' | first
          if bmp4 or block.settings.video.preview_image or block.settings.poster != blank
            assign all_count = all_count | plus: 1
          endif
        elsif block.settings.video_url != blank or block.settings.poster != blank
          assign all_count = all_count | plus: 1
        endif
      elsif block.settings.image != blank
        assign all_count = all_count | plus: 1
      endif
    endfor
  else
    assign all_count = product.images.size | minus: 1
  endif
  assign gallery_count = all_count
  if gallery_count > tiles
    assign gallery_count = tiles
  endif
  assign glayout = section.settings.gallery_layout | default: 'stage'
-%}
{%- if gallery_count > 0 and section.settings.show_gallery -%}
  <div class="prop-gallery s-surface inner{% if section.settings.show_thumbs == false %} pg-nothumbs{% endif %}{% if section.settings.show_rooms == false %} pg-norooms{% endif %}{% if section.settings.show_expand == false %} pg-noexpand{% endif %}" style="--pgs-ar:{{ section.settings.stage_shape | default: '16/9' }}">
    {%- if section.settings.gallery_label != blank -%}<div class="slabel reveal">{{ section.settings.gallery_label }}</div>{%- endif -%}
    <h2 class="prop-gallery-h reveal d1">{{ section.settings.gallery_heading_html | replace: name_token, name_span }}</h2>
    {%- if glayout == 'grid' -%}
    <div class="prop-gallery-grid gn-{{ gallery_count }}" id="galleryGrid">
      {%- assign gdelays = ',d1,d2' | split: ',' -%}
      {%- if use_blocks -%}
        {%- assign g_n = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign cap = block.settings.caption
            assign vid = ''
            assign pic = block.settings.image
            if block.type == 'video'
              assign pic = block.settings.poster
              if block.settings.video != blank
                for src in block.settings.video.sources
                  if src.format == 'mp4'
                    assign vid = src.url
                  endif
                endfor
                if pic == blank
                  assign pic = block.settings.video.preview_image
                endif
              elsif block.settings.video_url != blank
                assign vid = block.settings.video_url
              endif
            endif
            if cap == blank
              if pic != blank and pic.alt != blank
                assign cap = pic.alt
              else
                assign cap = res.title
              endif
            endif
          -%}
          {%- if pic == blank and vid == blank -%}{%- continue -%}{%- endif -%}
          {%- comment -%} Counted among the blocks that still hold a photo or film, so an emptied block leaves no gap (15 Sep 2026). {%- endcomment -%}
          {%- assign g_n = g_n | plus: 1 -%}
          {%- assign i = g_n | minus: 1 | modulo: 3 -%}
          {%- assign in_grid = true -%}
          {%- if g_n > tiles -%}{%- assign in_grid = false -%}{%- endif -%}
          {%- if in_grid -%}
            <div class="gallery-item gallery-tile reveal-wipe {{ gdelays[i] }}{% if vid != blank %} gallery-video{% endif %}" data-lb-item {% if vid != blank %}data-video="{{ vid }}"{% endif %} {% if pic != blank %}data-src="{{ pic | image_url: width: 1800, height: 1350, crop: 'center' }}"{% endif %} data-alt="{{ cap | escape }}" role="button" tabindex="0" aria-label="{% if vid != blank %}Play video{% else %}View photo{% endif %}: {{ cap | escape }}" {{ block.shopify_attributes }}>
              {%- if pic != blank -%}
                <img class="gallery-img" src="{{ pic | image_url: width: 900, height: 675, crop: 'center' }}" alt="{{ cap | escape }}" width="900" height="675" loading="lazy" decoding="async">
              {%- else -%}
                <video class="gallery-img" src="{{ vid }}" muted playsinline preload="metadata"></video>
              {%- endif -%}
            </div>
          {%- else -%}
            <span hidden data-lb-item {% if vid != blank %}data-video="{{ vid }}"{% endif %} {% if pic != blank %}data-src="{{ pic | image_url: width: 2000, height: 1400, crop: 'center' }}"{% endif %} data-alt="{{ cap | escape }}"></span>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for image in product.images offset: 1 limit: tiles -%}
          {%- assign i = forloop.index0 | modulo: 3 -%}
          <div class="gallery-item gallery-tile reveal-wipe {{ gdelays[i] }}" data-lb-item data-src="{{ image | image_url: width: 1800, height: 1350, crop: 'center' }}" data-alt="{{ image.alt | default: res.title | escape }}" role="button" tabindex="0" aria-label="View photo: {{ image.alt | default: res.title | escape }}">
            <img class="gallery-img" src="{{ image | image_url: width: 900, height: 675, crop: 'center' }}" alt="{{ image.alt | default: res.title | escape }}" width="900" height="675" loading="lazy" decoding="async">
          </div>
        {%- endfor -%}
        {%- if all_count > tiles -%}
          <div hidden>
            {%- assign extra_offset = tiles | plus: 1 -%}
            {%- for image in product.images offset: extra_offset -%}
              <span data-lb-item data-src="{{ image | image_url: width: 2000, height: 1400, crop: 'center' }}" data-alt="{{ image.alt | default: res.title | escape }}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if all_count > 1 -%}
      <div class="gallery-more reveal d2">
        <button type="button" class="btn-g" id="galleryAll">{{ section.settings.gallery_all_label | default: "View all photos" }} ({{ all_count }}) &rarr;</button>
      </div>
    {%- endif -%}
    {%- else -%}
    {%- comment -%} Stage + filmstrip. Every photo (blocks or Products › Media) is
        listed once as data; the stage, the strip, the room index and the
        full-screen viewer all read from it. {%- endcomment -%}
    <div hidden id="pgData">
      {%- if use_blocks -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign cap = block.settings.caption
            assign vid = ''
            assign pic = block.settings.image
            if block.type == 'video'
              assign pic = block.settings.poster
              if block.settings.video != blank
                for src in block.settings.video.sources
                  if src.format == 'mp4'
                    assign vid = src.url
                  endif
                endfor
                if pic == blank
                  assign pic = block.settings.video.preview_image
                endif
              elsif block.settings.video_url != blank
                assign vid = block.settings.video_url
              endif
            endif
            if cap == blank
              if pic != blank and pic.alt != blank
                assign cap = pic.alt
              else
                assign cap = res.title
              endif
            endif
          -%}
          {%- if pic == blank and vid == blank -%}{%- continue -%}{%- endif -%}
          <span data-lb-item {% if vid != blank %}data-video="{{ vid }}"{% endif %} {% if pic != blank %}data-src="{{ pic | image_url: width: 2000, height: 1400, crop: 'center' }}" data-stage="{{ pic | image_url: width: 1800 }}" data-thumb="{{ pic | image_url: width: 320, height: 240, crop: 'center' }}"{% endif %} data-alt="{{ cap | escape }}" {{ block.shopify_attributes }}></span>
        {%- endfor -%}
      {%- else -%}
        {%- for image in product.images offset: 1 -%}
          <span data-lb-item data-src="{{ image | image_url: width: 2000, height: 1400, crop: 'center' }}" data-stage="{{ image | image_url: width: 1800 }}" data-thumb="{{ image | image_url: width: 320, height: 240, crop: 'center' }}" data-alt="{{ image.alt | default: res.title | escape }}"></span>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="pg reveal d1" id="pg" data-house="{{ res.title | escape }}">
      <div class="pg-stage" id="pgStage" tabindex="0" aria-roledescription="carousel" aria-label="{{ res.title | escape }} photos">
        <img class="pg-img" id="pgImgA" alt="" decoding="async">
        <img class="pg-img" id="pgImgB" alt="" decoding="async">
        <video class="pg-vid" id="pgVid" muted playsinline loop preload="none" hidden></video>
        <div class="pg-veil" aria-hidden="true"></div>
        <div class="pg-top"><span class="pg-house">{{ prop_name }}{% if mf.suburb.value != blank %} &middot; {{ mf.suburb.value }}{% endif %}</span><span class="pg-count" id="pgCount"></span></div>
        <div class="pg-cap" id="pgCap" aria-live="polite"></div>
        <button type="button" class="pg-arrow pg-prev" id="pgPrev" aria-label="Previous photo">&larr;</button>
        <button type="button" class="pg-arrow pg-next" id="pgNext" aria-label="Next photo">&rarr;</button>
        <button type="button" class="pg-expand" id="pgExpand"><span aria-hidden="true">&#x2922;</span> {{ section.settings.gallery_all_label | default: "View all photos" }} ({{ all_count }})</button>
      </div>
      <div class="pg-strip" id="pgStrip" role="tablist" aria-label="Photo thumbnails"></div>
      <div class="pg-rooms" id="pgRooms" aria-label="Rooms"></div>
    </div>
    {%- endif -%}
  </div>
{%- endif -%}

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <img id="lbImg" alt="">
  <video id="lbVideo" controls playsinline hidden></video>
  <button class="lb-btn lb-prev" id="lbPrev" aria-label="Previous photo">&larr;</button>
  <button class="lb-btn lb-next" id="lbNext" aria-label="Next photo">&rarr;</button>
  <button class="lb-close" id="lbClose" aria-label="Close">&#10005;</button>
  <div class="lb-meta"><span class="lb-cap" id="lbCap"></span><span id="lbCount"></span></div>
</div>
<script>
  (function () {
    var lb = document.getElementById('lb');
    if (!lb || lb.dataset.lbInit) return;
    lb.dataset.lbInit = '1';
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-lb-item]')).filter(function (el) { return !el.closest('[id^="pg-"]'); });
    if (!items.length) return;
    /* One photo: nothing to page through, so no arrows (15 Sep 2026). */
    if (items.length < 2) { document.getElementById('lbPrev').style.display = 'none'; document.getElementById('lbNext').style.display = 'none'; }
    var img = document.getElementById('lbImg'), cap = document.getElementById('lbCap'), count = document.getElementById('lbCount');
    var i = 0, lastFocus = null;
    var house = {{ res.handle | json }};
    var renderNote = {{ s.render_note | json }};
    /* Photos are named house-room-NN; alt text arrives as "SOLACE - solace-kitchen-01"
       or "SOLACE - Kitchen 01". Show just the room, and say when it is a render. */
    function caption(alt) {
      var s = (alt || '').split(' - ').pop().toLowerCase().replace(/\.[a-z]+$/, '');
      if (s.indexOf(house + '-') === 0 || s.indexOf(house + ' ') === 0) s = s.slice(house.length + 1);
      var render = /(^|-)render(-|$)/.test(s);
      s = s.replace(/(^|-)render(-|$)/, '$1').replace(/[-_]?\d+$/, '').replace(/[-_]+/g, ' ').trim();
      if (!s || s === house) s = {{ res.title | json }};
      s = s.replace(/\b\w/g, function (c) { return c.toUpperCase(); });
      return render && renderNote ? s + ' \u00b7 ' + renderNote : s;
    }
    function show(n) {
      i = (n + items.length) % items.length;
      var it = items[i];
      var vid = document.getElementById('lbVideo'), vsrc = it.getAttribute('data-video');
      if (vsrc) {
        img.hidden = true; img.removeAttribute('src');
        vid.hidden = false; if (vid.getAttribute('src') !== vsrc) vid.src = vsrc; vid.play().catch(function () {});
      } else {
        vid.pause(); vid.hidden = true;
        img.hidden = false; img.src = it.getAttribute('data-src');
      }
      img.alt = it.getAttribute('data-alt') || '';
      cap.textContent = caption(it.getAttribute('data-alt'));
      count.textContent = (i + 1) + ' / ' + items.length;
      [i + 1, i - 1].forEach(function (k) { var n = items[(k + items.length) % items.length]; if (!n.getAttribute('data-video') && n.getAttribute('data-src')) { var p = new Image(); p.src = n.getAttribute('data-src'); } });
    }
    function open(n) {
      lastFocus = document.activeElement;
      lb.hidden = false;
      requestAnimationFrame(function () { lb.classList.add('open'); });
      document.documentElement.style.overflow = 'hidden';
      show(n);
      document.getElementById('lbClose').focus();
    }
    function close() {
      document.getElementById('lbVideo').pause();
      lb.classList.remove('open');
      document.documentElement.style.overflow = '';
      setTimeout(function () { lb.hidden = true; }, 350);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    items.forEach(function (it, n) {
      it.addEventListener('click', function () { open(n); });
      it.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(n); } });
    });
    lb.__open = open; lb.__caption = caption;
    var allBtn = document.getElementById('galleryAll');
    if (allBtn) allBtn.addEventListener('click', function () { open(0); });
    /* Swipe to page on touch screens */
    var tx = null;
    lb.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', function (e) {
      if (tx === null) return;
      var dx = e.changedTouches[0].clientX - tx; tx = null;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
    }, { passive: true });
    document.getElementById('lbPrev').addEventListener('click', function () { show(i - 1); });
    document.getElementById('lbNext').addEventListener('click', function () { show(i + 1); });
    document.getElementById('lbClose').addEventListener('click', close);
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(i + 1);
      else if (e.key === 'ArrowLeft') show(i - 1);
    });
  })();
</script>
<script>
  (function () {
    var pg = document.getElementById('pg');
    if (!pg || pg.dataset.init) return;
    pg.dataset.init = '1';
    var data = Array.prototype.slice.call(document.querySelectorAll('#pgData [data-lb-item]'));
    if (!data.length) { pg.hidden = true; return; }
    var lb = document.getElementById('lb');
    var imgs = [document.getElementById('pgImgA'), document.getElementById('pgImgB')];
    var vid = document.getElementById('pgVid'), cap = document.getElementById('pgCap'), count = document.getElementById('pgCount');
    var strip = document.getElementById('pgStrip'), rooms = document.getElementById('pgRooms'), stage = document.getElementById('pgStage');
    var i = 0, on = 0, reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function capOf(n) { var a = data[n].getAttribute('data-alt') || ''; return (lb && lb.__caption) ? lb.__caption(a) : a; }
    function roomOf(n) { return capOf(n).replace(/\s*·.*$/, ''); }
    /* One photo: no arrows or filmstrip to step through (15 Sep 2026). */
    if (data.length < 2) { document.getElementById('pgPrev').style.display = 'none'; document.getElementById('pgNext').style.display = 'none'; strip.style.display = 'none'; }
    /* Filmstrip */
    data.forEach(function (el, n) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'pg-thumb' + (el.getAttribute('data-video') ? ' pg-thumb-video' : '');
      b.setAttribute('role', 'tab'); b.setAttribute('aria-label', capOf(n));
      /* A film with no poster has no still: its thumb is the play mark alone, never an empty img (15 Sep 2026). */
      var tsrc = el.getAttribute('data-thumb') || el.getAttribute('data-src');
      if (tsrc) { var im = document.createElement('img'); im.loading = 'lazy'; im.decoding = 'async'; im.alt = ''; im.src = tsrc; b.appendChild(im); }
      b.addEventListener('click', function () { show(n); });
      strip.appendChild(b);
    });
    /* Room index: one entry per room, in photo order */
    /* Group by the full caption ("Kitchen", "Master Suite"); when photos are
       named more finely than that ("Pool Night", "Pool Day"), group by the
       first word so the index stays a short row of rooms. */
    /* One index entry per room. Photo names carry the room ("kitchen-01",
       "pool-night-03", "formal-living-fireplace-01"); this maps them onto a
       short list of rooms so the index reads like a floor plan. */
    var RN = {
      robe: {{ s.room_robe | default: 'Walk-in Robe' | json }},
      master: {{ s.room_master | default: 'Master Suite' | json }},
      ensuite: {{ s.room_ensuite | default: 'Ensuite' | json }},
      bedrooms: {{ s.room_bedrooms | default: 'Bedrooms' | json }},
      bathrooms: {{ s.room_bathrooms | default: 'Bathrooms' | json }},
      powder: {{ s.room_powder | default: 'Powder Room' | json }},
      kitchen: {{ s.room_kitchen | default: 'Kitchen' | json }},
      dining: {{ s.room_dining | default: 'Dining' | json }},
      living: {{ s.room_living | default: 'Living' | json }},
      games: {{ s.room_games | default: 'Games Room' | json }},
      media: {{ s.room_media | default: 'Media Room' | json }},
      cinema: {{ s.room_cinema | default: 'Cinema' | json }},
      study: {{ s.room_study | default: 'Study' | json }},
      gym: {{ s.room_gym | default: 'Gym' | json }},
      wellness: {{ s.room_wellness | default: 'Wellness' | json }},
      cellar: {{ s.room_cellar | default: 'Cellar' | json }},
      laundry: {{ s.room_laundry | default: 'Laundry' | json }},
      mud: {{ s.room_mud | default: 'Mud Room' | json }},
      garage: {{ s.room_garage | default: 'Garage' | json }},
      pool: {{ s.room_pool | default: 'Pool' | json }},
      alfresco: {{ s.room_alfresco | default: 'Alfresco' | json }},
      terrace: {{ s.room_terrace | default: 'Terrace' | json }},
      balcony: {{ s.room_balcony | default: 'Balcony' | json }},
      rooftop: {{ s.room_rooftop | default: 'Rooftop' | json }},
      courtyard: {{ s.room_courtyard | default: 'Courtyard' | json }},
      garden: {{ s.room_garden | default: 'Garden' | json }},
      entry: {{ s.room_entry | default: 'Entry' | json }},
      stair: {{ s.room_stair | default: 'Staircase' | json }},
      exterior: {{ s.room_exterior | default: 'Exterior' | json }},
      aerial: {{ s.room_aerial | default: 'Aerial' | json }},
      interior: {{ s.room_interior | default: 'Interior' | json }}
    };
    var ROOMS = [['walk in robe', RN.robe], ['robe', RN.robe], ['master', RN.master], ['ensuite', RN.ensuite], ['bedroom', RN.bedrooms], ['bed ', RN.bedrooms], ['bathroom', RN.bathrooms], ['bath', RN.bathrooms], ['powder', RN.powder], ['kitchen', RN.kitchen], ['butler', RN.kitchen], ['pantry', RN.kitchen], ['dining', RN.dining], ['living', RN.living], ['lounge', RN.living], ['family', RN.living], ['games', RN.games], ['media', RN.media], ['cinema', RN.cinema], ['study', RN.study], ['office', RN.study], ['gym', RN.gym], ['sauna', RN.wellness], ['spa', RN.wellness], ['cellar', RN.cellar], ['laundry', RN.laundry], ['mud', RN.mud], ['garage', RN.garage], ['pool', RN.pool], ['cabana', RN.pool], ['alfresco', RN.alfresco], ['terrace', RN.terrace], ['balcony', RN.balcony], ['rooftop', RN.rooftop], ['courtyard', RN.courtyard], ['garden', RN.garden], ['entry', RN.entry], ['foyer', RN.entry], ['hall', RN.entry], ['stair', RN.stair], ['facade', RN.exterior], ['exterior', RN.exterior], ['street', RN.exterior], ['front', RN.exterior], ['rear', RN.exterior], ['aerial', RN.aerial], ['interior', RN.interior]];
    var house = (pg.getAttribute('data-house') || '').toLowerCase();
    var roomKey = function (n) {
      var c = roomOf(n).toLowerCase();
      for (var k = 0; k < ROOMS.length; k++) { if (c.indexOf(ROOMS[k][0]) !== -1) return ROOMS[k][1]; }
      var w = c.replace(/\b\d+\b/g, '').trim().split(/\s+/).filter(function (x) { return x && x !== house; });
      return w.length ? w.slice(0, 2).join(' ').replace(/\b\w/g, function (ch) { return ch.toUpperCase(); }) : '';
    };
    var roomAt = {}, roomKeys = [];
    data.forEach(function (el, n) { var r = roomKey(n); if (r && !(r in roomAt)) { roomAt[r] = n; roomKeys.push(r); } });
    if (roomKeys.length > 1 && roomKeys.length <= 16) {
      roomKeys.forEach(function (r) {
        var b = document.createElement('button'); b.type = 'button'; b.className = 'pg-room'; b.textContent = r;
        b.addEventListener('click', function () { show(roomAt[r]); });
        rooms.appendChild(b);
      });
    } else { rooms.hidden = true; }
    function show(n, instant) {
      i = (n + data.length) % data.length;
      var el = data[i], v = el.getAttribute('data-video');
      if (v) {
        imgs.forEach(function (im) { im.classList.remove('is-on'); });
        vid.hidden = false; if (vid.getAttribute('src') !== v) vid.src = v; vid.play().catch(function () {});
      } else {
        vid.pause(); vid.hidden = true;
        var nxt = imgs[1 - on], src = el.getAttribute('data-stage') || el.getAttribute('data-src');
        var swap = function () { imgs[on].classList.remove('is-on'); nxt.classList.add('is-on'); on = 1 - on; nxt.onload = null; };
        nxt.alt = capOf(i);
        if (nxt.getAttribute('src') === src && nxt.complete) swap();
        else { nxt.onload = swap; nxt.src = src; }
      }
      cap.textContent = capOf(i); count.textContent = (i + 1) + ' / ' + data.length;
      var th = strip.children;
      for (var k = 0; k < th.length; k++) { th[k].classList.toggle('is-on', k === i); th[k].setAttribute('aria-selected', k === i ? 'true' : 'false'); }
      if (th[i]) strip.scrollTo({ left: th[i].offsetLeft - strip.clientWidth / 2 + th[i].offsetWidth / 2, behavior: (instant || reduce) ? 'auto' : 'smooth' });
      var rk = roomKey(i);
      Array.prototype.forEach.call(rooms.children, function (b) { b.classList.toggle('is-on', b.textContent === rk); });
      [i + 1, i - 1].forEach(function (k) { var e = data[(k + data.length) % data.length]; if (!e.getAttribute('data-video')) { var p = new Image(); p.src = e.getAttribute('data-stage') || e.getAttribute('data-src'); } });
    }
    document.getElementById('pgPrev').addEventListener('click', function (e) { e.stopPropagation(); show(i - 1); });
    document.getElementById('pgNext').addEventListener('click', function (e) { e.stopPropagation(); show(i + 1); });
    var openFull = function (e) { if (e) e.stopPropagation(); if (lb && lb.__open) lb.__open(i); };
    document.getElementById('pgExpand').addEventListener('click', openFull);
    stage.addEventListener('click', function (e) { if (e.target.closest('button')) return; openFull(); });
    stage.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openFull(); }
    });
    var tx = null;
    stage.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (tx === null) return; var dx = e.changedTouches[0].clientX - tx; tx = null;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
    }, { passive: true });
    show(0, true);
  })();
</script>
<style>
  /* [hidden] alone loses to .lb{display:flex} in style.css, so the photo viewer never hid. */
  .lb[hidden]{display:none}
  .pg-nothumbs .pg-strip{display:none}
  .pg-norooms .pg-rooms{display:none}
  .pg-noexpand .pg-expand{display:none}
  .prop-gallery .pg-stage{aspect-ratio:var(--pgs-ar,16/9)}
</style>

