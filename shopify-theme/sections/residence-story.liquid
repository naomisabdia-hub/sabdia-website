    {
      "type": "text",
      "id": "f_last",
      "label": "Last name label",
      "default": "Last Name*",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "f_email",
      "label": "Email label",
      "default": "Email*",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "f_phone",
      "label": "Phone label",
      "default": "Phone",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "f_interest",
      "label": "Enquiry type label",
      "default": "Enquiry Type",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "f_message",
      "label": "Message label",
      "default": "Message",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "ph_first",
      "label": "First name placeholder",
      "default": "First name",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "ph_last",
      "label": "Last name placeholder",
      "default": "Last name",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "ph_email",
      "label": "Email placeholder",
