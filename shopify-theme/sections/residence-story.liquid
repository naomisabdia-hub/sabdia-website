      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "ph_phone",
      "label": "Phone placeholder",
      "default": "Phone number",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "ph_message",
      "label": "Message placeholder",
      "default": "Tell us about your requirements or any questions you have…",
