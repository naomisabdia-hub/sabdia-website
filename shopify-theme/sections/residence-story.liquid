{%- comment -%}
  Description and enquiry - the residence's story beside the form

  Headline, description and key features (typed in this panel, or the
  words saved on the page when a box is empty) with the enquiry form, buyer questions and the brochure / general
  enquiry buttons beside them. (The sticky Enquire bar on phones lives in
  the Property page section.)

  Split out of the all-in-one Property page section on 14 Sep 2026 so each
  part of the residence page has its own panel in the customizer. Real
  photographs and real footage only, never generated.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  # The residence being shown: its product, or its page (15 Sep 2026: the
  # residences moved from $0 products to pages - same fields, same design).
  assign res = product
  if res == blank and page != blank
    assign res = page
  endif
  assign mf = res.metafields.custom
  # The description: the product's, or the page's body (the same words).
  assign res_desc = product.description
  if res_desc == blank and res != blank
    assign res_desc = res.content
  endif
  # The {name} token editors write in the shared framing copy. Built with
  # append because Shopify's Liquid parser rejects literal braces inside
  # an output tag's string arguments.
  assign name_token = '{' | append: 'name' | append: '}'
  capture pstatus
    render 'residence-status', product: res
  endcapture
  assign sold = false
  if pstatus contains 'Sold'
    assign sold = true
  endif
  assign state = mf.state.value | default: 'QLD'
  # Words typed in this section's panel win (17 Sep 2026, so Tamsin can edit
  # every word in Customize); an empty box falls back to the page's saved
  # fields (Content › Pages › the residence).
  assign r_headline = s.headline_text | default: mf.headline.value
  assign r_desc = res_desc
  assign desc_typed = s.description_text | strip_html | strip
  if desc_typed != blank
    assign r_desc = s.description_text
  endif
  assign r_feats = mf.features.value
  assign feats_typed = s.features_list | strip
  if feats_typed != blank
    assign r_feats = s.features_list | newline_to_br | split: '<br />'
  endif
  assign r_enq_heading = s.enquiry_heading | default: mf.enquiry_heading.value | default: 'Enquire Now'
  assign r_enq_intro = s.enquiry_intro | default: mf.enquiry_text.value
  assign r_enq_button = s.enquiry_button | default: mf.enquiry_button.value | default: 'Submit Enquiry'
  # The residence's name in its own brochure face (Products › the residence
  # › Metafields › Residence name font …), for headings that carry it.
  capture name_span
    render 'residence-name', product: res
  endcapture
  # The name as the brochure writes it (Sierra, not SIERRA) where it is
  # printed as plain text.
  assign prop_name = res.title
  assign nf_any = mf.name_font.value | strip | append: mf.name_font_file.value
  if nf_any != blank
    unless mf.name_font_caps.value
      assign prop_name = res.title | downcase | capitalize
    endunless
  endif
-%}
{%- liquid
  assign pr_split = '7fr 5fr'
  if s.body_layout == 'equal'
    assign pr_split = '1fr 1fr'
  elsif s.body_layout == 'stack' or s.body_layout == 'form-first-stack'
    assign pr_split = '1fr'
  endif
-%}
{% render 'section-look', section: section %}
<div class="prop-body s-surface pb-{{ section.settings.body_layout | default: 'beside' }}" style="--prop-split:{{ pr_split }}">
  <div class="prop-layout inner">
    <div class="{% if section.settings.sticky_desc %}prop-desc{% endif %}">
      {%- if section.settings.show_about_label -%}<div class="slabel prop-desc-slabel reveal">{{ section.settings.about_label | replace: name_token, name_span }}</div>{%- endif -%}
      {%- if section.settings.show_headline and r_headline != blank -%}<h1 class="prop-body-h reveal d1">{{ r_headline }}</h1>{%- endif -%}
      {%- if section.settings.show_description -%}{{ r_desc | replace: '<p>', '<p class="prop-body-p reveal d2">' }}{%- endif -%}

      {%- if r_feats.size > 0 and section.settings.show_features -%}
        <div class="prop-features reveal d3">
          <div class="prop-features-h">{{ section.settings.features_heading }}</div>
          <div class="prop-feat-grid">
            {%- for f in r_feats -%}
              {%- assign ft = f | strip -%}
              {%- if ft != blank -%}<div class="prop-feat">{{ ft }}</div>{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_enquiry -%}
    <div class="reveal d2 prop-side">
      <div class="prop-enquire">
        <div class="prop-enquire-h">{{ r_enq_heading | replace: name_token, res.title | replace: res.title, name_span }}</div>
        <p style="font-size:13px;font-weight:300;color:var(--ink3);line-height:1.75;margin-bottom:24px">{{ r_enq_intro | replace: name_token, prop_name }}</p>
        {%- if settings.form_backend == 'vercel' -%}
        <form class="cform" id="cform" name="property-enquiry" method="POST" action="{{ settings.forms_endpoint }}/api/contact">
          <input type="hidden" name="form-name" value="property-enquiry">
          <input type="hidden" name="property" value="{{ res.title | escape }}">
          <p class="hidden" style="display:none" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
          <div class="frow">
            <div class="fg"><label class="fl" for="pe-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="pe-first" name="first-name" class="fi" placeholder="{{ s.ph_first | escape }}" autocomplete="given-name" required></div>
            <div class="fg"><label class="fl" for="pe-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="pe-last" name="last-name" class="fi" placeholder="{{ s.ph_last | escape }}" autocomplete="family-name" required></div>
          </div>
          <div class="fg"><label class="fl" for="pe-email">{{ section.settings.f_email | default: "Email*" }}</label><input type="email" id="pe-email" name="email" class="fi" placeholder="{{ s.ph_email | escape }}" autocomplete="email" required></div>
          <div class="fg"><label class="fl" for="pe-phone">{{ section.settings.f_phone | default: "Phone" }}</label><input type="tel" id="pe-phone" name="phone" class="fi" required placeholder="{{ s.ph_phone | escape }}" autocomplete="tel"></div>
          {%- unless sold -%}
            <div class="fg">
              <label class="fl" for="pe-type">{{ section.settings.f_interest | default: "Enquiry Type" }}</label>
              <select class="fsel" id="pe-type" name="enquiry-type">
                {%- assign etypes = section.settings.enquiry_types | newline_to_br | split: '<br />' -%}
                {%- for t in etypes -%}
                  {%- assign parts = t | split: '|' -%}
                  {%- assign tt = parts[0] | strip -%}
                  {%- if tt != blank -%}<option>{{ tt | replace: name_token, prop_name }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
              {%- for t in etypes -%}
                {%- assign parts = t | split: '|' -%}
                {%- if parts.size > 1 -%}<span hidden data-thanks-for="{{ parts[0] | strip | replace: name_token, prop_name | escape }}">{{ parts[1] | strip | replace: name_token, prop_name }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endunless -%}
          {% render 'prequal-fields', mode: 'vercel', s: section.settings, residence_suburb: mf.suburb.value %}
          <div class="fg"><label class="fl" for="pe-message">{{ section.settings.f_message | default: "Message" }}</label><textarea class="fta" id="pe-message" name="message" placeholder="{{ s.ph_message | escape }}"></textarea></div>
          <p class="form-note">{% render 'privacy-link', note: section.settings.privacy_note %}</p>
          <button type="submit" class="fsub" id="fsub">{{ r_enq_button }} &rarr;</button>
          <p class="sr-status" role="status" aria-live="polite" data-form-status></p>
        </form>
        {%- else -%}
        {% form 'contact', id: 'cform', class: 'cform' %}
          <span hidden data-thanks>{{ section.settings.success_text }}</span>
          {%- if form.posted_successfully? -%}
            {% render 'form-thanks', text: section.settings.success_text, heading: section.settings.thanks_heading %}
          {%- else -%}
          {%- if form.errors -%}
            <p class="form-note" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[Property]" value="{{ res.title | escape }}">
          <div class="frow">
            <div class="fg"><label class="fl" for="pe-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="pe-first" name="contact[First name]" class="fi" placeholder="{{ s.ph_first | escape }}" autocomplete="given-name" required></div>
            <div class="fg"><label class="fl" for="pe-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="pe-last" name="contact[Last name]" class="fi" placeholder="{{ s.ph_last | escape }}" autocomplete="family-name" required></div>
          </div>
          <div class="fg"><label class="fl" for="pe-email">{{ section.settings.f_email | default: "Email*" }}</label><input type="email" id="pe-email" name="contact[email]" class="fi" placeholder="{{ s.ph_email | escape }}" autocomplete="email" required></div>
          <div class="fg"><label class="fl" for="pe-phone">{{ section.settings.f_phone | default: "Phone" }}</label><input type="tel" id="pe-phone" name="contact[Phone]" class="fi" required placeholder="{{ s.ph_phone | escape }}" autocomplete="tel"></div>
          {%- unless sold -%}
            <div class="fg">
              <label class="fl" for="pe-type">{{ section.settings.f_interest | default: "Enquiry Type" }}</label>
              <select class="fsel" id="pe-type" name="contact[Enquiry type]">
                {%- assign etypes = section.settings.enquiry_types | newline_to_br | split: '<br />' -%}
                {%- for t in etypes -%}
                  {%- assign parts = t | split: '|' -%}
                  {%- assign tt = parts[0] | strip -%}
                  {%- if tt != blank -%}<option>{{ tt | replace: name_token, prop_name }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
              {%- for t in etypes -%}
                {%- assign parts = t | split: '|' -%}
                {%- if parts.size > 1 -%}<span hidden data-thanks-for="{{ parts[0] | strip | replace: name_token, prop_name | escape }}">{{ parts[1] | strip | replace: name_token, prop_name }}</span>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endunless -%}
          {% render 'prequal-fields', mode: 'shopify', s: section.settings, residence_suburb: mf.suburb.value %}
          <div class="fg"><label class="fl" for="pe-message">{{ section.settings.f_message | default: "Message" }}</label><textarea class="fta" id="pe-message" name="contact[body]" placeholder="{{ s.ph_message | escape }}"></textarea></div>
          <p class="form-note">{% render 'privacy-link', note: section.settings.privacy_note %}</p>
          {% render 'form-optin', label: section.settings.optin_label %}
          <button type="submit" class="fsub" id="fsub">{{ r_enq_button }} &rarr;</button>
        {%- endif -%}
          {% endform %}
          {%- assign cm_uid = 'cm-' | append: section.id -%}{% render 'customer-mirror', uid: cm_uid, residence: res.handle %}
        {%- endif -%}
      </div>
      <div style="margin-top:16px;display:flex;flex-direction:column;gap:10px">
        {%- if mf.brochure_url.value != blank and section.settings.show_brochure -%}
          <a href="{{ mf.brochure_url.value }}" target="_blank" rel="noopener" class="btn-g btn-g-gold" style="justify-content:center" download>{{ section.settings.brochure_label }} &darr;</a>
        {%- endif -%}
        {%- if sold -%}
          <a href="{{ section.settings.sold_banner_link | default: '/collections/for-sale' }}" class="btn-p" style="justify-content:center">{{ section.settings.sold_cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.show_general -%}<a href="{{ section.settings.general_link | default: '/pages/contact' }}" class="btn-g {% unless sold %}btn-g-gold{% endunless %}" style="justify-content:center">{{ section.settings.general_label }}</a>{%- endif -%}
      </div>
    </div>
    {%- endif -%}
  </div>
</div>

<style>
  @media(min-width:1201px){.prop-body .prop-layout{grid-template-columns:var(--prop-split,7fr 5fr)}}
  .pb-form-first .prop-layout>div:first-child,.pb-form-first-stack .prop-layout>div:first-child{order:2}
  .pb-stack .prop-side,.pb-form-first-stack .prop-side{max-width:640px}
</style>

{% schema %}
{
  "name": "About and enquiry",
  "settings": [
    {
      "type": "paragraph",
      "content": "About the residence and the enquiry flow: the residence's story beside the enquiry form (Enquire about {name}), the buyer questions and the buttons around it. Every word here is editable in this panel. The headline, description, key features and form heading start as the words saved on the page (Content › Pages › the residence); an empty box shows the page's words again."
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "paragraph",
      "content": "Shared framing text for every property page. Write {name} wherever the residence's name should appear."
    },
    {
      "type": "checkbox",
      "id": "show_about_label",
      "label": "Show the description label",
      "default": true
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "Description label",
      "default": "About {name}",
      "visible_if": "{{ section.settings.show_about_label }}"
    },
    {
      "type": "checkbox",
      "id": "show_headline",
      "label": "Show the headline",
      "default": true
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "Headline",
      "info": "Put <em> and </em> around the italic words and <br> where the line breaks. Empty = the headline saved on the page.",
      "visible_if": "{{ section.settings.show_headline }}"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the description",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description_text",
      "label": "Description",
      "info": "Empty = the page's own text (Content › Pages › the residence). The site chat answers from the page's own text, so when a fact changes, change it there too.",
      "visible_if": "{{ section.settings.show_description }}"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show the key features",
      "default": true
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features heading",
      "default": "Key Features",
      "visible_if": "{{ section.settings.show_features }}"
    },
    {
      "type": "textarea",
      "id": "features_list",
      "label": "Key features (one per line)",
      "info": "They show in two columns, in this order. Empty = the list saved on the page. The For Sale filter (pool, views, lift…) still reads the page's saved list.",
      "visible_if": "{{ section.settings.show_features }}"
    },
    {
      "type": "checkbox",
      "id": "sticky_desc",
      "label": "Description holds while the form scrolls",
      "default": true
    },
    {
      "type": "select",
      "id": "body_layout",
      "label": "Description and form",
      "options": [
        {
          "value": "beside",
          "label": "Description 7 : form 5 (as designed)"
        },
        {
          "value": "equal",
          "label": "Equal halves"
        },
        {
          "value": "form-first",
          "label": "Form first"
        },
        {
          "value": "stack",
          "label": "Form under the description"
        },
        {
          "value": "form-first-stack",
          "label": "Form above the description"
        }
      ],
      "default": "beside"
    },
    {
      "type": "header",
      "content": "Enquiry form"
    },
    {
      "type": "checkbox",
      "id": "show_enquiry",
      "label": "Show the enquiry panel",
      "default": true
    },
    {
      "type": "text",
      "id": "enquiry_heading",
      "label": "Form heading",
      "info": "{name} becomes the residence's name. Empty = the heading saved on the page, or Enquire Now.",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "textarea",
      "id": "enquiry_intro",
      "label": "Form intro",
      "info": "The line under the heading. Empty = the intro saved on the page.",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
      "id": "enquiry_button",
      "label": "Send button",
      "info": "Empty = the button saved on the page, or Submit Enquiry.",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "textarea",
      "id": "enquiry_types",
      "label": "Enquiry types (one per line)",
      "info": "{name} becomes the residence's name. The budget, timeline and location questions appear only for an inspection or an interest enquiry (Naomi, 14 Sep 2026). Add a tailored thank-you after a | on the same line, e.g. Custom home design | Thank you. Sabdia designs and builds every residence in-house, so we do not take on custom commissions - but we will be in touch about our current and upcoming releases.",
      "default": "General enquiry about {name} | Thank you for your enquiry about {name}. A member of the Sabdia team will be in touch shortly.\nArrange an inspection | Thank you. Inspections of {name} are by private appointment, and a member of the Sabdia team will be in touch shortly to arrange a time.\nRegister my interest | Thank you for registering your interest in {name}. A member of the Sabdia team will be in touch shortly.",
      "visible_if": "{{ section.settings.show_enquiry }}"
    },
    {
      "type": "text",
