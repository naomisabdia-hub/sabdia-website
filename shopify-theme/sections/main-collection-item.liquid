{%- comment -%}
  Collection residence page - port of collection/[slug].astro, shared by
  every completed residence via templates/page.collection-item.json.
  The residence itself comes from PAGE metafields (namespace custom):
    loc            single line   - "Camp Hill QLD, Australia"
    image          single line   - hero/poster URL or /images/… path
    video          single line   - film URL (optional)
    series_posts   json          - the residence's real Instagram posts
    gallery        list of URLs  - the residence's photos, in order (Gallery
                                   photos in the page's metafields). Shown as a
                                   stage + filmstrip with the full-screen viewer.
  The editorial story is stitched from the strongest Series captions,
  exactly like the live site. "More from the Collection" renders from
  this section's blocks (the full portfolio list; the residence being
  viewed is skipped).
{%- endcomment -%}
{%- liquid
  assign mf = page.metafields.custom
  assign posts = mf.series_posts.value
  assign gallery = mf.gallery.value
  assign hero = mf.image.value
  if hero == blank and gallery.size > 0
    assign hero = gallery[0]
  endif
  assign name_token = '{' | append: 'name' | append: '}'
-%}

<section class="cd-hero">
  {%- if hero != blank -%}
    <img src="{% render 'ext-variant', src: hero, w: 1920, h: 1080 %}" alt="{{ page.title | escape }}" loading="eager" fetchpriority="high" width="1920" height="1080">
  {%- endif -%}
  <div class="cd-hero-ov"></div>
  <div class="cd-hero-content">
    <div class="cd-badge reveal">{{ section.settings.badge }}</div>
    <h1 class="cd-name reveal d1">{{ page.title }}</h1>
    <div class="cd-loc reveal d2">{{ mf.loc.value }}</div>
  </div>
</section>

{%- liquid
  # Editorial story - the strongest captions (over 60 characters),
  # deduplicated, first three, each closed with a full stop.
  capture story_raw
    for p in posts
      if p.caption.size > 60 and p.hidden != true
        echo p.caption | strip | append: '¦'
      endif
    endfor
  endcapture
  assign story = story_raw | split: '¦' | uniq
-%}
{%- if story.size > 0 -%}
  <div class="cd-story">
    {%- for p in story limit: 3 -%}
      {%- assign last = p | slice: -1, 1 -%}
      <p class="reveal">{{ p }}{% unless last == '.' or last == '!' or last == '?' %}.{% endunless %}</p>
    {%- endfor -%}
  </div>
{%- endif -%}

{%- if gallery.size > 0 -%}
  {%- comment -%} Photo gallery - the same stage + filmstrip as the residences for sale,
      fed by the page's Gallery photos. Thumbnails live beside the photos
      (…/media/collection-thumbs/…); a photo without one just uses itself. {%- endcomment -%}
  <section class="cd-gallery">
    <div class="prop-gallery inner">
      <div class="slabel reveal">{{ section.settings.gallery_label }}</div>
      <h2 class="prop-gallery-h reveal d1">{{ section.settings.gallery_heading_html | replace: name_token, page.title }}</h2>
      <div hidden id="pgData">
        {%- for u in gallery -%}
          {%- assign t = u | replace: '/media/collection/', '/media/collection-thumbs/' -%}
          <span data-lb-item data-src="{{ u }}" data-stage="{{ u }}" data-thumb="{{ t }}" data-alt="{{ page.title | escape }} &middot; {{ forloop.index }}"></span>
        {%- endfor -%}
      </div>
      <div class="pg reveal d1" id="pg" data-house="{{ page.title | escape }}">
        <div class="pg-stage" id="pgStage" tabindex="0" aria-roledescription="carousel" aria-label="{{ page.title | escape }} photos">
          <img class="pg-img" id="pgImgA" alt="" decoding="async" width="1800" height="1013">
          <img class="pg-img" id="pgImgB" alt="" decoding="async" width="1800" height="1013">
          <div class="pg-veil" aria-hidden="true"></div>
          <div class="pg-top"><span class="pg-house">{{ page.title }}{% if mf.loc.value != blank %} &middot; {{ mf.loc.value | split: ',' | first }}{% endif %}</span><span class="pg-count" id="pgCount"></span></div>
          <button type="button" class="pg-arrow pg-prev" id="pgPrev" aria-label="Previous photo">&larr;</button>
          <button type="button" class="pg-arrow pg-next" id="pgNext" aria-label="Next photo">&rarr;</button>
          <button type="button" class="pg-expand" id="pgExpand"><span aria-hidden="true">&#x2922;</span> {{ section.settings.gallery_all_label | default: "View all photos" }} ({{ gallery.size }})</button>
        </div>
        <div class="pg-strip" id="pgStrip" role="tablist" aria-label="Photo thumbnails"></div>
      </div>
    </div>
  </section>

  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <img id="lbImg" src="" alt="" width="2000" height="1400">
    <button class="lb-btn lb-prev" id="lbPrev" aria-label="Previous photo">&larr;</button>
    <button class="lb-btn lb-next" id="lbNext" aria-label="Next photo">&rarr;</button>
    <button class="lb-close" id="lbClose" aria-label="Close">&#10005;</button>
    <div class="lb-meta"><span class="lb-cap" id="lbCap"></span><span id="lbCount"></span></div>
  </div>
  <style>
    .cd-gallery{padding-top:clamp(8px,2vw,24px)}
    .cd-gallery .pg{margin-top:32px}
  </style>
  <script>
    (function () {
      var pg = document.getElementById('pg'), lb = document.getElementById('lb');
      if (!pg || !lb || pg.dataset.init) return;
      pg.dataset.init = '1';
      var data = Array.prototype.slice.call(document.querySelectorAll('#pgData [data-lb-item]'));
      if (!data.length) { pg.hidden = true; return; }
      var house = pg.getAttribute('data-house') || '';
      var imgs = [document.getElementById('pgImgA'), document.getElementById('pgImgB')];
      var count = document.getElementById('pgCount'), strip = document.getElementById('pgStrip'), stage = document.getElementById('pgStage');
      var lbImg = document.getElementById('lbImg'), lbCap = document.getElementById('lbCap'), lbCount = document.getElementById('lbCount');
      var i = 0, on = 0, li = 0, lastFocus = null;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function srcOf(n) { return data[n].getAttribute('data-src'); }
      function preload(n) { [n + 1, n - 1].forEach(function (k) { var p = new Image(); p.src = srcOf((k + data.length) % data.length); }); }
      /* Filmstrip */
      data.forEach(function (el, n) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'pg-thumb'; b.setAttribute('role', 'tab'); b.setAttribute('aria-label', house + ' photo ' + (n + 1));
        var im = document.createElement('img'); im.loading = 'lazy'; im.decoding = 'async'; im.alt = '';
        im.src = el.getAttribute('data-thumb') || el.getAttribute('data-src');
        im.addEventListener('error', function () { if (im.src !== el.getAttribute('data-src')) im.src = el.getAttribute('data-src'); }, { once: true });
        b.appendChild(im); b.addEventListener('click', function () { show(n); });
        strip.appendChild(b);
      });
      function show(n, instant) {
        i = (n + data.length) % data.length;
        var nxt = imgs[1 - on], src = srcOf(i);
        var swap = function () { imgs[on].classList.remove('is-on'); nxt.classList.add('is-on'); on = 1 - on; nxt.onload = null; };
        nxt.alt = house + ' photo ' + (i + 1);
        if (nxt.getAttribute('src') === src && nxt.complete) swap(); else { nxt.onload = swap; nxt.src = src; }
        count.textContent = (i + 1) + ' / ' + data.length;
        var th = strip.children;
        for (var k = 0; k < th.length; k++) { th[k].classList.toggle('is-on', k === i); th[k].setAttribute('aria-selected', k === i ? 'true' : 'false'); }
        if (th[i]) strip.scrollTo({ left: th[i].offsetLeft - strip.clientWidth / 2 + th[i].offsetWidth / 2, behavior: (instant || reduce) ? 'auto' : 'smooth' });
        preload(i);
      }
      /* Full-screen viewer */
      function lbShow(n) {
        li = (n + data.length) % data.length;
        lbImg.src = srcOf(li); lbImg.alt = house + ' photo ' + (li + 1);
        lbCap.textContent = house; lbCount.textContent = (li + 1) + ' / ' + data.length;
        preload(li);
      }
      function openFull(e) {
        if (e) e.stopPropagation();
        lastFocus = document.activeElement;
        lb.hidden = false; requestAnimationFrame(function () { lb.classList.add('open'); });
        document.documentElement.style.overflow = 'hidden';
        lbShow(i); document.getElementById('lbClose').focus();
      }
      function close() {
        lb.classList.remove('open'); document.documentElement.style.overflow = '';
        setTimeout(function () { lb.hidden = true; }, 350);
        show(li, true);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      document.getElementById('pgPrev').addEventListener('click', function (e) { e.stopPropagation(); show(i - 1); });
      document.getElementById('pgNext').addEventListener('click', function (e) { e.stopPropagation(); show(i + 1); });
      document.getElementById('pgExpand').addEventListener('click', openFull);
      stage.addEventListener('click', function (e) { if (e.target.closest('button')) return; openFull(); });
      stage.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openFull(); }
      });
      document.getElementById('lbPrev').addEventListener('click', function () { lbShow(li - 1); });
      document.getElementById('lbNext').addEventListener('click', function () { lbShow(li + 1); });
      document.getElementById('lbClose').addEventListener('click', close);
      lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') lbShow(li + 1);
        else if (e.key === 'ArrowLeft') lbShow(li - 1);
      });
      /* Swipe on touch screens - stage and viewer */
      [stage, lb].forEach(function (el, which) {
        var tx = null;
        el.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].clientX; }, { passive: true });
        el.addEventListener('touchend', function (e) {
          if (tx === null) return; var dx = e.changedTouches[0].clientX - tx; tx = null;
          if (Math.abs(dx) > 40) { if (which) lbShow(dx < 0 ? li + 1 : li - 1); else show(dx < 0 ? i + 1 : i - 1); }
        }, { passive: true });
      });
      show(0, true);
    })();
  </script>
{%- endif -%}

{%- if mf.video.value != blank -%}
  {%- assign film_token = '{' | append: 'name' | append: '}' -%}
  <section class="film-band" id="film">
    <div class="film-grid">
      <div class="film-copy">
        <div class="slabel slabel-dark reveal">{{ section.settings.film_label }}</div>
        <h2 class="film-h reveal d1">{{ section.settings.film_heading_html | replace: film_token, page.title }}</h2>
        <p class="film-p reveal d2">{{ section.settings.film_text | replace: film_token, page.title }}</p>
      </div>
      <div class="reveal d2">
        <div class="film-frame" data-film>
          <video src="{{ mf.video.value }}" {% if mf.image.value != blank %}poster="{% render 'ext-variant', src: mf.image.value, w: 1200, h: 675 %}"{% endif %} muted loop playsinline preload="none"></video>
          <button class="film-sound" type="button" aria-label="Toggle sound" data-sound>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            <span data-sound-label>{{ section.settings.sound_label | default: "Sound On" }}</span>
          </button>
        </div>
        <div class="film-caption">
          <span><b>{{ page.title }} - On Film</b></span>
          <span>{{ mf.loc.value }}</span>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{%- capture more_cards -%}
  {%- assign shown = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.name == page.title or shown >= 3 -%}{%- continue -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    {%- liquid
      # The linked residence page's own photo (its Hero image metafield) wins
      # over the address typed into the block, so a page updated in Pages
      # shows the same photo everywhere.
      assign more_img = block.settings.image_ext
      if block.settings.link contains '/pages/'
        assign more_handle = block.settings.link | split: '/pages/' | last | split: '?' | first | split: '#' | first
        assign more_page = pages[more_handle]
        if more_page.metafields.custom.image.value != blank
          assign more_img = more_page.metafields.custom.image.value
        elsif more_page.metafields.custom.gallery.value.size > 0
          assign more_img = more_page.metafields.custom.gallery.value | first
        endif
      endif
    -%}
    <a href="{{ block.settings.link }}" class="port-card reveal" {{ block.shopify_attributes }}>
      <div class="port-img-wrap">
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 800, height: 600, crop: 'center' }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="800" height="600">
        {%- elsif more_img != blank -%}
          <img src="{% render 'ext-variant', src: more_img, w: 800, h: 600 %}" alt="{{ block.settings.name | escape }}" loading="lazy" width="800" height="600">
        {%- endif -%}
      </div>
      <div class="port-name">{{ block.settings.name }}</div>
      <div class="port-loc">{{ block.settings.loc }}</div>
    </a>
  {%- endfor -%}
{%- endcapture -%}
{%- assign more_stripped = more_cards | strip -%}
{%- if more_stripped != blank -%}
  <section class="sp" style="border-top:1px solid var(--border)">
    <div class="inner">
      <div class="slabel reveal" style="margin-bottom:32px">{{ section.settings.more_label }}</div>
      <div class="portfolio-grid">{{ more_cards }}</div>
    </div>
  </section>
{%- endif -%}

<section class="sp" style="background:var(--dark);text-align:center">
  <div class="inner-sm">
    <div class="slabel slabel-dark reveal" style="justify-content:center;margin-bottom:20px">{{ section.settings.cta_label }}</div>
    {%- assign cta_token = '{' | append: 'name' | append: '}' -%}
    <h2 class="reveal d1" style="font-family:var(--font-d);font-size:clamp(34px,5vw,64px);font-weight:300;color:var(--white);letter-spacing:-.02em;margin-bottom:22px">{{ section.settings.cta_heading_html | replace: cta_token, page.title }}</h2>
    <p class="reveal d2" style="font-size:13px;font-weight:300;color:rgba(253,251,246,.45);max-width:440px;margin:0 auto 38px;line-height:1.85">{{ section.settings.cta_text }}</p>
    <div class="reveal d3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="{{ section.settings.cta1_link | default: '/pages/contact' }}" class="btn-p">{{ section.settings.cta1_label }}</a>
      <a href="{{ section.settings.cta2_link | default: '/collections/for-sale' }}" class="btn-g btn-g-light">{{ section.settings.cta2_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection residence",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Hero badge",
      "default": "The Sabdia Collection"
    },
    {
      "type": "text",
      "id": "film_label",
      "label": "Film label",
      "default": "The Film"
    },
    {
      "type": "html",
      "id": "film_heading_html",
      "label": "Film heading (HTML - {name})",
      "default": "Experience <em>{name}</em>."
    },
    {
      "type": "textarea",
      "id": "film_text",
      "label": "Film text ({name})",
      "default": "{name}, on film."
    },
    {
      "type": "header",
      "content": "Gallery",
      "info": "Shows when the page has Gallery photos (Pages > the residence > Metafields)."
    },
    {
      "type": "text",
      "id": "gallery_label",
      "label": "Gallery label",
      "default": "The Residence"
    },
    {
      "type": "html",
      "id": "gallery_heading_html",
      "label": "Gallery heading (HTML - {name})",
      "default": "Inside <em>{name}</em>."
    },
    {
      "type": "text",
      "id": "gallery_all_label",
      "label": "View all button",
      "default": "View all photos"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "More label",
      "default": "More from the Collection"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Commission Your Own"
    },
    {
      "type": "html",
      "id": "cta_heading_html",
      "label": "CTA heading (HTML - {name})",
      "default": "Inspired by <em style=\"font-style:italic;color:var(--gold2)\">{name}</em>?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Have a site? Tell us what you want to build."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button",
      "default": "Begin a Conversation"
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button",
      "default": "View Current Properties"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Wording"
    },
    {
      "type": "text",
      "id": "sound_label",
      "label": "Sound button",
      "default": "Sound On"
    }
  ],
  "blocks": [
    {
      "type": "residence",
      "name": "Portfolio residence",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "loc",
          "label": "Location line"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_ext",
          "label": "Current photo (URL)",
          "info": "The photo showing now is loaded from this address. Choose an image above and it takes over - you never need to edit this field."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
