    {"type": "range", "id": "hero_dim", "label": "Darken the hero photo or film", "min": 0, "max": 100, "step": 5, "default": 90, "unit": "%", "info": "Lower = brighter."},
    {"type": "select", "id": "hero_height", "label": "Hero height", "options": [{"value": "tall", "label": "Tall (as designed)"}, {"value": "full", "label": "Full screen"}, {"value": "standard", "label": "Standard"}, {"value": "short", "label": "Short"}], "default": "tall"},
    {"type": "select", "id": "hero_focus", "label": "Crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center"},
    {"type": "select", "id": "hero_words", "label": "Where the words sit", "options": [{"value": "base-left", "label": "Base, left (as designed)"}, {"value": "centre", "label": "Centre"}], "default": "base-left"},
    {"type": "checkbox", "id": "show_badge", "label": "Show the badge", "default": true},
    {"type": "checkbox", "id": "show_meta", "label": "Suburb · style · year under the name", "default": true},
    {"type": "header", "content": "Story"},
    {"type": "checkbox", "id": "show_story", "label": "Show the story", "default": true},
    {"type": "checkbox", "id": "show_about_label", "label": "Show the story label", "default": true},
    {"type": "checkbox", "id": "show_headline", "label": "Show the headline", "default": true},
    {"type": "checkbox", "id": "show_features", "label": "Show the key features", "default": true},
    {"type": "checkbox", "id": "show_links", "label": "Photos and film buttons under the story", "default": true},
    {"type": "select", "id": "story_align", "label": "Story column", "options": [{"value": "left", "label": "Left (as designed)"}, {"value": "centre", "label": "Centred on the page"}], "default": "left", "info": "Applies while the side photos are off: the story runs a reading measure with no empty column beside it."},
    {"type": "checkbox", "id": "show_side_photos", "label": "Show the two photos beside the story", "default": false, "info": "Off as designed: the photos stay in the gallery below. On, photos 2 and 3 (or the picks in the Residence photos and film block) return beside the story."},
    {"type": "checkbox", "id": "show_side_caption", "label": "Caption under the side photos", "default": true},
    {"type": "checkbox", "id": "sticky_story", "label": "Story holds while the photos scroll", "default": true, "info": "Only with the side photos on."},
    {"type": "select", "id": "story_split", "label": "Column split", "options": [{"value": "7-5", "label": "Story 7 : photos 5 (as designed)"}, {"value": "equal", "label": "Equal halves"}, {"value": "8-4", "label": "Story 8 : photos 4"}], "default": "7-5"},
    {"type": "select", "id": "side_layout", "label": "Side photos", "options": [{"value": "offset", "label": "Overlapping, offset (as designed)"}, {"value": "stack", "label": "Stacked, full width"}, {"value": "single", "label": "One photo"}], "default": "offset"},
    {"type": "header", "content": "Gallery and film"},
    {"type": "checkbox", "id": "show_gallery", "label": "Show the gallery", "default": true},
    {"type": "checkbox", "id": "show_thumbs", "label": "Filmstrip of thumbnails", "default": true},
    {"type": "checkbox", "id": "show_expand", "label": "\"View all photos\" button on the stage", "default": true},
    {"type": "checkbox", "id": "show_mosaic", "label": "Details mosaic under the gallery (ten or more photos)", "default": true},
    {"type": "select", "id": "stage_shape", "label": "Stage shape", "options": [{"value": "16/9", "label": "Wide 16:9 (as designed)"}, {"value": "3/2", "label": "Landscape 3:2"}, {"value": "4/3", "label": "Landscape 4:3"}, {"value": "21/9", "label": "Cinematic 21:9"}], "default": "16/9"},
    {"type": "checkbox", "id": "show_film", "label": "Show the film band", "default": true},
    {"type": "select", "id": "body_film", "label": "Film in the body", "options": [{"value": "same", "label": "The residence's film (as designed)"}, {"value": "second", "label": "A second film, picked for the residence"}, {"value": "none", "label": "No film band"}], "default": "same", "info": "The band with the sound button, after the gallery. It shows the film even when the same film already plays silently in the hero. A second film comes from the Residence photos and film block; a residence without one keeps its film."},
    {"type": "checkbox", "id": "show_film_caption", "label": "Caption under the film", "default": true},
    {"type": "select", "id": "film_side", "label": "Film sits", "options": [{"value": "right", "label": "Right (as designed)"}, {"value": "left", "label": "Left"}], "default": "right"},
    {"type": "select", "id": "film_shape", "label": "Film shape", "options": [{"value": "9/16", "label": "Portrait 9:16 (as designed)"}, {"value": "4/5", "label": "Portrait 4:5"}, {"value": "1/1", "label": "Square"}, {"value": "16/9", "label": "Landscape 16:9"}], "default": "9/16"}
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Residence photos and film",
      "settings": [
        { "type": "paragraph", "content": "Picks for one completed residence. Choose its page, then pick. A picked photo or film wins over that page's Hero image / Gallery / Film metafields; leave a picker empty to keep the metafield. Ignored on every other residence's page." },
        { "type": "page", "id": "page", "label": "Residence page", "info": "The completed residence these picks belong to (Content › Pages, template collection-item)." },
        { "type": "image_picker", "id": "hero_image", "label": "Hero photo", "info": "Takes over from the page's Hero image metafield. Also the film's poster unless one is picked below." },
        { "type": "video", "id": "film", "label": "Film (upload)", "info": "Takes over from the page's Film metafield. Plays silently in the hero and with sound in the body band." },
        { "type": "image_picker", "id": "film_poster", "label": "Film poster", "info": "The still shown before the body film plays. Empty = the hero photo." },
        { "type": "video", "id": "film_2", "label": "Second film (upload)", "info": "Shown in the body band instead of the residence's film when Film in the body is set to a second film." },
        { "type": "image_picker", "id": "film_2_poster", "label": "Second film poster", "info": "Empty = the hero photo." },
        { "type": "image_picker", "id": "side_photo_1", "label": "Story column, tall photo", "info": "Only with Show the two photos beside the story on. Takes over from the second Gallery photo." },
        { "type": "image_picker", "id": "side_photo_2", "label": "Story column, wide photo", "info": "Only with the side photos on. Takes over from the third Gallery photo." }
      ]
    }
  ]
}
{% endschema %}
