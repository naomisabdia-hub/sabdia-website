{%- comment -%}
  Collection residence page - a completed Sabdia home, laid out like the
  residences for sale but with no enquiry flow: photographic hero, specs
  bar, the story beside an editorial photo column, the stage + filmstrip
  gallery, a details mosaic, the film, similar residences and a quiet
  push to what is for sale now.

  Everything about the residence comes from PAGE metafields (namespace
  custom, Content › Pages › the residence › Metafields):
    loc        "Camp Hill QLD, Australia"        image   hero URL
    video      film URL (optional)               gallery list of photo URLs
    style      Mediterranean / Palm Springs / Hamptons / Contemporary / Moroccan
    year       completed                          beds / baths / cars / land
    headline   italic line above the story        story   one paragraph per line
    features   short feature lines                series_posts  Instagram posts
  With no story the page stitches one from the strongest Instagram
  captions, as before. "Similar residences" is chosen from this section's
  Residence blocks: same style first, then same suburb, then the rest.
{%- endcomment -%}
{%- liquid
  assign mf = page.metafields.custom
  assign posts = mf.series_posts.value
  assign gallery = mf.gallery.value
  # The film poster (a portrait reel frame) is not a hero: when the Hero
  # image is one of those and the page has photos, the first photo leads.
  assign hero = mf.image.value
  if gallery.size > 0
    if hero == blank or hero contains '/films/'
      assign hero = gallery[0]
    endif
  endif
  assign name_token = '{' | append: 'name' | append: '}'
  assign loc = mf.loc.value
  assign suburb = loc | split: ',' | first | replace: ' QLD', '' | replace: ' Qld', '' | strip
  assign style_name = mf.style.value | strip
  assign year = mf.year.value
  assign gcount = gallery.size

  # Story: the Story field, one paragraph per line; else the strongest
  # Instagram captions (over 60 characters), deduplicated, first three.
  assign story = '' | split: '¦'
  if mf.story.value != blank
    assign story = mf.story.value | strip | newline_to_br | split: '<br />'
  elsif posts.size > 0
    capture story_raw
      for p in posts
        if p.caption.size > 60 and p.hidden != true
          echo p.caption | strip | append: '¦'
        endif
      endfor
    endcapture
    assign story = story_raw | split: '¦' | uniq
  endif

  assign headline = mf.headline.value
  if headline == blank
    if style_name != blank and suburb != blank
      assign headline = 'A ' | append: style_name | append: ' residence, <em>in ' | append: suburb | append: '</em>.'
    elsif suburb != blank
      assign headline = 'Designed and built, <em>in ' | append: suburb | append: '</em>.'
    else
      assign headline = 'Designed and built <em>by Sabdia</em>.'
    endif
  endif

  assign has_specs = false
  if mf.beds.value != blank or mf.baths.value != blank or mf.cars.value != blank or mf.land.value != blank or year != blank or style_name != blank
    assign has_specs = true
  endif

  # Editorial side column: photos 2 and 3 (the hero is usually photo 1).
  assign side_a = blank
  assign side_b = blank
  if gcount > 2
    assign side_a = gallery[1]
    assign side_b = gallery[2]
  elsif gcount == 2
    assign side_a = gallery[1]
  endif

  # Details mosaic: five photos from deeper in the set, when there are
  # enough for it to add something the stage has not already shown.
  assign mosaic = false
  if gcount >= 10
    assign mosaic = true
    assign m_start = gcount | minus: 6
  endif
-%}

<section class="cd-hero">
  {%- if hero != blank -%}
    <img src="{% render 'ext-variant', src: hero, w: 1920, h: 1080 %}" alt="{{ page.title | escape }}{% if suburb != blank %}, {{ suburb | escape }}{% endif %}" loading="eager" fetchpriority="high" width="1920" height="1080">
  {%- endif -%}
  <div class="cd-hero-ov"></div>
  <div class="cd-hero-content">
    <div class="cd-badge reveal">{{ section.settings.badge }}</div>
    <h1 class="cd-name reveal d1">{{ page.title }}</h1>
    <div class="cd-meta reveal d2">
      {%- if suburb != blank -%}<span>{{ suburb }}</span>{%- endif -%}
      {%- if style_name != blank -%}<span class="cd-meta-dot" aria-hidden="true">&middot;</span><span>{{ style_name }}</span>{%- endif -%}
      {%- if year != blank -%}<span class="cd-meta-dot" aria-hidden="true">&middot;</span><span>{{ section.settings.completed_word | default: "Completed" }} {{ year }}</span>{%- endif -%}
    </div>
  </div>
</section>

{%- if has_specs and section.settings.hide_specs != true -%}
<div class="prop-specs-bar cd-specs">
  <div class="prop-specs-inner">
    {%- if suburb != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_location | default: "Location" }}</div>
      <div class="prop-spec-v" style="font-size:16px">{{ suburb }}</div>
    </div>
    {%- endif -%}
    {%- if style_name != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_style | default: "Style" }}</div>
      <div class="prop-spec-v" style="font-size:16px">{{ style_name }}</div>
    </div>
    {%- endif -%}
    {%- if year != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_year | default: "Completed" }}</div>
      <div class="prop-spec-v">{{ year }}</div>
    </div>
    {%- endif -%}
    {%- if mf.beds.value != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_beds | default: "Bedrooms" }}</div>
      <div class="prop-spec-v">{{ mf.beds.value }}</div>
    </div>
    {%- endif -%}
    {%- if mf.baths.value != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_baths | default: "Bathrooms" }}</div>
      <div class="prop-spec-v">{{ mf.baths.value }}</div>
    </div>
    {%- endif -%}
    {%- if mf.cars.value != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_cars | default: "Garages" }}</div>
      <div class="prop-spec-v">{{ mf.cars.value }}</div>
    </div>
    {%- endif -%}
    {%- if mf.land.value != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_land | default: "Land Size" }}</div>
      <div class="prop-spec-v">{{ mf.land.value }}<em>m&sup2;</em></div>
    </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<div class="prop-body cd-body">
  <div class="cd-layout inner">
    <div class="prop-desc cd-desc">
      <div class="slabel prop-desc-slabel reveal">{{ section.settings.about_label | replace: name_token, page.title }}</div>
      <h2 class="prop-body-h reveal d1">{{ headline }}</h2>
      {%- if story.size > 0 -%}
        {%- for p in story limit: 4 -%}
          {%- assign pt = p | strip -%}
          {%- if pt == blank -%}{%- continue -%}{%- endif -%}
          {%- assign last = pt | slice: -1, 1 -%}
          <p class="prop-body-p reveal d2">{{ pt }}{% unless last == '.' or last == '!' or last == '?' %}.{% endunless %}</p>
        {%- endfor -%}
      {%- elsif section.settings.fallback_text != blank -%}
        <p class="prop-body-p reveal d2">{{ section.settings.fallback_text | replace: name_token, page.title }}</p>
      {%- endif -%}
      {%- if mf.features.value.size > 0 -%}
        <div class="prop-features reveal d3">
          <div class="prop-features-h">{{ section.settings.features_heading }}</div>
          <div class="prop-feat-grid">
            {%- for f in mf.features.value -%}
              <div class="prop-feat">{{ f }}</div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <div class="cd-desc-links reveal d3">
        {%- if gcount > 0 -%}<a href="#gallery" class="btn-g btn-g-gold">{{ section.settings.gallery_button | default: "View the photos" }} ({{ gcount }})</a>{%- endif -%}
        {%- if mf.video.value != blank -%}<a href="#film" class="btn-g">{{ section.settings.film_button | default: "Watch the film" }}</a>{%- endif -%}
      </div>
    </div>

    {%- if side_a != blank -%}
    <aside class="cd-side" aria-label="{{ page.title | escape }} photos">
      <figure class="cd-side-a reveal-wipe d1">
        <img src="{% render 'ext-variant', src: side_a, w: 900, h: 1125 %}" alt="{{ page.title | escape }}{% if suburb != blank %}, {{ suburb | escape }}{% endif %}" loading="lazy" decoding="async" width="900" height="1125">
      </figure>
      {%- if side_b != blank -%}
      <figure class="cd-side-b reveal-wipe d3">
        <img src="{% render 'ext-variant', src: side_b, w: 900, h: 675 %}" alt="{{ page.title | escape }}{% if suburb != blank %}, {{ suburb | escape }}{% endif %}" loading="lazy" decoding="async" width="900" height="675">
      </figure>
      {%- endif -%}
      <div class="cd-side-cap reveal d4"><b>{{ page.title }}</b>{% if loc != blank %}<span>{{ loc }}</span>{% endif %}</div>
    </aside>
    {%- endif -%}
  </div>
</div>

{%- if gcount > 0 -%}
  {%- comment -%} Photo gallery - the same stage + filmstrip as the residences for sale,
      fed by the page's Gallery photos. Thumbnails live beside the photos
      (…/media/collection-thumbs/…); a photo without one just uses itself. {%- endcomment -%}
  <section class="cd-gallery" id="gallery">
    <div class="prop-gallery inner">
      <div class="slabel reveal">{{ section.settings.gallery_label }}</div>
      <h2 class="prop-gallery-h reveal d1">{{ section.settings.gallery_heading_html | replace: name_token, page.title }}</h2>
      <div hidden id="pgData">
        {%- for u in gallery -%}
          {%- assign t = u | replace: '/media/collection/', '/media/collection-thumbs/' -%}
          <span data-lb-item data-src="{{ u }}" data-stage="{{ u }}" data-thumb="{{ t }}" data-alt="{{ page.title | escape }}{% if suburb != blank %} &middot; {{ suburb | escape }}{% endif %}"></span>
        {%- endfor -%}
      </div>
      <div class="pg reveal d1" id="pg" data-house="{{ page.title | escape }}">
        <div class="pg-stage" id="pgStage" tabindex="0" aria-roledescription="carousel" aria-label="{{ page.title | escape }} photos">
          <img class="pg-img" id="pgImgA" alt="" decoding="async" width="1800" height="1013">
          <img class="pg-img" id="pgImgB" alt="" decoding="async" width="1800" height="1013">
          <div class="pg-veil" aria-hidden="true"></div>
          <div class="pg-top"><span class="pg-house">{{ page.title }}{% if suburb != blank %} &middot; {{ suburb }}{% endif %}</span><span class="pg-count" id="pgCount"></span></div>
          <button type="button" class="pg-arrow pg-prev" id="pgPrev" aria-label="Previous photo">&larr;</button>
          <button type="button" class="pg-arrow pg-next" id="pgNext" aria-label="Next photo">&rarr;</button>
          <button type="button" class="pg-expand" id="pgExpand"><span aria-hidden="true">&#x2922;</span> {{ section.settings.gallery_all_label | default: "View all photos" }} ({{ gcount }})</button>
        </div>
        <div class="pg-strip" id="pgStrip" role="tablist" aria-label="Photo thumbnails"></div>
      </div>
    </div>
  </section>

  {%- if mosaic -%}
  <section class="cd-mosaic-wrap">
    <div class="inner">
      <div class="cd-mosaic">
        {%- for i in (0..4) -%}
          {%- assign gi = m_start | plus: i -%}
          {%- assign u = gallery[gi] -%}
          {%- if u == blank -%}{%- continue -%}{%- endif -%}
          {%- case i -%}
            {%- when 0 -%}{%- assign mw = 1200 -%}{%- assign mh = 900 -%}
            {%- when 1 -%}{%- assign mw = 700 -%}{%- assign mh = 900 -%}
            {%- else -%}{%- assign mw = 800 -%}{%- assign mh = 450 -%}
          {%- endcase -%}
          <button type="button" class="cd-mosaic-item cd-m{{ i }} reveal-wipe{% if i > 0 %} d{{ i }}{% endif %}" data-cd-open="{{ gi }}" aria-label="View photo {{ gi | plus: 1 }} of {{ gcount }}">
            <img src="{% render 'ext-variant', src: u, w: mw, h: mh %}" alt="{{ page.title | escape }}{% if suburb != blank %}, {{ suburb | escape }}{% endif %}" loading="lazy" decoding="async" width="{{ mw }}" height="{{ mh }}">
          </button>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <img id="lbImg" src="" alt="" width="2000" height="1400">
    <button class="lb-btn lb-prev" id="lbPrev" aria-label="Previous photo">&larr;</button>
    <button class="lb-btn lb-next" id="lbNext" aria-label="Next photo">&rarr;</button>
    <button class="lb-close" id="lbClose" aria-label="Close">&#10005;</button>
    <div class="lb-meta"><span class="lb-cap" id="lbCap"></span><span id="lbCount"></span></div>
  </div>
  <script>
    (function () {
      var pg = document.getElementById('pg'), lb = document.getElementById('lb');
      if (!pg || !lb || pg.dataset.init) return;
      pg.dataset.init = '1';
      var data = Array.prototype.slice.call(document.querySelectorAll('#pgData [data-lb-item]'));
      if (!data.length) { pg.hidden = true; return; }
      var house = pg.getAttribute('data-house') || '';
      var imgs = [document.getElementById('pgImgA'), document.getElementById('pgImgB')];
      var count = document.getElementById('pgCount'), strip = document.getElementById('pgStrip'), stage = document.getElementById('pgStage');
      var lbImg = document.getElementById('lbImg'), lbCap = document.getElementById('lbCap'), lbCount = document.getElementById('lbCount');
      var i = 0, on = 0, li = 0, lastFocus = null;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function srcOf(n) { return data[n].getAttribute('data-src'); }
      function capOf(n) { return data[n].getAttribute('data-alt') || house; }
      function preload(n) { [n + 1, n - 1].forEach(function (k) { var p = new Image(); p.src = srcOf((k + data.length) % data.length); }); }
      /* Filmstrip */
      data.forEach(function (el, n) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'pg-thumb'; b.setAttribute('role', 'tab'); b.setAttribute('aria-label', house + ' photo ' + (n + 1));
        var im = document.createElement('img'); im.loading = 'lazy'; im.decoding = 'async'; im.alt = '';
        im.src = el.getAttribute('data-thumb') || el.getAttribute('data-src');
        im.addEventListener('error', function () { if (im.src !== el.getAttribute('data-src')) im.src = el.getAttribute('data-src'); }, { once: true });
        b.appendChild(im); b.addEventListener('click', function () { show(n); });
        strip.appendChild(b);
      });
      function show(n, instant) {
        i = (n + data.length) % data.length;
        var nxt = imgs[1 - on], src = srcOf(i);
        var swap = function () { imgs[on].classList.remove('is-on'); nxt.classList.add('is-on'); on = 1 - on; nxt.onload = null; };
        nxt.alt = house + ' photo ' + (i + 1);
        if (nxt.getAttribute('src') === src && nxt.complete) swap(); else { nxt.onload = swap; nxt.src = src; }
        count.textContent = (i + 1) + ' / ' + data.length;
        var th = strip.children;
        for (var k = 0; k < th.length; k++) { th[k].classList.toggle('is-on', k === i); th[k].setAttribute('aria-selected', k === i ? 'true' : 'false'); }
        if (th[i]) strip.scrollTo({ left: th[i].offsetLeft - strip.clientWidth / 2 + th[i].offsetWidth / 2, behavior: (instant || reduce) ? 'auto' : 'smooth' });
        preload(i);
      }
      /* Full-screen viewer */
      function lbShow(n) {
        li = (n + data.length) % data.length;
        lbImg.src = srcOf(li); lbImg.alt = house + ' photo ' + (li + 1);
        lbCap.textContent = capOf(li); lbCount.textContent = (li + 1) + ' / ' + data.length;
        preload(li);
      }
      function openAt(n, e) {
        if (e) e.stopPropagation();
        lastFocus = document.activeElement;
        lb.hidden = false; requestAnimationFrame(function () { lb.classList.add('open'); });
        document.documentElement.style.overflow = 'hidden';
        lbShow(typeof n === 'number' ? n : i); document.getElementById('lbClose').focus();
      }
      function openFull(e) { openAt(i, e); }
      function close() {
        lb.classList.remove('open'); document.documentElement.style.overflow = '';
        setTimeout(function () { lb.hidden = true; }, 350);
        show(li, true);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }
      document.getElementById('pgPrev').addEventListener('click', function (e) { e.stopPropagation(); show(i - 1); });
      document.getElementById('pgNext').addEventListener('click', function (e) { e.stopPropagation(); show(i + 1); });
      document.getElementById('pgExpand').addEventListener('click', openFull);
      stage.addEventListener('click', function (e) { if (e.target.closest('button')) return; openFull(); });
      stage.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openFull(); }
      });
      /* The details mosaic opens the viewer on its own photo */
      document.querySelectorAll('[data-cd-open]').forEach(function (b) {
        b.addEventListener('click', function (e) { openAt(Number(b.getAttribute('data-cd-open')) || 0, e); });
      });
      document.getElementById('lbPrev').addEventListener('click', function () { lbShow(li - 1); });
      document.getElementById('lbNext').addEventListener('click', function () { lbShow(li + 1); });
      document.getElementById('lbClose').addEventListener('click', close);
      lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') lbShow(li + 1);
        else if (e.key === 'ArrowLeft') lbShow(li - 1);
      });
      /* Swipe on touch screens - stage and viewer */
      [stage, lb].forEach(function (el, which) {
        var tx = null;
        el.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].clientX; }, { passive: true });
        el.addEventListener('touchend', function (e) {
          if (tx === null) return; var dx = e.changedTouches[0].clientX - tx; tx = null;
          if (Math.abs(dx) > 40) { if (which) lbShow(dx < 0 ? li + 1 : li - 1); else show(dx < 0 ? i + 1 : i - 1); }
        }, { passive: true });
      });
      show(0, true);
    })();
  </script>
{%- endif -%}

{%- if mf.video.value != blank -%}
  <section class="film-band" id="film">
    <div class="film-grid">
      <div class="film-copy">
        <div class="slabel slabel-dark reveal">{{ section.settings.film_label }}</div>
        <h2 class="film-h reveal d1">{{ section.settings.film_heading_html | replace: name_token, page.title }}</h2>
        <p class="film-p reveal d2">{{ section.settings.film_text | replace: name_token, page.title }}</p>
      </div>
      <div class="reveal d2">
        <div class="film-frame" data-film>
          <video src="{{ mf.video.value }}" {% if mf.image.value != blank %}poster="{% render 'ext-variant', src: mf.image.value, w: 1200, h: 675 %}"{% endif %} muted loop playsinline preload="none"></video>
          <button class="film-sound" type="button" aria-label="Toggle sound" data-sound>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            <span data-sound-label>{{ section.settings.sound_label | default: "Sound On" }}</span>
          </button>
        </div>
        <div class="film-caption">
          <span><b>{{ page.title }} - On Film</b></span>
          <span>{{ loc }}</span>
        </div>
      </div>
    </div>
  </section>
  <script>if (typeof sabdiaFilmInit === 'function') sabdiaFilmInit();</script>
{%- endif -%}

{%- comment -%} Similar residences: from the Residence blocks, never this
    page; same style first, then same suburb, then the rest in block order. {%- endcomment -%}
{%- capture ranked_raw -%}
  {%- for pass in (1..3) -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign rp = block.settings.page
        if rp == blank and block.settings.link contains '/pages/'
          assign rp_handle = block.settings.link | split: '/pages/' | last | split: '?' | first | split: '#' | first
          assign rp = pages[rp_handle]
        endif
        assign r_name = block.settings.name | default: rp.title
        if r_name == page.title or r_name == blank
          continue
        endif
        assign r_style = rp.metafields.custom.style.value | strip
        assign r_loc = block.settings.loc | default: rp.metafields.custom.loc.value
        assign r_suburb = r_loc | split: ',' | first | replace: ' QLD', '' | replace: ' Qld', '' | strip
        assign hit = false
        if pass == 1 and r_style != blank and r_style == style_name
          assign hit = true
        elsif pass == 2 and r_suburb != blank and r_suburb == suburb
          assign hit = true
        elsif pass == 3
          assign hit = true
        endif
        if hit
          echo block.id | append: '¦'
        endif
      -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign ranked = ranked_raw | strip | split: '¦' | uniq -%}
{%- capture more_cards -%}
  {%- assign shown = 0 -%}
  {%- for bid in ranked -%}
    {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.id != bid -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign rp = block.settings.page
        if rp == blank and block.settings.link contains '/pages/'
          assign rp_handle = block.settings.link | split: '/pages/' | last | split: '?' | first | split: '#' | first
          assign rp = pages[rp_handle]
        endif
        assign r_name = block.settings.name | default: rp.title
        assign r_loc = block.settings.loc | default: rp.metafields.custom.loc.value
        assign r_suburb = r_loc | split: ',' | first | replace: ' QLD', '' | replace: ' Qld', '' | strip
        assign r_style = rp.metafields.custom.style.value
        assign r_year = rp.metafields.custom.year.value
        assign r_link = block.settings.link | default: rp.url
        assign r_video = block.settings.video | default: rp.metafields.custom.video.value
        assign r_img = rp.metafields.custom.image.value | default: block.settings.image_ext
        if rp.metafields.custom.gallery.value.size > 0
          if r_img == blank or r_img contains '/films/'
            assign r_img = rp.metafields.custom.gallery.value | first
          endif
        endif
        assign shown = shown | plus: 1
      -%}
      <a href="{{ r_link }}" class="pf-card reveal{% if shown == 2 %} d1{% elsif shown == 3 %} d2{% endif %}" data-port-card {{ block.shopify_attributes }}>
        <div class="pf-media">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 900, height: 675, crop: 'center' }}" alt="{{ r_name | escape }}" loading="lazy" decoding="async" width="900" height="675">
          {%- elsif r_img != blank -%}
            <img src="{% render 'ext-variant', src: r_img, w: 900, h: 675 %}" alt="{{ r_name | escape }}" loading="lazy" decoding="async" width="900" height="675">
          {%- endif -%}
          {%- if r_video != blank -%}
            <video src="{{ r_video }}" muted loop playsinline preload="none" data-port-video></video>
            <span class="port-film-tag">{{ section.settings.film_tag | default: "Film" }}</span>
          {%- endif -%}
        </div>
        <div class="pf-info">
          <div class="pf-name">{{ r_name }} <span aria-hidden="true">&rarr;</span></div>
          <div class="pf-meta">{{ r_suburb }}{% if r_style != blank %} <i>&middot;</i> {{ r_style }}{% endif %}{% if r_year != blank %} <i>&middot;</i> {{ r_year }}{% endif %}</div>
        </div>
      </a>
      {%- break -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign more_stripped = more_cards | strip -%}
{%- if more_stripped != blank -%}
  <section class="cd-similar">
    <div class="inner">
      <div class="cd-similar-hdr">
        <div>
          <div class="slabel reveal">{{ section.settings.more_label }}</div>
          <h2 class="cd-similar-h reveal d1">{{ section.settings.more_heading_html }}</h2>
        </div>
        <a href="{{ section.settings.more_link | default: '/pages/collection' }}" class="btn-g reveal d2">{{ section.settings.more_button | default: "The full Collection" }} &rarr;</a>
      </div>
      <div class="pf-grid pf-grid-3">{{ more_cards }}</div>
    </div>
  </section>
  <script>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('.cd-similar [data-port-card]').forEach(function (card) {
        if (card.dataset.portInit) return;
        card.dataset.portInit = '1';
        var video = card.querySelector('[data-port-video]');
        if (!video) return;
        card.addEventListener('mouseenter', function () { video.play().then(function () { video.classList.add('playing'); }).catch(function () {}); });
        card.addEventListener('mouseleave', function () { video.pause(); video.classList.remove('playing'); });
      });
    })();
  </script>
{%- endif -%}

<section class="cd-close">
  <div class="inner-sm">
    <div class="slabel slabel-dark reveal" style="justify-content:center;margin-bottom:20px">{{ section.settings.cta_label }}</div>
    <h2 class="cd-close-h reveal d1">{{ section.settings.cta_heading_html | replace: name_token, page.title }}</h2>
    {%- if section.settings.cta_text != blank -%}<p class="cd-close-p reveal d2">{{ section.settings.cta_text | replace: name_token, page.title }}</p>{%- endif -%}
    <div class="reveal d3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="{{ section.settings.cta1_link | default: '/collections/for-sale' }}" class="btn-p">{{ section.settings.cta1_label }}</a>
      {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link | default: '/pages/collection' }}" class="btn-g btn-g-light">{{ section.settings.cta2_label }}</a>{%- endif -%}
    </div>
    {%- assign share_url = shop.url | append: page.url -%}
    {%- assign share_title = page.title | append: ' - ' | append: suburb | append: ' | Sabdia Constructions' -%}
    {%- assign eu = share_url | url_encode -%}
    {%- assign et = share_title | url_encode -%}
    <div class="share-row cd-share reveal d4" aria-label="Share this page">
      <span class="share-l">{{ section.settings.share_label | default: "Share" }}</span>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ eu }}" target="_blank" rel="noopener" class="share-a">Facebook</a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ eu }}" target="_blank" rel="noopener" class="share-a">LinkedIn</a>
      <a href="mailto:?subject={{ et }}&body={{ et }}%0A{{ eu }}" class="share-a">Email</a>
      <button type="button" class="share-a share-copy" data-share-url="{{ share_url }}">{{ section.settings.copy_link_label | default: "Copy link" }}</button>
    </div>
  </div>
</section>

<style>
  .cd-meta{display:flex;flex-wrap:wrap;align-items:center;gap:0 12px;margin-top:20px;font-size:var(--t-label);font-weight:300;letter-spacing:.24em;text-transform:uppercase;color:rgba(253,251,246,.6)}
  .cd-meta-dot{color:var(--gold2)}
  .cd-specs .prop-spec-item{min-width:0}
  .cd-layout{display:grid;grid-template-columns:7fr 5fr;gap:clamp(48px,7vw,110px);max-width:1400px;margin:0 auto;align-items:start}
  .cd-desc-links{display:flex;gap:12px;flex-wrap:wrap;margin-top:40px}
  .cd-side{position:relative;padding-top:clamp(0px,2vw,24px)}
  .cd-side figure{margin:0;overflow:hidden;background:var(--bg3)}
  .cd-side img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.96);transition:transform 1.2s var(--ease)}
  .cd-side figure:hover img{transform:scale(1.03)}
  .cd-side-a{aspect-ratio:4/5;width:78%}
  .cd-side-b{aspect-ratio:4/3;width:62%;margin-left:auto!important;margin-top:-18%!important;box-shadow:0 30px 60px -30px rgba(31,27,20,.45);border:6px solid var(--bg)}
  .cd-side-cap{display:flex;justify-content:space-between;gap:16px;margin-top:22px;font-size:var(--t-label);font-weight:300;letter-spacing:.26em;text-transform:uppercase;color:var(--taupe-d)}
  .cd-side-cap b{font-weight:400;color:var(--ink)}
  .cd-gallery{padding-top:0}
  .cd-gallery .pg{margin-top:32px}
  .cd-mosaic-wrap{padding:0 clamp(22px,5vw,80px) clamp(64px,9vw,130px)}
  .cd-mosaic{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:auto;gap:8px}
  .cd-mosaic-item{display:block;padding:0;border:0;background:var(--bg3);cursor:zoom-in;overflow:hidden;position:relative}
  .cd-mosaic-item img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.95);transition:transform 1.1s var(--ease),filter .5s}
  .cd-mosaic-item:hover img{transform:scale(1.03);filter:saturate(1)}
  .cd-mosaic-item:focus-visible{outline:2px solid var(--gold2);outline-offset:2px}
  .cd-m0{grid-column:1/8;aspect-ratio:4/3}
  .cd-m1{grid-column:8/13;aspect-ratio:7/9}
  .cd-m2,.cd-m3,.cd-m4{grid-column:span 4;aspect-ratio:16/10}
  .cd-similar{padding:clamp(64px,9vw,120px) clamp(22px,5vw,80px);background:var(--bg2);border-top:1px solid var(--border)}
  .cd-similar-hdr{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:40px}
  .cd-similar-h{font-family:var(--font-d);font-size:var(--t-h2);font-weight:300;color:var(--ink);letter-spacing:-.02em}
  .cd-similar-h em{font-style:italic;color:var(--ink)}
  .cd-close{padding:clamp(72px,9vw,132px) clamp(22px,5vw,80px);background:var(--dark);text-align:center}
  .cd-close-h{font-family:var(--font-d);font-size:clamp(34px,5vw,64px);font-weight:300;color:var(--white);letter-spacing:-.02em;margin-bottom:22px}
  .cd-close-h em{font-style:italic;color:var(--gold2)}
  .cd-close-p{font-size:13px;font-weight:300;color:rgba(253,251,246,.5);max-width:440px;margin:0 auto 38px;line-height:1.85}
  .cd-share{justify-content:center;margin-top:52px;padding-top:32px;border-top:1px solid rgba(255,255,255,.08)}
  .cd-share .share-l{color:rgba(253,251,246,.45)}
  .cd-share .share-a{color:rgba(253,251,246,.7);border-bottom-color:rgba(195,164,94,.35)}
  .cd-share .share-a:hover{color:var(--white);border-color:var(--gold2)}
  .share-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
  .share-l{font-size:10px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:var(--ink3)}
  .share-a{background:none;border:none;cursor:pointer;padding:4px 0;font-family:var(--font-u);font-size:11px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:var(--ink2);border-bottom:1px solid rgba(168,135,74,.35);transition:color .25s,border-color .25s;text-decoration:none}
  @media(max-width:900px){
    .cd-layout{grid-template-columns:1fr;gap:44px}
    .cd-desc{position:static}
    .cd-side-a{width:86%}
    .cd-side-b{width:64%;margin-top:-16%!important}
    .cd-m0{grid-column:1/13;aspect-ratio:16/10}
    .cd-m1{grid-column:1/7;aspect-ratio:4/5}
    .cd-m2{grid-column:7/13;aspect-ratio:4/5}
    .cd-m3,.cd-m4{grid-column:span 6;aspect-ratio:4/3}
  }
</style>
<script>
  (function () {
    document.querySelectorAll('.cd-share .share-copy').forEach(function (b) {
      if (b.dataset.init) return; b.dataset.init = '1';
      b.addEventListener('click', function () {
        var u = b.getAttribute('data-share-url'), t = b.textContent;
        if (navigator.clipboard) navigator.clipboard.writeText(u).then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = t; }, 1600); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection residence",
  "settings": [
    { "type": "paragraph", "content": "Everything about the residence itself - photos, film, style, year, bedrooms, headline, story - is set on the page: Content › Pages › the residence › Metafields. This section only sets the shared wording. Write {name} wherever the residence's name should appear." },
    { "type": "text", "id": "badge", "label": "Hero badge", "default": "The Sabdia Collection" },
    { "type": "text", "id": "completed_word", "label": "Word before the year in the hero", "default": "Completed" },
    { "type": "text", "id": "about_label", "label": "Story label", "default": "About {name}" },
    { "type": "textarea", "id": "fallback_text", "label": "Story when the page has none", "default": "{name} was designed, developed and built entirely in-house by Sabdia - one team from the first sketch to handover.", "info": "Shown only when the page has no Story and no Instagram captions yet." },
    { "type": "text", "id": "features_heading", "label": "Features heading", "default": "Key Features" },
    { "type": "text", "id": "gallery_button", "label": "Photos button", "default": "View the photos" },
    { "type": "text", "id": "film_button", "label": "Film button", "default": "Watch the film" },
    { "type": "header", "content": "Specs bar" },
    { "type": "checkbox", "id": "hide_specs", "label": "Hide the specs bar", "default": false },
    { "type": "text", "id": "spec_location", "label": "Location label", "default": "Location" },
    { "type": "text", "id": "spec_style", "label": "Style label", "default": "Style" },
    { "type": "text", "id": "spec_year", "label": "Completed label", "default": "Completed" },
    { "type": "text", "id": "spec_beds", "label": "Bedrooms label", "default": "Bedrooms" },
    { "type": "text", "id": "spec_baths", "label": "Bathrooms label", "default": "Bathrooms" },
    { "type": "text", "id": "spec_cars", "label": "Garages label", "default": "Garages" },
    { "type": "text", "id": "spec_land", "label": "Land size label", "default": "Land Size" },
    { "type": "header", "content": "Gallery", "info": "Shows when the page has Gallery photos (Content › Pages › the residence › Metafields). With ten or more photos a details mosaic follows the gallery." },
    { "type": "text", "id": "gallery_label", "label": "Gallery label", "default": "The Residence" },
    { "type": "html", "id": "gallery_heading_html", "label": "Gallery heading (HTML - {name})", "default": "Inside <em>{name}</em>." },
    { "type": "text", "id": "gallery_all_label", "label": "View all button", "default": "View all photos" },
    { "type": "header", "content": "Film" },
    { "type": "text", "id": "film_label", "label": "Film label", "default": "The Film" },
    { "type": "html", "id": "film_heading_html", "label": "Film heading (HTML - {name})", "default": "Experience <em>{name}</em>." },
    { "type": "textarea", "id": "film_text", "label": "Film text ({name})", "default": "{name}, on film." },
    { "type": "text", "id": "sound_label", "label": "Sound button", "default": "Sound On" },
    { "type": "header", "content": "Similar residences", "info": "Chosen from the Residence blocks below: same style first, then the same suburb, then the rest. Never the residence being viewed." },
    { "type": "text", "id": "more_label", "label": "Label", "default": "More from the Collection" },
    { "type": "html", "id": "more_heading_html", "label": "Heading (HTML)", "default": "Similar <em>residences</em>." },
    { "type": "text", "id": "more_button", "label": "Button", "default": "The full Collection" },
    { "type": "url", "id": "more_link", "label": "Button link" },
    { "type": "text", "id": "film_tag", "label": "Film tag on cards", "default": "Film" },
    { "type": "header", "content": "Closing band", "info": "No enquiry form on completed residences - this points people to what is for sale now." },
    { "type": "text", "id": "cta_label", "label": "Label", "default": "Now Selling" },
    { "type": "html", "id": "cta_heading_html", "label": "Heading (HTML - {name})", "default": "See what is <em>for sale</em> now." },
    { "type": "textarea", "id": "cta_text", "label": "Text", "default": "Every Sabdia residence is designed and built in-house, to the standard you see in {name}." },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "View Current Properties" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Back to the Collection" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "share_label", "label": "Share row label", "default": "Share" },
    { "type": "text", "id": "copy_link_label", "label": "Copy link button", "default": "Copy link" }
  ],
  "blocks": [
    {
      "type": "residence",
      "name": "Portfolio residence",
      "settings": [
        { "type": "page", "id": "page", "label": "Residence page", "info": "Pick the completed residence's page (Content › Pages, template \"collection-item\"). Name, location, style, year, photo and film then come from that page - the fields below only override." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "loc", "label": "Location line" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_ext", "label": "Current photo (URL)", "info": "The photo showing now is loaded from this address. Choose an image above and it takes over - you never need to edit this field." },
        { "type": "text", "id": "video", "label": "Hover film (URL)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
