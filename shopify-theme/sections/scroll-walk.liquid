{%- comment -%}
  Scroll-driven cinematic walkthrough - verbatim port of ScrollWalk.astro.

  ⛔ ABSOLUTE CONTENT RULE: frame sequences fed to this section must
  contain ONLY the visualiser's real footage. No AI-generated
  architecture, ever - including "anchored" transitions. Missing joins =
  reversed real footage or a plain crossfade.

  Frames + manifest.json live in the media library under
  scrollwalk/<folder>/ - the folder comes from this section's setting or,
  on a property page, from the product's scrollwalk_folder metafield.
  Publishing a new cut is just pointing at the new folder.
{%- endcomment -%}
{%- liquid
  # The residence: its product, or its page (15 Sep 2026, same fields).
  assign sw_res = nil
  if template.name == 'product' and product != blank
    assign sw_res = product
  elsif page != blank and page.metafields.custom.status != blank
    assign sw_res = page
  endif
  assign folder = section.settings.folder
  if folder == blank and sw_res != blank
    assign folder = sw_res.metafields.custom.scrollwalk_folder.value
  endif
  # Per-residence switch: Products › the residence › "Show the scroll
  # walkthrough". Off hides it even when a folder is set; unset = on.
  if sw_res != blank
    assign sw_switch = sw_res.metafields.custom.show_walkthrough
    if sw_switch != blank and sw_switch.value == false
      assign folder = blank
    endif
  endif
  assign wt_name = section.settings.name
  assign wt_name_html = wt_name
  if wt_name == blank and sw_res != blank
    assign wt_name = sw_res.title
    capture wt_name_html
      render 'residence-name', product: sw_res
    endcapture
  endif
  assign base = folder
  unless folder contains '://'
    assign base = settings.media_base | append: '/scrollwalk/' | append: folder
  endunless
-%}
{%- if folder != blank -%}
{% render 'section-look', section: section, mode: 'hero' %}
{%- liquid
  assign name_token = '{' | append: 'name' | append: '}'
  assign sw_heading = section.settings.heading_html
  if sw_heading == blank
    assign sw_heading = 'Scroll to move <em>through ' | append: name_token | append: '</em>.'
  endif
-%}
<section class="sw-section sw-{{ section.settings.stage_size | default: 'cinema' }}{% if section.settings.show_rooms == false %} sw-norooms{% endif %}{% if section.settings.show_progress == false %} sw-noprog{% endif %}{% if section.settings.show_caption == false %} sw-nocap{% endif %}{% if section.settings.show_hint == false %} sw-nohint{% endif %}{% if section.settings.frame_border == false %} sw-noborder{% endif %}{% if section.settings.vignette == false %} sw-novig{% endif %}" id="scrollwalk" data-base="{{ base }}" data-pace="{{ section.settings.scroll_pace | default: 12 }}">
  {%- if section.settings.show_intro -%}
  <div class="sw-intro inner">
    {%- if section.settings.show_label -%}<div class="slabel reveal">{{ section.settings.walk_label | default: "The Walkthrough" }}</div>{%- endif -%}
    <h2 class="sw-h reveal d1">{{ sw_heading | replace: name_token, wt_name_html }}</h2>
  </div>
  {%- endif -%}
  <div class="sw-track" style="height:480vh">
    <div class="sw-sticky">
      <div class="sw-stage">
        <canvas class="sw-canvas" width="1152" height="648"></canvas>
        <div class="sw-vignette" aria-hidden="true"></div>
        <div class="sw-caption" aria-live="polite">
          <span class="sw-cap-num"></span>
          <span class="sw-cap-label"></span>
        </div>
        <div class="sw-progress" aria-hidden="true"><i></i></div>
        <nav class="sw-rooms" aria-label="Rooms"></nav>
        <div class="sw-hint" aria-hidden="true">
          <svg width="12" height="18" viewBox="0 0 12 18" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1" y="1" width="10" height="16" rx="5"/><path d="M6 4v4"/></svg>
          <span>{{ section.settings.hint_walk | default: "Scroll to walk" }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* Verbatim port of the ScrollWalk player - immediate call + guard. */
  function sabdiaScrollWalkInit() {
    var section = document.querySelector('.sw-section');
    if (!section || section.dataset.swInit) return;
    section.dataset.swInit = '1';

    var manifest = null;
    var base = section.dataset.base;
    var canvas = section.querySelector('.sw-canvas');
    var ctx = canvas.getContext('2d');
    var track = section.querySelector('.sw-track');
    var capNum = section.querySelector('.sw-cap-num');
    var capLabel = section.querySelector('.sw-cap-label');
    var caption = section.querySelector('.sw-caption');
    var progress = section.querySelector('.sw-progress i');
    var hint = section.querySelector('.sw-hint');

    var total = 0;
    var frames = [];
    var loadedMax = 0;
    var current = -1;
    var chapterAt = -1;

    function boot(m) {
      manifest = m;
      total = m.total;
      frames = new Array(total + 1);
      canvas.width = m.w;
      canvas.height = m.h;
      /* ~12px of scroll per frame - unhurried but not endless */
      var pace = Number(section.dataset.pace) || 12;
      track.style.height = Math.max(320, Math.round((total * pace) / 8)) + 'vh';
      buildRooms();
      loadFrame(1);
      loadPass();
      update();
      displayF = frameF; /* start exactly where the scroll sits */
    }

    /* Room menu: selecting a room scrolls the page to that segment, so
       the camera glides through the house to it. */
    var rooms = section.querySelector('.sw-rooms');
    function scrollToChapter(c) {
      var ch = manifest.chapters[c];
      var mid = ch.start + Math.min(ch.count - 1, 6);
      var p = mid / (total - 1);
      var top = track.getBoundingClientRect().top + window.pageYOffset;
      var span = track.offsetHeight - window.innerHeight;
      window.scrollTo({ top: top + p * span, behavior: 'smooth' });
    }
    function buildRooms() {
      manifest.chapters.forEach(function (ch, c) {
        if (ch.hidden) return;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'sw-room';
        b.textContent = ch.label;
        b.dataset.c = c;
        b.addEventListener('click', function () { scrollToChapter(c); });
        rooms.appendChild(b);
      });
    }

    function url(i) { return base + '/f' + String(i).padStart(4, '0') + '.webp'; }

    function loadFrame(i, cb) {
      if (frames[i]) { cb && cb(); return; }
      var img = new Image();
      img.crossOrigin = 'anonymous';
      img.decoding = 'async';
      img.onload = function () { frames[i] = img; if (i > loadedMax) loadedMax = i; cb && cb(); draw(); };
      img.onerror = function () { cb && cb(); }; /* a missing frame must not stall the loading passes (15 Sep 2026) */
      img.src = url(i);
    }

    /* coarse → medium → full loading passes */
    var passes = [8, 2, 1];
    var passIdx = 0;
    var started = false;
    function loadPass() {
      if (!manifest || passIdx >= passes.length) return;
      var step = passes[passIdx];
      var pending = 0;
      for (var i = 1; i <= total; i += step) {
        if (!frames[i]) { pending++; loadFrame(i, done); }
      }
      passIdx++;
      if (!pending) loadPass();
      function done() { if (--pending <= 0) loadPass(); }
    }
    function start() {
      if (started) return;
      started = true;
      fetch(base + '/manifest.json')
        .then(function (r) { if (!r.ok) throw new Error('manifest ' + r.status); return r.json(); })
        .then(function (m) { if (!m || !(m.total > 0) || !m.chapters) throw new Error('manifest'); boot(m); })
        /* Folder or manifest missing (15 Sep 2026): there is no still to show,
           so the section folds away instead of leaving a blank stage. */
        .catch(function () { section.style.display = 'none'; });
    }

    function nearestLoaded(i) {
      for (var d = 0; d < total; d++) {
        if (frames[i - d]) return i - d;
        if (frames[i + d]) return i + d;
      }
      return 0;
    }

    /* displayF eases toward the scroll target every animation frame, and
       adjacent frames are alpha-blended for the fractional part - the
       scrub glides instead of stepping. */
    var frameF = 1;
    var displayF = 1;
    var lastDrawnA = -1, lastDrawnB = -1, lastAlpha = -1;
    function draw() {
      if (!total) return;
      var f = Math.min(total, Math.max(1, displayF));
      var i0 = nearestLoaded(Math.floor(f));
      var i1 = Math.floor(f) + 1;
      // blend ONLY true neighbours - blending across a loading gap
      // ghosts two different views and reads as pixelated mush
      var blendOK = i1 <= total && frames[i1] && i1 - i0 === 1;
      var a = blendOK ? f - Math.floor(f) : 0;
      if (i0 === lastDrawnA && (blendOK ? i1 : -1) === lastDrawnB && Math.abs(a - lastAlpha) < 0.02) return;
      lastDrawnA = i0; lastDrawnB = blendOK ? i1 : -1; lastAlpha = a;
      if (!i0) return;
      ctx.globalAlpha = 1;
      ctx.drawImage(frames[i0], 0, 0, canvas.width, canvas.height);
      if (a > 0.02) {
        ctx.globalAlpha = a;
        ctx.drawImage(frames[i1], 0, 0, canvas.width, canvas.height);
        ctx.globalAlpha = 1;
      }
      current = i0;
    }

    function targetFrame() {
      return Math.min(total, Math.max(1, Math.round(frameF)));
    }

    /* glide loop runs while the section is on screen. The scrub eases
       toward the scroll target; on big jumps (room-menu travel) it
       catches up to within a short window first so the camera doesn't
       strobe through half-loaded rooms. */
    var looping = false;
    function loop() {
      if (!looping) return;
      var d = frameF - displayF;
      if (d > 30) displayF = frameF - 30;
      else if (d < -30) displayF = frameF + 30;
      displayF += (frameF - displayF) * 0.18;
      if (Math.abs(frameF - displayF) < 0.01) displayF = frameF;
      draw();
      requestAnimationFrame(loop);
    }
    function setLooping(on) {
      if (on === looping) return;
      looping = on;
      if (on) requestAnimationFrame(loop);
    }

    function chapterFor(i) {
      for (var c = manifest.chapters.length - 1; c >= 0; c--) {
        if (i - 1 >= manifest.chapters[c].start) return c;
      }
      return 0;
    }

    var roman = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV','XV','XVI'];
    function update() {
      if (!manifest) return;
      var rect = track.getBoundingClientRect();
      var vh = window.innerHeight;
      var span = rect.height - vh;
      var p = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 0;
      frameF = 1 + p * (total - 1);
      setLooping(rect.bottom > -vh && rect.top < vh * 2);
      var want = targetFrame();
      progress.style.transform = 'scaleY(' + p + ')';
      if (p > 0.015) hint.classList.add('sw-hidden');
      var c = chapterFor(want);
      if (c !== chapterAt) {
        chapterAt = c;
        var ch = manifest.chapters[c];
        var btns = rooms.children;
        caption.classList.remove('sw-cap-show');
        if (ch.hidden) {
          for (var b = 0; b < btns.length; b++) btns[b].classList.remove('sw-room-on');
        } else {
          void caption.offsetWidth; /* restart transition */
          var vis = 0;
          for (var k = 0; k < c; k++) if (!manifest.chapters[k].hidden) vis++;
          capNum.textContent = roman[vis] || String(vis + 1);
          capLabel.textContent = ch.label;
          caption.classList.add('sw-cap-show');
          for (var b = 0; b < btns.length; b++) btns[b].classList.toggle('sw-room-on', +btns[b].dataset.c === c);
        }
      }
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { start(); io.disconnect(); }
        });
      }, { rootMargin: '1200px 0px' });
      io.observe(section);
    } else {
      start();
    }
    window.addEventListener('scroll', function () { start(); onScroll(); }, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
  sabdiaScrollWalkInit();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Scroll walkthrough",
  "settings": [
    { "type": "paragraph", "content": "On a residence page the frames come from Products › the residence › Scroll walkthrough folder, and the switch \"Show the scroll walkthrough\" (Metafields) turns it on or off for that residence. Not every residence has one - leave the folder empty or the switch off and the section simply does not appear. On the residence pages this section starts hidden (the eye icon beside it in the left sidebar); click the eye to show it once the residence has a walkthrough." },
    {
      "type": "paragraph",
      "content": "⛔ Frame sets must be 100% real visualiser footage - never AI-generated architecture, in any form."
    },
    {
      "type": "text",
      "id": "folder",
      "label": "Frame folder",
      "info": "Folder name inside scrollwalk/ - e.g. qasr-v21. On a property page, leave blank to use the product's scrollwalk_folder field. Publishing a new cut is just typing the new folder name."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Residence name",
      "info": "Leave blank on property pages to use the product title."
    },
    {
      "type": "header",
      "content": "Wording"
    },
    {
      "type": "text",
      "id": "walk_label",
      "label": "Walkthrough label",
      "default": "The Walkthrough"
    },
    {
      "type": "text",
      "id": "hint_walk",
      "label": "Hint (mobile)",
      "default": "Scroll to walk"
    },
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."},
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_intro", "label": "Show the label and heading above the stage", "default": true},
    {"type": "checkbox", "id": "show_label", "label": "Show the small label", "default": true},
    {"type": "checkbox", "id": "show_rooms", "label": "Show the \"Jump to a room\" rail", "default": true},
    {"type": "checkbox", "id": "show_caption", "label": "Show the room caption on the stage", "default": true},
    {"type": "checkbox", "id": "show_progress", "label": "Show the progress line", "default": true},
    {"type": "checkbox", "id": "show_hint", "label": "Show the \"Scroll to walk\" hint", "default": true},
    {"type": "checkbox", "id": "frame_border", "label": "Thin gold frame around the stage", "default": true},
    {"type": "checkbox", "id": "vignette", "label": "Soft vignette on the stage", "default": true},
    {"type": "header", "content": "Words"},
    {"type": "html", "id": "heading_html", "label": "Heading", "default": "Scroll to move <em>through {name}</em>.", "info": "Write {name} where the residence's name goes. Default: Scroll to move <em>through {name}</em>."},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "stage_size", "label": "Stage", "options": [{"value": "cinema", "label": "Cinema frame (as designed)"}, {"value": "full", "label": "Edge to edge"}], "default": "cinema"},
    {"type": "range", "id": "scroll_pace", "label": "Scroll per frame", "min": 6, "max": 24, "step": 1, "default": 12, "unit": "px", "info": "Lower = the walk passes faster as you scroll; higher = slower, more scrolling."}
  ],
  "presets": [
    {
      "name": "Scroll walkthrough"
    }
  ]
}
{% endschema %}
