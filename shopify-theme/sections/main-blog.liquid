{%- comment -%}
  The Sabdia Journal - article listing, with the live site's page header
  (warm stone band) and its "first edition" empty state when nothing is
  published yet.
{%- endcomment -%}
{% render 'section-look', section: section %}
{%- liquid
  assign bl_layout = section.settings.layout | default: 'cards'
  assign bl_align = section.settings.header_align | default: 'left'
  case section.settings.header_surface
    when 'cream'
      assign bl_bg = 'var(--bg)'
    when 'none'
      assign bl_bg = 'transparent'
    else
      assign bl_bg = 'var(--bg3)'
  endcase
-%}
<section class="bl-head{% if bl_align == 'centre' %} bl-centre{% endif %}" style="padding:calc(var(--nav-h) + (clamp(140px,20vw,200px) - var(--nav-h)) * var(--sp-top,1)) var(--page-pad) calc(clamp(52px,8vw,96px) * var(--sp-bot,1));background:{{ bl_bg }};{% if section.settings.header_rule %}border-bottom:1px solid var(--border){% endif %}">
  <div class="inner">
    {%- if section.settings.show_label -%}<div class="slabel reveal" style="margin-bottom:20px{% if bl_align == 'centre' %};justify-content:center{% endif %}">{{ section.settings.label }}</div>{%- endif -%}
    <h1 class="reveal d1" style="font-family:var(--font-d);font-size:calc(var(--t-display)*var(--s-h,1));font-weight:300;line-height:.9;letter-spacing:-.035em;color:var(--ink)">{{ section.settings.title_html | default: blog.title }}</h1>
    {%- if section.settings.text != blank and section.settings.show_text -%}
      <p class="reveal d2" style="font-size:calc(15.5px*var(--s-t,1));font-weight:400;color:var(--ink3);max-width:460px;margin-top:28px;line-height:1.85{% if bl_align == 'centre' %};margin-left:auto;margin-right:auto{% endif %}">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>

<section class="sp bl-list" style="--bl-cols:{{ section.settings.columns | default: '3' }};--bl-ar:{{ section.settings.card_shape | default: '16/10' }}">
  <div class="inner">
    {%- if blog.articles.size == 0 -%}
      <div style="text-align:center;padding:clamp(48px,8vw,96px) 0">
        <div class="slabel reveal" style="justify-content:center">{{ section.settings.empty_label }}</div>
        <p class="reveal d1" style="font-family:'EB Garamond',Georgia,serif;font-style:italic;font-size:calc(clamp(19px,2.4vw,26px)*var(--s-h,1));color:var(--ink2);max-width:520px;margin:18px auto 0;line-height:1.6">{{ section.settings.empty_text }}</p>
      </div>
    {%- elsif bl_layout == 'editorial' -%}
      {%- assign lead = blog.articles | first -%}
      <a href="{{ lead.url }}" class="jn-lead reveal">
        {%- if lead.image -%}
          {%- assign lh = 1200 | divided_by: lead.image.aspect_ratio | round -%}
          <img src="{{ lead.image | image_url: width: 1200 }}" alt="{{ lead.title | escape }}" width="1200" height="{{ lh }}" loading="eager">
        {%- endif -%}
        <div>
          {%- if section.settings.show_date -%}<div class="jn-meta">{{ lead.published_at | date: '%-d %B %Y' }}</div>{%- endif -%}
          <h2 class="jn-lead-h">{{ lead.title }}</h2>
          {%- if section.settings.show_excerpt -%}<p class="jn-ex">{{ lead.excerpt_or_content | strip_html | truncatewords: 40 }}</p>{%- endif -%}
          <span class="jn-more">{{ section.settings.read_more_label | default: "Read the story" }}</span>
        </div>
      </a>
      {%- if blog.articles.size > 1 -%}
      <div class="jn-grid">
        {%- for article in blog.articles offset: 1 -%}
          <a href="{{ article.url }}" class="jn-card reveal">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 800, height: 560, crop: 'center' }}" alt="{{ article.title | escape }}" width="800" height="560" loading="lazy" decoding="async">{%- endif -%}
            {%- if section.settings.show_date -%}<div class="jn-meta">{{ article.published_at | date: '%-d %B %Y' }}</div>{%- endif -%}
            <h3 class="jn-card-h">{{ article.title }}</h3>
            {%- if section.settings.show_excerpt -%}<p class="jn-ex">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>
      {%- endif -%}
    {%- else -%}
      <div class="proj-grid-3 bl-cards">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="pc reveal-wipe" style="aspect-ratio:var(--bl-ar,16/10)">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 900, height: 560, crop: 'center' }}" alt="{{ article.title | escape }}" width="900" height="560" loading="lazy" decoding="async">
            {%- endif -%}
            <div class="pc-ov"></div>
            <div class="pc-info">
              <div class="pc-name" style="font-size:calc(20px*var(--s-h,1))">{{ article.title }}</div>
              {%- if section.settings.show_date -%}<div class="pc-loc">{{ article.published_at | date: '%-d %B %Y' }}</div>{%- endif -%}
            </div>
            <div class="pc-arrow">&rarr;</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .bl-centre{text-align:center}
  .proj-grid-3.bl-cards{grid-template-columns:repeat(var(--bl-cols,3),1fr)}
  @media(max-width:1100px){.proj-grid-3.bl-cards{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:768px){.proj-grid-3.bl-cards{grid-template-columns:1fr}}
</style>

{% schema %}
{
  "name": "Journal listing",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Notes from the studio" },
    { "type": "html", "id": "title_html", "label": "Title (HTML)", "default": "The <em style=\"font-style:italic\">Journal<\/em>." },
    { "type": "textarea", "id": "text", "label": "Sub-line", "default": "New releases and finished homes, written by the people who build them." },
    { "type": "text", "id": "empty_label", "label": "Empty-state label", "default": "First edition coming soon" },
    { "type": "textarea", "id": "empty_text", "label": "Empty-state text", "default": "We're writing the first entries now. Join the list below and we'll send them to you first." },
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_label", "label": "Show the small label", "default": true},
    {"type": "checkbox", "id": "show_text", "label": "Show the sub-line", "default": true},
    {"type": "checkbox", "id": "show_date", "label": "Show the date on each story", "default": true},
    {"type": "checkbox", "id": "show_excerpt", "label": "Show an excerpt (editorial layout)", "default": true},
    {"type": "checkbox", "id": "header_rule", "label": "Hairline under the header band", "default": true},
    {"type": "header", "content": "Header band"},
    {"type": "select", "id": "header_surface", "label": "Header background", "options": [{"value": "stone", "label": "Warm stone (as designed)"}, {"value": "cream", "label": "Cream"}, {"value": "none", "label": "None"}], "default": "stone"},
    {"type": "select", "id": "header_align", "label": "Words sit", "options": [{"value": "left", "label": "Left"}, {"value": "centre", "label": "Centre"}], "default": "left"},
    {"type": "header", "content": "The stories"},
    {"type": "select", "id": "layout", "label": "Layout", "options": [{"value": "cards", "label": "Photo cards (as designed)"}, {"value": "editorial", "label": "Editorial: one lead story, then a grid"}], "default": "cards"},
    {"type": "select", "id": "columns", "label": "Cards across", "options": [{"value": "2", "label": "Two"}, {"value": "3", "label": "Three"}, {"value": "4", "label": "Four"}], "default": "3", "info": "Photo cards layout."},
    {"type": "select", "id": "card_shape", "label": "Card shape", "options": [{"value": "16/10", "label": "Landscape 16:10"}, {"value": "4/3", "label": "Landscape 4:3"}, {"value": "3/2", "label": "Landscape 3:2"}, {"value": "16/9", "label": "Wide 16:9"}, {"value": "1/1", "label": "Square"}, {"value": "4/5", "label": "Portrait 4:5"}], "default": "16/10"},
    {"type": "text", "id": "read_more_label", "label": "Lead story link", "default": "Read the story"},
    {"type": "header", "content": "Look"},
    {"type": "paragraph", "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}, {"value": "media", "label": "A photo or film behind it (below)"}], "default": "design", "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#F0EADE", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "header", "content": "Backdrop photo or film", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "paragraph", "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "image_picker", "id": "look_image", "label": "Backdrop photo", "info": "Also the poster while a backdrop film loads.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "video", "id": "look_video", "label": "Backdrop film (upload)", "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "checkbox", "id": "look_media_link", "label": "Use a film link instead of an upload", "default": false, "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "text", "id": "look_video_url", "label": "Backdrop film (URL)", "info": "A direct .mp4 link, used when no backdrop film is uploaded above.", "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"},
    {"type": "range", "id": "look_dim", "label": "Darken the backdrop", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Lower = brighter. The words stay readable down to about 40%.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_focus", "label": "Backdrop crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_media_tone", "label": "Words over the backdrop", "options": [{"value": "dark", "label": "Light words on a darkened backdrop"}, {"value": "light", "label": "Dark words on a pale backdrop"}], "default": "dark", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."}
  ]
}
{% endschema %}
