{%- comment -%}
  The Sabdia Journal — article listing, with the live site's page header
  (warm stone band) and its "first edition" empty state when nothing is
  published yet.
{%- endcomment -%}
<section style="padding:clamp(140px,20vw,200px) clamp(22px,5vw,80px) clamp(52px,8vw,96px);background:var(--bg3);border-bottom:1px solid var(--border)">
  <div class="inner">
    <div class="slabel reveal" style="margin-bottom:20px">{{ section.settings.label }}</div>
    <h1 class="reveal d1" style="font-family:var(--font-d);font-size:clamp(52px,10vw,140px);font-weight:300;line-height:.9;letter-spacing:-.035em;color:var(--ink)">{{ section.settings.title_html | default: blog.title }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="reveal d2" style="font-size:15.5px;font-weight:400;color:var(--ink3);max-width:460px;margin-top:28px;line-height:1.85">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</section>

<section class="sp">
  <div class="inner">
    {%- if blog.articles.size == 0 -%}
      <div style="text-align:center;padding:clamp(48px,8vw,96px) 0">
        <div class="slabel reveal" style="justify-content:center">{{ section.settings.empty_label }}</div>
        <p class="reveal d1" style="font-family:'EB Garamond',Georgia,serif;font-style:italic;font-size:clamp(19px,2.4vw,26px);color:var(--ink2);max-width:520px;margin:18px auto 0;line-height:1.6">{{ section.settings.empty_text }}</p>
      </div>
    {%- else -%}
      <div class="proj-grid-3">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="pc reveal-wipe" style="aspect-ratio:16/10">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 900, height: 560, crop: 'center' }}" alt="{{ article.title | escape }}" width="900" height="560" loading="lazy" decoding="async">
            {%- endif -%}
            <div class="pc-ov"></div>
            <div class="pc-info">
              <div class="pc-name" style="font-size:20px">{{ article.title }}</div>
              <div class="pc-loc">{{ article.published_at | date: '%-d %B %Y' }}</div>
            </div>
            <div class="pc-arrow">&rarr;</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal listing",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Notes from the studio" },
    { "type": "html", "id": "title_html", "label": "Title (HTML)", "default": "The <em style=\"font-style:italic\">Journal<\/em>." },
    { "type": "textarea", "id": "text", "label": "Sub-line", "default": "New releases, completed residences, and ideas in luxury living — written by the team designing and building them." },
    { "type": "text", "id": "empty_label", "label": "Empty-state label", "default": "First edition coming soon" },
    { "type": "textarea", "id": "empty_text", "label": "Empty-state text", "default": "We're writing the first entries now. Join the list below and we'll send them to you first." }
  ]
}
{% endschema %}
