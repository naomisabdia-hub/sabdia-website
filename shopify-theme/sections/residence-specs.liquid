{%- comment -%}
  Property page - the residence's general items

  The specs bar (suburb, bedrooms, bathrooms, garages, land and status)
  under the hero, the sold banner above it on a sold residence, and the
  sticky Enquire bar on phones. The numbers come from Products › the
  residence › Metafields; this section decides which show and what the
  labels say. Sold banner and sticky bar moved here from the Header and
  the About and enquiry sections on 14 Sep 2026 (Naomi: "general items").

  Split out of the all-in-one Property page section on 14 Sep 2026 so each
  part of the residence page has its own panel in the customizer. Real
  photographs and real footage only, never generated.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign mf = product.metafields.custom
  # The {name} token editors write in the shared framing copy. Built with
  # append because Shopify's Liquid parser rejects literal braces inside
  # an output tag's string arguments.
  assign name_token = '{' | append: 'name' | append: '}'
  capture pstatus
    render 'residence-status', product: product
  endcapture
  assign sold = false
  if pstatus contains 'Sold'
    assign sold = true
  endif
  assign state = mf.state.value | default: 'QLD'
  # The residence's name in its own brochure face (Products › the residence
  # › Metafields › Residence name font …), for headings that carry it.
  capture name_span
    render 'residence-name', product: product
  endcapture
  # The name as the brochure writes it (Sierra, not SIERRA) where it is
  # printed as plain text.
  assign prop_name = product.title
  assign nf_any = mf.name_font.value | strip | append: mf.name_font_file.value
  if nf_any != blank
    unless mf.name_font_caps.value
      assign prop_name = product.title | downcase | capitalize
    endunless
  endif
-%}
{% render 'section-look', section: section %}
{%- comment -%} Sold banner - under the hero, above the specs bar, only while the residence's Status is in the Sold group. {%- endcomment -%}
{%- if sold and section.settings.show_sold_banner -%}
  <div style="background:var(--bg2);border-bottom:1px solid var(--border);padding:22px var(--page-pad)">
    <div class="inner" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
      <div style="padding:7px 16px;background:rgba(var(--gold-rgb),.14);border:1px solid rgba(var(--gold-rgb),.4);font-size:10px;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:var(--ink)">{{ pstatus }}</div>
      <span style="font-size:13.5px;font-weight:400;color:var(--ink3)">{{ section.settings.sold_notice }}</span>
      <a href="{{ section.settings.sold_banner_link | default: '/collections/for-sale' }}" class="btn-g btn-g-gold" style="margin-left:auto;padding:9px 20px;font-size:10px">{{ section.settings.sold_banner_label }} &rarr;</a>
    </div>
  </div>
{%- endif -%}
{%- unless section.settings.hide_specs -%}
<div class="prop-specs-bar s-surface{% if section.settings.specs_align == 'centre' %} prop-specs-centre{% endif %}">
  <div class="prop-specs-inner">
    {%- if section.settings.spec_show_location -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_location | default: "Location" }}</div>
      <div class="prop-spec-v" style="font-size:16px">{{ mf.suburb.value }}</div>
    </div>
    {%- endif -%}
    {%- if section.settings.spec_show_beds -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_beds | default: "Bedrooms" }}</div>
      <div class="prop-spec-v">{{ mf.beds.value }}</div>
    </div>
    {%- endif -%}
    {%- if section.settings.spec_show_baths -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_baths | default: "Bathrooms" }}</div>
      <div class="prop-spec-v">{{ mf.baths.value }}</div>
    </div>
    {%- endif -%}
    {%- if section.settings.spec_show_cars -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_cars | default: "Garages" }}</div>
      <div class="prop-spec-v">{{ mf.cars.value }}</div>
    </div>
    {%- endif -%}
    {%- if section.settings.spec_show_land -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_land | default: "Land Size" }}</div>
      <div class="prop-spec-v">{{ mf.land.value }}<em>m&sup2;{% if mf.land_over.value %}+{% endif %}</em></div>
    </div>
    {%- endif -%}
    {%- if section.settings.spec_show_build and mf.build_size.value != blank -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_build | default: "Build Size" }}</div>
      <div class="prop-spec-v">{{ mf.build_size.value }}<em>m&sup2;</em></div>
    </div>
    {%- endif -%}
    {%- if section.settings.spec_show_status -%}
    <div class="prop-spec-item">
      <div class="prop-spec-l">{{ section.settings.spec_status | default: "Status" }}</div>
      <div class="prop-spec-v" style="font-size:16px;color:{% if sold %}var(--taupe-d){% else %}var(--ink){% endif %}">{{ pstatus }}</div>
    </div>
    {%- endif -%}
  </div>
</div>

{%- endunless -%}
{%- comment -%} Sticky Enquire bar on phones - fixed to the bottom of the screen until the enquiry form scrolls into view. {%- endcomment -%}
{%- unless sold or section.settings.show_sticky == false -%}
  <div class="prop-sticky-bar" id="stickyEnquire">
    <div class="psb-name">{{ prop_name }} <span class="psb-loc">- {{ mf.suburb.value }}</span></div>
    <a href="#cform" class="psb-btn">{{ section.settings.sticky_label }} &rarr;</a>
  </div>
  <script>
    (function () {
      var bar = document.getElementById('stickyEnquire');
      var form = document.getElementById('cform');
      if (!bar || bar.dataset.stickyInit || !form || !('IntersectionObserver' in window)) return;
      bar.dataset.stickyInit = '1';
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          bar.classList.toggle('psb-hidden', e.isIntersecting);
        });
      }, { threshold: 0.15 });
      obs.observe(form);
    })();
  </script>
{%- endunless -%}
<style>
  .prop-specs-centre .prop-specs-inner{justify-content:center}
</style>

{% schema %}
