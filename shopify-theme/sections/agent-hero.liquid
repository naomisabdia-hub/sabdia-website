{%- comment -%}
  Agent Access - the full-height dark hero with the portrait image and
  bottom-anchored copy.
{%- endcomment -%}
<section style="position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;background:var(--dark)">
  {%- if section.settings.image -%}
    <img src="{{ section.settings.image | image_url: width: 1400, height: 1800, crop: 'center' }}" alt="{{ section.settings.image_alt | default: 'Agent Access' | escape }}" loading="eager" width="1400" height="1800"
         style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.72) saturate(.92)">
  {%- elsif section.settings.image_ext != blank -%}
    <img src="{% render 'ext-variant', src: section.settings.image_ext, w: 1400, h: 1800 %}" alt="{{ section.settings.image_alt | default: 'Agent Access' | escape }}" loading="eager" width="1400" height="1800"
         style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.72) saturate(.92)">
  {%- endif -%}
  <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(31,27,20,.95) 0%,rgba(31,27,20,.3) 60%,transparent 100%)"></div>
  <div class="inner" style="position:relative;z-index:2;padding:clamp(22px,5vw,80px);padding-bottom:clamp(72px,12vw,140px)">
    <div class="slabel slabel-dark reveal" style="margin-bottom:20px">{{ section.settings.label }}</div>
    <h1 class="reveal d1" style="font-family:var(--font-d);font-size:clamp(52px,10vw,140px);font-weight:300;line-height:.88;letter-spacing:-.035em;color:var(--white)">{{ section.settings.title_html }}</h1>
    <p class="reveal d2" style="font-size:15px;font-weight:400;color:rgba(253,251,246,.8);max-width:440px;margin-top:28px;line-height:1.85">{{ section.settings.text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Agent hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "For Real Estate Professionals"
    },
    {
      "type": "html",
      "id": "title_html",
      "label": "Title (HTML)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_ext",
      "label": "Current photo (URL)",
      "info": "The photo showing now is loaded from this address. Choose an image above and it takes over - you never need to edit this field."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    }
  ],
  "presets": [
    {
      "name": "Agent hero"
    }
  ]
}
{% endschema %}
