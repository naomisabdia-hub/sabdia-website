{%- comment -%}
  Port of the homepage contact section - details column + the enquiry
  form. The form posts into the Sabdia leads inbox via the forms
  endpoint; main.js handles submission and the status line.
{%- endcomment -%}
{% render 'section-look', section: section %}
<section class="sp cc-band cc-{{ section.settings.layout | default: 'beside' }}{% if section.settings.form_style == 'card' %} cc-card{% endif %}" id="contact" style="background:var(--bg2);{% if section.settings.show_rule %}border-top:1px solid var(--border){% endif %}">
  <div class="inner contact-grid">
    <div>
      {%- if section.settings.show_label -%}<div class="slabel reveal">{{ section.settings.label }}</div>{%- endif -%}
      {%- if section.settings.show_heading -%}<h2 class="contact-h reveal d1">{{ section.settings.heading_html }}</h2>{%- endif -%}
      {%- if section.settings.show_text and section.settings.text != blank -%}<p class="about-p reveal d2" style="margin-bottom:36px">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.show_details -%}
      <ul class="cdet reveal d3">
        {%- if section.settings.d_show_location -%}<li class="cd"><span class="cd-l">{{ section.settings.d_location | default: "Location" }}</span><span class="cd-v">{{ settings.location }}</span></li>{%- endif -%}
        {%- if section.settings.d_show_phone and settings.contact_phone != blank -%}<li class="cd"><span class="cd-l">{{ section.settings.d_phone | default: "Phone" }}</span><a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="cd-v">{{ settings.contact_phone }}</a></li>{%- endif -%}
        {%- if section.settings.d_show_email and settings.contact_email != blank -%}<li class="cd"><span class="cd-l">{{ section.settings.d_email | default: "Email" }}</span><a href="mailto:{{ settings.contact_email }}" class="cd-v">{{ settings.contact_email }}</a></li>{%- endif -%}
        {%- if section.settings.d_show_instagram -%}<li class="cd"><span class="cd-l">{{ section.settings.d_instagram | default: "Instagram" }}</span><a href="{{ settings.instagram_url }}" target="_blank" class="cd-v">{{ settings.instagram_label }}</a></li>{%- endif -%}
        {%- if section.settings.d_show_facebook -%}<li class="cd"><span class="cd-l">{{ section.settings.d_facebook | default: "Facebook" }}</span><a href="{{ settings.facebook_url }}" target="_blank" class="cd-v">{{ section.settings.d_facebook_v | default: "Sabdia Constructions" }}</a></li>{%- endif -%}
        {%- if section.settings.d_show_linkedin -%}<li class="cd"><span class="cd-l">{{ section.settings.d_linkedin | default: "LinkedIn" }}</span><a href="{{ settings.linkedin_url }}" target="_blank" class="cd-v">{{ section.settings.d_linkedin_v | default: "Sabdia Constructions" }}</a></li>{%- endif -%}
      </ul>
      {%- endif -%}
    </div>
    <div>
      {%- if settings.form_backend == 'vercel' -%}
      <form class="cform reveal d1" id="cform" name="contact" method="POST" action="{{ settings.forms_endpoint }}/api/contact">
        <input type="hidden" name="form-name" value="contact">
        <p class="hidden" style="display:none" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <div class="frow">
          <div class="fg"><label class="fl" for="cf-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="cf-first" name="first-name" class="fi" placeholder="{{ section.settings.f_first_ph | default: "First name" }}" autocomplete="given-name" required></div>
          <div class="fg"><label class="fl" for="cf-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="cf-last" name="last-name" class="fi" placeholder="{{ section.settings.f_last_ph | default: "Last name" }}" autocomplete="family-name" required></div>
        </div>
        <div class="fg"><label class="fl" for="cf-email">{{ section.settings.f_email | default: "Email*" }}</label><input type="email" id="cf-email" name="email" class="fi" placeholder="{{ section.settings.f_email_ph | default: "Email address" }}" autocomplete="email" required></div>
        <div class="fg"><label class="fl" for="cf-phone">{{ section.settings.f_phone | default: "Phone" }}</label><input type="tel" id="cf-phone" name="phone" class="fi" required placeholder="{{ section.settings.f_phone_ph | default: "Phone number" }}" autocomplete="tel"></div>
        <div class="fg">
          <label class="fl" for="cf-interest">{{ section.settings.f_interest | default: "Interest" }}</label>
          <select class="fsel" id="cf-interest" name="enquiry-type" required>
            <option value="">{{ section.settings.f_interest_ph | default: "Select an enquiry type…" }}</option>
            {%- assign interests = section.settings.interests | newline_to_br | split: '<br />' -%}
            {%- for opt in interests -%}
              {%- assign parts = opt | split: '|' -%}
              {%- assign o = parts[0] | strip -%}
              {%- if o != blank -%}<option>{{ o }}</option>{%- endif -%}
              {%- if forloop.first -%}
                {%- comment -%} The residences for sale, same as the Contact page, so both forms behave alike. {%- endcomment -%}
                {%- for product in collections.all.products -%}
                  {%- unless product.tags contains 'property' -%}{%- continue -%}{%- endunless -%}
                  {%- capture pstatus -%}{% render 'residence-status', product: product %}{%- endcapture -%}
                  {%- if pstatus contains 'Sold' -%}{%- continue -%}{%- endif -%}
                  <option>{{ product.title }} - {{ product.metafields.custom.suburb.value }}</option>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </select>
          {%- for opt in interests -%}
            {%- assign parts = opt | split: '|' -%}
            {%- if parts.size > 1 -%}<span hidden data-thanks-for="{{ parts[0] | strip | escape }}">{{ parts[1] | strip }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'prequal-fields', mode: 'vercel', s: section.settings %}
        <div class="fg"><label class="fl" for="cf-message">{{ section.settings.f_message | default: "Message*" }}</label><textarea class="fta" id="cf-message" name="message" placeholder="{{ section.settings.f_message_ph | default: "Tell us about your interest..." }}" required></textarea></div>
        <button type="submit" class="fsub" id="fsub">{{ section.settings.f_submit | default: "Submit" }} &rarr;</button>
        <p class="sr-status" role="status" aria-live="polite" data-form-status></p>
        <p class="form-note">{{ section.settings.note }}</p>
      </form>
      {%- else -%}
      {%- comment -%} Shopify-native: emails the store's sender address and files the enquirer under Customers. {%- endcomment -%}
      {% form 'contact', id: 'cform', class: 'cform reveal d1' %}
        <span hidden data-thanks>{{ section.settings.success_text | default: "Thank you - we will be in touch within a business day." }}</span>
        {%- if form.posted_successfully? -%}
          {% render 'form-thanks', text: section.settings.success_text %}
        {%- else -%}
        {%- if form.errors -%}
          <p class="form-note" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="frow">
          <div class="fg"><label class="fl" for="cf-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="cf-first" name="contact[First name]" class="fi" placeholder="{{ section.settings.f_first_ph | default: "First name" }}" autocomplete="given-name" required></div>
          <div class="fg"><label class="fl" for="cf-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="cf-last" name="contact[Last name]" class="fi" placeholder="{{ section.settings.f_last_ph | default: "Last name" }}" autocomplete="family-name" required></div>
        </div>
        <div class="fg"><label class="fl" for="cf-email">{{ section.settings.f_email | default: "Email*" }}</label><input type="email" id="cf-email" name="contact[email]" class="fi" placeholder="{{ section.settings.f_email_ph | default: "Email address" }}" autocomplete="email" required></div>
        <div class="fg"><label class="fl" for="cf-phone">{{ section.settings.f_phone | default: "Phone" }}</label><input type="tel" id="cf-phone" name="contact[Phone]" class="fi" required placeholder="{{ section.settings.f_phone_ph | default: "Phone number" }}" autocomplete="tel"></div>
        <div class="fg">
          <label class="fl" for="cf-interest">{{ section.settings.f_interest | default: "Interest" }}</label>
          <select class="fsel" id="cf-interest" name="contact[Interest]" required>
            <option value="">{{ section.settings.f_interest_ph | default: "Select an enquiry type…" }}</option>
            {%- assign interests = section.settings.interests | newline_to_br | split: '<br />' -%}
            {%- for opt in interests -%}
              {%- assign parts = opt | split: '|' -%}
              {%- assign o = parts[0] | strip -%}
              {%- if o != blank -%}<option>{{ o }}</option>{%- endif -%}
              {%- if forloop.first -%}
                {%- comment -%} The residences for sale, same as the Contact page, so both forms behave alike. {%- endcomment -%}
                {%- for product in collections.all.products -%}
                  {%- unless product.tags contains 'property' -%}{%- continue -%}{%- endunless -%}
                  {%- capture pstatus -%}{% render 'residence-status', product: product %}{%- endcapture -%}
                  {%- if pstatus contains 'Sold' -%}{%- continue -%}{%- endif -%}
                  <option>{{ product.title }} - {{ product.metafields.custom.suburb.value }}</option>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </select>
          {%- for opt in interests -%}
            {%- assign parts = opt | split: '|' -%}
            {%- if parts.size > 1 -%}<span hidden data-thanks-for="{{ parts[0] | strip | escape }}">{{ parts[1] | strip }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'prequal-fields', mode: 'shopify', s: section.settings %}
        <div class="fg"><label class="fl" for="cf-message">{{ section.settings.f_message | default: "Message*" }}</label><textarea class="fta" id="cf-message" name="contact[body]" placeholder="{{ section.settings.f_message_ph | default: "Tell us about your interest..." }}" required></textarea></div>
        {% render 'form-optin', label: section.settings.optin_label %}
        <button type="submit" class="fsub" id="fsub">{{ section.settings.f_submit | default: "Submit" }} &rarr;</button>
        <p class="form-note">{{ section.settings.note }}</p>
      {%- endif -%}
        {% endform %}
        {%- assign cm_uid = 'cm-' | append: section.id -%}{% render 'customer-mirror', uid: cm_uid, residence: '' %}
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .cc-formonly .contact-grid{grid-template-columns:1fr;max-width:760px}
  .cc-formonly .contact-grid>div:first-child{display:none}
  .cc-above .contact-grid{grid-template-columns:1fr;gap:48px}
  .cc-flip .contact-grid>div:first-child{order:2}
  .cc-card .cform{padding:clamp(22px,3vw,36px);background:var(--white);border:1px solid var(--border);border-top:2px solid var(--gold)}
</style>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Get In Touch"
    },
    {
      "type": "html",
      "id": "heading_html",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph"
    },
    {
      "type": "textarea",
      "id": "interests",
      "label": "Interest options",
      "info": "One option per line. Add a tailored thank-you after a | on the same line, e.g. Custom home design | Thank you. Everything at Sabdia is designed and built in-house, so we do not take on custom commissions - we will be in touch about our releases."
    },
    {
      "type": "text",
