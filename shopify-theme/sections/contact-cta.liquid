      "id": "label",
      "label": "Small label",
      "default": "Get In Touch"
    },
    {
      "type": "html",
      "id": "heading_html",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph"
    },
    { "type": "paragraph", "content": "Interest options: one list shared with the Contact page form, at Theme settings › Contact › Enquiry options." },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button"
    },
    { "type": "text", "id": "success_text", "label": "Thank you message (Shopify mode)", "default": "Thank you - we will be in touch within a business day." },
    { "type": "text", "id": "f_interest_ph", "label": "Interest placeholder", "default": "Select an enquiry type…" },
    { "type": "header", "content": "Pre-qualification (budget, timeline, locations)" },
    { "type": "paragraph", "content": "Appears when the Interest is a residence or For Sale. Budget and timeline are then required; locations are required for a For Sale enquiry and optional for a residence (its suburb is pre-selected). Same behaviour as the Contact page." },
    { "type": "text", "id": "prequal_budget_label", "label": "Budget label", "default": "Budget range" },
    { "type": "textarea", "id": "prequal_budget", "label": "Budget options (one per line)", "default": "Under $4m\n$4m - $5m\n$5m - $6m\n$6m - $8m\n$8m+\nPrefer not to say" },
    { "type": "text", "id": "prequal_timeline_label", "label": "Timeline label", "default": "Timeline to purchase" },
    { "type": "textarea", "id": "prequal_timeline", "label": "Timeline options (one per line)", "default": "Ready now\n1 - 3 months\n3 - 6 months\n6 - 12 months\nJust researching" },
    { "type": "text", "id": "prequal_flex_label", "label": "Flexibility label", "default": "Flexibility" },
    { "type": "textarea", "id": "prequal_flex", "label": "Flexibility options (one per line)", "default": "Only this residence\nOpen to other Sabdia residences\nOpen to upcoming releases" },
    { "type": "textarea", "id": "prequal_ask", "label": "Thank-you when budget or timeline is left blank", "default": "Thank you for your interest. So we can send the most relevant information, could you share your approximate budget range and your timeline for purchase? We will follow up with further details on the residence." },
    { "type": "text", "id": "prequal_loc_label", "label": "Locations label (For Sale enquiry)", "default": "Preferred locations" },
    { "type": "text", "id": "prequal_loc_label_other", "label": "Locations label (residence enquiry)", "default": "Other locations you would also consider (optional)" },
    { "type": "textarea", "id": "prequal_locations", "label": "Location options (one per line)", "info": "Leave empty to list the suburbs of the residences for sale plus Other inner Brisbane." },
    { "type": "text", "id": "optin_label", "label": "Keep-me-updated box", "default": "Keep me updated on new Sabdia releases", "info": "Ticked by default. Ticked = tagged newsletter in Customers (the mailing list). Every enquirer is filed under Customers regardless, tagged enquiry and the residence." },
    {
      "type": "header",
      "content": "Form wording"
    },
    {
      "type": "text",
      "id": "f_first",
      "label": "First name label",
      "default": "First Name*"
    },
    {
      "type": "text",
      "id": "f_first_ph",
