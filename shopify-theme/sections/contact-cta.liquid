      "label": "Note under the button"
    },
    { "type": "text", "id": "success_text", "label": "Thank you message (Shopify mode)", "default": "Thank you - we will be in touch within a business day." },
    { "type": "text", "id": "f_interest_ph", "label": "Interest placeholder", "default": "Select an enquiry type…" },
    { "type": "header", "content": "Pre-qualification (budget, timeline, locations)" },
    { "type": "paragraph", "content": "Appears when the Interest is a residence or For Sale. Budget and timeline are then required; locations are required for a For Sale enquiry and optional for a residence (its suburb is pre-selected). Same behaviour as the Contact page." },
    { "type": "text", "id": "prequal_budget_label", "label": "Budget label", "default": "Budget range" },
    { "type": "textarea", "id": "prequal_budget", "label": "Budget options (one per line)", "default": "Under $4m\n$4m - $5m\n$5m - $6m\n$6m - $8m\n$8m+\nPrefer not to say" },
    { "type": "text", "id": "prequal_timeline_label", "label": "Timeline label", "default": "Timeline to purchase" },
    { "type": "textarea", "id": "prequal_timeline", "label": "Timeline options (one per line)", "default": "Ready now\n1 - 3 months\n3 - 6 months\n6 - 12 months\nJust researching" },
    { "type": "text", "id": "prequal_flex_label", "label": "Flexibility label", "default": "Flexibility" },
    { "type": "textarea", "id": "prequal_flex", "label": "Flexibility options (one per line)", "default": "Only this residence\nOpen to other Sabdia residences\nOpen to upcoming releases" },
    { "type": "textarea", "id": "prequal_ask", "label": "Thank-you when budget or timeline is left blank", "default": "Thank you for your interest. So we can send the most relevant information, could you share your approximate budget range and your timeline for purchase? We will follow up with further details on the residence." },
    { "type": "text", "id": "prequal_loc_label", "label": "Locations label (For Sale enquiry)", "default": "Preferred locations" },
    { "type": "text", "id": "prequal_loc_label_other", "label": "Locations label (residence enquiry)", "default": "Other locations you would also consider (optional)" },
    { "type": "textarea", "id": "prequal_locations", "label": "Location options (one per line)", "info": "Leave empty to list the suburbs of the residences for sale plus Other inner Brisbane." },
    { "type": "text", "id": "optin_label", "label": "Keep-me-updated box", "default": "Keep me updated on new Sabdia releases", "info": "Ticked by default. Ticked = tagged newsletter in Customers (the mailing list). Every enquirer is filed under Customers regardless, tagged enquiry and the residence." },
    {
      "type": "header",
      "content": "Form wording"
    },
    {
      "type": "text",
      "id": "f_first",
      "label": "First name label",
      "default": "First Name*"
    },
    {
      "type": "text",
      "id": "f_first_ph",
      "label": "First name placeholder",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "f_last",
      "label": "Last name label",
      "default": "Last Name*"
    },
    {
      "type": "text",
      "id": "f_last_ph",
      "label": "Last name placeholder",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "f_email",
      "label": "Email label",
      "default": "Email*"
    },
    {
      "type": "text",
      "id": "f_email_ph",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "f_phone",
      "label": "Phone label",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "f_phone_ph",
      "label": "Phone placeholder",
      "default": "Phone number"
    },
    {
      "type": "text",
      "id": "f_interest",
      "label": "Interest label",
      "default": "Interest"
    },
    {
      "type": "text",
      "id": "f_message",
      "label": "Message label",
      "default": "Message*"
    },
    {
      "type": "text",
      "id": "f_message_ph",
      "label": "Message placeholder",
      "default": "Tell us about your interest..."
    },
    {
      "type": "text",
      "id": "f_submit",
      "label": "Button",
      "default": "Submit"
    },
    {
      "type": "header",
      "content": "Details column"
    },
    {
      "type": "text",
      "id": "d_location",
      "label": "Location row label",
      "default": "Location"
    },
    {
      "type": "text",
      "id": "d_instagram",
      "label": "Instagram row label",
      "default": "Instagram"
    },
    {
      "type": "text",
      "id": "d_facebook",
      "label": "Facebook row label",
      "default": "Facebook"
    },
    {
      "type": "text",
      "id": "d_facebook_v",
      "label": "Facebook display text",
      "default": "Sabdia Constructions"
    },
    {
      "type": "text",
      "id": "d_linkedin",
      "label": "LinkedIn row label",
      "default": "LinkedIn"
    },
    {
      "type": "text",
      "id": "d_linkedin_v",
      "label": "LinkedIn display text",
      "default": "Sabdia Constructions"
    },
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_label", "label": "Show the small label", "default": true},
    {"type": "checkbox", "id": "show_heading", "label": "Show the heading", "default": true},
    {"type": "checkbox", "id": "show_text", "label": "Show the paragraph", "default": true},
    {"type": "checkbox", "id": "show_details", "label": "Show the details list", "default": true},
    {"type": "checkbox", "id": "d_show_location", "label": "Location row", "default": true},
    {"type": "checkbox", "id": "d_show_phone", "label": "Phone row", "default": false, "info": "Needs a phone in Theme settings › Contact."},
    {"type": "checkbox", "id": "d_show_email", "label": "Email row", "default": false},
    {"type": "checkbox", "id": "d_show_instagram", "label": "Instagram row", "default": true},
    {"type": "checkbox", "id": "d_show_facebook", "label": "Facebook row", "default": true},
    {"type": "checkbox", "id": "d_show_linkedin", "label": "LinkedIn row", "default": true},
    {"type": "checkbox", "id": "show_rule", "label": "Hairline above the section", "default": true},
    {"type": "text", "id": "d_phone", "label": "Phone row label", "default": "Phone"},
    {"type": "text", "id": "d_email", "label": "Email row label", "default": "Email"},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "layout", "label": "Details and form", "options": [{"value": "beside", "label": "Details beside the form (as designed)"}, {"value": "flip", "label": "Form first, details after"}, {"value": "above", "label": "Details above the form"}, {"value": "formonly", "label": "Form only"}], "default": "beside"},
    {"type": "select", "id": "form_style", "label": "Form style", "options": [{"value": "plain", "label": "Fields on the band (as designed)"}, {"value": "card", "label": "In a white card"}], "default": "plain"},
    {"type": "header", "content": "Look"},
    {"type": "paragraph", "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}, {"value": "media", "label": "A photo or film behind it (below)"}], "default": "design", "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#F0EADE"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light"},
    {"type": "header", "content": "Photo or film behind the section"},
    {"type": "paragraph", "content": "Used when Background is set to a photo or film. Real photographs and real footage only, never generated."},
    {"type": "image_picker", "id": "look_image", "label": "Photo", "info": "Also the poster while a film loads."},
    {"type": "video", "id": "look_video", "label": "Film (upload)", "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast."},
    {"type": "text", "id": "look_video_url", "label": "Current film (URL)", "info": "A direct .mp4 link, used when no film is uploaded above."},
    {"type": "range", "id": "look_dim", "label": "Darken the photo or film", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Lower = brighter. The words stay readable down to about 40%."},
    {"type": "select", "id": "look_focus", "label": "Crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center"},
    {"type": "select", "id": "look_media_tone", "label": "Words over the photo", "options": [{"value": "dark", "label": "Light words on a darkened photo"}, {"value": "light", "label": "Dark words on a pale photo"}], "default": "dark"},
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."}
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
