{%- comment -%}
  Sold band - the sold residences under the For Sale grid.

  Split out of the all-in-one Collection grid section on 14 Sep 2026 so each
  part of the For Sale page has its own panel in the customizer (Naomi:
  "have the header its settings, then the Now Selling, then each individual
  grid has their setting"). Real photographs and real footage only, never
  generated.
{%- endcomment -%}
{%- liquid
  capture list_csv
    render 'collection-handles', collection: collection
  endcapture
  assign handles = list_csv | split: ','
  assign count = handles.size
  assign show_rich = true
  if collection.handle == 'sold'
    assign show_rich = false
  endif
-%}
{%- liquid
  capture sold_csv
    render 'residence-handles', col: collections['sold'], group: 'sold'
  endcapture
  assign sold_handles = sold_csv | split: ','
  # Hand-picked sold residences (Residence blocks) replace the automatic
  # list, in block order (15 Sep 2026); each block can reword its card.
  assign picked = false
  if section.blocks.size > 0
    assign picked = true
    assign sold_csv = ''
    for block in section.blocks
      if block.settings.product == blank
        continue
      endif
      assign sold_csv = sold_csv | append: block.settings.product.handle | append: ','
    endfor
    assign sold_handles = sold_csv | split: ','
  endif
-%}
{% render 'section-look', section: section %}
{%- if show_rich and section.settings.show_sold_band and sold_handles.size > 0 -%}
  <section style="padding:clamp(64px,8vw,100px) var(--page-pad) clamp(80px,10vw,120px);background:var(--bg)">
    <div class="inner">
      <div class="slabel reveal" style="margin-bottom:32px">{{ section.settings.sold_label }}</div>
      <div class="proj-grid-sold" style="margin-top:0">
        {%- if picked -%}
        {%- assign si = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product == blank -%}{%- continue -%}{%- endif -%}
          {%- assign sdelay = si | modulo: 2 -%}{%- assign si = si | plus: 1 -%}
          {%- if sdelay == 1 -%}
            {% render 'sold-card', product: block.settings.product, class: 'reveal d1', img_w: 900, img_h: 560, image: block.settings.image, url: block.settings.link, focus: block.settings.focus, name: block.settings.name, suburb: block.settings.suburb, status: block.settings.status, beds: block.settings.beds, baths: block.settings.baths, cars: block.settings.cars, build: block.settings.build, land: block.settings.land, attrs: block.shopify_attributes %}
          {%- else -%}
            {% render 'sold-card', product: block.settings.product, class: 'reveal', img_w: 900, img_h: 560, image: block.settings.image, url: block.settings.link, focus: block.settings.focus, name: block.settings.name, suburb: block.settings.suburb, status: block.settings.status, beds: block.settings.beds, baths: block.settings.baths, cars: block.settings.cars, build: block.settings.build, land: block.settings.land, attrs: block.shopify_attributes %}
          {%- endif -%}
        {%- endfor -%}
        {%- else -%}
        {%- for h in sold_handles -%}
          {%- assign sdelay = forloop.index0 | modulo: 2 -%}
          {%- for product in collections.all.products -%}
            {%- if product.handle != h -%}{%- continue -%}{%- endif -%}
            {%- if sdelay == 1 -%}
              {% render 'sold-card', product: product, class: 'reveal d1', img_w: 900, img_h: 560 %}
            {%- else -%}
              {% render 'sold-card', product: product, class: 'reveal', img_w: 900, img_h: 560 %}
            {%- endif -%}
            {%- break -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Sold band",
  "settings": [
    {
      "type": "paragraph",
      "content": "The band of sold residences under the grid on the For Sale page. One Residence block per card (⊕ Add block) - click a card in the preview to change its photo, name, status word, location, numbers or link for this card only. With no blocks the band is automatic: every residence whose Status contains Sold, in the Sold collection's order. Not shown on the Sold page itself."
    },
    {
      "type": "header",
      "content": "Show"
    },
    {
      "type": "checkbox",
      "id": "show_sold_band",
      "label": "Show the sold band under the grid",
      "default": false,
      "info": "Off by default - with one sold home it looked odd (Tamsin, 10 Sep 2026). Sold residences still appear on the Collection page and at /collections/sold."
    },
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "sold_label",
      "label": "Sold band label",
      "default": "Sold Prior to Completion"
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "paragraph",
      "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."
    },
    {
      "type": "select",
      "id": "look_surface",
      "label": "Background",
      "options": [
        {
          "value": "design",
          "label": "As designed"
        },
        {
          "value": "cream",
          "label": "Cream (the page colour)"
        },
        {
          "value": "stone",
          "label": "Stone (soft panel)"
        },
        {
          "value": "obsidian",
          "label": "Obsidian (dark)"
        },
        {
          "value": "custom",
          "label": "A colour of your own (below)"
        },
        {
          "value": "media",
          "label": "A photo or film behind it (below)"
        }
      ],
      "default": "design",
      "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."
    },
    {
      "type": "color",
      "id": "look_color",
      "label": "Your colour",
      "default": "#F0EADE",
      "visible_if": "{{ section.settings.look_surface == 'custom' }}"
    },
    {
      "type": "select",
      "id": "look_tone",
      "label": "Words on your colour",
      "options": [
        {
          "value": "light",
          "label": "Dark words (for a light colour)"
        },
        {
          "value": "dark",
          "label": "Light words (for a dark colour)"
        }
      ],
      "default": "light",
      "visible_if": "{{ section.settings.look_surface == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Backdrop photo or film",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "paragraph",
      "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "image_picker",
      "id": "look_image",
      "label": "Backdrop photo",
      "info": "Also the poster while a backdrop film loads.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "video",
      "id": "look_video",
      "label": "Backdrop film (upload)",
      "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "checkbox",
      "id": "look_media_link",
      "label": "Use a film link instead of an upload",
      "default": false,
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "text",
      "id": "look_video_url",
      "label": "Backdrop film (URL)",
      "info": "A direct .mp4 link, used when no backdrop film is uploaded above.",
      "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"
    },
    {
      "type": "range",
      "id": "look_dim",
      "label": "Darken the backdrop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55,
      "info": "Lower = brighter. The words stay readable down to about 40%.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "select",
      "id": "look_focus",
      "label": "Backdrop crop focus",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "select",
      "id": "look_media_tone",
      "label": "Words over the backdrop",
      "options": [
        {
          "value": "dark",
          "label": "Light words on a darkened backdrop"
        },
        {
          "value": "light",
          "label": "Dark words on a pale backdrop"
        }
      ],
      "default": "dark",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "header",
      "content": "Space"
    },
    {
      "type": "range",
      "id": "look_space_top",
      "label": "Space above",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100,
      "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."
    },
    {
      "type": "range",
      "id": "look_space_bottom",
      "label": "Space below",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "look_width",
      "label": "Content width",
      "options": [
        {
          "value": "theme",
          "label": "Theme setting (Layout › Content width)"
        },
        {
          "value": "720",
          "label": "Narrow (720px)"
        },
        {
          "value": "900",
          "label": "Reading (900px)"
        },
        {
          "value": "1100",
          "label": "Medium (1100px)"
        },
        {
          "value": "1300",
          "label": "Wide (1300px)"
        },
        {
          "value": "1600",
          "label": "Very wide (1600px)"
        },
        {
          "value": "edge",
          "label": "Edge to edge"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "look_margins",
      "label": "Side margins",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100,
      "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."
    },
    {
      "type": "header",
      "content": "Type"
    },
    {
      "type": "range",
      "id": "look_heading",
      "label": "Heading size",
      "min": 50,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales the serif headings and titles in this section."
    },
    {
      "type": "range",
      "id": "look_text",
      "label": "Text size",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Paragraphs, captions and standfirsts."
    },
    {
      "type": "range",
      "id": "look_label",
      "label": "Small label size",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 0,
      "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."
    },
    {
      "type": "header",
      "content": "Finishing"
    },
    {
      "type": "checkbox",
      "id": "look_animate",
      "label": "Fade in as it scrolls into view",
      "default": true,
      "info": "Off = the section is simply there, no entrance."
    },
    {
      "type": "checkbox",
      "id": "look_rule_top",
      "label": "Hairline above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "look_rule_bottom",
      "label": "Hairline below",
      "default": false
    },
    {
      "type": "text",
      "id": "look_anchor",
      "label": "Anchor name",
      "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."
    }
  ],
  "blocks": [
    {
      "type": "residence",
      "name": "Residence",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Residence",
          "info": "A residence from Products. Its numbers, suburb and Status come from the product; Anything typed below replaces that line on this card only."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card photo",
          "info": "Empty = the residence's main photo. Real photographs only, never generated."
        },
        {
          "type": "select",
          "id": "focus",
          "label": "Crop focus",
          "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}],
          "default": "center"
        },
        { "type": "header", "content": "Words on the card" },
        { "type": "paragraph", "content": "Each box replaces that line on this card only; empty = the residence's own (Products › the residence). The residence page itself is unchanged." },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "status", "label": "Status word", "info": "The chip, e.g. For Sale, Under Offer, Coming Soon. A word containing Sold turns the card into a sold card." },
        { "type": "text", "id": "suburb", "label": "Location line", "info": "Written as it should read, e.g. Camp Hill, QLD." },
        { "type": "text", "id": "beds", "label": "Bedrooms" },
        { "type": "text", "id": "baths", "label": "Bathrooms" },
        { "type": "text", "id": "cars", "label": "Garages" },
        { "type": "text", "id": "build", "label": "Build size (m²)" },
        { "type": "text", "id": "land", "label": "Land size (m²)" },
        { "type": "url", "id": "link", "label": "Link", "info": "Empty = the residence's page." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Sold band"
    }
  ]
}
{% endschema %}
