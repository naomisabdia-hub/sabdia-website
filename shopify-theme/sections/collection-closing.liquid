{%- comment -%}
  Private inspections - the closing enquiry band of the For Sale page.

  Split out of the all-in-one Collection grid section on 14 Sep 2026 so each
  part of the For Sale page has its own panel in the customizer (Naomi:
  "have the header its settings, then the Now Selling, then each individual
  grid has their setting"). Real photographs and real footage only, never
  generated.
{%- endcomment -%}
{% render 'section-look', section: section %}
{%- if section.settings.show_cta -%}
<section class="sp s-surface" style="background:var(--bg2);border-top:1px solid var(--border);text-align:center">
  <div class="inner-sm">
    {%- if section.settings.cta_label != blank -%}<div class="slabel reveal" style="justify-content:center;margin-bottom:20px">{{ section.settings.cta_label }}</div>{%- endif -%}
    <h2 class="reveal d1" style="font-family:var(--font-d);font-size:calc(clamp(32px,5vw,64px)*var(--s-h,1));font-weight:300;color:var(--ink);margin-bottom:20px;letter-spacing:-.02em">{{ section.settings.cta_heading_html }}</h2>
    {%- if section.settings.cta_text != blank -%}<p class="reveal d2" style="font-size:calc(13px*var(--s-t,1));font-weight:300;color:var(--ink3);max-width:420px;margin:0 auto 36px;line-height:1.85">{{ section.settings.cta_text }}</p>{%- endif -%}
    <div class="reveal d3 mc-cta-row" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      {%- if section.settings.show_cta1 and section.settings.cta1_label != blank -%}<a href="{{ section.settings.cta1_link | default: '/pages/contact?interest=Request%20a%20Viewing' }}" class="btn-p">{{ section.settings.cta1_label }}{% if section.settings.cta1_arrow != blank %} {{ section.settings.cta1_arrow }}{% endif %}</a>{%- endif -%}
      {%- if section.settings.show_cta2 and section.settings.cta2_label != blank and settings.agent_access_enabled -%}<a href="{{ section.settings.cta2_link | default: '/pages/contact?interest=Agent%20Access' }}" class="btn-g">{{ section.settings.cta2_label }}</a>{%- endif -%}
      {%- if section.settings.show_cta3 and section.settings.cta3_label != blank and settings.guided_match_enabled != false -%}<a href="{{ section.settings.cta3_link | default: '/pages/find-your-home' }}" class="btn-g btn-g-gold">{{ section.settings.cta3_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Private inspections",
  "settings": [
    {
      "type": "paragraph",
      "content": "The closing band: \"Arrange a private inspection\" with its buttons. The Agent Enquiries button only shows while Theme settings › Agent access is on; the gold button while Find your home is on."
    },
    {
      "type": "header",
      "content": "Show"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show the closing band",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cta1",
      "label": "Primary button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cta2",
      "label": "Secondary button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cta3",
      "label": "Gold button",
      "default": true,
      "info": "Also needs Theme settings › Guided Match to be on."
    },
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Private Enquiry"
    },
    {
      "type": "html",
      "id": "cta_heading_html",
      "label": "CTA heading (HTML)",
      "default": "Interested in a<br><em>private viewing</em>?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Inspections are by private appointment. Tell us when suits you."
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button",
      "default": "Request a Viewing"
    },
    {
      "type": "text",
      "id": "cta1_arrow",
      "label": "Primary button arrow",
      "default": "→",
      "info": "After the button words. Empty = no arrow."
    },
    {
      "type": "url",
      "id": "cta1_link",
      "label": "Primary link",
      "info": "Empty = the contact form with Request a Viewing already chosen."
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button",
      "default": "Agent Enquiries"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary link",
      "info": "Empty = the contact form with Agent Access already chosen (/pages/contact?interest=Agent Access). The Agent Access page itself is parked for launch."
    },
    {
      "type": "text",
      "id": "cta3_label",
      "label": "Gold button",
      "default": "Guided Match"
    },
    {
      "type": "url",
      "id": "cta3_link",
      "label": "Gold button link",
      "info": "The Find Your Home page. Hidden site-wide when Theme settings › Guided Match is switched off; the row re-centres on the two buttons left."
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "paragraph",
      "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."
    },
    {
      "type": "select",
      "id": "look_surface",
      "label": "Background",
      "options": [
        {
          "value": "design",
          "label": "As designed"
        },
        {
          "value": "cream",
          "label": "Cream (the page colour)"
        },
        {
          "value": "stone",
          "label": "Stone (soft panel)"
        },
        {
          "value": "obsidian",
          "label": "Obsidian (dark)"
        },
        {
          "value": "custom",
          "label": "A colour of your own (below)"
        },
        {
          "value": "media",
          "label": "A photo or film behind it (below)"
        }
      ],
      "default": "design",
      "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."
    },
    {
      "type": "color",
      "id": "look_color",
      "label": "Your colour",
      "default": "#F0EADE",
      "visible_if": "{{ section.settings.look_surface == 'custom' }}"
    },
    {
      "type": "select",
      "id": "look_tone",
      "label": "Words on your colour",
      "options": [
        {
          "value": "light",
          "label": "Dark words (for a light colour)"
        },
        {
          "value": "dark",
          "label": "Light words (for a dark colour)"
        }
      ],
      "default": "light",
      "visible_if": "{{ section.settings.look_surface == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Backdrop photo or film",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "paragraph",
      "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "image_picker",
      "id": "look_image",
      "label": "Backdrop photo",
      "info": "Also the poster while a backdrop film loads.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "video",
      "id": "look_video",
      "label": "Backdrop film (upload)",
      "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "checkbox",
      "id": "look_media_link",
      "label": "Use a film link instead of an upload",
      "default": false,
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "text",
      "id": "look_video_url",
      "label": "Backdrop film (URL)",
      "info": "A direct .mp4 link, used when no backdrop film is uploaded above.",
      "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"
    },
    {
      "type": "range",
      "id": "look_dim",
      "label": "Darken the backdrop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55,
      "info": "Lower = brighter. The words stay readable down to about 40%.",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "select",
      "id": "look_focus",
      "label": "Backdrop crop focus",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "select",
      "id": "look_media_tone",
      "label": "Words over the backdrop",
      "options": [
        {
          "value": "dark",
          "label": "Light words on a darkened backdrop"
        },
        {
          "value": "light",
          "label": "Dark words on a pale backdrop"
        }
      ],
      "default": "dark",
      "visible_if": "{{ section.settings.look_surface == 'media' }}"
    },
    {
      "type": "header",
      "content": "Space"
    },
    {
      "type": "range",
      "id": "look_space_top",
      "label": "Space above",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100,
      "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."
    },
    {
      "type": "range",
      "id": "look_space_bottom",
      "label": "Space below",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "look_width",
      "label": "Content width",
      "options": [
        {
          "value": "theme",
          "label": "Theme setting (Layout › Content width)"
        },
        {
          "value": "720",
          "label": "Narrow (720px)"
        },
        {
          "value": "900",
          "label": "Reading (900px)"
        },
        {
          "value": "1100",
          "label": "Medium (1100px)"
        },
        {
          "value": "1300",
          "label": "Wide (1300px)"
        },
        {
          "value": "1600",
          "label": "Very wide (1600px)"
        },
        {
          "value": "edge",
          "label": "Edge to edge"
        }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "look_margins",
      "label": "Side margins",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100,
      "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."
    },
    {
      "type": "header",
      "content": "Type"
    },
    {
      "type": "range",
      "id": "look_heading",
      "label": "Heading size",
      "min": 50,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Scales the serif headings and titles in this section."
    },
    {
      "type": "range",
      "id": "look_text",
      "label": "Text size",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Paragraphs, captions and standfirsts."
    },
    {
      "type": "range",
      "id": "look_label",
      "label": "Small label size",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 0,
      "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."
    },
    {
      "type": "header",
      "content": "Finishing"
    },
    {
      "type": "checkbox",
      "id": "look_animate",
      "label": "Fade in as it scrolls into view",
      "default": true,
      "info": "Off = the section is simply there, no entrance."
    },
    {
      "type": "checkbox",
      "id": "look_rule_top",
      "label": "Hairline above",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "look_rule_bottom",
      "label": "Hairline below",
      "default": false
    },
    {
      "type": "text",
      "id": "look_anchor",
      "label": "Anchor name",
      "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."
    }
  ],
  "presets": [
    {
      "name": "Private inspections"
    }
  ]
}
{% endschema %}
