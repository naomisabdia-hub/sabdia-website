{%- comment -%}
  Centred closing CTA used by About / Services / Projects - label, display
  heading, optional text, two buttons. Light by default; the dark variant
  is the obsidian band Services closes on.
{%- endcomment -%}
{%- liquid
  assign dark = section.settings.dark
  assign hsize = 'clamp(36px,5vw,68px)'
  if section.settings.compact
    assign hsize = 'clamp(32px,5vw,60px)'
  endif
-%}
{%- liquid
  assign look_designed = 'light'
  if section.settings.dark
    assign look_designed = 'dark'
  endif
-%}
{% render 'section-look', section: section, designed: look_designed %}
{%- liquid
  assign cc_align = section.settings.align | default: 'centre'
  assign cc_width = section.settings.width | default: 'narrow'
  assign cc_inner = 'inner-sm'
  if cc_width == 'medium'
    assign cc_inner = 'inner-md'
  elsif cc_width == 'wide'
    assign cc_inner = 'inner'
  endif
  if dark and cc_width == 'narrow'
    assign cc_inner = 'inner'
  endif
  assign cc_left = false
  if cc_align == 'left'
    assign cc_left = true
  endif
-%}
<section class="sp cta-c{% if cc_left %} cta-left{% endif %}{% if section.settings.stack_buttons %} cta-stack{% endif %}" style="text-align:{% if cc_left %}left{% else %}center{% endif %}{% if dark %};background:var(--dark){% endif %}">
  <div class="{{ cc_inner }}">
    {%- if section.settings.show_label and section.settings.label != blank -%}<div class="slabel {% if dark %}slabel-dark {% endif %}reveal" style="{% unless cc_left %}justify-content:center;{% endunless %}margin-bottom:20px">{{ section.settings.label }}</div>{%- endif -%}
    {%- if dark -%}
      <h2 class="reveal d1" style="font-family:var(--font-d);font-size:calc({{ hsize }}*var(--s-h,1));font-weight:300;color:var(--white);margin-bottom:24px;letter-spacing:-.02em">{{ section.settings.heading_html }}</h2>
    {%- else -%}
      <h2 class="about-h reveal d1" style="text-align:{% if cc_left %}left{% else %}center{% endif %};font-size:calc({{ hsize }}*var(--s-h,1))">{{ section.settings.heading_html }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank and section.settings.show_text -%}
      {%- if dark -%}
        <p class="reveal d2" style="font-size:calc(13px*var(--s-t,1));font-weight:300;color:rgba(var(--white-rgb),.45);max-width:440px;margin:0 {% unless cc_left %}auto{% else %}0{% endunless %} 40px;line-height:1.8">{{ section.settings.text }}</p>
      {%- else -%}
        <p class="about-p reveal d2" style="text-align:{% if cc_left %}left{% else %}center{% endif %};margin:24px {% unless cc_left %}auto{% else %}0{% endunless %} 40px;max-width:480px">{{ section.settings.text }}</p>
      {%- endif -%}
    {%- endif -%}
    {%- if section.settings.show_buttons -%}
    <div class="reveal d3 cta-btns" style="display:flex;gap:14px;justify-content:{% if cc_left %}flex-start{% else %}center{% endif %};flex-wrap:wrap{% if section.settings.text == blank or section.settings.show_text == false %};margin-top:36px{% endif %}">
      {%- comment -%} A button to the guided match is left out when Theme settings › Features › Guided Match is off; the centred flex row re-centres on its own. {%- endcomment -%}
      {%- liquid
        assign cc_hide1 = false
        assign cc_hide2 = false
        if settings.guided_match_enabled == false
          if section.settings.cta1_link contains 'find-your-home'
            assign cc_hide1 = true
          endif
          if section.settings.cta2_link contains 'find-your-home'
            assign cc_hide2 = true
          endif
        endif
        if settings.agent_access_enabled != true
          if section.settings.cta1_link contains 'agent'
            assign cc_hide1 = true
          endif
          if section.settings.cta2_link contains 'agent'
            assign cc_hide2 = true
          endif
        endif
      -%}
      {%- if section.settings.cta1_label != blank and cc_hide1 == false -%}
        <a href="{{ section.settings.cta1_link }}" class="{% if section.settings.cta1_style == 'ghost' %}btn-g{% if dark %} btn-g-light{% endif %}{% else %}btn-p{% endif %}">{{ section.settings.cta1_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank and cc_hide2 == false -%}
        <a href="{{ section.settings.cta2_link }}" class="btn-g{% if dark %} btn-g-light{% endif %}">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
<style>.cta-stack .cta-btns{flex-direction:column;align-items:center}.cta-left.cta-stack .cta-btns{align-items:flex-start}</style>

{% schema %}
{
  "name": "Closing CTA",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "html", "id": "heading_html", "label": "Heading (HTML)" },
    { "type": "textarea", "id": "text", "label": "Text (optional)" },
    { "type": "text", "id": "cta1_label", "label": "Primary button label" },
    { "type": "url", "id": "cta1_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" },
    { "type": "checkbox", "id": "dark", "label": "Dark (obsidian) band", "default": false },
    { "type": "checkbox", "id": "compact", "label": "Slightly smaller heading", "default": false },
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_label", "label": "Show the small label", "default": true},
    {"type": "checkbox", "id": "show_text", "label": "Show the text", "default": true},
    {"type": "checkbox", "id": "show_buttons", "label": "Show the buttons", "default": true},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "align", "label": "Words sit", "options": [{"value": "centre", "label": "Centre (as designed)"}, {"value": "left", "label": "Left"}], "default": "centre"},
    {"type": "select", "id": "width", "label": "Width of the words", "options": [{"value": "narrow", "label": "Narrow (as designed)"}, {"value": "medium", "label": "Medium"}, {"value": "wide", "label": "Full content width"}], "default": "narrow"},
    {"type": "select", "id": "cta1_style", "label": "Primary button", "options": [{"value": "solid", "label": "Solid"}, {"value": "ghost", "label": "Outlined"}], "default": "solid"},
    {"type": "checkbox", "id": "stack_buttons", "label": "Buttons one under the other", "default": false},
    {"type": "header", "content": "Look"},
    {"type": "paragraph", "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}, {"value": "media", "label": "A photo or film behind it (below)"}], "default": "design", "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#F0EADE", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "header", "content": "Backdrop photo or film", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "paragraph", "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "image_picker", "id": "look_image", "label": "Backdrop photo", "info": "Also the poster while a backdrop film loads.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "video", "id": "look_video", "label": "Backdrop film (upload)", "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "checkbox", "id": "look_media_link", "label": "Use a film link instead of an upload", "default": false, "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "text", "id": "look_video_url", "label": "Backdrop film (URL)", "info": "A direct .mp4 link, used when no backdrop film is uploaded above.", "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"},
    {"type": "range", "id": "look_dim", "label": "Darken the backdrop", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Lower = brighter. The words stay readable down to about 40%.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_focus", "label": "Backdrop crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_media_tone", "label": "Words over the backdrop", "options": [{"value": "dark", "label": "Light words on a darkened backdrop"}, {"value": "light", "label": "Dark words on a pale backdrop"}], "default": "dark", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."}
  ],
  "presets": [{ "name": "Closing CTA" }]
}
{% endschema %}
