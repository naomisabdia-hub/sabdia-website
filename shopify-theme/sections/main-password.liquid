{%- comment -%}
  Password page - shown while the store is locked (Online Store ›
  Preferences › Restrict access). Shopify's own storefront_password form
  lets anyone with the password in; the layout is the site's normal
  theme.liquid so the logo, fonts and footer match.
{%- endcomment -%}
{%- liquid
  # A film (or photo) behind the coming-soon message. Uploaded film first,
  # then the URL; the photo is its poster or stands alone.
  assign pw_video = section.settings.video_url
  if section.settings.video
    assign pwmp4 = section.settings.video.sources | where: 'format', 'mp4' | first
    if pwmp4
      assign pw_video = pwmp4.url
    endif
  endif
  assign pw_media = false
  if pw_video != blank or section.settings.image or section.settings.image_ext != blank
    assign pw_media = true
  endif
-%}
{% render 'section-look', section: section, mode: 'hero' %}
{%- assign pw_dim = section.settings.dim | default: 76 | divided_by: 100.0 -%}
<section class="sp pw-band{% if pw_media %} pw-has-media{% endif %}{% if section.settings.align == 'left' %} pw-left{% endif %}" style="min-height:{% if pw_media %}{{ section.settings.min_height | default: 100 }}svh{% else %}70vh{% endif %};display:flex;align-items:center;position:relative;overflow:hidden;--pw-dim:{{ pw_dim }};--pw-logo:{{ section.settings.logo_size | default: 56 }}px">
  {%- if pw_media -%}
    {%- if pw_video != blank -%}
      {%- comment -%}
        The still sits under the film rather than instead of it: with
        reduced motion the CSS below hides the film, and what remains is
        the photograph rather than a bare dark screen.
      {%- endcomment -%}
      {%- if section.settings.image -%}
        <img class="pw-media pw-still" src="{{ section.settings.image | image_url: width: 1920, height: 1080, crop: 'center' }}" alt="" width="1920" height="1080" loading="eager">
      {%- elsif section.settings.image_ext != blank -%}
        <img class="pw-media pw-still" src="{% render 'ext-variant', src: section.settings.image_ext, w: 1920, h: 1080 %}" alt="" width="1920" height="1080" loading="eager">
      {%- endif -%}
      <video class="pw-media" src="{{ pw_video }}" autoplay muted loop playsinline preload="metadata" aria-hidden="true"{% if section.settings.image %} poster="{{ section.settings.image | image_url: width: 1920 }}"{% elsif section.settings.image_ext != blank %} poster="{{ section.settings.image_ext }}"{% endif %}></video>
    {%- elsif section.settings.image -%}
      <img class="pw-media" src="{{ section.settings.image | image_url: width: 1920, height: 1080, crop: 'center' }}" alt="" width="1920" height="1080" loading="eager">
    {%- else -%}
      <img class="pw-media" src="{% render 'ext-variant', src: section.settings.image_ext, w: 1920, h: 1080 %}" alt="" width="1920" height="1080" loading="eager">
    {%- endif -%}
    <div class="pw-ov" aria-hidden="true"></div>
  {%- endif -%}
  <div class="inner" style="max-width:{{ section.settings.box_width | default: 560 }}px;text-align:{% if section.settings.align == 'left' %}left{% else %}center{% endif %};position:relative;z-index:2{% if section.settings.align == 'left' %};margin-left:0{% endif %}">
    {%- if pw_media and section.settings.show_logo -%}
      {%- liquid
        assign pw_logo = 'logo.png' | asset_url
        if settings.logo
          assign pw_logo = settings.logo | image_url: width: 900
        endif
      -%}
      <img class="pw-logo reveal" src="{{ pw_logo }}" alt="{{ settings.site_name | default: 'Sabdia' }}" width="900" height="180">
    {%- endif -%}
    {%- if section.settings.show_label and section.settings.label != blank -%}<div class="slabel reveal{% if pw_media %} slabel-dark{% endif %}" style="{% unless section.settings.align == 'left' %}justify-content:center{% endunless %}">{{ section.settings.label }}</div>{%- endif -%}
    <h1 class="about-h reveal d1"{% if pw_media %} style="color:var(--white)"{% endif %}>{{ section.settings.heading_html }}</h1>
    {%- if section.settings.text != blank and section.settings.show_text -%}
      <p class="about-p reveal d2" style="margin-top:14px{% if pw_media %};color:rgba(var(--white-rgb),.7){% endif %}{% unless section.settings.align == 'left' %};margin-left:auto;margin-right:auto{% endunless %}">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- comment -%}
      The page is a statement first: the field folds away behind a quiet
      link so a visitor is not met with a login. Folding is CSS under
      html.js only, so with scripting off the field is simply open and
      whoever has the password can still get in. A wrong password renders
      .pw-err, which the script reads to reopen the row.
    {%- endcomment -%}
    {%- form 'storefront_password', class: 'reveal d3 pw-key' -%}
      {%- if form.errors -%}
        <p class="form-note pw-err" role="alert" style="color:var(--gold2);margin:18px 0 0">{{ section.settings.error_text }}</p>
      {%- endif -%}
      {%- if section.settings.fold_form -%}
        <button type="button" class="pw-key-btn" aria-expanded="false">{{ section.settings.toggle_label }}</button>
      {%- endif -%}
      <div class="pw-key-row" style="display:flex;gap:10px;justify-content:{% if section.settings.align == 'left' %}flex-start{% else %}center{% endif %};margin-top:28px;flex-wrap:wrap">
        <label for="pw" class="sr-only">{{ section.settings.field_label }}</label>
        <input type="password" id="pw" name="password" class="fi" placeholder="{{ section.settings.field_label | escape }}" autocomplete="current-password" required style="max-width:280px">
        <button type="submit" class="btn-p">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}
    {%- comment -%}
      An enquiry that arrives while the site is still closed should still
      reach someone. Email and phone come from Theme settings › Contact.
    {%- endcomment -%}
    {%- if section.settings.show_contact -%}
      {%- assign pw_mail = settings.contact_email -%}
      {%- assign pw_tel = settings.contact_phone -%}
      {%- if pw_mail != blank or pw_tel != blank -%}
        <p class="pw-contact reveal d3">
          {%- if section.settings.contact_text != blank -%}<span>{{ section.settings.contact_text }}</span>{%- endif -%}
          {%- if pw_mail != blank -%}<a href="mailto:{{ pw_mail }}">{{ pw_mail }}</a>{%- endif -%}
          {%- if pw_tel != blank -%}<a href="tel:{{ pw_tel | remove: ' ' | remove: '(' | remove: ')' }}">{{ pw_tel }}</a>{%- endif -%}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .pw-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(calc(1 - var(--pw-dim,.76) * .5)) saturate(.9)}
  .pw-ov{opacity:calc(var(--pw-dim,.76) / .76)}
  .pw-left .pw-logo{margin-left:0}
  .pw-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(var(--dark-rgb),.75),rgba(var(--dark-rgb),.25) 50%,rgba(var(--dark-rgb),.45))}
  .pw-has-media .about-h em{color:var(--gold2)}
  .pw-has-media .fi{background:rgba(var(--white-rgb),.08);border-color:rgba(var(--white-rgb),.35);color:var(--white)}
  .pw-has-media .fi::placeholder{color:rgba(var(--white-rgb),.55)}
  .pw-has-media .btn-p{background:var(--gold);color:var(--dark)}
  .pw-logo{height:min(var(--pw-logo,56px),9vw);width:auto;margin:0 auto 28px;display:block;filter:invert(1) brightness(10);opacity:.92}
  @media(prefers-reduced-motion:reduce){video.pw-media{display:none}}
  /* Folding password entry. The row is hidden only under html.js, so with
     scripting off the field is open and the link never appears. */
  .pw-key-btn{display:none;margin:28px auto 0;background:none;border:0;border-bottom:1px solid rgba(var(--dark-rgb),.25);padding:6px 2px;font:inherit;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink3);cursor:pointer;transition:color .3s var(--ease),border-color .3s var(--ease)}
  .pw-has-media .pw-key-btn{color:rgba(var(--white-rgb),.6);border-bottom-color:rgba(var(--white-rgb),.3)}
  .pw-key-btn:hover,.pw-has-media .pw-key-btn:hover{color:var(--gold2);border-bottom-color:var(--gold2)}
  .pw-left .pw-key-btn{margin-left:0}
  /* 33px of link is a mean target on a phone; padding takes it past 44. */
  @media(max-width:600px){.pw-key-btn{padding:12px 10px}}
  html.js .pw-key:not(.is-open) .pw-key-row{display:none!important}
  html.js .pw-key:not(.is-open) .pw-key-btn{display:inline-block}
  .pw-contact{margin:34px 0 0;display:flex;gap:18px;flex-wrap:wrap;align-items:baseline;justify-content:center;font-size:13px;letter-spacing:.04em;color:var(--ink3)}
  .pw-left .pw-contact{justify-content:flex-start}
  .pw-contact span{font-size:11px;letter-spacing:.16em;text-transform:uppercase;opacity:.7}
  .pw-contact a{color:inherit;text-decoration:none;border-bottom:1px solid rgba(var(--dark-rgb),.22);padding-bottom:2px;transition:color .3s var(--ease),border-color .3s var(--ease)}
  .pw-has-media .pw-contact{color:rgba(var(--white-rgb),.72)}
  .pw-has-media .pw-contact a{border-bottom-color:rgba(var(--white-rgb),.22)}
  .pw-contact a:hover{color:var(--gold2);border-bottom-color:var(--gold2)}
</style>

<script>
(function () {
  var f = document.querySelector('.pw-key');
  if (!f) return;
  var b = f.querySelector('.pw-key-btn');
  /* No link (the dial is off) or a wrong password just tried: stay open. */
  if (!b || f.querySelector('.pw-err')) { f.classList.add('is-open'); return; }
  b.addEventListener('click', function () {
    f.classList.add('is-open');
    b.setAttribute('aria-expanded', 'true');
    var i = f.querySelector('#pw');
    if (i) i.focus();
  });
})();
</script>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "header", "content": "Film or photo behind the message", "info": "Tamsin, 10 Sep 2026: a film on the coming-soon page. Landscape footage works best." },
    { "type": "video", "id": "video", "label": "Film (upload)" },
    { "type": "text", "id": "video_url", "label": "Current film (URL)", "info": "A direct .mp4 link, used when no film is uploaded above.", "default": "https://b91p0j-f4.myshopify.com/cdn/shop/videos/c/vp/06e92778318d404fa168f505e5493bc7/06e92778318d404fa168f505e5493bc7.HD-1080p-7.2Mbps-93849692.mp4" },
    { "type": "image_picker", "id": "image", "label": "Photo (poster for the film, or on its own)" },
    { "type": "text", "id": "image_ext", "label": "Current photo (URL)", "default": "https://b91p0j-f4.myshopify.com/cdn/shop/files/sierra-exterior-front-dusk-01.jpg?v=1788919262&width=1920" },
    { "type": "checkbox", "id": "show_logo", "label": "Show the wordmark above the message", "default": true },
    { "type": "text", "id": "label", "label": "Small label", "default": "Coming soon" },
    { "type": "html", "id": "heading_html", "label": "Heading", "default": "The new Sabdia site is <em>nearly</em> ready." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "If you have the password, enter it below." },
    { "type": "text", "id": "field_label", "label": "Password field label", "default": "Password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "error_text", "label": "Wrong-password message", "default": "That password is not right - please try again." },
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."},
    {"type": "header", "content": "Photo or film"},
    {"type": "range", "id": "dim", "label": "Darken the film or photo", "min": 0, "max": 100, "step": 4, "default": 76, "unit": "%", "info": "Lower = brighter."},
    {"type": "range", "id": "min_height", "label": "Height", "min": 60, "max": 100, "step": 5, "default": 100, "unit": "svh", "info": "A share of the window height, with a film or photo."},
    {"type": "header", "content": "Words"},
    {"type": "checkbox", "id": "show_label", "label": "Show the small label", "default": true},
    {"type": "checkbox", "id": "show_text", "label": "Show the text", "default": true},
    {"type": "checkbox", "id": "fold_form", "label": "Fold the password field behind a link", "default": true, "info": "On, the page reads as a statement and the field opens when the link is clicked. Off, the field is always showing."},
    {"type": "text", "id": "toggle_label", "label": "Link that opens the field", "default": "Enter with password"},
    {"type": "checkbox", "id": "show_contact", "label": "Show the enquiry line", "default": true, "info": "Email and phone come from Theme settings › Contact, so an enquiry still reaches someone while the site is closed."},
    {"type": "text", "id": "contact_text", "label": "Word before the enquiry line", "default": "Enquiries"},
    {"type": "range", "id": "logo_size", "label": "Wordmark height", "min": 24, "max": 120, "step": 4, "default": 56, "unit": "px"},
    {"type": "select", "id": "align", "label": "Words sit", "options": [{"value": "centre", "label": "Centre (as designed)"}, {"value": "left", "label": "Left"}], "default": "centre"},
    {"type": "range", "id": "box_width", "label": "Width of the words", "min": 420, "max": 900, "step": 20, "default": 560, "unit": "px"}
  ],
  "presets": [ { "name": "Password page" } ]
}
{% endschema %}
