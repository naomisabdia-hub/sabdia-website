{%- comment -%}
  Password page - shown while the store is locked (Online Store ›
  Preferences › Restrict access). Shopify's own storefront_password form
  lets anyone with the password in; the layout is the site's normal
  theme.liquid so the logo, fonts and footer match.
{%- endcomment -%}
<section class="sp" style="min-height:70vh;display:flex;align-items:center">
  <div class="inner" style="max-width:560px;text-align:center">
    <div class="slabel reveal" style="justify-content:center">{{ section.settings.label }}</div>
    <h1 class="about-h reveal d1">{{ section.settings.heading_html }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="about-p reveal d2" style="margin-top:14px">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'reveal d3' -%}
      {%- if form.errors -%}
        <p class="form-note" role="alert" style="color:var(--gold2);margin:18px 0 0">{{ section.settings.error_text }}</p>
      {%- endif -%}
      <div style="display:flex;gap:10px;justify-content:center;margin-top:28px;flex-wrap:wrap">
        <label for="pw" class="sr-only">{{ section.settings.field_label }}</label>
        <input type="password" id="pw" name="password" class="fi" placeholder="{{ section.settings.field_label | escape }}" autocomplete="current-password" required style="max-width:280px">
        <button type="submit" class="btn-p">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Coming soon" },
    { "type": "html", "id": "heading_html", "label": "Heading", "default": "The new Sabdia site is <em>nearly</em> ready." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "If you have the password, enter it below." },
    { "type": "text", "id": "field_label", "label": "Password field label", "default": "Password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "error_text", "label": "Wrong-password message", "default": "That password is not right - please try again." }
  ],
  "presets": [ { "name": "Password page" } ]
}
{% endschema %}
