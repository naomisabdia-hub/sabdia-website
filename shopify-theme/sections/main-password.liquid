{%- comment -%}
  Password page - shown while the store is locked (Online Store ›
  Preferences › Restrict access). Shopify's own storefront_password form
  lets anyone with the password in; the layout is the site's normal
  theme.liquid so the logo, fonts and footer match.
{%- endcomment -%}
{%- liquid
  # A film (or photo) behind the coming-soon message. Uploaded film first,
  # then the URL; the photo is its poster or stands alone.
  assign pw_video = section.settings.video_url
  if section.settings.video
    assign pwmp4 = section.settings.video.sources | where: 'format', 'mp4' | first
    if pwmp4
      assign pw_video = pwmp4.url
    endif
  endif
  assign pw_media = false
  if pw_video != blank or section.settings.image or section.settings.image_ext != blank
    assign pw_media = true
  endif
-%}
<section class="sp pw-band{% if pw_media %} pw-has-media{% endif %}" style="min-height:{% if pw_media %}100svh{% else %}70vh{% endif %};display:flex;align-items:center;position:relative;overflow:hidden">
  {%- if pw_media -%}
    {%- if pw_video != blank -%}
      <video class="pw-media" src="{{ pw_video }}" autoplay muted loop playsinline preload="metadata" aria-hidden="true"{% if section.settings.image %} poster="{{ section.settings.image | image_url: width: 1920 }}"{% elsif section.settings.image_ext != blank %} poster="{{ section.settings.image_ext }}"{% endif %}></video>
    {%- elsif section.settings.image -%}
      <img class="pw-media" src="{{ section.settings.image | image_url: width: 1920, height: 1080, crop: 'center' }}" alt="" width="1920" height="1080" loading="eager">
    {%- else -%}
      <img class="pw-media" src="{% render 'ext-variant', src: section.settings.image_ext, w: 1920, h: 1080 %}" alt="" width="1920" height="1080" loading="eager">
    {%- endif -%}
    <div class="pw-ov" aria-hidden="true"></div>
  {%- endif -%}
  <div class="inner" style="max-width:560px;text-align:center;position:relative;z-index:2">
    {%- if pw_media and section.settings.show_logo -%}
      {%- liquid
        assign pw_logo = 'logo.png' | asset_url
        if settings.logo
          assign pw_logo = settings.logo | image_url: width: 900
        endif
      -%}
      <img class="pw-logo reveal" src="{{ pw_logo }}" alt="{{ settings.site_name | default: 'Sabdia' }}" width="900" height="180">
    {%- endif -%}
    <div class="slabel reveal{% if pw_media %} slabel-dark{% endif %}" style="justify-content:center">{{ section.settings.label }}</div>
    <h1 class="about-h reveal d1"{% if pw_media %} style="color:var(--white)"{% endif %}>{{ section.settings.heading_html }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="about-p reveal d2" style="margin-top:14px{% if pw_media %};color:rgba(253,251,246,.7){% endif %}">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'reveal d3' -%}
      {%- if form.errors -%}
        <p class="form-note" role="alert" style="color:var(--gold2);margin:18px 0 0">{{ section.settings.error_text }}</p>
      {%- endif -%}
      <div style="display:flex;gap:10px;justify-content:center;margin-top:28px;flex-wrap:wrap">
        <label for="pw" class="sr-only">{{ section.settings.field_label }}</label>
        <input type="password" id="pw" name="password" class="fi" placeholder="{{ section.settings.field_label | escape }}" autocomplete="current-password" required style="max-width:280px">
        <button type="submit" class="btn-p">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

<style>
  .pw-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.62) saturate(.9)}
  .pw-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(31,27,20,.75),rgba(31,27,20,.25) 50%,rgba(31,27,20,.45))}
  .pw-has-media .about-h em{color:var(--gold2)}
  .pw-has-media .fi{background:rgba(253,251,246,.08);border-color:rgba(253,251,246,.35);color:var(--white)}
  .pw-has-media .fi::placeholder{color:rgba(253,251,246,.55)}
  .pw-has-media .btn-p{background:var(--gold);color:var(--dark)}
  .pw-logo{height:clamp(36px,5vw,64px);width:auto;margin:0 auto 28px;display:block;filter:invert(1) brightness(10);opacity:.92}
  @media(prefers-reduced-motion:reduce){video.pw-media{display:none}}
</style>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "header", "content": "Film or photo behind the message", "info": "Tamsin, 10 Sep 2026: a film on the coming-soon page. Landscape footage works best." },
    { "type": "video", "id": "video", "label": "Film (upload)" },
    { "type": "text", "id": "video_url", "label": "Current film (URL)", "info": "A direct .mp4 link, used when no film is uploaded above." },
    { "type": "image_picker", "id": "image", "label": "Photo (poster for the film, or on its own)" },
    { "type": "text", "id": "image_ext", "label": "Current photo (URL)" },
    { "type": "checkbox", "id": "show_logo", "label": "Show the wordmark above the message", "default": true },
    { "type": "text", "id": "label", "label": "Small label", "default": "Coming soon" },
    { "type": "html", "id": "heading_html", "label": "Heading", "default": "The new Sabdia site is <em>nearly</em> ready." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "If you have the password, enter it below." },
    { "type": "text", "id": "field_label", "label": "Password field label", "default": "Password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "error_text", "label": "Wrong-password message", "default": "That password is not right - please try again." }
  ],
  "presets": [ { "name": "Password page" } ]
}
{% endschema %}
