{%- comment -%}
  For Sale - faithful port of properties/index.astro: photographic hero,
  refine/sort toolbar, the Now Selling intro band, the featured-residence
  banner, the residence grid, the sold band, the How It Works strip and the
  enquiry CTA. Filters read each residence's metafields (suburb, cars,
  land, build_size, beds, baths, status, year and the normalised feature
  tokens from residence-feats). On /collections/for-sale and
  /collections/sold the list is driven by each residence's Status (see
  residence-status): the collection's manual order leads, then any other
  residence whose Status belongs here is swept in. Other collections list
  their own products.

  Each residence's brochure face (metafields custom.name_font /
  name_font_file / name_font_weight / name_font_caps, the same fields the
  residence page reads) is loaded once here, so the cards can set the name
  in it: one Google Fonts stylesheet for every distinct family, and an
  @font-face for every font file.
{%- endcomment -%}
{%- liquid
  if collection.handle == 'for-sale' or collection.handle == 'sold'
    assign group = 'live'
    if collection.handle == 'sold'
      assign group = 'sold'
    endif
    capture list_csv
      render 'residence-handles', col: collection, group: group
    endcapture
  else
    capture list_csv
      for p in collection.products
        unless forloop.first
          echo ','
        endunless
        echo p.handle
      endfor
    endcapture
  endif
  assign handles = list_csv | split: ','
  assign count = handles.size
  case count
    when 1
      assign count_word = 'One'
    when 2
      assign count_word = 'Two'
    when 3
      assign count_word = 'Three'
    when 4
      assign count_word = 'Four'
    when 5
      assign count_word = 'Five'
    when 6
      assign count_word = 'Six'
    when 7
      assign count_word = 'Seven'
    when 8
      assign count_word = 'Eight'
    when 9
      assign count_word = 'Nine'
    else
      assign count_word = count
  endcase
  assign count_token = '{' | append: 'count' | append: '}'
  assign intro = section.settings.intro_template | replace: count_token, count_word
  if count == 1
    assign intro = intro | replace: ' residences ', ' residence ' | replace: ' homes ', ' home ' | replace: ', each ', ', '
  endif
  assign show_rich = true
  if collection.handle == 'sold'
    assign show_rich = false
  endif
  assign has_build = false
  for p in collections.all.products
    if p.metafields.custom.build_size.value != blank
      assign has_build = true
      break
    endif
  endfor
  assign featured = false
  assign first_handle = handles.first
  for p in collections.all.products
    if p.handle == first_handle
      assign featured = p
      break
    endif
  endfor
  capture sold_csv
    render 'residence-handles', col: collections['sold'], group: 'sold'
  endcapture
  assign sold_handles = sold_csv | split: ','

  # One pass over the listed residences: the suburbs, the largest bed and
  # bath counts, the statuses and feature tokens present (so the toolbar
  # only offers choices that match something), whether any has a year, and
  # every distinct brochure face to load.
  assign live_suburbs = ''
  assign max_beds = 0
  assign max_baths = 0
  # Every distinct count in use, so a step is only offered when a residence
  # has it (Naomi, 11 Sep 2026: every home has five bedrooms, so "4+" was
  # offering a choice nothing could answer).
  assign bed_vals = ''
  assign bath_vals = ''
  assign car_vals = ''
  assign land_vals = ''
  assign statuses = ''
  assign feats_all = ''
  assign has_year = false
  assign gfonts = ''
  assign ffiles = ''
  for h in handles
    for p in collections.all.products
      if p.handle != h
        continue
      endif
      assign pm = p.metafields.custom
      if pm.suburb.value != blank
        assign live_suburbs = live_suburbs | append: pm.suburb.value | append: '¦'
      endif
      assign pb = pm.beds.value | plus: 0
      if pb > max_beds
        assign max_beds = pb
      endif
      if pb > 0
        assign bed_vals = bed_vals | append: pb | append: '¦'
      endif
      assign pba = pm.baths.value | plus: 0
      if pba > max_baths
        assign max_baths = pba
      endif
      if pba > 0
        assign bath_vals = bath_vals | append: pba | append: '¦'
      endif
      assign pc = pm.cars.value | plus: 0
      if pc > 0
        assign car_vals = car_vals | append: pc | append: '¦'
      endif
      assign pl = pm.land.value | plus: 0
      if pl > 0
        assign land_vals = land_vals | append: pl | append: '¦'
      endif
      capture pst
        render 'residence-status', product: p
      endcapture
      assign statuses = statuses | append: pst | append: '¦'
      capture pft
        render 'residence-feats', product: p
      endcapture
      assign feats_all = feats_all | append: ' ' | append: pft
      if pm.year.value != blank
        assign has_year = true
      endif
      assign pf = pm.name_font.value | strip
      assign pff = pm.name_font_file.value | strip
      assign pfw = pm.name_font_weight.value | default: 400
      if pff != blank
        assign pfam = pf
        if pfam == blank
          assign pfam = 'ResidenceFace-' | append: p.handle
        endif
        assign ffiles = ffiles | append: pfam | append: '¦' | append: pff | append: '¦' | append: pfw | append: '||'
      elsif pf != blank
        assign gfonts = gfonts | append: pf | append: ':wght@' | append: pfw | append: '||'
      endif
      break
    endfor
  endfor
  assign suburb_list = live_suburbs | split: '¦' | uniq | sort
  assign status_list = statuses | split: '¦' | uniq
  assign bed_list = bed_vals | split: '¦' | uniq | sort_natural
  assign bath_list = bath_vals | split: '¦' | uniq | sort_natural
  assign car_list = car_vals | split: '¦' | uniq | sort_natural
  assign land_nums = land_vals | split: '¦'
  assign land_small = false
  assign land_mid = false
  assign land_big = false
  for lv in land_nums
    assign lvn = lv | plus: 0
    if lvn < 600
      assign land_small = true
    elsif lvn < 800
      assign land_mid = true
    else
      assign land_big = true
    endif
  endfor
  assign gfont_list = gfonts | split: '||' | uniq
  assign ffile_list = ffiles | split: '||' | uniq

  # Hero film (uploaded or URL) beats the hero photo. With neither chosen the
  # hero shows a different residence from the featured banner underneath
  # (the second in the order; else the featured home's second photo), so the
  # page never opens on the same house twice.
  assign hero_video = section.settings.hero_video_url
  if section.settings.hero_video
    assign hmp4 = section.settings.hero_video.sources | where: 'format', 'mp4' | first
    if hmp4
      assign hero_video = hmp4.url
    endif
  endif
  assign hero_auto = false
  assign use_chosen = true
  if section.settings.hero_source == 'auto'
    assign use_chosen = false
  endif
  if section.settings.image == blank and section.settings.image_ext == blank
    assign use_chosen = false
  endif
  if use_chosen == false and featured
    assign second_handle = handles[1]
    for p in collections.all.products
      if p.handle == second_handle and p.featured_image
        assign hero_auto = p.featured_image
        break
      endif
    endfor
    if hero_auto == false
      if featured.images.size > 1
        assign hero_auto = featured.images[1]
      else
        assign hero_auto = featured.featured_image
      endif
    endif
  endif
-%}

{%- if gfont_list.size > 0 -%}
  {%- capture gf_query -%}{%- for f in gfont_list -%}{%- unless forloop.first -%}&{%- endunless -%}family={{ f | replace: ' ', '+' }}{%- endfor -%}{%- endcapture -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ gf_query }}&display=swap">
{%- endif -%}
{%- if ffile_list.size > 0 -%}
  <style>
  {%- for f in ffile_list -%}
    {%- assign fp = f | split: '¦' -%}
    {%- liquid
      assign ff_fmt = 'woff2'
      if fp[1] contains '.ttf'
        assign ff_fmt = 'truetype'
      elsif fp[1] contains '.otf'
        assign ff_fmt = 'opentype'
      elsif fp[1] contains '.woff2'
        assign ff_fmt = 'woff2'
      elsif fp[1] contains '.woff'
        assign ff_fmt = 'woff'
      endif
    -%}
    @font-face{font-family:'{{ fp[0] }}';src:url('{{ fp[1] }}') format('{{ ff_fmt }}');font-weight:{{ fp[2] | default: 400 }};font-display:swap}
  {%- endfor -%}
  </style>
{%- endif -%}

{% render 'section-look', section: section, mode: 'hero' %}
{%- liquid
  case section.settings.hero_height
    when 'short'
      assign mc_h = '44vh'
      assign mc_hm = '40vh'
    when 'tall'
      assign mc_h = '78vh'
      assign mc_hm = '60vh'
    when 'full'
      assign mc_h = '100vh'
      assign mc_hm = '100svh'
    else
      assign mc_h = 'max(460px,60vh)'
      assign mc_hm = 'max(340px,50vh)'
  endcase
  assign mc_dim = section.settings.hero_dim | default: 52 | divided_by: 100.0
  assign mc_featured = section.settings.show_featured
  assign mc_style = 'aspect-ratio:' | append: section.settings.card_shape | default: '16/10'
-%}
<section class="page-hero ph-sized ph-pos-{{ section.settings.hero_words | default: 'base-left' }} ph-scrim-{{ section.settings.hero_scrim | default: 'corner' }}" style="--ph-h:{{ mc_h }};--ph-hm:{{ mc_hm }};--ph-dim:{{ mc_dim }}">
  {%- if hero_video != blank -%}
    <video class="page-hero-video" src="{{ hero_video }}" autoplay muted loop playsinline preload="metadata" aria-hidden="true"{% if section.settings.image %} poster="{{ section.settings.image | image_url: width: 1920, height: 1080, crop: 'center' }}"{% endif %}></video>
  {%- elsif use_chosen and section.settings.image -%}
    <img src="{{ section.settings.image | image_url: width: 1920, height: 1080, crop: 'center' }}" alt="" loading="eager" width="1920" height="1080">
  {%- elsif use_chosen and section.settings.image_ext != blank -%}
    <img src="{% render 'ext-variant', src: section.settings.image_ext, w: 1920, h: 1080 %}" alt="" loading="eager" width="1920" height="1080">
  {%- elsif hero_auto -%}
    <img src="{{ hero_auto | image_url: width: 1920, height: 1080, crop: 'center' }}" alt="" loading="eager" width="1920" height="1080">
  {%- endif -%}
  <div class="page-hero-ov"></div>
  <div class="page-hero-content inner">
    {%- liquid
      # The Sold collection is served by these same settings, so its hero takes the
      # collection's own words rather than the For Sale label and heading.
      assign hero_label = section.settings.label | default: collection.title
      assign hero_heading = section.settings.heading_html | default: collection.title
      unless show_rich
        assign hero_label = collection.title
        assign hero_heading = collection.title
      endunless
    -%}
    {%- if section.settings.show_label -%}<div class="slabel slabel-dark">{{ hero_label }}</div>{%- endif -%}
    <h1 class="page-h">{{ hero_heading }}</h1>
    {%- if section.settings.show_intro -%}<p class="page-hero-sub">{{ intro }}</p>{%- endif -%}
  </div>
</section>

{%- if show_rich and section.settings.show_toolbar -%}
<div class="prop-toolbar">
  <div class="prop-toolbar-inner">
    <span class="ptool-l">{{ section.settings.refine_label }}</span>
    {%- if section.settings.show_filter_suburb != false -%}
    <select class="ptool-sel" id="fSuburb" aria-label="Filter by suburb">
      <option value="">{{ section.settings.all_suburbs }}</option>
      {%- for s in suburb_list -%}
        {%- assign st = s | strip -%}
        {%- if st != blank -%}<option value="{{ st | escape }}">{{ st }}</option>{%- endif -%}
      {%- endfor -%}
    </select>
    {%- endif -%}
    {%- if section.settings.show_filter_beds != false and bed_list.size > 0 -%}
    <select class="ptool-sel" id="fBeds" aria-label="Minimum bedrooms">
      <option value="">{{ section.settings.filter_any_beds | default: "Any Bedrooms" }}</option>
      {%- for v in bed_list -%}<option value="{{ v }}">{{ v }}+ Bed</option>{%- endfor -%}
    </select>
    {%- endif -%}
    {%- if section.settings.show_filter_baths != false and bath_list.size > 0 -%}
    <select class="ptool-sel" id="fBaths" aria-label="Minimum bathrooms">
      <option value="">{{ section.settings.filter_any_baths | default: "Any Bathrooms" }}</option>
      {%- for v in bath_list -%}<option value="{{ v }}">{{ v }}+ Bath</option>{%- endfor -%}
    </select>
    {%- endif -%}
    {%- if section.settings.show_filter_garage != false and car_list.size > 0 -%}
    <select class="ptool-sel" id="fCars" aria-label="Minimum garage spaces">
      <option value="">{{ section.settings.filter_any_garage | default: "Any Garage" }}</option>
      {%- for v in car_list -%}<option value="{{ v }}">{{ v }}+ Cars</option>{%- endfor -%}
    </select>
    {%- endif -%}
    {%- if section.settings.show_filter_land != false -%}
    <select class="ptool-sel" id="fLand" aria-label="Land size">
      <option value="">{{ section.settings.filter_any_land | default: "Any Land Size" }}</option>
      {%- if land_small -%}<option value="0-600">Up to 600m&sup2;</option>{%- endif -%}
      {%- if land_mid -%}<option value="600-800">600&ndash;800m&sup2;</option>{%- endif -%}
      {%- if land_big -%}<option value="800-">800m&sup2;+</option>{%- endif -%}
    </select>
    {%- endif -%}
    {%- if section.settings.show_filter_build != false and has_build -%}
    <select class="ptool-sel" id="fBuild" aria-label="Build size">
      <option value="">{{ section.settings.filter_any_build | default: "Any Build Size" }}</option>
      <option value="0-450">Up to 450m&sup2;</option>
      <option value="450-600">450&ndash;600m&sup2;</option>
      <option value="600-">600m&sup2;+</option>
    </select>
    {%- endif -%}
    {%- if section.settings.show_filter_status != false and status_list.size > 1 -%}
    <select class="ptool-sel" id="fStatus" aria-label="Status">
      <option value="">{{ section.settings.filter_any_status | default: "Any Status" }}</option>
      {%- for s in status_list -%}
        {%- assign st = s | strip -%}
        {%- if st == blank -%}{%- continue -%}{%- endif -%}
        <option value="{{ st | escape }}">{% if st == 'For Sale' and settings.label_for_sale != blank %}{{ settings.label_for_sale }}{% else %}{{ st }}{% endif %}</option>
      {%- endfor -%}
    </select>
    {%- endif -%}
    {%- if section.settings.show_sort != false -%}
    <select class="ptool-sel" id="fSort" aria-label="Sort properties">
      <option value="featured">{{ section.settings.sort_featured_label | default: "Sort - Featured" }}</option>
      <option value="land">{{ section.settings.filter_land_label | default: "Land Size" }}</option>
      <option value="beds">{{ section.settings.sort_beds_label | default: "Bedrooms" }}</option>
      <option value="cars">{{ section.settings.filter_garage_label | default: "Garage Spaces" }}</option>
      {%- if has_year -%}<option value="year">{{ section.settings.sort_newest_label | default: "Newest" }}</option>{%- endif -%}
      <option value="name">{{ section.settings.sort_name_label | default: "Name A–Z" }}</option>
    </select>
    {%- endif -%}
    <div class="ptool-end">
      <button type="button" class="ptool-clear" id="fClear" hidden>{{ section.settings.clear_label | default: "Clear filters" }}</button>
      <span class="ptool-count" id="fCount"></span>
    </div>
    {%- comment -%} Features read as a dropdown like the rest of the toolbar, with a
        box beside each one so several can be chosen (Naomi, 11 Sep 2026). {%- endcomment -%}
    {%- if section.settings.show_filter_features != false and feats_all != blank -%}
    <details class="ptool-drop" data-feat-drop>
      <summary class="ptool-sel ptool-sel-drop" aria-label="{{ section.settings.features_label | default: 'Features' | escape }}">
        <span data-feat-summary>{{ section.settings.filter_any_features | default: "Any Features" }}</span>
      </summary>
      <div class="ptool-menu" role="group" aria-label="{{ section.settings.features_label | default: 'Features' | escape }}">
        {%- if feats_all contains 'pool' -%}<label class="ptool-opt"><input type="checkbox" data-feat="pool"><span>{{ section.settings.chip_pool | default: "Pool" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'views' -%}<label class="ptool-opt"><input type="checkbox" data-feat="views"><span>{{ section.settings.chip_views | default: "City Views" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'lift' -%}<label class="ptool-opt"><input type="checkbox" data-feat="lift"><span>{{ section.settings.chip_lift | default: "Lift" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'cinema' -%}<label class="ptool-opt"><input type="checkbox" data-feat="cinema"><span>{{ section.settings.chip_cinema | default: "Cinema" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'gym' -%}<label class="ptool-opt"><input type="checkbox" data-feat="gym"><span>{{ section.settings.chip_gym | default: "Gym" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'cellar' -%}<label class="ptool-opt"><input type="checkbox" data-feat="cellar"><span>{{ section.settings.chip_cellar | default: "Cellar" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'study' -%}<label class="ptool-opt"><input type="checkbox" data-feat="study"><span>{{ section.settings.chip_study | default: "Study" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'solar' -%}<label class="ptool-opt"><input type="checkbox" data-feat="solar"><span>{{ section.settings.chip_solar | default: "Solar and Battery" }}</span></label>{%- endif -%}
        {%- if feats_all contains 'butler' -%}<label class="ptool-opt"><input type="checkbox" data-feat="butler"><span>{{ section.settings.chip_butler | default: "Butler's Pantry" }}</span></label>{%- endif -%}
      </div>
    </details>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- if show_rich and section.settings.show_intro_band != false -%}
{%- liquid
  assign ib_heading = section.settings.intro_band_heading | replace: count_token, count_word
  if ib_heading == blank
    if count == 1
      assign ib_heading = count_word | append: ' residence, <em>inner Brisbane</em>.'
    else
      assign ib_heading = count_word | append: ' residences, <em>inner Brisbane</em>.'
    endif
  endif
  assign ib_suburbs = suburb_list | join: ' · '
-%}
<section class="mc-intro">
  <div class="inner mc-intro-grid">
    <div>
      {%- if section.settings.intro_band_label != blank -%}<div class="slabel reveal">{{ section.settings.intro_band_label }}</div>{%- endif -%}
      <h2 class="mc-intro-h reveal d1">{{ ib_heading }}</h2>
    </div>
    <div class="mc-intro-side">
      {%- if section.settings.intro_band_text != blank -%}<p class="mc-intro-p reveal d2">{{ section.settings.intro_band_text }}</p>{%- endif -%}
      {%- if section.settings.intro_band_suburbs != false and ib_suburbs != blank -%}<div class="mc-intro-suburbs reveal d3">{{ ib_suburbs }}</div>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- if show_rich -%}
{%- if featured and mc_featured -%}
  {%- assign fmf = featured.metafields.custom -%}
  {%- capture fstatus -%}{% render 'residence-status', product: featured %}{%- endcapture -%}
  {%- if fstatus == 'For Sale' and settings.label_for_sale != blank -%}{%- assign fstatus = settings.label_for_sale -%}{%- endif -%}
  <section style="padding:clamp(40px,5vw,64px) var(--page-pad) 0;background:var(--bg)" id="featuredWrap">
    <div class="inner">
      <a href="{{ featured.url }}" class="reveal" style="display:block;position:relative;overflow:hidden;height:min({{ section.settings.featured_height | default: 680 }}px,clamp(400px,52vw,680px));cursor:pointer;text-decoration:none">
        {%- if featured.featured_image -%}
          <img src="{{ featured.featured_image | image_url: width: 1600, height: 900, crop: 'center' }}" alt="{{ featured.title | escape }}" width="1600" height="900" loading="eager" fetchpriority="high"
               style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.98) saturate(.96);transition:filter .7s,transform .7s">
        {%- endif -%}
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(var(--dark-rgb),.88) 0%,rgba(var(--dark-rgb),.1) 50%,transparent 100%);transition:opacity .4s"></div>
        <div style="position:absolute;bottom:0;left:0;right:0;padding:clamp(28px,4vw,52px)">
          <div style="display:inline-flex;align-items:center;gap:6px;margin-bottom:10px">
            <div style="width:5px;height:5px;border-radius:50%;background:var(--gold2);{% if fstatus == 'For Sale' or fstatus == settings.label_for_sale %}animation:pulse 2s ease-in-out infinite;{% endif %}flex-shrink:0"></div>
            <span style="font-size:10.5px;font-weight:400;letter-spacing:.26em;text-transform:uppercase;color:var(--gold2)">{{ fstatus }}</span>
          </div>
          <div style="font-family:var(--font-d);font-size:calc(var(--t-display)*var(--s-h,1));font-weight:300;line-height:.88;letter-spacing:-.04em;color:var(--white);margin-bottom:10px">{{ featured.title }}</div>
          <div style="font-size:11.5px;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:rgba(var(--white-rgb),.78);margin-bottom:18px">{{ fmf.suburb.value }}, {{ fmf.state.value | default: 'QLD' }}</div>
          {%- if section.settings.featured_specs -%}
          <div style="display:flex;gap:18px;flex-wrap:wrap">
            <span style="font-size:11px;font-weight:400;letter-spacing:.08em;color:rgba(var(--white-rgb),.82)">{{ fmf.beds.value }} Bed</span>
            <span style="font-size:11px;color:rgba(var(--white-rgb),.45)">&middot;</span>
            <span style="font-size:11px;font-weight:400;letter-spacing:.08em;color:rgba(var(--white-rgb),.82)">{{ fmf.baths.value }} Bath</span>
            <span style="font-size:11px;color:rgba(var(--white-rgb),.45)">&middot;</span>
            <span style="font-size:11px;font-weight:400;letter-spacing:.08em;color:rgba(var(--white-rgb),.82)">{{ fmf.cars.value }} Garage</span>
            <span style="font-size:11px;color:rgba(var(--white-rgb),.45)">&middot;</span>
            <span style="font-size:11px;font-weight:400;letter-spacing:.08em;color:rgba(var(--white-rgb),.82)">{{ fmf.land.value }}m&sup2;{% if fmf.land_over.value %}+{% endif %}</span>
          </div>
          {%- endif -%}
        </div>
        <div style="position:absolute;top:clamp(18px,3vw,32px);right:clamp(18px,3vw,32px);width:44px;height:44px;border:1px solid rgba(var(--gold2-rgb),.45);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold2);font-size:16px">&rarr;</div>
      </a>
    </div>
  </section>
{%- endif -%}
{%- endif -%}

<section style="padding:clamp(8px,1vw,10px) var(--page-pad) 0;background:var(--bg);--pgc-cols:{{ section.settings.columns | default: '3' }};--pgc-gap:{{ section.settings.gap | default: 10 }}px">
  <div class="inner">
    <div class="proj-grid-3 mc-grid" id="propGrid" {% unless show_rich and mc_featured %}style="padding-top:clamp(32px,4vw,56px)"{% endunless %}>
      {%- for h in handles -%}
        {%- assign delay = forloop.index0 | modulo: 3 -%}
        {%- assign is_first = forloop.first -%}
        {%- assign order = forloop.index -%}
        {%- for product in collections.all.products -%}
        {%- if product.handle != h -%}{%- continue -%}{%- endif -%}
        {%- assign mfp = product.metafields.custom -%}
        {%- capture pstatus -%}{% render 'residence-status', product: product %}{%- endcapture -%}
        {%- capture pfeats -%}{% render 'residence-feats', product: product %}{%- endcapture -%}
        <div
          data-prop-card
          {% if show_rich and is_first and mc_featured %}data-featured="1" style="display:none"{% endif %}
          data-suburb="{{ mfp.suburb.value | escape }}"
          data-cars="{{ mfp.cars.value }}"
          data-land="{{ mfp.land.value }}"
          data-build="{{ mfp.build_size.value }}"
          data-beds="{{ mfp.beds.value }}"
          data-baths="{{ mfp.baths.value }}"
          data-status="{{ pstatus | escape }}"
          data-feats="{{ pfeats }}"
          data-year="{{ mfp.year.value }}"
          data-name="{{ product.title | escape }}"
          data-order="{{ order }}"
        >
          {%- if pstatus contains 'Sold' -%}
            {% render 'sold-card', product: product, class: 'reveal-wipe', img_w: 800, img_h: 500, show_suburb: true %}
          {%- elsif delay == 1 -%}
            {% render 'property-card', product: product, class: 'reveal d1', style: mc_style, img_w: 900, img_h: 562, show_cars: section.settings.show_cars, show_land: section.settings.show_land %}
          {%- elsif delay == 2 -%}
            {% render 'property-card', product: product, class: 'reveal d2', style: mc_style, img_w: 900, img_h: 562, show_cars: section.settings.show_cars, show_land: section.settings.show_land %}
          {%- else -%}
            {% render 'property-card', product: product, class: 'reveal', style: mc_style, img_w: 900, img_h: 562, show_cars: section.settings.show_cars, show_land: section.settings.show_land %}
          {%- endif -%}
        </div>
        {%- break -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <p id="fEmpty" style="display:none;padding:56px 0;text-align:center;font-family:var(--font-d);font-size:calc(var(--t-h3)*var(--s-h,1));font-weight:300;font-style:italic;color:var(--taupe-d)">{{ section.settings.empty_text }}</p>
  </div>
</section>

{%- if show_rich and section.settings.show_sold_band and sold_handles.size > 0 -%}
  <section style="padding:clamp(64px,8vw,100px) var(--page-pad) clamp(80px,10vw,120px);background:var(--bg)">
    <div class="inner">
      <div class="slabel reveal" style="margin-bottom:32px">{{ section.settings.sold_label }}</div>
      <div class="proj-grid-sold" style="margin-top:0">
        {%- for h in sold_handles -%}
          {%- assign sdelay = forloop.index0 | modulo: 2 -%}
          {%- for product in collections.all.products -%}
            {%- if product.handle != h -%}{%- continue -%}{%- endif -%}
            {%- if sdelay == 1 -%}
              {% render 'sold-card', product: product, class: 'reveal d1', img_w: 900, img_h: 560 %}
            {%- else -%}
              {% render 'sold-card', product: product, class: 'reveal', img_w: 900, img_h: 560 %}
            {%- endif -%}
            {%- break -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- if show_rich and section.settings.show_how != false -%}
{%- liquid
  # The four steps are numbered settings (how1_title … how4_text); a step
  # with an empty title is left out and the track closes up.
  assign how_delays = ',d1,d2,d3' | split: ','
  assign how_n = 0
  for i in (1..4)
    assign tkey = 'how' | append: i | append: '_title'
    if section.settings[tkey] != blank
      assign how_n = how_n | plus: 1
    endif
  endfor
-%}
{%- if how_n > 0 -%}
<section class="mc-how">
  <div class="inner">
    {%- if section.settings.how_label != blank -%}<div class="slabel reveal mc-how-l">{{ section.settings.how_label }}</div>{%- endif -%}
    <div class="proc-track" style="--proc-cols:{{ how_n }};--proc-n:44px">
      {%- assign how_i = 0 -%}
      {%- for i in (1..4) -%}
        {%- assign tkey = 'how' | append: i | append: '_title' -%}
        {%- assign dkey = 'how' | append: i | append: '_text' -%}
        {%- if section.settings[tkey] == blank -%}{%- continue -%}{%- endif -%}
        <div class="proc-step reveal {{ how_delays[how_i] }}">
          <div class="proc-n">{{ how_i | plus: 1 }}</div>
          <div class="proc-t">{{ section.settings[tkey] }}</div>
          {%- if section.settings[dkey] != blank -%}<div class="proc-d">{{ section.settings[dkey] }}</div>{%- endif -%}
        </div>
        {%- assign how_i = how_i | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{%- endif -%}

{%- if section.settings.show_cta -%}
<section class="sp" style="background:var(--bg2);border-top:1px solid var(--border);text-align:center">
  <div class="inner-sm">
    {%- if section.settings.cta_label != blank -%}<div class="slabel reveal" style="justify-content:center;margin-bottom:20px">{{ section.settings.cta_label }}</div>{%- endif -%}
    <h2 class="reveal d1" style="font-family:var(--font-d);font-size:calc(clamp(32px,5vw,64px)*var(--s-h,1));font-weight:300;color:var(--ink);margin-bottom:20px;letter-spacing:-.02em">{{ section.settings.cta_heading_html }}</h2>
    {%- if section.settings.cta_text != blank -%}<p class="reveal d2" style="font-size:calc(13px*var(--s-t,1));font-weight:300;color:var(--ink3);max-width:420px;margin:0 auto 36px;line-height:1.85">{{ section.settings.cta_text }}</p>{%- endif -%}
    <div class="reveal d3 mc-cta-row" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      {%- if section.settings.show_cta1 and section.settings.cta1_label != blank -%}<a href="{{ section.settings.cta1_link | default: '/pages/contact?interest=Request%20a%20Viewing' }}" class="btn-p">{{ section.settings.cta1_label }} &rarr;</a>{%- endif -%}
      {%- if section.settings.show_cta2 and section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link | default: '/pages/contact?interest=Agent%20Access' }}" class="btn-g">{{ section.settings.cta2_label }}</a>{%- endif -%}
      {%- if section.settings.show_cta3 and section.settings.cta3_label != blank and settings.guided_match_enabled != false -%}<a href="{{ section.settings.cta3_link | default: '/pages/find-your-home' }}" class="btn-g btn-g-gold">{{ section.settings.cta3_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

