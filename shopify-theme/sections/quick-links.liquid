{%- comment -%}
  "You may also be interested in" - the tag/title/description link cards.
{%- endcomment -%}
<section class="sp-sm" style="background:var(--bg2);border-top:1px solid var(--border)">
  <div class="inner">
    <div class="slabel reveal" style="margin-bottom:32px">{{ section.settings.label }}</div>
    <div class="quick-links-grid">
      {%- assign qdelays = ',d1,d2' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- assign di = forloop.index0 | modulo: 3 -%}
        <a href="{{ block.settings.link }}" class="reveal {{ qdelays[di] }}" style="display:block;padding:32px;background:var(--white);border:1px solid var(--border);transition:border-color .3s;text-decoration:none" {{ block.shopify_attributes }}>
          <div style="font-size:10px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:var(--ink);margin-bottom:10px">{{ block.settings.tag }}</div>
          <div style="font-family:var(--font-d);font-size:22px;font-weight:300;color:var(--ink);margin-bottom:8px">{{ block.settings.title }}</div>
          <div style="font-size:12px;font-weight:300;color:var(--ink3)">{{ block.settings.desc }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .quick-links-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  @media(max-width:900px){.quick-links-grid{grid-template-columns:1fr}}
</style>

{% schema %}
{
  "name": "Quick links",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "You May Also Be Interested In" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link card",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "desc", "label": "Description" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Quick links" }]
}
{% endschema %}
