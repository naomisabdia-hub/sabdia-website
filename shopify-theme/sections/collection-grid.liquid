{%- comment -%}
  The residences - the featured banner and the grid of residence cards on
  the For Sale page, automatic or hand-picked with Residence blocks. The
  refine toolbar (its own section) filters and sorts this grid; the filter
  script lives here.

  Split out of the all-in-one Collection grid section on 14 Sep 2026 so each
  part of the For Sale page has its own panel in the customizer (Naomi:
  "have the header its settings, then the Now Selling, then each individual
  grid has their setting"). Real photographs and real footage only, never
  generated.
{%- endcomment -%}
{%- liquid
  capture list_csv
    render 'collection-handles', collection: collection
  endcapture
  assign handles = list_csv | split: ','
  assign count = handles.size
  assign show_rich = true
  if collection.handle == 'sold'
    assign show_rich = false
  endif
-%}
{%- liquid
  # Hand-picked residences (Residence blocks) replace the automatic list, in
  # block order. Each residence's own Status still decides how its card reads.
  # The same template serves /collections/sold: there the blocks (the For
  # Sale cards) step aside and the sold list stays automatic.
  assign picked = false
  if section.blocks.size > 0 and show_rich
    assign picked = true
    assign list_csv = ''
    for block in section.blocks
      assign gb_res = block.settings.page | default: block.settings.product
      if gb_res == blank
        continue
      endif
      assign list_csv = list_csv | append: gb_res.handle | append: ','
    endfor
    assign handles = list_csv | split: ','
    assign count = handles.size
  endif
  assign featured = false
  assign first_handle = handles.first
  # The residence's page leads (15 Sep 2026); one still only in Products is found there.
  if first_handle != blank and pages[first_handle] != blank
    assign featured = pages[first_handle]
  else
    for p in collections.all.products
      if p.handle == first_handle
        assign featured = p
        break
      endif
    endfor
  endif
  # Every distinct brochure face to load, so a card can set its name in it.
  assign gfonts = ''
  assign ffiles = ''
  for h in handles
    assign fp_res = pages[h]
    if fp_res == blank
      for cand in collections.all.products
        if cand.handle == h
          assign fp_res = cand
          break
        endif
      endfor
    endif
    if fp_res == blank
      continue
    endif
    for p in (1..1)
      assign pm = fp_res.metafields.custom
      assign pf = pm.name_font.value | strip
      assign pff = pm.name_font_file.value | strip
      assign pfw = pm.name_font_weight.value | default: 400
      if pff != blank
        assign pfam = pf
        if pfam == blank
          assign pfam = 'ResidenceFace-' | append: fp_res.handle
        endif
        assign ffiles = ffiles | append: pfam | append: '¦' | append: pff | append: '¦' | append: pfw | append: '||'
      elsif pf != blank
        assign gfonts = gfonts | append: pf | append: ':wght@' | append: pfw | append: '||'
      endif
      break
    endfor
  endfor
  assign gfont_list = gfonts | split: '||' | uniq
  assign ffile_list = ffiles | split: '||' | uniq
  assign mc_featured = section.settings.show_featured
  assign mc_style = 'aspect-ratio:' | append: section.settings.card_shape | default: '16/10'
  # Card words (17 Sep 2026): the chips on the banner and on every card,
  # from Card words in this section's panel.
  assign w_bed = section.settings.word_bed | default: 'Bed'
  assign w_bath = section.settings.word_bath | default: 'Bath'
  assign w_garage = section.settings.word_garage | default: 'Garage'
  assign w_area = section.settings.unit_area | default: 'm²'
  assign w_build = section.settings.word_build | default: 'build'
  assign w_land = section.settings.word_land | default: 'land'
  assign w_over = section.settings.mark_land_over | default: '+'
  assign w_tip_build = section.settings.tip_build | default: 'Build size'
  assign w_tip_land = section.settings.tip_land | default: 'Land size'
  assign w_state = section.settings.loc_state | default: ', QLD'
  # The first Residence block's own words and photo lead the featured
  # banner too (15 Sep 2026): anything typed on the block replaces the
  # residence's line there as on its card.
  assign fb = false
  if picked
    for block in section.blocks
      assign fb_res = block.settings.page | default: block.settings.product
      if fb_res != blank
        assign fb = block.settings
        break
      endif
    endfor
  endif
-%}

{%- if gfont_list.size > 0 -%}
  {%- capture gf_query -%}{%- for f in gfont_list -%}{%- unless forloop.first -%}&{%- endunless -%}family={{ f | replace: ' ', '+' }}{%- endfor -%}{%- endcapture -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ gf_query }}&display=swap">
{%- endif -%}
{%- if ffile_list.size > 0 -%}
  <style>
  {%- for f in ffile_list -%}
    {%- assign fp = f | split: '¦' -%}
    {%- liquid
      assign ff_fmt = 'woff2'
      if fp[1] contains '.ttf'
        assign ff_fmt = 'truetype'
      elsif fp[1] contains '.otf'
        assign ff_fmt = 'opentype'
      elsif fp[1] contains '.woff2'
        assign ff_fmt = 'woff2'
      elsif fp[1] contains '.woff'
        assign ff_fmt = 'woff'
      endif
    -%}
    @font-face{font-family:'{{ fp[0] }}';src:url('{{ fp[1] }}') format('{{ ff_fmt }}');font-weight:{{ fp[2] | default: 400 }};font-display:swap}
  {%- endfor -%}
  </style>
{%- endif -%}

{%- if show_rich -%}
{%- if featured and mc_featured -%}
  {%- assign fmf = featured.metafields.custom -%}
  {%- capture fstatus -%}{% render 'residence-status', product: featured %}{%- endcapture -%}
  {%- liquid
    if fb and fb.status != blank
      assign fstatus = fb.status | strip
    endif
    assign f_img = featured.featured_image
    if f_img == blank
      # A residence page has no product photo: its main photo by name in Content › Files.
      assign f_hero = featured.handle | append: '-hero.jpg'
      assign f_img = images[f_hero]
    endif
    assign f_url = featured.url
    assign f_focus = 'center'
    assign f_suburb = fmf.suburb.value | append: ', ' | append: fmf.state.value | default: 'QLD'
    if fmf.state.value == blank
      assign f_suburb = fmf.suburb.value | append: w_state
    endif
    assign f_beds = fmf.beds.value
    assign f_baths = fmf.baths.value
    assign f_cars = fmf.cars.value
    assign f_build = fmf.build_size.value
    assign f_land = fmf.land.value | append: w_area
    if fmf.land_over.value
      assign f_land = f_land | append: w_over
    endif
    if fb
      if fb.image
        assign f_img = fb.image
      endif
      if fb.link != blank
        assign f_url = fb.link
      endif
      assign f_focus = fb.focus | default: 'center'
      if fb.suburb != blank
        assign f_suburb = fb.suburb
      endif
      if fb.beds != blank
        assign f_beds = fb.beds
      endif
      if fb.baths != blank
        assign f_baths = fb.baths
      endif
      if fb.cars != blank
        assign f_cars = fb.cars
      endif
      if fb.build != blank
        assign f_build = fb.build
      endif
      if fb.land != blank
        assign f_land = fb.land | append: w_area
      endif
    endif
  -%}
  {%- if fstatus == 'For Sale' and settings.label_for_sale != blank -%}{%- assign fstatus = settings.label_for_sale -%}{%- endif -%}
  <section style="padding:clamp(40px,5vw,64px) var(--page-pad) 0;background:var(--bg)" id="featuredWrap">
    <div class="inner">
      <a href="{{ f_url }}" class="reveal" style="display:block;position:relative;overflow:hidden;height:min({{ section.settings.featured_height | default: 680 }}px,clamp(400px,52vw,680px));cursor:pointer;text-decoration:none{% unless f_img %};background:var(--dark){% endunless %}">
        {%- comment -%} No photo on the block or the residence (15 Sep 2026): the banner stands on the dark ground, never a pale empty frame under white words. {%- endcomment -%}
        {%- if f_img -%}
          <img src="{{ f_img | image_url: width: 1600, height: 900, crop: f_focus }}" alt="{{ featured.title | escape }}" width="1600" height="900" loading="eager" fetchpriority="high"
               style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.98) saturate(.96);transition:filter .7s,transform .7s">
        {%- endif -%}
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(var(--dark-rgb),.88) 0%,rgba(var(--dark-rgb),.1) 50%,transparent 100%);transition:opacity .4s"></div>
        <div style="position:absolute;bottom:0;left:0;right:0;padding:clamp(28px,4vw,52px)">
          <div style="display:inline-flex;align-items:center;gap:6px;margin-bottom:10px">
            <div style="width:5px;height:5px;border-radius:50%;background:var(--gold2);{% if fstatus == 'For Sale' or fstatus == settings.label_for_sale %}animation:pulse 2s ease-in-out infinite;{% endif %}flex-shrink:0"></div>
            <span style="font-size:10.5px;font-weight:400;letter-spacing:.26em;text-transform:uppercase;color:var(--gold2)">{{ fstatus }}</span>
          </div>
          {%- liquid
            assign fb_nf = fmf.name_font.value | strip
            assign fb_nff = fmf.name_font_file.value | strip
            assign fb_name = featured.title
            assign fb_font = 'var(--font-d)'
            assign fb_caps = ''
            if fb_nf != blank or fb_nff != blank
              assign fb_fam = fb_nf
              if fb_fam == blank
                assign fb_fam = 'ResidenceFace-' | append: featured.handle
              endif
              assign fb_font = "'" | append: fb_fam | append: "',var(--font-d)"
              capture fb_scale
                render 'residence-face-scale', product: featured
              endcapture
              if fmf.name_font_caps.value
                assign fb_caps = ';text-transform:uppercase'
              else
                assign fb_name = featured.title | downcase | capitalize
              endif
            endif
            if fb and fb.name != blank
              assign fb_name = fb.name
            endif
          -%}
          <div style="font-family:{{ fb_font }};font-size:calc(var(--t-display)*var(--s-h,1)*{{ fb_scale | default: 1 | strip }});font-weight:{{ fmf.name_font_weight.value | default: 300 }};line-height:.95;letter-spacing:0;color:var(--white);margin-bottom:10px{{ fb_caps }}">{{ fb_name }}</div>
          <div style="font-size:11.5px;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:rgba(var(--white-rgb),.78);margin-bottom:18px">{{ f_suburb }}</div>
          {%- if section.settings.featured_specs -%}
          {%- comment -%} The same chips as the cards below, so the featured residence matches (Naomi, 15 Sep 2026). {%- endcomment -%}
          <ul class="pc-specs" style="margin-top:0">
            {%- if f_beds != blank -%}<li class="pc-spec">{% render 'spec-icon', icon: 'beds' %}<span>{{ f_beds }} {{ w_bed }}</span></li>{%- endif -%}
            {%- if f_baths != blank -%}<li class="pc-spec">{% render 'spec-icon', icon: 'baths' %}<span>{{ f_baths }} {{ w_bath }}</span></li>{%- endif -%}
            {%- if f_cars != blank -%}<li class="pc-spec">{% render 'spec-icon', icon: 'cars' %}<span>{{ f_cars }} {{ w_garage }}</span></li>{%- endif -%}
            {%- if f_build != blank -%}<li class="pc-spec" title="{{ w_tip_build | escape }}">{% render 'spec-icon', icon: 'house' %}<span>{{ f_build }}{{ w_area }}<span class="pc-spec-k"> {{ w_build }}</span></span></li>{%- endif -%}
            {%- if f_land != w_area -%}<li class="pc-spec" title="{{ w_tip_land | escape }}">{% render 'spec-icon', icon: 'land' %}<span>{{ f_land }}<span class="pc-spec-k"> {{ w_land }}</span></span></li>{%- endif -%}
          </ul>
          {%- endif -%}
        </div>
        <div style="position:absolute;top:clamp(18px,3vw,32px);right:clamp(18px,3vw,32px);width:44px;height:44px;border:1px solid rgba(var(--gold2-rgb),.45);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--gold2);font-size:16px">&rarr;</div>
      </a>
    </div>
  </section>
{%- endif -%}
{%- endif -%}

<section class="mc-grid-sec" style="padding:clamp(8px,1vw,10px) var(--page-pad) var(--mcg-pb,0);background:var(--bg);--pgc-cols:{{ section.settings.columns | default: '3' }};--pgc-gap:{{ section.settings.gap | default: 10 }}px;--pc-status:{{ section.settings.card_status_size | default: 100 | divided_by: 100.0 }};--pc-name-scale:{{ section.settings.card_name_size | default: 100 | divided_by: 100.0 }};--pc-chip:{{ section.settings.card_chip_size | default: 100 | divided_by: 100.0 }}">
  <div class="inner">
    <div class="proj-grid-3 mc-grid" id="propGrid" {% unless show_rich and mc_featured %}style="padding-top:clamp(32px,4vw,56px)"{% endunless %}>
      {%- if picked -%}
        {%- assign gi = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign gb_res = block.settings.page | default: block.settings.product -%}
          {%- if gb_res == blank -%}{%- continue -%}{%- endif -%}
          {%- assign gi = gi | plus: 1 -%}
          {%- assign lead = false -%}{%- if show_rich and mc_featured -%}{%- assign lead = true -%}{%- endif -%}
          {% render 'collection-card', product: gb_res, index: gi, featured: lead, style: mc_style, show_cars: section.settings.show_cars, show_land: section.settings.show_land, show_build: section.settings.show_build, image: block.settings.image, url: block.settings.link, focus: block.settings.focus, name: block.settings.name, suburb: block.settings.suburb, status: block.settings.status, beds: block.settings.beds, baths: block.settings.baths, cars: block.settings.cars, build: block.settings.build, land: block.settings.land, attrs: block.shopify_attributes, word_bed: w_bed, word_bath: w_bath, word_garage: w_garage, unit_area: w_area, word_build: w_build, word_land: w_land, mark_land_over: w_over, tip_build: w_tip_build, tip_land: w_tip_land, loc_state: w_state %}
        {%- endfor -%}
      {%- else -%}
      {%- for h in handles -%}
        {%- assign gc_res = pages[h] -%}{%- if gc_res == blank -%}{%- for cand in collections.all.products -%}{%- if cand.handle == h -%}{%- assign gc_res = cand -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
        {%- if gc_res == blank -%}{%- continue -%}{%- endif -%}
        {%- for once in (1..1) -%}
          {%- assign lead = false -%}{%- if show_rich and mc_featured -%}{%- assign lead = true -%}{%- endif -%}
          {% render 'collection-card', product: gc_res, index: forloop.parentloop.index, featured: lead, style: mc_style, show_cars: section.settings.show_cars, show_land: section.settings.show_land, show_build: section.settings.show_build, word_bed: w_bed, word_bath: w_bath, word_garage: w_garage, unit_area: w_area, word_build: w_build, word_land: w_land, mark_land_over: w_over, tip_build: w_tip_build, tip_land: w_tip_land, loc_state: w_state %}
        {%- break -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- endif -%}
    </div>
    <p id="fEmpty" style="display:none;padding:56px 0;text-align:center;font-family:var(--font-d);font-size:calc(var(--t-h3)*var(--s-h,1));font-weight:300;font-style:italic;color:var(--taupe-d)">{{ section.settings.empty_text }}</p>
  </div>
</section>
<style>
  .proj-grid-3.mc-grid{grid-template-columns:repeat(var(--pgc-cols,3),1fr);gap:var(--pgc-gap,10px)}
  /* The grid keeps its own space below (15 Sep 2026): the Sold band and How it works are off by default, so
     the last row must never sit flush on the next band. Same rhythm as every section; Look > Space below scales it. */
  .mc-grid-sec{--mcg-pb:calc(clamp(72px,9vw,132px)*var(--sp-scale,1)*var(--sp-bot,1))}
  @media(max-width:768px){.mc-grid-sec{--mcg-pb:calc(clamp(52px,10vw,80px)*var(--sp-scale,1)*var(--sp-bot,1))}}
  html.bk .mc-grid-sec{--mcg-pb:calc(clamp(52px,6.2vw,92px)*var(--sp-scale,1)*var(--sp-bot,1))}
  @media(max-width:1100px){.proj-grid-3.mc-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:768px){.proj-grid-3.mc-grid{grid-template-columns:1fr}}
</style>

<script>
  (function () {
  function initGrid() {
    var grid = document.getElementById('propGrid');
    if (!grid || grid.dataset.filterInit) return;
    grid.dataset.filterInit = '1';
    var byId = function (id) { return document.getElementById(id); };
    var suburb = byId('fSuburb');
    var beds = byId('fBeds');
    var baths = byId('fBaths');
    var cars = byId('fCars');
    var size = byId('fSize');
    var status = byId('fStatus');
    var sort = byId('fSort');
    var count = byId('fCount');
    var empty = byId('fEmpty');
    var clear = byId('fClear');
    var featuredWrap = byId('featuredWrap');
    var drop = document.querySelector('[data-feat-drop]');
    var chips = Array.prototype.slice.call(document.querySelectorAll('.ptool-opt input[data-feat]'));
    var featSummary = document.querySelector('[data-feat-summary]');
    var featAnyLabel = featSummary ? featSummary.textContent : '';
    /* Words the script writes into the toolbar, set beside No-matches text in this section's panel. */
    var featManyWord = {{ section.settings.features_many | default: 'Features' | json }};
    var countOneWord = {{ section.settings.count_one | default: 'Residence' | json }};
    var countManyWord = {{ section.settings.count_many | default: 'Residences' | json }};
    var selects = [suburb, beds, baths, cars, size, status].filter(Boolean);
    var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-prop-card]'));
    if (!selects.length && !chips.length && !sort) return;

    function val(el) { return el ? el.value : ''; }
    function inRange(raw, spec, required) {
      var n = Number(raw);
      if (!n) return !required;
      var r = spec.split('-');
      var lo = Number(r[0] || 0);
      var hi = r[1] ? Number(r[1]) : Infinity;
      return n >= lo && n < hi;
    }
    function activeFeats() {
      return chips.filter(function (c) { return c.checked; })
        .map(function (c) { return c.dataset.feat; });
    }

    function apply() {
      var feats = activeFeats();
      var sortVal = sort ? sort.value : 'featured';
      var anyFilter = feats.length > 0 || selects.some(function (el) { return !!el.value; });
      var isDefault = !anyFilter && sortVal === 'featured';
      if (featuredWrap) featuredWrap.style.display = isDefault ? '' : 'none';
      if (clear) clear.hidden = isDefault;

      var visible = 0;
      cards.forEach(function (c) {
        var ok = true;
        if (isDefault && c.dataset.featured) ok = false; // featured shown in hero block instead
        if (ok && val(suburb) && c.dataset.suburb !== suburb.value) ok = false;
        if (ok && val(beds) && Number(c.dataset.beds) < Number(beds.value)) ok = false;
        if (ok && val(baths) && Number(c.dataset.baths) < Number(baths.value)) ok = false;
        if (ok && val(cars) && Number(c.dataset.cars) < Number(cars.value)) ok = false;
        if (ok && val(size)) {
          var sz = size.value.split(':');
          if (sz[0] === 'land' && !inRange(c.dataset.land, sz[1], false)) ok = false;
          if (sz[0] === 'build' && !inRange(c.dataset.build, sz[1], true)) ok = false;
        }
        if (ok && val(status) && c.dataset.status !== status.value) ok = false;
        if (ok && feats.length) {
          var have = (c.dataset.feats || '').split(' ');
          ok = feats.every(function (f) { return have.indexOf(f) > -1; });
        }
        c.style.display = ok ? '' : 'none';
        if (ok) visible++;
        var r = c.querySelector('.reveal');
        if (r) r.classList.add('vis');
      });

      var sorted = cards.slice().sort(function (a, b) {
        var d = 0;
        if (sortVal === 'build') d = Number(b.dataset.build || 0) - Number(a.dataset.build || 0);
        else if (sortVal === 'land') d = Number(b.dataset.land) - Number(a.dataset.land);
        else if (sortVal === 'beds') d = Number(b.dataset.beds) - Number(a.dataset.beds);
        else if (sortVal === 'cars') d = Number(b.dataset.cars) - Number(a.dataset.cars);
        else if (sortVal === 'year') d = Number(b.dataset.year || 0) - Number(a.dataset.year || 0);
        else if (sortVal === 'name') d = a.dataset.name.localeCompare(b.dataset.name);
        return d || Number(a.dataset.order) - Number(b.dataset.order);
      });
      sorted.forEach(function (c) { grid.appendChild(c); });

      if (empty) empty.style.display = visible === 0 ? '' : 'none';
      if (count) count.textContent = isDefault
        ? ''
        : visible + ' ' + (visible === 1 ? countOneWord : countManyWord);
    }

    selects.concat(sort ? [sort] : []).forEach(function (el) {
      el.addEventListener('change', apply);
    });
    function featLabel() {
      if (!featSummary) return;
      var on = chips.filter(function (c) { return c.checked; });
      featSummary.textContent = on.length === 0 ? featAnyLabel
        : (on.length === 1 ? on[0].parentNode.textContent.trim() : on.length + ' ' + featManyWord);
    }
    chips.forEach(function (chip) {
      chip.addEventListener('change', function () { featLabel(); apply(); });
    });
    /* A dropdown left open over the grid gets in the way. */
    if (drop) {
      document.addEventListener('click', function (e) { if (drop.open && !drop.contains(e.target)) drop.open = false; });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && drop.open) { drop.open = false; drop.querySelector('summary').focus(); } });
    }
    if (clear) clear.addEventListener('click', function () {
      selects.forEach(function (el) { el.value = ''; });
      if (sort) sort.value = 'featured';
      chips.forEach(function (chip) { chip.checked = false; });
      featLabel();
      apply();
    });
  }
  // The toolbar is its own section and may sit anywhere on the page: wire up once everything is in the DOM.
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initGrid); } else { initGrid(); }
  })();
</script>

{% schema %}
{
  "name": "The residences",
  "settings": [
    {
      "type": "paragraph",
      "content": "The residences on the For Sale page: the featured banner and the grid of cards. One Residence block per card (⊕ Add block) - drag to reorder, the first leads as the featured banner. Click a card in the preview to open its block: its photo, crop, name, status word, location, numbers and link can each be changed there for this card only. With no blocks the grid is automatic: every residence whose Status is live, in the For Sale collection's order, with the numbers from Products › the residence."
    },
    {
      "type": "header",
      "content": "Featured residence"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Lead with the featured residence banner",
      "default": true,
      "info": "Off = the first residence sits in the grid with the others."
    },
    {
      "type": "checkbox",
      "id": "featured_specs",
      "label": "Bed · bath · garage · build · land on the banner",
      "default": true
    },
    {
      "type": "range",
      "id": "featured_height",
      "label": "Banner height, at most",
      "min": 360,
      "max": 800,
      "step": 20,
      "default": 680,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "The grid"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Cards across",
      "options": [
        {
          "value": "2",
