{%- comment -%}
  Photo gallery - the "put all my photos here" section. Drop it on any
  page from ⊕ Add section, then add one Photo block per image (up to 50).
  Structures are a dropdown; every photo opens in the same full-screen
  viewer the residence pages use (the .lb styles in style.css), with
  arrow keys, swipe-free tap targets and Escape to close.

  The viewer is scoped to this section instance so two galleries on one
  page never fight, and the script guards against ClientRouter-style
  double binding the way the rest of the theme does.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'three'
  assign sid = section.id
  assign delays = ',d1,d2,d3' | split: ','
  assign carousel = false
  if layout == 'carousel'
    assign carousel = true
  endif
  # Photos that actually exist (15 Sep 2026): a Photo block left in place
  # with its photo removed is not a photo, so it never earns arrows.
  assign pg_count = 0
  for block in section.blocks
    if block.settings.image or block.settings.image_ext != blank
      assign pg_count = pg_count | plus: 1
    endif
  endfor
-%}

{%- liquid
  assign look_designed = 'light'
  if section.settings.dark
    assign look_designed = 'dark'
  endif
-%}
{% render 'section-look', section: section, designed: look_designed %}
<section class="pg pg-{{ layout }}{% if section.settings.dark %} pg-dark{% endif %}{% if section.settings.hover_zoom == false %} pg-nozoom{% endif %}{% if section.settings.frame %} pg-frame{% endif %}{% if section.settings.align == 'centre' %} pg-centre{% endif %}{% if section.settings.caption_style == 'below' %} pg-cap-below{% endif %}{% if section.settings.lightbox == false %} pg-nolb{% endif %} pg-m{{ section.settings.columns_mobile | default: 'auto' }}" id="pg-{{ sid }}" data-gallery
         style="--pg-ar:{{ section.settings.shape | default: '4/3' }};--pg-gap:{{ section.settings.gap | default: 10 }}px;--pg-slide:{{ section.settings.slide_width | default: 72 }}%;--pg-radius:{{ section.settings.corner | default: 0 }}px">
  <div class="inner">
    {%- if section.settings.label != blank or section.settings.heading_html != blank or section.settings.text != blank -%}
      <div class="pg-hdr">
        {%- if section.settings.label != blank -%}<div class="slabel{% if section.settings.dark %} slabel-dark{% endif %} reveal">{{ section.settings.label }}</div>{%- endif -%}
        {%- if section.settings.heading_html != blank -%}<h2 class="pg-h reveal d1">{{ section.settings.heading_html }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="pg-p reveal d2">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="pg-strip"{% if carousel %} data-pg-car{% if section.settings.autoplay %} data-autoplay="{{ section.settings.autoplay_secs | default: 5 }}"{% endif %}{% endif %}>
    {%- if carousel and pg_count > 1 -%}
      <button class="pg-arrow pg-arrow-prev" type="button" aria-label="Previous photos" data-pg-prev>&larr;</button>
      <button class="pg-arrow pg-arrow-next" type="button" aria-label="Next photos" data-pg-next>&rarr;</button>
    {%- endif -%}
    <div class="pg-grid"{% if carousel %} tabindex="0" aria-label="Photo carousel - scroll sideways or use the arrows"{% endif %}>
      {%- for block in section.blocks -%}
        {%- assign di = forloop.index0 | modulo: 4 -%}
        {%- liquid
          assign thumb = blank
          assign full = blank
          assign alt = block.settings.alt | default: block.settings.caption | default: section.settings.label
          if block.settings.image
            assign thumb = block.settings.image | image_url: width: 1200
            assign full = block.settings.image | image_url: width: 2400
            if block.settings.alt == blank and block.settings.image.alt != blank
              assign alt = block.settings.image.alt
            endif
          elsif block.settings.image_ext != blank
            capture thumb
              render 'ext-variant', src: block.settings.image_ext, w: 1200, h: 900
            endcapture
            capture full
              render 'ext-variant', src: block.settings.image_ext, w: 2400, h: 1800
            endcapture
          endif
        -%}
        {%- if thumb != blank -%}
          <figure class="pg-item{% if block.settings.wide %} pg-wide{% endif %}{% if block.settings.tall %} pg-tall{% endif %} reveal-wipe {{ delays[di] }}"
                  {% if section.settings.lightbox %}data-lb-item data-src="{{ full }}" data-alt="{{ alt | escape }}" data-cap="{{ block.settings.caption | escape }}"
                  role="button" tabindex="0" aria-label="View photo: {{ alt | escape }}"{% endif %} {{ block.shopify_attributes }}>
            <img src="{{ thumb }}" alt="{{ alt | escape }}" loading="lazy" decoding="async" width="1200" height="900" style="object-position:{{ block.settings.focus | default: 'center' }}">
            {%- if block.settings.caption != blank and section.settings.show_captions -%}
              <figcaption class="pg-cap">{{ block.settings.caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    </div>

    {%- comment -%} The how-to hint shows in the editor only, also when every block's photo was removed, never to visitors (15 Sep 2026). {%- endcomment -%}
    {%- if pg_count == 0 and request.design_mode -%}
      <p class="pg-empty">Add photos with <strong>⊕ Add block → Photo</strong> in the panel on the left.</p>
    {%- endif -%}
  </div>

  {%- comment -%} Full-screen viewer - same look as the residence galleries. {%- endcomment -%}
  <div class="lb" id="lb-{{ sid }}" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <img alt="" width="1600" height="1200">
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">&larr;</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">&rarr;</button>
    <button class="lb-close" type="button" aria-label="Close">&#10005;</button>
    <div class="lb-meta"><span class="lb-cap"></span><span class="lb-count"></span></div>
  </div>
</section>

<style>
  .pg{padding:clamp(56px,7vw,104px) var(--page-pad);background:var(--bg)}
  .pg-dark{background:var(--dark)}
  .pg-hdr{max-width:720px;margin-bottom:clamp(28px,4vw,48px)}
  .pg-h{font-family:var(--font-d);font-size:calc(var(--t-h2)*var(--s-h,1));font-weight:300;line-height:1.05;letter-spacing:-.02em;color:var(--ink);margin-top:14px}
  .pg-h em{font-style:italic}
  .pg-dark .pg-h{color:var(--white)}
  .pg-dark .pg-h em{color:var(--gold2)}
  .pg-p{font-size:calc(var(--t-body)*var(--s-t,1));font-weight:300;line-height:var(--lh-body);color:var(--ink3);margin-top:16px;max-width:520px}
  .pg-dark .pg-p{color:rgba(var(--white-rgb),.6)}
  .pg-grid{display:grid;gap:var(--pg-gap,10px);grid-auto-flow:dense}
  .pg-two .pg-grid{grid-template-columns:repeat(2,1fr)}
  .pg-three .pg-grid{grid-template-columns:repeat(3,1fr)}
  .pg-four .pg-grid{grid-template-columns:repeat(4,1fr)}
  .pg-editorial .pg-grid{grid-template-columns:repeat(6,1fr)}
  .pg-item{margin:0;position:relative;overflow:hidden;aspect-ratio:var(--pg-ar,4/3);cursor:zoom-in;background:var(--bg3);border-radius:var(--pg-radius,0)}
  .pg-nolb .pg-item{cursor:default}
  .pg-nozoom .pg-item:hover img,.pg-nozoom .pg-item:focus-visible img{transform:none}
  .pg-frame .pg-item{border:1px solid var(--border)}
  .pg-centre .pg-hdr{text-align:center;margin-left:auto;margin-right:auto}.pg-centre .pg-hdr .slabel{justify-content:center}.pg-centre .pg-p{margin-left:auto;margin-right:auto}
  .pg-cap-below .pg-item{overflow:visible}
  .pg-cap-below .pg-cap{position:static;background:none;padding:10px 0 0;color:var(--taupe-d);text-transform:none;letter-spacing:.04em;font-size:12px;pointer-events:auto}
  .pg-dark.pg-cap-below .pg-cap{color:rgba(var(--white-rgb),.6)}
  @media(max-width:560px){.pg-m1 .pg-grid{grid-template-columns:1fr!important}.pg-m2 .pg-grid{grid-template-columns:repeat(2,1fr)!important}}
  .pg-dark .pg-item{background:var(--dark2)}
  .pg-editorial .pg-item{grid-column:span 2}
  .pg-editorial .pg-item:nth-child(6n+1){grid-column:span 4;aspect-ratio:16/10}
  .pg-editorial .pg-item:nth-child(6n+4){grid-column:span 3;aspect-ratio:3/2}
  .pg-editorial .pg-item:nth-child(6n+5){grid-column:span 3;aspect-ratio:3/2}
  .pg-item.pg-wide{grid-column:span 2}
  .pg-editorial .pg-item.pg-wide{grid-column:span 4}
  .pg-item.pg-tall{grid-row:span 2;aspect-ratio:auto}
  .pg-item img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.94);transition:transform 1s var(--ease),filter .5s}
  .pg-item:hover img,.pg-item:focus-visible img{transform:scale(1.035);filter:saturate(1)}
  .pg-item:focus-visible{outline:2px solid var(--gold2);outline-offset:3px}
  .pg-cap{position:absolute;left:0;right:0;bottom:0;padding:28px 14px 12px;background:linear-gradient(to top,rgba(var(--dark-rgb),.7),transparent);font-size:10px;font-weight:300;letter-spacing:.2em;text-transform:uppercase;color:rgba(var(--white-rgb),.85);pointer-events:none}
  .pg-empty{font-size:12px;color:var(--ink3);padding:36px;border:1px dashed var(--border);text-align:center}
  /* Carousel structure - a sideways strip that snaps photo by photo. */
  .pg-strip{position:relative}
  .pg-carousel .pg-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none;scroll-behavior:smooth;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
  .pg-carousel .pg-grid::-webkit-scrollbar{display:none}
  .pg-carousel .pg-grid:focus-visible{outline:2px solid var(--gold2);outline-offset:4px}
  .pg-carousel .pg-item{flex:0 0 var(--pg-slide,72%);max-width:100%;scroll-snap-align:start}
  .pg-carousel .pg-item.pg-wide,.pg-carousel .pg-item.pg-tall{grid-column:auto;grid-row:auto}
  .pg-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:44px;height:44px;border-radius:50%;border:1px solid rgba(var(--gold2-rgb),.5);background:rgba(var(--dark-rgb),.55);color:var(--gold2);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;font-family:var(--font-u);transition:background .3s,opacity .3s}
  .pg-arrow:hover{background:rgba(var(--dark-rgb),.82)}
  .pg-arrow:focus-visible{outline:2px solid var(--gold2);outline-offset:3px}
  .pg-arrow[disabled]{opacity:.3;cursor:default}
  .pg-arrow-prev{left:14px}
  .pg-arrow-next{right:14px}
  @media(max-width:560px){
    .pg-carousel .pg-item{flex-basis:var(--pg-slide-m,86%)}
    .pg-arrow{width:38px;height:38px}
    .pg-arrow-prev{left:8px}
    .pg-arrow-next{right:8px}
  }
  .lb[hidden]{display:none}
  .lb-count{opacity:.7}
  @media(max-width:900px){
    .pg-four .pg-grid{grid-template-columns:repeat(2,1fr)}
    .pg-editorial .pg-grid{grid-template-columns:repeat(2,1fr)}
    .pg-editorial .pg-item,.pg-editorial .pg-item:nth-child(n){grid-column:span 1;aspect-ratio:4/3}
    .pg-editorial .pg-item.pg-wide,.pg-item.pg-wide{grid-column:span 2}
  }
  @media(max-width:560px){
    .pg-three .pg-grid,.pg-four .pg-grid{grid-template-columns:repeat(2,1fr)}
    .pg-two .pg-grid{grid-template-columns:1fr}
  }
</style>

<script>
  (function () {
    var root = document.getElementById('pg-{{ sid }}');
    if (!root || root.dataset.pgInit) return;
    root.dataset.pgInit = '1';
    var items = Array.prototype.slice.call(root.querySelectorAll('[data-lb-item]'));
    var lb = document.getElementById('lb-{{ sid }}');
    var tiles = Array.prototype.slice.call(root.querySelectorAll('.pg-item'));
    /* The carousel arrows and auto-advance further down work with "Open
       full screen on click" switched off too (15 Sep 2026); only the
       viewer itself needs photos marked for it. */
    if (items.length && lb) {
      var img = lb.querySelector('img'), cap = lb.querySelector('.lb-cap'), count = lb.querySelector('.lb-count');
      var i = 0, lastFocus = null;
      /* One photo left: no prev/next to step through. */
      if (items.length < 2) {
        lb.querySelector('.lb-prev').style.display = 'none';
        lb.querySelector('.lb-next').style.display = 'none';
      }

      function show(n) {
        i = (n + items.length) % items.length;
        var it = items[i];
        img.src = it.getAttribute('data-src');
        img.alt = it.getAttribute('data-alt') || '';
        cap.textContent = it.getAttribute('data-cap') || it.getAttribute('data-alt') || '';
        count.textContent = (i + 1) + ' / ' + items.length;
        /* Warm the neighbours so arrowing feels instant. */
        [i + 1, i - 1].forEach(function (k) { var p = new Image(); p.src = items[(k + items.length) % items.length].getAttribute('data-src'); });
      }
      function open(n) {
        lastFocus = document.activeElement;
        lb.hidden = false;
        requestAnimationFrame(function () { lb.classList.add('open'); });
        document.documentElement.style.overflow = 'hidden';
        show(n);
        lb.querySelector('.lb-close').focus();
      }
      function close() {
        lb.classList.remove('open');
        document.documentElement.style.overflow = '';
        setTimeout(function () { lb.hidden = true; }, 350);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      items.forEach(function (it, n) {
        it.addEventListener('click', function () { open(n); });
        it.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(n); } });
      });
      lb.querySelector('.lb-prev').addEventListener('click', function () { show(i - 1); });
      lb.querySelector('.lb-next').addEventListener('click', function () { show(i + 1); });
      lb.querySelector('.lb-close').addEventListener('click', close);
      lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(i + 1);
        else if (e.key === 'ArrowLeft') show(i - 1);
      });
      /* A viewer left open would strand the next page unscrollable under
         client-side navigation, so close on any page swap. */
      document.addEventListener('astro:before-swap', close);
    }

    /* Carousel structure: arrows step one photo, optional auto-advance
       that pauses on hover, focus, an open viewer, and reduced motion. */
    var strip = root.querySelector('[data-pg-car]');
    if (strip) {
      var track = root.querySelector('.pg-grid');
      var prev = strip.querySelector('[data-pg-prev]');
      var next = strip.querySelector('[data-pg-next]');
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
      function stepWidth() { return tiles[0] ? tiles[0].getBoundingClientRect().width + gap : track.clientWidth * 0.7; }
      function atEnd() { return track.scrollLeft + track.clientWidth >= track.scrollWidth - 2; }
      function atStart() { return track.scrollLeft <= 2; }
      function updateArrows() { if (prev) prev.disabled = atStart(); if (next) next.disabled = atEnd(); }
      function step(dir) {
        if (dir > 0 && atEnd()) track.scrollTo({ left: 0, behavior: 'smooth' });
        else if (dir < 0 && atStart()) track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
        else track.scrollBy({ left: dir * stepWidth(), behavior: 'smooth' });
      }
      if (prev) prev.addEventListener('click', function () { step(-1); });
      if (next) next.addEventListener('click', function () { step(1); });
      track.addEventListener('scroll', function () { window.requestAnimationFrame(updateArrows); }, { passive: true });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      });
      /* Loop arrows are never disabled; they wrap instead. */
      if (prev) prev.disabled = false;
      if (next) next.disabled = false;

      var secs = Number(strip.dataset.autoplay || 0);
      if (secs > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var paused = false, timer = null;
        function tick() { if (!paused && (!lb || lb.hidden) && document.visibilityState === 'visible') step(1); }
        function start() { if (!timer) timer = setInterval(tick, secs * 1000); }
        strip.addEventListener('mouseenter', function () { paused = true; });
        strip.addEventListener('mouseleave', function () { paused = false; });
        strip.addEventListener('focusin', function () { paused = true; });
        strip.addEventListener('focusout', function () { paused = false; });
        track.addEventListener('touchstart', function () { paused = true; }, { passive: true });
        track.addEventListener('touchend', function () { setTimeout(function () { paused = false; }, secs * 1000); }, { passive: true });
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) start(); else if (timer) { clearInterval(timer); timer = null; } });
          }, { threshold: 0.3 }).observe(strip);
        } else start();
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Photo gallery",
  "settings": [
    { "type": "paragraph", "content": "Add one Photo block per image (up to 50). Every photo opens full-screen when clicked. Choose a structure below; Editorial mixes large and small frames automatically; Carousel makes a sideways slideshow with arrows." },
    {
      "type": "select", "id": "layout", "label": "Structure",
      "options": [
        { "value": "two", "label": "Two across" },
        { "value": "three", "label": "Three across" },
        { "value": "four", "label": "Four across" },
        { "value": "editorial", "label": "Editorial (mixed sizes)" },
        { "value": "carousel", "label": "Carousel (sideways slideshow)" }
      ],
      "default": "three"
    },
    { "type": "header", "content": "Carousel" },
    { "type": "paragraph", "content": "Only used when the structure is Carousel. Photos sit in a strip that scrolls sideways with arrows and swipe; every photo still opens full-screen." },
    { "type": "range", "id": "slide_width", "label": "Photo width", "min": 30, "max": 100, "step": 2, "unit": "%", "default": 72, "info": "Share of the strip one photo takes. 100 = one photo at a time; 50 = two side by side. Phones show one photo regardless." },
    { "type": "checkbox", "id": "autoplay", "label": "Advance automatically", "default": false },
    { "type": "range", "id": "autoplay_secs", "label": "Seconds per photo", "min": 2, "max": 15, "step": 1, "unit": "s", "default": 5 },
    { "type": "text", "id": "label", "label": "Small label (optional)", "default": "Gallery" },
    { "type": "html", "id": "heading_html", "label": "Heading (optional)", "info": "Wrap a word in <em> for the italic accent." },
    { "type": "textarea", "id": "text", "label": "Intro text (optional)" },
    { "type": "header", "content": "Size" },
    {
      "type": "select", "id": "shape", "label": "Photo shape",
      "options": [
        { "value": "4/3", "label": "Landscape 4:3" },
        { "value": "3/2", "label": "Landscape 3:2" },
        { "value": "16/9", "label": "Wide 16:9" },
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait 4:5" },
        { "value": "3/4", "label": "Portrait 3:4" }
      ],
      "default": "4/3",
      "info": "Editorial keeps its own mix of large frames; the small frames follow this."
    },
    { "type": "range", "id": "gap", "label": "Gap between photos", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "checkbox", "id": "show_captions", "label": "Show captions on the photos", "default": false },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    {"type": "header", "content": "Photos"},
    {"type": "checkbox", "id": "lightbox", "label": "Open full screen on click", "default": true},
    {"type": "checkbox", "id": "hover_zoom", "label": "Photos zoom gently on hover", "default": true},
    {"type": "select", "id": "caption_style", "label": "Captions", "options": [{"value": "over", "label": "Over the photo (as designed)"}, {"value": "below", "label": "Under the photo"}], "default": "over"},
    {"type": "range", "id": "corner", "label": "Rounded corners", "min": 0, "max": 24, "step": 2, "default": 0, "unit": "px"},
    {"type": "checkbox", "id": "frame", "label": "Hairline frame around each photo", "default": false},
    {"type": "select", "id": "columns_mobile", "label": "Across on phones", "options": [{"value": "auto", "label": "As designed"}, {"value": "1", "label": "One"}, {"value": "2", "label": "Two"}], "default": "auto"},
    {"type": "select", "id": "align", "label": "Words sit", "options": [{"value": "left", "label": "Left"}, {"value": "centre", "label": "Centre"}], "default": "left"},
    {"type": "header", "content": "Look"},
    {"type": "paragraph", "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}, {"value": "media", "label": "A photo or film behind it (below)"}], "default": "design", "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#F0EADE", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "header", "content": "Backdrop photo or film", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "paragraph", "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "image_picker", "id": "look_image", "label": "Backdrop photo", "info": "Also the poster while a backdrop film loads.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "video", "id": "look_video", "label": "Backdrop film (upload)", "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "checkbox", "id": "look_media_link", "label": "Use a film link instead of an upload", "default": false, "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "text", "id": "look_video_url", "label": "Backdrop film (URL)", "info": "A direct .mp4 link, used when no backdrop film is uploaded above.", "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"},
    {"type": "range", "id": "look_dim", "label": "Darken the backdrop", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Lower = brighter. The words stay readable down to about 40%.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
