{%- comment -%}
  Agent Access - the application band: copy and licence note on the left,
  the agent application form on the right. Posts to the existing Vercel
  API as form-name "agent-application".
{%- endcomment -%}
{%- comment -%} Theme settings › Features › Agent Access off: this section renders nothing. {%- endcomment -%}
{%- if settings.agent_access_enabled -%}
{% render 'section-look', section: section %}
<section class="sp aa aa-{{ section.settings.layout | default: 'beside' }}" style="background:var(--bg2);{% if section.settings.show_rule %}border-top:1px solid var(--border){% endif %}" id="apply">
  <div class="inner agent-apply-grid">
    <div>
      {%- if section.settings.show_label -%}<div class="slabel reveal">{{ section.settings.label }}</div>{%- endif -%}
      {%- if section.settings.show_heading -%}<h2 class="about-h reveal d1" style="font-size:calc(clamp(32px,4vw,52px)*var(--s-h,1))">{{ section.settings.heading_html }}</h2>{%- endif -%}
      {%- if section.settings.show_text and section.settings.text != blank -%}<p class="about-p reveal d2">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.show_note and section.settings.note_text != blank -%}
      <div class="reveal d3 aa-note aa-note-{{ section.settings.note_style | default: 'obsidian' }}">
        <div class="aa-note-l">{{ section.settings.note_label }}</div>
        <div class="aa-note-t">{% render 'privacy-link', note: section.settings.note_text %}</div>
      </div>
      {%- endif -%}
    </div>
    <div>
      {%- if settings.form_backend == 'vercel' -%}
      <form class="cform reveal d1" id="cform" name="agent-application" method="POST" action="{{ settings.forms_endpoint }}/api/contact">
        <input type="hidden" name="form-name" value="agent-application">
        <p class="hidden" style="display:none" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <div class="frow">
          <div class="fg"><label class="fl" for="aa-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="aa-first" name="first-name" class="fi" placeholder="{{ section.settings.ph_first | escape }}" autocomplete="given-name" required></div>
          <div class="fg"><label class="fl" for="aa-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="aa-last" name="last-name" class="fi" placeholder="{{ section.settings.ph_last | escape }}" autocomplete="family-name" required></div>
        </div>
        <div class="fg"><label class="fl" for="aa-agency">{{ section.settings.f_agency | default: "Agency / Company*" }}</label><input type="text" id="aa-agency" name="agency" class="fi" placeholder="{{ section.settings.ph_agency | escape }}" autocomplete="organization" required></div>
        <div class="fg"><label class="fl" for="aa-email">{{ section.settings.f_email | default: "Email Address*" }}</label><input type="email" id="aa-email" name="email" class="fi" placeholder="{{ section.settings.ph_email | escape }}" autocomplete="email" required></div>
        <div class="fg"><label class="fl" for="aa-phone">{{ section.settings.f_phone | default: "Phone Number*" }}</label><input type="tel" id="aa-phone" name="phone" class="fi" placeholder="{{ section.settings.ph_phone | escape }}" autocomplete="tel" required></div>
        <div class="fg"><label class="fl" for="aa-licence">{{ section.settings.f_licence | default: "Real Estate Licence No.*" }}</label><input type="text" id="aa-licence" name="licence-number" class="fi" placeholder="{{ section.settings.ph_licence | escape }}" autocomplete="off" required></div>
        <div class="fg">
          <label class="fl" for="aa-suburbs">{{ section.settings.f_suburbs | default: "Primary Suburb Markets" }}</label>
          <input type="text" id="aa-suburbs" name="suburb-markets" class="fi" placeholder="{{ section.settings.ph_suburbs | escape }}">
        </div>
        <div class="fg"><label class="fl" for="aa-message">{{ section.settings.f_message | default: "Additional Information" }}</label><textarea class="fta" id="aa-message" name="message" placeholder="{{ section.settings.ph_message | escape }}"></textarea></div>
        <button type="submit" class="fsub" id="fsub">{{ section.settings.submit_label }} &rarr;</button>
        <p class="sr-status" role="status" aria-live="polite" data-form-status></p>
      </form>
      {%- else -%}
      {% form 'contact', id: 'cform', class: 'cform reveal d1' %}
        <span hidden data-thanks>{{ section.settings.success_text }}</span>
        {%- if form.posted_successfully? -%}
          {% render 'form-thanks', text: section.settings.success_text %}
        {%- else -%}
        {%- if form.errors -%}
          <p class="form-note" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <input type="hidden" name="contact[Enquiry]" value="Agent application">
        <div class="frow">
          <div class="fg"><label class="fl" for="aa-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="aa-first" name="contact[First name]" class="fi" placeholder="{{ section.settings.ph_first | escape }}" autocomplete="given-name" required></div>
          <div class="fg"><label class="fl" for="aa-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="aa-last" name="contact[Last name]" class="fi" placeholder="{{ section.settings.ph_last | escape }}" autocomplete="family-name" required></div>
        </div>
        <div class="fg"><label class="fl" for="aa-agency">{{ section.settings.f_agency | default: "Agency / Company*" }}</label><input type="text" id="aa-agency" name="contact[Agency]" class="fi" placeholder="{{ section.settings.ph_agency | escape }}" autocomplete="organization" required></div>
        <div class="fg"><label class="fl" for="aa-email">{{ section.settings.f_email | default: "Email Address*" }}</label><input type="email" id="aa-email" name="contact[email]" class="fi" placeholder="{{ section.settings.ph_email | escape }}" autocomplete="email" required></div>
        <div class="fg"><label class="fl" for="aa-phone">{{ section.settings.f_phone | default: "Phone Number*" }}</label><input type="tel" id="aa-phone" name="contact[Phone]" class="fi" placeholder="{{ section.settings.ph_phone | escape }}" autocomplete="tel" required></div>
        <div class="fg"><label class="fl" for="aa-licence">{{ section.settings.f_licence | default: "Real Estate Licence No.*" }}</label><input type="text" id="aa-licence" name="contact[Licence number]" class="fi" placeholder="{{ section.settings.ph_licence | escape }}" autocomplete="off" required></div>
        <div class="fg">
          <label class="fl" for="aa-suburbs">{{ section.settings.f_suburbs | default: "Primary Suburb Markets" }}</label>
          <input type="text" id="aa-suburbs" name="contact[Suburb markets]" class="fi" placeholder="{{ section.settings.ph_suburbs | escape }}">
        </div>
        <div class="fg"><label class="fl" for="aa-message">{{ section.settings.f_message | default: "Additional Information" }}</label><textarea class="fta" id="aa-message" name="contact[body]" placeholder="{{ section.settings.ph_message | escape }}"></textarea></div>
        {% render 'form-optin', label: section.settings.optin_label %}
        <button type="submit" class="fsub" id="fsub">{{ section.settings.submit_label }} &rarr;</button>
      {%- endif -%}
        {% endform %}
        {%- assign cm_uid = 'cm-' | append: section.id -%}{% render 'customer-mirror', uid: cm_uid, residence: '' %}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .agent-apply-grid{display:grid;grid-template-columns:1fr 1fr;gap:96px;align-items:start}
  .aa-above .agent-apply-grid{grid-template-columns:1fr;gap:40px;max-width:760px}
  .aa-note{margin-top:36px;padding:28px;background:var(--dark);border-left:2px solid var(--gold)}
  .aa-note-l{font-size:10px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:var(--gold3);margin-bottom:10px}
  .aa-note-t{font-size:calc(14px*var(--s-t,1));font-weight:400;color:rgba(var(--white-rgb),.78);line-height:1.75}
  .aa-note-stone{background:var(--bg3)}.aa-note-stone .aa-note-l{color:var(--ink)}.aa-note-stone .aa-note-t{color:var(--ink3)}
  .aa-note-plain{background:transparent;padding:22px 0 0;border-left:0;border-top:1px solid var(--border)}.aa-note-plain .aa-note-l{color:var(--ink)}.aa-note-plain .aa-note-t{color:var(--ink3)}
  @media(max-width:1024px){.agent-apply-grid{grid-template-columns:1fr;gap:52px}}
</style>

{%- endif -%}
{% schema %}
{
  "name": "Agent application",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Apply for Access"
    },
    {
      "type": "html",
      "id": "heading_html",
      "label": "Heading (HTML)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Note label",
      "default": "Please note"
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Note text"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "Submit Application"
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Success message (Shopify mode)",
      "default": "Thank you - your application has been received. We'll be in touch within one business day."
    },
    { "type": "text", "id": "optin_label", "label": "Keep-me-updated box", "default": "Keep me updated on new Sabdia releases", "info": "Ticked by default. Ticked = tagged newsletter in Customers (the mailing list). Every enquirer is filed under Customers regardless, tagged enquiry and the residence." },
    {
      "type": "header",
      "content": "Wording"
    },
    {
      "type": "text",
      "id": "f_first",
      "label": "First name label",
      "default": "First Name*"
    },
    {
      "type": "text",
      "id": "f_last",
      "label": "Last name label",
      "default": "Last Name*"
    },
    {
      "type": "text",
      "id": "f_agency",
      "label": "Agency label",
      "default": "Agency / Company*"
    },
    {
      "type": "text",
      "id": "f_email",
      "label": "Email label",
      "default": "Email Address*"
    },
    {
      "type": "text",
      "id": "f_phone",
      "label": "Phone label",
      "default": "Phone Number*"
    },
    {
      "type": "text",
      "id": "f_licence",
      "label": "Licence number label",
      "default": "Real Estate Licence No.*"
    },
    {
      "type": "text",
      "id": "f_suburbs",
      "label": "Suburb markets label",
      "default": "Primary Suburb Markets"
    },
    {
      "type": "text",
      "id": "f_message",
      "label": "Additional information label",
      "default": "Additional Information"
    },
    {
      "type": "text",
      "id": "ph_first",
      "label": "First name placeholder",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "ph_last",
      "label": "Last name placeholder",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "ph_agency",
      "label": "Agency placeholder",
      "default": "Agency or company name"
    },
    {
      "type": "text",
      "id": "ph_email",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "ph_phone",
      "label": "Phone placeholder",
      "default": "+61 4xx xxx xxx"
    },
    {
      "type": "text",
      "id": "ph_licence",
      "label": "Licence number placeholder",
      "default": "Your licence number"
    },
    {
      "type": "text",
      "id": "ph_suburbs",
      "label": "Suburb markets placeholder",
      "default": "e.g. Coorparoo, Camp Hill, New Farm…"
    },
    {
      "type": "textarea",
      "id": "ph_message",
      "label": "Additional information placeholder",
      "default": "Tell us about your client base, experience with luxury property, or any other relevant information…"
    },
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_label", "label": "Show the small label", "default": true},
    {"type": "checkbox", "id": "show_heading", "label": "Show the heading", "default": true},
    {"type": "checkbox", "id": "show_text", "label": "Show the paragraph", "default": true},
    {"type": "checkbox", "id": "show_note", "label": "Show the note", "default": true},
    {"type": "checkbox", "id": "show_rule", "label": "Hairline above the section", "default": true},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "layout", "label": "Words", "options": [{"value": "beside", "label": "Beside the form"}, {"value": "above", "label": "Above the form"}], "default": "beside"},
    {"type": "select", "id": "note_style", "label": "Note style", "options": [{"value": "obsidian", "label": "Obsidian card (as designed)"}, {"value": "stone", "label": "Stone card"}, {"value": "plain", "label": "Plain, under a hairline"}], "default": "obsidian"},
    {"type": "header", "content": "Look"},
    {"type": "paragraph", "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}, {"value": "media", "label": "A photo or film behind it (below)"}], "default": "design", "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#F0EADE", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "header", "content": "Backdrop photo or film", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "paragraph", "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "image_picker", "id": "look_image", "label": "Backdrop photo", "info": "Also the poster while a backdrop film loads.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "video", "id": "look_video", "label": "Backdrop film (upload)", "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "checkbox", "id": "look_media_link", "label": "Use a film link instead of an upload", "default": false, "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "text", "id": "look_video_url", "label": "Backdrop film (URL)", "info": "A direct .mp4 link, used when no backdrop film is uploaded above.", "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"},
    {"type": "range", "id": "look_dim", "label": "Darken the backdrop", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Lower = brighter. The words stay readable down to about 40%.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_focus", "label": "Backdrop crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_media_tone", "label": "Words over the backdrop", "options": [{"value": "dark", "label": "Light words on a darkened backdrop"}, {"value": "light", "label": "Dark words on a pale backdrop"}], "default": "dark", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."}
  ],
  "presets": [
    {
      "name": "Agent application"
    }
  ]
}
{% endschema %}
