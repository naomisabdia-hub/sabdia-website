{%- comment -%}
  Contact - the two-column body: direct-contact details (from theme
  settings), the dark agent-enquiries block and map card on the left;
  the enquiry form on the right. The form posts to the existing Vercel
  API so leads keep landing in the Sabdia inbox. The enquiry-type select
  lists each for-sale residence, then the editable interest options.
{%- endcomment -%}
{%- assign fs = section.settings.listings_collection | default: collections['for-sale'] -%}
{% render 'section-look', section: section %}
{%- liquid
  assign careers_bucket = settings.careers_bucket | default: 'careers'
  assign careers_upload = settings.supabase_url | default: 'https://fvczsjcrvwzqtcbforgo.supabase.co' | append: '/storage/v1/object/' | append: careers_bucket
-%}
<section class="sp cp cp-{{ section.settings.layout | default: 'beside' }} cp-agent-{{ section.settings.agent_style | default: 'obsidian' }}{% if section.settings.form_style == 'card' %} cp-card{% endif %}" style="--cm-map-ar:{{ section.settings.map_shape | default: '16/9' }}">
  <div class="inner contact-page-grid">
    <div>
      {%- if section.settings.show_direct -%}
      {%- if section.settings.direct_label != blank -%}<div class="slabel reveal">{{ section.settings.direct_label }}</div>{%- endif -%}
      <ul class="cdet reveal d1" style="margin-top:12px">
        {%- if section.settings.d_show_location -%}<li class="cd"><span class="cd-l">{{ section.settings.d_location | default: "Location" }}</span><span class="cd-v">{{ settings.location }}</span></li>{%- endif -%}
        {%- if settings.contact_phone != blank and section.settings.d_show_phone -%}
          <li class="cd"><span class="cd-l">{{ section.settings.d_phone | default: "Phone" }}</span><a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="cd-v">{{ settings.contact_phone }}</a></li>
        {%- endif -%}
        {%- if settings.contact_email != blank and section.settings.d_show_email -%}
          <li class="cd"><span class="cd-l">{{ section.settings.d_email | default: "Email" }}</span><a href="mailto:{{ settings.contact_email }}" class="cd-v">{{ settings.contact_email }}</a></li>
        {%- endif -%}
        {%- if section.settings.d_show_instagram -%}<li class="cd"><span class="cd-l">{{ section.settings.d_instagram | default: "Instagram" }}</span><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" class="cd-v">{{ settings.instagram_label }}</a></li>{%- endif -%}
        {%- if section.settings.d_show_facebook -%}<li class="cd"><span class="cd-l">{{ section.settings.d_facebook | default: "Facebook" }}</span><a href="{{ settings.facebook_url }}" target="_blank" rel="noopener" class="cd-v">{{ section.settings.facebook_label | default: settings.site_name }}</a></li>{%- endif -%}
        {%- if section.settings.d_show_linkedin -%}<li class="cd"><span class="cd-l">{{ section.settings.d_linkedin | default: "LinkedIn" }}</span><a href="{{ settings.linkedin_url }}" target="_blank" rel="noopener" class="cd-v">{{ section.settings.linkedin_label | default: settings.site_name }}</a></li>{%- endif -%}
        {%- if section.settings.d_show_website -%}<li class="cd"><span class="cd-l">{{ section.settings.d_website | default: "Website" }}</span><a href="{{ settings.domain_url }}" target="_blank" rel="noopener" class="cd-v">{{ settings.domain_display }}</a></li>{%- endif -%}
      </ul>
      {%- endif -%}

      {%- if section.settings.show_agent and section.settings.agent_body_html != blank and settings.agent_access_enabled -%}
      <div class="contact-info-block reveal d2">
        <div class="contact-info-h">{{ section.settings.agent_heading }}</div>
        <p class="contact-info-p">{{ section.settings.agent_body_html }}</p>
      </div>
      {%- endif -%}

      {%- if section.settings.show_map -%}
      <div class="contact-map-placeholder reveal d3" style="margin-top:32px">
        {%- if section.settings.map_image -%}
          <img src="{{ section.settings.map_image | image_url: width: 900, height: 500, crop: 'center' }}" alt="{{ section.settings.map_label | escape }}" loading="lazy" width="900" height="500">
        {%- elsif section.settings.map_image_ext != blank -%}
          <img src="{% render 'ext-variant', src: section.settings.map_image_ext, w: 900, h: 500 %}" alt="{{ section.settings.map_label | escape }}" loading="lazy" width="900" height="500">
        {%- endif -%}
        {%- if section.settings.map_label != blank -%}<div class="contact-map-placeholder-label">{{ section.settings.map_label }}</div>{%- endif -%}
      </div>
      {%- endif -%}
    </div>

    <div>
      {%- if section.settings.show_form_label and section.settings.form_label != blank -%}<div class="slabel reveal">{{ section.settings.form_label }}</div>{%- endif -%}
      {%- comment -%} One switch, Theme settings › Features › Guided Match, hides this pointer everywhere. {%- endcomment -%}
      {%- if section.settings.guided_line_html != blank and section.settings.show_guided and settings.guided_match_enabled != false -%}
        <p class="reveal d1" style="font-family:'EB Garamond',Georgia,serif;font-size:14px;font-style:italic;color:var(--ink3);margin:10px 0 6px">{{ section.settings.guided_line_html }}</p>
      {%- endif -%}
      {%- if settings.form_backend == 'vercel' -%}
      <form class="cform reveal d1" id="cform" style="margin-top:12px" name="contact" method="POST" action="{{ settings.forms_endpoint }}/api/contact" data-careers-upload="{{ careers_upload }}" data-careers-key="{{ settings.supabase_anon_key }}">
        <input type="hidden" name="form-name" value="contact">
        <p class="hidden" style="display:none" aria-hidden="true"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <div class="frow">
          <div class="fg"><label class="fl" for="cf-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="cf-first" name="first-name" class="fi" placeholder="{{ section.settings.f_first_ph | default: "First name" }}" autocomplete="given-name" required></div>
          <div class="fg"><label class="fl" for="cf-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="cf-last" name="last-name" class="fi" placeholder="{{ section.settings.f_last_ph | default: "Last name" }}" autocomplete="family-name" required></div>
        </div>
        <div class="fg"><label class="fl" for="cf-email">{{ section.settings.f_email | default: "Email Address*" }}</label><input type="email" id="cf-email" name="email" class="fi" placeholder="your@email.com" autocomplete="email" required></div>
        <div class="fg"><label class="fl" for="cf-phone">{{ section.settings.f_phone | default: "Phone Number" }}</label><input type="tel" id="cf-phone" name="phone" class="fi" required placeholder="+61 4xx xxx xxx" autocomplete="tel"></div>
        <div class="fg">
          <label class="fl" for="cf-interest">{{ section.settings.f_interest | default: "How can we help?*" }}</label>
          <select class="fsel" id="cf-interest" name="enquiry-type" required>
            <option value="">{{ section.settings.f_interest_ph | default: "Select an enquiry type…" }}</option>
            <option>For Sale - Current Residences</option>
            {%- for product in fs.products -%}
              <option>{{ product.title }} - {{ product.metafields.custom.suburb.value }}</option>
            {%- endfor -%}
            {%- for block in section.blocks -%}
              {%- if settings.agent_access_enabled != true and block.settings.text contains 'Agent' -%}{%- continue -%}{%- endif -%}
              <option {{ block.shopify_attributes }}>{{ block.settings.text }}</option>
            {%- endfor -%}
          </select>
          {%- for block in section.blocks -%}
            {%- if block.settings.thanks != blank -%}<span hidden data-thanks-for="{{ block.settings.text | escape }}">{{ block.settings.thanks }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'prequal-fields', mode: 'vercel', s: section.settings %}
        <div class="fg" data-careers-wrap hidden>
          <label class="fl" for="cf-cv-v">{{ section.settings.careers_label | default: "CV or resume*" }}</label>
          <input type="file" id="cf-cv-v" class="fi fi-file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" data-careers-file disabled>
          <p class="form-note" style="margin:0">{{ section.settings.careers_note | default: "PDF or Word, up to 10 MB." }}</p>
          <input type="hidden" name="cv" value="" data-careers-path>
        </div>
        <div class="fg"><label class="fl" for="cf-message">{{ section.settings.f_message | default: "Your Message*" }}</label><textarea class="fta" id="cf-message" name="message" placeholder="Tell us about your interest, timeline, or any questions you have…" style="min-height:140px" required></textarea></div>
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <button type="submit" class="fsub" id="fsub">{{ section.settings.submit_label }} &rarr;</button>
          <p class="form-note" style="margin:0">{% render 'privacy-link', note: section.settings.form_note %}</p>
        </div>
        <p class="sr-status" role="status" aria-live="polite" data-form-status></p>
      </form>
      {%- else -%}
      {%- comment -%} Shopify-native: emails the store's sender address and
          files the enquirer under Customers. {%- endcomment -%}
      <div data-careers-upload="{{ careers_upload }}" data-careers-key="{{ settings.supabase_anon_key }}">
      {% form 'contact', id: 'cform', class: 'cform reveal d1', style: 'margin-top:12px' %}
        <span hidden data-thanks>{{ section.settings.success_text }}</span>
        {%- if form.posted_successfully? -%}
          {% render 'form-thanks', text: section.settings.success_text %}
        {%- else -%}
        {%- if form.errors -%}
          <p class="form-note" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="frow">
          <div class="fg"><label class="fl" for="cf-first">{{ section.settings.f_first | default: "First Name*" }}</label><input type="text" id="cf-first" name="contact[First name]" class="fi" placeholder="{{ section.settings.f_first_ph | default: "First name" }}" autocomplete="given-name" required></div>
          <div class="fg"><label class="fl" for="cf-last">{{ section.settings.f_last | default: "Last Name*" }}</label><input type="text" id="cf-last" name="contact[Last name]" class="fi" placeholder="{{ section.settings.f_last_ph | default: "Last name" }}" autocomplete="family-name" required></div>
        </div>
        <div class="fg"><label class="fl" for="cf-email">{{ section.settings.f_email | default: "Email Address*" }}</label><input type="email" id="cf-email" name="contact[email]" class="fi" placeholder="your@email.com" autocomplete="email" required></div>
        <div class="fg"><label class="fl" for="cf-phone">{{ section.settings.f_phone | default: "Phone Number" }}</label><input type="tel" id="cf-phone" name="contact[Phone]" class="fi" required placeholder="+61 4xx xxx xxx" autocomplete="tel"></div>
        <div class="fg">
          <label class="fl" for="cf-interest">{{ section.settings.f_interest | default: "How can we help?*" }}</label>
          <select class="fsel" id="cf-interest" name="contact[Enquiry type]" required>
            <option value="">{{ section.settings.f_interest_ph | default: "Select an enquiry type…" }}</option>
            <option>For Sale - Current Residences</option>
            {%- for product in fs.products -%}
              <option>{{ product.title }} - {{ product.metafields.custom.suburb.value }}</option>
            {%- endfor -%}
            {%- for block in section.blocks -%}
              {%- if settings.agent_access_enabled != true and block.settings.text contains 'Agent' -%}{%- continue -%}{%- endif -%}
              <option {{ block.shopify_attributes }}>{{ block.settings.text }}</option>
            {%- endfor -%}
          </select>
          {%- for block in section.blocks -%}
            {%- if block.settings.thanks != blank -%}<span hidden data-thanks-for="{{ block.settings.text | escape }}">{{ block.settings.thanks }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'prequal-fields', mode: 'shopify', s: section.settings %}
        {%- comment -%} Careers: a CV is required and uploads to the careers folder before the form sends (main.js). {%- endcomment -%}
        <div class="fg" data-careers-wrap hidden>
          <label class="fl" for="cf-cv">{{ section.settings.careers_label | default: "CV or resume*" }}</label>
          <input type="file" id="cf-cv" class="fi fi-file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" data-careers-file disabled>
          <p class="form-note" style="margin:0">{{ section.settings.careers_note | default: "PDF or Word, up to 10 MB." }}</p>
          <input type="hidden" name="contact[CV]" value="" data-careers-path>
        </div>
        <div class="fg"><label class="fl" for="cf-message">{{ section.settings.f_message | default: "Your Message*" }}</label><textarea class="fta" id="cf-message" name="contact[body]" placeholder="Tell us about your interest, timeline, or any questions you have…" style="min-height:140px" required></textarea></div>
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          {% render 'form-optin', label: section.settings.optin_label %}
          <button type="submit" class="fsub" id="fsub">{{ section.settings.submit_label }} &rarr;</button>
          <p class="form-note" style="margin:0">{% render 'privacy-link', note: section.settings.form_note %}</p>
        </div>
      {%- endif -%}
        {% endform %}
      </div>
        {%- assign cm_uid = 'cm-' | append: section.id -%}{% render 'customer-mirror', uid: cm_uid, residence: '' %}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .contact-page-grid{display:grid;grid-template-columns:5fr 7fr;gap:96px;align-items:start}
  .cp-flip .contact-page-grid>div:first-child{order:2}
  .cp-formonly .contact-page-grid{grid-template-columns:1fr;max-width:760px}
  .cp-formonly .contact-page-grid>div:first-child{display:none}
  .cp-above .contact-page-grid{grid-template-columns:1fr;gap:48px}
  .cp-card .cform{padding:clamp(22px,3vw,36px);background:var(--white);border:1px solid var(--border);border-top:2px solid var(--gold)}
  .contact-info-block{padding:44px;background:var(--dark);color:var(--white);margin-top:44px}
  .contact-info-h{font-family:var(--font-d);font-size:calc(18px*var(--s-h,1));font-weight:300;color:var(--white);margin-bottom:20px}
  .contact-info-p{font-size:calc(14px*var(--s-t,1));font-weight:400;color:rgba(var(--white-rgb),.78);line-height:1.8}
  .cp-agent-stone .contact-info-block{background:var(--bg3);color:var(--ink)}.cp-agent-stone .contact-info-h{color:var(--ink)}.cp-agent-stone .contact-info-p{color:var(--ink3)}
  .cp-agent-plain .contact-info-block{background:transparent;padding:28px 0 0;border-top:1px solid var(--border);color:var(--ink)}.cp-agent-plain .contact-info-h{color:var(--ink)}.cp-agent-plain .contact-info-p{color:var(--ink3)}
  .contact-map-placeholder{width:100%;aspect-ratio:var(--cm-map-ar,16/9);background:var(--bg3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;margin-top:44px;position:relative;overflow:hidden}
  .contact-map-placeholder img{width:100%;height:100%;object-fit:cover;filter:saturate(.75) brightness(.98)}
  .contact-map-placeholder-label{position:absolute;bottom:20px;left:20px;padding:8px 16px;background:rgba(var(--dark-rgb),.8);backdrop-filter:blur(8px);font-size:10px;font-weight:300;letter-spacing:.22em;text-transform:uppercase;color:rgba(var(--white-rgb),.7)}
  @media(max-width:1000px){.contact-page-grid{grid-template-columns:1fr;gap:52px}}
</style>

<script>
  /* Links such as /pages/contact?interest=Request%20a%20Viewing (the For Sale
     page's "Request a Viewing" button) arrive with the form already chosen.
     ?interest=<Interest label>  chooses that enquiry type (added to the list if it is not there).
     ?property=<residence title> chooses that residence from the same list when no interest is
                                 given; otherwise the message opens with "Regarding <property>: ".
     ?message=<text>             starts the message (only when the message is still empty).
     Values are URL-decoded by the browser (Agent%20Access, SOLACE, Hello%20there). */
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}') || document;
    var sel = root.querySelector('#cf-interest');
    var msg = root.querySelector('#cf-message');
    if (!sel || sel.dataset.prefill) return;
    sel.dataset.prefill = '1';
    var q = new URLSearchParams(location.search);
    var interest = (q.get('interest') || '').trim();
    var property = (q.get('property') || '').trim();
    var message = (q.get('message') || '').trim();
    if (!interest && !property && !message) return;
    var option = function (test) {
      for (var i = 0; i < sel.options.length; i++) {
        var v = sel.options[i].value;
        if (v && test(v.toLowerCase())) return sel.options[i];
      }
      return null;
    };
    var pick = null, residencePicked = false;
    if (interest) {
      var wantI = interest.toLowerCase();
      pick = option(function (v) { return v === wantI; });
      if (!pick) { pick = new Option(interest, interest); sel.add(pick, 1); }
    } else if (property) {
      /* The residences for sale sit in this list as "SOLACE - Camp Hill". */
      var wantP = property.toLowerCase();
      pick = option(function (v) { return v === wantP || v.indexOf(wantP + ' - ') === 0; });
      residencePicked = !!pick;
    }
    if (pick) {
      sel.value = pick.value;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
    }
    if (msg && !msg.value.trim()) {
      var lead = property && !residencePicked ? 'Regarding ' + property + ': ' : '';
      if (lead || message) msg.value = lead + message;
    }
  })();
</script>

{% schema %}
{
  "name": "Contact body",
  "settings": [
    {"type": "header", "content": "Careers"},
    {"type": "paragraph", "content": "Add an enquiry type block named Careers below. Choosing it asks for a CV (required) instead of the buyer questions; the file uploads to the careers folder and its name arrives with the enquiry."},
    {"type": "text", "id": "careers_label", "label": "CV field label", "default": "CV or resume*"},
    {"type": "text", "id": "careers_note", "label": "CV field note", "default": "PDF or Word, up to 10 MB."},
    {
      "type": "text",
      "id": "direct_label",
      "label": "Direct-contact label",
      "default": "Direct Contact"
    },
    {
      "type": "text",
      "id": "facebook_label",
      "label": "Facebook display name"
    },
    {
      "type": "text",
      "id": "linkedin_label",
      "label": "LinkedIn display name"
    },
    {
      "type": "text",
      "id": "agent_heading",
      "label": "Agent block heading",
      "default": "Agent Enquiries"
    },
    {
      "type": "html",
      "id": "agent_body_html",
      "label": "Agent block text (HTML links allowed)"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Map card image"
    },
    {
      "type": "text",
      "id": "map_image_ext",
      "label": "Current map image (URL)",
      "info": "The photo showing now is loaded from this address. Choose an image above and it takes over - you never need to edit this field."
    },
    {
      "type": "text",
      "id": "map_label",
      "label": "Map card label",
      "default": "Brisbane, Queensland"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Form label",
