{%- comment -%}
  How it works - the four-step strip above the closing band.

  Split out of the all-in-one Collection grid section on 14 Sep 2026 so each
  part of the For Sale page has its own panel in the customizer (Naomi:
  "have the header its settings, then the Now Selling, then each individual
  grid has their setting"). Real photographs and real footage only, never
  generated.
{%- endcomment -%}
{%- liquid
  capture list_csv
    render 'collection-handles', collection: collection
  endcapture
  assign handles = list_csv | split: ','
  assign count = handles.size
  assign show_rich = true
  if collection.handle == 'sold'
    assign show_rich = false
  endif
-%}
{% render 'section-look', section: section %}
{%- if show_rich and section.settings.show_how != false -%}
{%- liquid
  # The four steps are numbered settings (how1_title … how4_text); a step
  # with an empty title is left out and the track closes up.
  assign how_delays = ',d1,d2,d3' | split: ','
  assign how_n = 0
  for i in (1..4)
    assign tkey = 'how' | append: i | append: '_title'
    if section.settings[tkey] != blank
      assign how_n = how_n | plus: 1
    endif
  endfor
-%}
{%- if how_n > 0 -%}
<section class="mc-how s-surface">
  <div class="inner">
    {%- if section.settings.how_label != blank -%}<div class="slabel reveal mc-how-l">{{ section.settings.how_label }}</div>{%- endif -%}
    <div class="proc-track" style="--proc-cols:{{ how_n }};--proc-n:44px">
      {%- assign how_i = 0 -%}
      {%- for i in (1..4) -%}
        {%- assign tkey = 'how' | append: i | append: '_title' -%}
        {%- assign dkey = 'how' | append: i | append: '_text' -%}
        {%- if section.settings[tkey] == blank -%}{%- continue -%}{%- endif -%}
        <div class="proc-step reveal {{ how_delays[how_i] }}">
          <div class="proc-n">{{ how_i | plus: 1 }}</div>
          <div class="proc-t">{{ section.settings[tkey] }}</div>
          {%- if section.settings[dkey] != blank -%}<div class="proc-d">{{ section.settings[dkey] }}</div>{%- endif -%}
        </div>
        {%- assign how_i = how_i | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{%- endif -%}
<style>
  .mc-how{padding:calc(clamp(56px,7vw,96px)*var(--sp-scale,1)*var(--sp-top,1)) var(--page-pad) calc(clamp(56px,7vw,96px)*var(--sp-scale,1)*var(--sp-bot,1));background:var(--bg);border-top:1px solid var(--border)}
  .mc-how-l{justify-content:center;margin-bottom:8px}
  .mc-how .proc-step{padding-top:40px}
  .mc-how .proc-t{font-size:calc(var(--t-h3)*var(--s-h,1)*.92)}
  .mc-how .proc-d{max-width:280px;margin:0 auto}
  @media(max-width:900px){.mc-how .proc-step{padding-top:0}.mc-how .proc-d{max-width:none}}
</style>

