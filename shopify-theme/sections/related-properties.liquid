{%- comment -%}
  More Sabdia residences - the row of other residences at the foot of a
  residence page, and the share row under it.

  Hand-picked: add Residence blocks (⊕ Add block) and the row shows those
  residences in that order. With no blocks it is automatic: up to three
  other live residences (never the one being viewed), in the For Sale
  collection's order. The heading switches when this residence's Status
  is in the Sold group.
{%- endcomment -%}
{%- comment -%} The residences' own brochure faces, so a card name prints in its house's face. {%- endcomment -%}
{% render 'residence-faces' %}
{%- liquid
  # The residence being viewed: its product, or its page (15 Sep 2026).
  assign rp_res = product
  if rp_res == blank and page != blank
    assign rp_res = page
  endif
  assign col = section.settings.related_collection | default: collections['for-sale']
  capture pstatus
    render 'residence-status', product: rp_res
  endcapture
  assign sold = false
  if pstatus contains 'Sold'
    assign sold = true
  endif
  capture live_csv
    render 'residence-handles', col: col, group: 'live'
  endcapture
  assign live_handles = live_csv | split: ','
  assign rp_count = section.settings.count | default: 3
  assign rp_shape = section.settings.card_shape | default: '4/3'
  assign rp_style = 'aspect-ratio:' | append: rp_shape
-%}
{%- capture cards -%}
  {%- assign shown = 0 -%}
  {%- if section.blocks.size > 0 -%}
    {%- comment -%} Hand-picked residences, in block order. The residence being viewed is skipped. {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.page | default: block.settings.product -%}
      {%- if p == blank or p.handle == rp_res.handle -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- assign delay = '' -%}
      {%- if shown == 2 -%}{%- assign delay = ' d1' -%}{%- elsif shown > 2 -%}{%- assign delay = ' d2' -%}{%- endif -%}
      {%- assign card_class = 'reveal' | append: delay -%}
      <div class="prop-related-pick" {{ block.shopify_attributes }}>{% render 'property-card', product: p, class: card_class, style: rp_style, img_w: 600, img_h: 400, show_cars: section.settings.show_cars, show_land: section.settings.show_land, show_build: section.settings.show_build %}</div>
    {%- endfor -%}
  {%- else -%}
  {%- for h in live_handles -%}
    {%- if shown >= rp_count -%}{%- break -%}{%- endif -%}
    {%- if h == rp_res.handle -%}{%- continue -%}{%- endif -%}
    {%- comment -%} The residence's page leads (15 Sep 2026); a residence still only in Products is found there. {%- endcomment -%}
    {%- assign rp_card = pages[h] -%}{%- if rp_card == blank -%}{%- for cand in collections.all.products -%}{%- if cand.handle == h -%}{%- assign rp_card = cand -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
    {%- if rp_card == blank -%}{%- continue -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    {%- case shown -%}
      {%- when 1 -%}{% render 'property-card', product: rp_card, class: 'reveal', style: rp_style, img_w: 600, img_h: 400, show_cars: section.settings.show_cars, show_land: section.settings.show_land, show_build: section.settings.show_build %}
      {%- when 2 -%}{% render 'property-card', product: rp_card, class: 'reveal d1', style: rp_style, img_w: 600, img_h: 400, show_cars: section.settings.show_cars, show_land: section.settings.show_land, show_build: section.settings.show_build %}
      {%- else -%}{% render 'property-card', product: rp_card, class: 'reveal d2', style: rp_style, img_w: 600, img_h: 400, show_cars: section.settings.show_cars, show_land: section.settings.show_land, show_build: section.settings.show_build %}
    {%- endcase -%}
  {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign cards_stripped = cards | strip -%}
{%- if cards_stripped != blank -%}
{% render 'section-look', section: section %}
<div class="prop-related inner s-surface" style="--rp-cols:{{ section.settings.columns | default: '3' }};--rp-gap:{{ section.settings.gap | default: 10 }}px">
  {%- if section.settings.label != blank -%}<div class="slabel reveal">{{ section.settings.label }}</div>{%- endif -%}
  {%- if section.settings.show_heading -%}<h2 class="prop-related-h reveal">{% if sold %}{{ section.settings.heading_sold_html }}{% else %}{{ section.settings.heading_html }}{% endif %}</h2>{%- endif -%}
  <div class="prop-related-grid">{{ cards }}</div>
  {%- if section.settings.cta_label != blank -%}
  <div class="reveal" style="margin-top:36px;text-align:center"><a class="btn-g" href="{{ section.settings.cta_link | default: '/collections/for-sale' }}">{{ section.settings.cta_label }} &rarr;</a></div>
  {%- endif -%}
</div>
{%- endif -%}
{%- comment -%} The share row lives under "More Sabdia residences" (Naomi, 14 Sep 2026). {%- endcomment -%}
{%- if section.settings.show_share -%}
{%- liquid
  assign mf = rp_res.metafields.custom
  assign share_url = shop.url | append: rp_res.url
  assign share_title = rp_res.title | append: ' - ' | append: mf.suburb.value | append: ' | Sabdia Constructions'
  assign eu = share_url | url_encode
  assign et = share_title | url_encode
-%}
<section style="padding:0 var(--page-pad) clamp(48px,6vw,72px)">
  <div class="inner" style="display:flex;justify-content:center">
    <div class="share-row" aria-label="Share this page">
      <span class="share-l">{{ section.settings.share_label | default: "Share" }}</span>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ eu }}" target="_blank" rel="noopener" class="share-a">Facebook</a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ eu }}" target="_blank" rel="noopener" class="share-a">LinkedIn</a>
      <a href="https://twitter.com/intent/tweet?url={{ eu }}&text={{ et }}" target="_blank" rel="noopener" class="share-a">X</a>
      <a href="mailto:?subject={{ et }}&body={{ et }}%0A{{ eu }}" class="share-a">Email</a>
      <button type="button" class="share-a share-copy" data-share-url="{{ share_url }}">{{ section.settings.copy_link_label | default: "Copy link" }}</button>
    </div>
  </div>
</section>
{%- endif -%}
<style>
  .prop-related-pick{min-width:0}.prop-related-pick>.pc{width:100%}
  .share-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin-top:36px}
  .share-l{font-size:10px;font-weight:500;letter-spacing:.28em;text-transform:uppercase;color:var(--ink3)}
  .share-a{background:none;border:none;cursor:pointer;padding:4px 0;font-family:var(--font-u);font-size:11px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:var(--ink2);border-bottom:1px solid rgba(var(--gold-rgb),.35);transition:color .25s,border-color .25s;text-decoration:none}
  .share-a:hover{color:var(--ink);border-color:var(--gold)}
</style>

{% schema %}
{
  "name": "More Sabdia residences",
  "settings": [
    {"type": "paragraph", "content": "The other residences at the foot of this page. Hand-pick them with ⊕ Add block › Residence (shown in that order), or leave the blocks empty and the row fills itself from the collection below: up to the number set under Layout, live residences only, never the one being viewed."},
    { "type": "collection", "id": "related_collection", "label": "Collection (automatic row)", "info": "Defaults to For Sale; sets the order. Any residence whose Status is live is included; the one being viewed is never shown. Ignored while Residence blocks are added." },
    { "type": "html", "id": "heading_html", "label": "Heading (HTML)", "default": "More <em>Sabdia residences<\/em>" },
    { "type": "html", "id": "heading_sold_html", "label": "Heading when sold (HTML)", "default": "Residences <em>for sale now<\/em>" },
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_heading", "label": "Show the heading", "default": true},
    {"type": "text", "id": "label", "label": "Small label above the heading (optional)"},
    {"type": "checkbox", "id": "show_cars", "label": "Garage count on the cards", "default": true},
    {"type": "checkbox", "id": "show_build", "label": "Build size on the cards", "default": false},
    {"type": "checkbox", "id": "show_land", "label": "Land size on the cards", "default": false},
    {"type": "header", "content": "Layout"},
    {"type": "range", "id": "count", "label": "Residences shown (automatic row)", "min": 1, "max": 6, "step": 1, "default": 3, "info": "Hand-picked Residence blocks all show."},
    {"type": "select", "id": "columns", "label": "Cards across", "options": [{"value": "2", "label": "Two"}, {"value": "3", "label": "Three"}, {"value": "4", "label": "Four"}], "default": "3"},
    {"type": "select", "id": "card_shape", "label": "Card shape", "options": [{"value": "16/10", "label": "Landscape 16:10"}, {"value": "4/3", "label": "Landscape 4:3"}, {"value": "3/2", "label": "Landscape 3:2"}, {"value": "16/9", "label": "Wide 16:9"}, {"value": "1/1", "label": "Square"}, {"value": "4/5", "label": "Portrait 4:5"}], "default": "4/3"},
    {"type": "range", "id": "gap", "label": "Gap between cards", "min": 0, "max": 40, "step": 2, "default": 10, "unit": "px"},
    {"type": "header", "content": "Button (optional)"},
    {"type": "text", "id": "cta_label", "label": "Button label", "info": "Leave empty for no button."},
    {"type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to the For Sale page."},
    {"type": "header", "content": "Share row (under the residences)"},
    {"type": "checkbox", "id": "show_share", "label": "Show the share row", "default": true},
    {"type": "text", "id": "share_label", "label": "Share label", "default": "Share"},
    {"type": "text", "id": "copy_link_label", "label": "Copy link button", "default": "Copy link"},
    {"type": "header", "content": "Look"},
    {"type": "paragraph", "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}, {"value": "media", "label": "A photo or film behind it (below)"}], "default": "design", "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#F0EADE", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "header", "content": "Backdrop photo or film", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "paragraph", "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "image_picker", "id": "look_image", "label": "Backdrop photo", "info": "Also the poster while a backdrop film loads.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "video", "id": "look_video", "label": "Backdrop film (upload)", "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "checkbox", "id": "look_media_link", "label": "Use a film link instead of an upload", "default": false, "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "text", "id": "look_video_url", "label": "Backdrop film (URL)", "info": "A direct .mp4 link, used when no backdrop film is uploaded above.", "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"},
    {"type": "range", "id": "look_dim", "label": "Darken the backdrop", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Lower = brighter. The words stay readable down to about 40%.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_focus", "label": "Backdrop crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_media_tone", "label": "Words over the backdrop", "options": [{"value": "dark", "label": "Light words on a darkened backdrop"}, {"value": "light", "label": "Dark words on a pale backdrop"}], "default": "dark", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."}
  ],
  "blocks": [
    {
      "type": "residence",
      "name": "Residence",
      "settings": [
        {"type": "page", "id": "page", "label": "Residence page", "info": "The residence's page (Content › Pages). Leads over the product below; the residences moved to pages on 15 Sep 2026."},
        {"type": "product", "id": "product", "label": "Residence", "info": "A residence from Products. It shows here whatever its Status; the residence being viewed is skipped."}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "More Sabdia residences" }]
}
{% endschema %}
