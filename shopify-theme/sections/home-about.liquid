        var lx = null;
        lb.addEventListener('touchstart', function (e) { lx = e.changedTouches[0].clientX; }, { passive: true });
        lb.addEventListener('touchend', function (e) {
          if (lx === null) return;
          var dx = e.changedTouches[0].clientX - lx; lx = null;
          if (n > 1 && Math.abs(dx) > 40) view(at + (dx < 0 ? 1 : -1));
        }, { passive: true });
      }

      strip.addEventListener('pointerenter', function (e) { if (e.pointerType !== 'touch') { hover = true; sync(); } });
      strip.addEventListener('pointerleave', function (e) { if (e.pointerType !== 'touch') { hover = false; sync(); } });
      document.addEventListener('visibilitychange', function () { hidden = !!document.hidden; sync(); });
      document.addEventListener('shopify:section:unload', function (e) {
        if (!e.target || !e.target.contains(strip)) return;
        stop();
        if (lb) { viewing = false; document.documentElement.style.overflow = ''; lb.remove(); }
      });
      // In the editor, selecting a Strip image block brings its photo forward
      // and holds it there until the block is deselected.
      document.addEventListener('shopify:block:select', function (e) {
