{%- comment -%}
  Port of the homepage About section - sticky heading + image strip on
  the left, paragraphs, signature, numbered values and CTA on the right.
{%- endcomment -%}
<section class="sp{% if section.settings.vals_caps == false %} about-vals-serif{% endif %}" id="about">
  <div class="inner about-grid">
    <div class="about-sticky">
      <div class="slabel reveal">{{ section.settings.label }}</div>
      <h2 class="about-h reveal d1">{{ section.settings.heading_html }}</h2>
      {%- liquid
        assign strip_h = section.settings.strip_height | default: 240
        assign strip_hm = section.settings.strip_height_mobile | default: 160
        assign strip_gap = section.settings.strip_gap | default: 8
        case section.settings.strip_split
          when 'equal'
            assign strip_cols = '1fr 1fr'
            assign w1 = 700
            assign w2 = 700
          when 'small-large'
            assign strip_cols = '1fr 2fr'
            assign w1 = 500
            assign w2 = 900
          when 'single'
            assign strip_cols = '1fr'
            assign w1 = 1400
            assign w2 = 1400
          else
            assign strip_cols = '2fr 1fr'
            assign w1 = 900
            assign w2 = 500
        endcase
        # Request the crop at twice the display height for retina screens.
        assign ih = strip_h | times: 2.5 | round
      -%}
      {%- comment -%} Two photo slots, as before. With "Rotate" on and more than two
          Strip images, each slot crossfades through the set - always two
          photos showing, always changing. {%- endcomment -%}
      {%- assign strip_imgs = section.blocks | where: 'type', 'image' -%}
      {%- assign rotate = false -%}
      {%- if section.settings.strip_rotate and strip_imgs.size > 2 and strip_cols != '1fr' -%}{%- assign rotate = true -%}{%- endif -%}
      <div class="about-img-strip reveal-wipe d2{% if rotate %} about-strip-rotate{% endif %}" style="--strip-h:{{ strip_h }}px;--strip-h-m:{{ strip_hm }}px;--strip-gap:{{ strip_gap }}px;--strip-cols:{{ strip_cols }}"{% if rotate %} data-about-rotate data-every="{{ section.settings.strip_every | default: 5 }}"{% endif %}>
        {%- if rotate -%}
          {%- for slot in (0..1) -%}
            {%- if slot == 0 -%}{%- assign iw = w1 -%}{%- else -%}{%- assign iw = w2 -%}{%- endif -%}
            <div class="about-slot" data-slot="{{ slot }}">
              {%- for block in strip_imgs -%}
                {%- assign focus = block.settings.focus | default: 'center' -%}
                {%- assign on = false -%}
                {%- if forloop.index0 == slot -%}{%- assign on = true -%}{%- endif -%}
                {%- if block.settings.image -%}
                  <img class="about-slide{% if on %} is-on{% endif %}" src="{{ block.settings.image | image_url: width: iw, height: ih, crop: focus }}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {% if slot == 0 %}{{ block.shopify_attributes }}{% endif %}>
                {%- elsif block.settings.ext != blank -%}
                  <img class="about-slide{% if on %} is-on{% endif %}" src="{% render 'ext-variant', src: block.settings.ext, w: iw, h: ih %}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {% if slot == 0 %}{{ block.shopify_attributes }}{% endif %}>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        {%- else -%}
        {%- assign img_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            {%- liquid
              if img_i == 0
                assign iw = w1
              else
                assign iw = w2
              endif
              assign img_i = img_i | plus: 1
              assign focus = block.settings.focus | default: 'center'
            -%}
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: iw, height: ih, crop: focus }}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {{ block.shopify_attributes }}>
            {%- elsif block.settings.ext != blank -%}
              <img src="{% render 'ext-variant', src: block.settings.ext, w: iw, h: ih %}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {{ block.shopify_attributes }}>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'paragraph' -%}
          <p class="about-p reveal d2" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.sig_name != blank -%}
      <div class="sig reveal d3" style="--sig-size:{{ section.settings.sig_size | default: 14 }}px">
        <div class="sig-name">{{ section.settings.sig_name }}</div>
        <div class="sig-title">{{ section.settings.sig_title }}</div>
      </div>
      {%- endif -%}
      <div class="about-vals reveal d4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="about-val" {{ block.shopify_attributes }}>
              <span class="about-val-n">{{ block.settings.n }}</span>
              <div><div class="about-val-t">{{ block.settings.title }}</div><div class="about-val-d">{{ block.settings.desc }}</div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="reveal d5" style="margin-top:40px">
        <a href="{{ section.settings.cta_link }}" class="btn-g">{{ section.settings.cta_label }} &rarr;</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-about-rotate]').forEach(function (strip) {
      if (strip.dataset.init) return;
      strip.dataset.init = '1';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var slots = strip.querySelectorAll('.about-slot');
      var n = slots[0] ? slots[0].querySelectorAll('.about-slide').length : 0;
      if (n < 3) return;
      var every = (Number(strip.dataset.every) || 5) * 1000, offset = 0, timer = null;
      function show() {
        slots.forEach(function (slot, k) {
          var imgs = slot.querySelectorAll('.about-slide');
          for (var i = 0; i < imgs.length; i++) imgs[i].classList.toggle('is-on', i === (offset + k) % n);
        });
      }
      function tick() { offset = (offset + 1) % n; show(); }
      function start() { if (!timer) timer = setInterval(tick, every); }
      function stop() { clearInterval(timer); timer = null; }
      strip.addEventListener('mouseenter', stop);
      strip.addEventListener('mouseleave', start);
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
      start();
    });
  })();
</script>

{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "About Sabdia"
    },
    {
      "type": "html",
      "id": "heading_html",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "vals_caps",
      "label": "Value titles as small capitals under the heading",
      "default": true,
      "info": "On since 10 Sep 2026 (Tamsin): the heading leads, the three titles read as sub-headings. Off restores the serif titles."
    },
    {
      "type": "header",
      "content": "Image strip"
    },
    {
      "type": "select",
      "id": "strip_split",
      "label": "Layout",
      "options": [
        { "value": "large-small", "label": "Large + small (2:1)" },
        { "value": "equal", "label": "Two equal" },
        { "value": "small-large", "label": "Small + large (1:2)" },
        { "value": "single", "label": "One image, full width" }
      ],
      "default": "large-small",
      "info": "With one image selected, only the first Strip image block shows."
    },
    {
      "type": "checkbox",
      "id": "strip_rotate",
      "label": "Rotate through every Strip image",
      "default": true,
      "info": "Two photos always show; with three or more Strip image blocks they crossfade through the set (Tamsin, 10 Sep 2026: more images, carousel feel). Off = the first two stay put."
    },
    {
      "type": "range",
      "id": "strip_every",
      "label": "Change every",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "strip_height",
      "label": "Height",
      "min": 120,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "strip_height_mobile",
      "label": "Height on phones",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "strip_gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Signature"
    },
    {
      "type": "text",
      "id": "sig_name",
      "label": "Signature name",
      "info": "A person, e.g. the founder. Leave empty to hide the signature; a company name here reads as a stray label."
    },
    {
      "type": "text",
      "id": "sig_title",
      "label": "Signature title"
    },
    {
      "type": "range",
      "id": "sig_size",
      "label": "Signature size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14,
      "info": "Naomi, 11 Sep 2026: bigger than the 10.5px labels."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "About Sabdia"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Button link",
      "default": "/pages/about"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Strip image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "ext",
          "label": "Current photo (URL)",
          "info": "The photo showing now is loaded from this address. Choose an image above and it takes over - you never need to edit this field."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "select",
          "id": "focus",
          "label": "Crop focus",
          "options": [
            { "value": "center", "label": "Centre" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "info": "Which part of the photo to keep when it is cropped to the strip height."
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "n",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
