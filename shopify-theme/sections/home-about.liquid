{%- comment -%}
  Port of the homepage About section - sticky heading + image strip on
  the left, paragraphs, signature, numbered values and CTA on the right.

  Image strip (11 Sep 2026): two slots that carousel through every Strip
  image block. Slot k shows image (offset + k) mod n, so on each tick the
  right-hand photo moves into the left-hand slot (a conveyor) while a new
  one arrives on the right. Each incoming photo fades in with a short drift
  from the right; reduced motion gets a plain swap.

  15 Sep 2026 (Naomi): One image, full width rotates too, one slot through
  the whole set, and Photo fit "Whole photo" (the default) shows every
  photograph complete, never cropped or stretched. The theme editor never
  re-runs this script after a setting change; assets/main.js does that for
  every section.

  Later on 15 Sep 2026 (Naomi): arrows (and swipe) to step through the
  photos, a click opens the full-screen viewer (the gallery's .lb styles),
  and any photo a section higher on the page already shows (the Featured
  residence photo) is left out of the strip.
{%- endcomment -%}
{% render 'section-look', section: section %}
{%- liquid
  assign ha_layout = section.settings.layout | default: 'beside'
  assign ha_split = section.settings.split | default: '5-7'
  assign ha_strip = section.settings.strip_position | default: 'heading'
  if section.settings.show_strip == false
    assign ha_strip = 'none'
  endif
-%}
<section class="sp ha ha-{{ ha_layout }} ha-split-{{ ha_split }}{% if section.settings.vals_caps == false %} about-vals-serif{% endif %}{% if section.settings.values_layout == 'columns' %} ha-vals-cols{% endif %}{% if section.settings.show_numbers == false %} ha-nonum{% endif %}{% if section.settings.serif_text %} ha-serif{% endif %}{% if section.settings.drop_cap %} ha-dropcap{% endif %}{% if section.settings.first_lead == false %} ha-nolead{% endif %}" id="about">
  <div class="inner about-grid">
    <div class="{% if section.settings.sticky and ha_layout == 'beside' %}about-sticky{% endif %}">
      {%- if section.settings.show_label -%}<div class="slabel reveal">{{ section.settings.label }}</div>{%- endif -%}
      {%- if section.settings.show_heading -%}<h2 class="about-h reveal d1">{{ section.settings.heading_html }}</h2>{%- endif -%}
      {%- capture about_strip -%}
      {%- liquid
        assign strip_h = section.settings.strip_height | default: 300
        assign strip_hm = section.settings.strip_height_mobile | default: 200
        assign strip_gap = section.settings.strip_gap | default: 8
        assign strip_every = section.settings.strip_every | default: 2.5
        case section.settings.strip_split
          when 'equal'
            assign strip_cols = '1fr 1fr'
            assign w1 = 700
            assign w2 = 700
          when 'small-large'
            assign strip_cols = '1fr 2fr'
            assign w1 = 500
            assign w2 = 900
          when 'single'
            assign strip_cols = '1fr'
            assign w1 = 1400
            assign w2 = 1400
          when 'large-small'
            assign strip_cols = '2fr 1fr'
            assign w1 = 900
            assign w2 = 500
          else
            # landscape-portrait (default): a wide slot on the left, an upright one on the right.
            assign strip_cols = '1.7fr 1fr'
            assign w1 = 900
            assign w2 = 500
        endcase
        # Request the crop at twice the display height for retina screens.
        assign ih = strip_h | times: 2.5 | round
        # Whole photo fetches each photo at its own shape and fits it inside
        # its frame; Fill the frame is the earlier cropped look. image_url with
        # a height always crops (crop=center), so whole photos are asked for by
        # width only, sized so the height still covers ih.
        assign strip_fit = section.settings.strip_fit | default: 'whole'
        assign slot_count = 2
        if strip_cols == '1fr'
          assign slot_count = 1
        endif
        # With one image the frame takes the photographs' own shape (the first
        # landscape one, 3:2 for every Sabdia shoot), so a landscape photo fills
        # it edge to edge and an upright one sits whole in the middle.
        assign strip_ratio = 1.5
        for b in section.blocks
          if b.type == 'image' and b.settings.image and b.settings.image.aspect_ratio >= 1
            assign strip_ratio = b.settings.image.aspect_ratio
            break
          endif
        endfor
      -%}
      {%- comment -%} One or two photo slots. With more Strip images than slots,
          each slot holds the whole set: the arrows step through it, and with
          "Rotate" on it also carousels by itself - the slots always full.
          {%- endcomment -%}
      {%- assign strip_imgs = section.blocks | where: 'type', 'image' -%}
      {%- assign rotate = false -%}
      {%- if strip_imgs.size > slot_count -%}{%- assign rotate = true -%}{%- endif -%}
      {%- assign last_slot = slot_count | minus: 1 -%}
      <div class="about-img-strip reveal-wipe d2 about-fit-{{ strip_fit }}{% if rotate %} about-strip-rotate{% endif %}{% if strip_cols == '1fr' %} about-strip-single{% endif %}" style="--strip-h:{{ strip_h }}px;--strip-h-m:{{ strip_hm }}px;--strip-gap:{{ strip_gap }}px;--strip-ratio:{{ strip_ratio }};--strip-cols:{{ strip_cols }}"{% if rotate %} data-about-rotate{% if section.settings.strip_rotate %} data-every="{{ strip_every }}"{% endif %}{% endif %}{% if section.settings.strip_lightbox %} data-lightbox{% endif %}{% if section.settings.strip_skip_used %} data-skip-used{% endif %}>
        {%- if rotate -%}
          {%- for slot in (0..last_slot) -%}
            {%- if slot == 0 -%}{%- assign iw = w1 -%}{%- else -%}{%- assign iw = w2 -%}{%- endif -%}
            <div class="about-slot" data-slot="{{ slot }}">
              {%- for block in strip_imgs -%}
                {%- liquid
                  assign focus = block.settings.focus | default: 'center'
                  assign on = false
                  if forloop.index0 == slot
                    assign on = true
                  endif
                  # The photo each slot opens with is fetched straight away; the
                  # rest are lazy, and the script wakes the next one a tick ahead.
                  if on
                    assign load = 'loading="eager"'
                  else
                    assign load = 'loading="lazy" fetchpriority="low"'
                  endif
                -%}
                {%- if block.settings.image -%}
                  {%- if strip_fit == 'fill' -%}
                  <img class="about-slide{% if on %} is-on{% endif %}" data-full="{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{% render 'ext-variant', src: block.settings.ext, w: 2400, h: 1600 %}{% endif %}" data-block-id="{{ block.id }}" src="{{ block.settings.image | image_url: width: iw, height: ih, crop: focus }}" alt="{{ block.settings.alt | escape }}" {{ load }} decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {% if slot == 0 %}{{ block.shopify_attributes }}{% endif %}>
                  {%- else -%}
                  {%- liquid
                    assign fw = ih | times: block.settings.image.aspect_ratio | round
                    if fw > iw
                      assign fw = iw
                    endif
                  -%}
                  <img class="about-slide{% if on %} is-on{% endif %}" data-full="{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{% render 'ext-variant', src: block.settings.ext, w: 2400, h: 1600 %}{% endif %}" data-block-id="{{ block.id }}" src="{{ block.settings.image | image_url: width: fw }}" alt="{{ block.settings.alt | escape }}" {{ load }} decoding="async" width="{{ fw }}" height="{{ fw | divided_by: block.settings.image.aspect_ratio | round }}" {% if slot == 0 %}{{ block.shopify_attributes }}{% endif %}>
                  {%- endif -%}
                {%- elsif block.settings.ext != blank -%}
                  <img class="about-slide{% if on %} is-on{% endif %}" data-full="{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{% render 'ext-variant', src: block.settings.ext, w: 2400, h: 1600 %}{% endif %}" data-block-id="{{ block.id }}" src="{% render 'ext-variant', src: block.settings.ext, w: iw, h: ih %}" alt="{{ block.settings.alt | escape }}" {{ load }} decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {% if slot == 0 %}{{ block.shopify_attributes }}{% endif %}>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
          {%- if section.settings.strip_arrows -%}
          <button class="about-arrow about-arrow-prev" type="button" aria-label="Previous photo" data-about-prev>&larr;</button>
          <button class="about-arrow about-arrow-next" type="button" aria-label="Next photo" data-about-next>&rarr;</button>
          {%- endif -%}
        {%- else -%}
        {%- assign img_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            {%- liquid
              if img_i == 0
                assign iw = w1
              else
                assign iw = w2
              endif
              assign img_i = img_i | plus: 1
              assign focus = block.settings.focus | default: 'center'
            -%}
            {%- if block.settings.image -%}
              {%- if strip_fit == 'fill' -%}
              <img data-full="{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{% render 'ext-variant', src: block.settings.ext, w: 2400, h: 1600 %}{% endif %}" data-block-id="{{ block.id }}" src="{{ block.settings.image | image_url: width: iw, height: ih, crop: focus }}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {{ block.shopify_attributes }}>
              {%- else -%}
              {%- liquid
                assign fw = ih | times: block.settings.image.aspect_ratio | round
                if fw > iw
                  assign fw = iw
                endif
              -%}
              <img data-full="{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{% render 'ext-variant', src: block.settings.ext, w: 2400, h: 1600 %}{% endif %}" data-block-id="{{ block.id }}" src="{{ block.settings.image | image_url: width: fw }}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" width="{{ fw }}" height="{{ fw | divided_by: block.settings.image.aspect_ratio | round }}" {{ block.shopify_attributes }}>
              {%- endif -%}
            {%- elsif block.settings.ext != blank -%}
              <img data-full="{% if block.settings.image %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{% render 'ext-variant', src: block.settings.ext, w: 2400, h: 1600 %}{% endif %}" data-block-id="{{ block.id }}" src="{% render 'ext-variant', src: block.settings.ext, w: iw, h: ih %}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" width="{{ iw }}" height="{{ ih }}" style="object-position:{{ focus }}" {{ block.shopify_attributes }}>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- endif -%}
      </div>
      {%- endcapture -%}
      {%- if ha_strip == 'heading' -%}{{ about_strip }}{%- endif -%}
    </div>
    <div>
      {%- if ha_strip == 'top' -%}<div class="ha-strip-top">{{ about_strip }}</div>{%- endif -%}
      {%- if section.settings.show_paragraphs -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'paragraph' -%}
          <p class="about-p reveal d2" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.sig_name != blank and section.settings.show_sig -%}
      <div class="sig reveal d3" style="--sig-size:{{ section.settings.sig_size | default: 14 }}px">
        <div class="sig-name">{{ section.settings.sig_name }}</div>
        <div class="sig-title">{{ section.settings.sig_title }}</div>
      </div>
      {%- endif -%}
      {%- if section.settings.show_values -%}
      <div class="about-vals reveal d4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="about-val" {{ block.shopify_attributes }}>
              {%- if section.settings.show_numbers -%}<span class="about-val-n">{{ block.settings.n }}</span>{%- endif -%}
              <div><div class="about-val-t">{{ block.settings.title }}</div><div class="about-val-d">{{ block.settings.desc }}</div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- if ha_strip == 'bottom' -%}<div class="ha-strip-bottom">{{ about_strip }}</div>{%- endif -%}
      {%- if section.settings.show_button and section.settings.cta_label != blank -%}
      <div class="reveal d5" style="margin-top:40px">
        <a href="{{ section.settings.cta_link }}" class="{% if section.settings.button_style == 'solid' %}btn-p{% else %}btn-g{% endif %}">{{ section.settings.cta_label }} &rarr;</a>
      </div>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.strip_lightbox and ha_strip != 'none' -%}
  <div class="lb about-lb" id="about-lb-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <img alt="" decoding="async">
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">&larr;</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">&rarr;</button>
    <button class="lb-close" type="button" aria-label="Close">&#10005;</button>
    <div class="lb-meta"><span class="lb-cap"></span><span class="lb-count"></span></div>
  </div>
  {%- endif -%}
</section>

<style>
  /* style.css hides every image after the first whenever the inline style
     merely contains "--strip-cols:1fr", which also catches "1fr 1fr" and
     "1fr 2fr". Only the single layout (marked .about-strip-single) should
     hide them; the other layouts get their images back here. */
  .about-grid .about-img-strip:not(.about-strip-single) img:not(:first-child){display:block}
  /* The same style.css rule would hide every rotating slide but the first in
     One image, full width, freezing it on one photo; the slides stack in
     their slot and the script fades them in turn. */
  .about-grid .about-img-strip.about-strip-rotate .about-slide{display:block}
  /* style.css also sizes every strip img to the strip height (200px on
     phones); a rotating slide always fills its own slot instead, which with
     one image takes the photos' shape rather than a fixed height. */
  .about-img-strip.about-strip-rotate .about-slide{height:100%}
  /* Whole photo: fitted inside the frame, never cropped or stretched. The
     frame has no fill, so any space beside an upright photo is the page. */
  .about-img-strip.about-fit-whole img{object-fit:contain}
  .about-img-strip.about-fit-whole .about-slot{background:transparent}
  .about-img-strip.about-fit-whole.about-strip-single .about-slot,
  .about-img-strip.about-fit-whole.about-strip-single > img{height:auto;aspect-ratio:var(--strip-ratio,1.5)}
  @media(min-width:1201px){
    .ha-above .about-grid{grid-template-columns:1fr;gap:40px}
    .ha-split-equal .about-grid{grid-template-columns:1fr 1fr}
    .ha-split-4-8 .about-grid{grid-template-columns:4fr 8fr}
    .ha-split-7-5 .about-grid{grid-template-columns:7fr 5fr}
  }
  .ha-above .about-sticky{position:static}
  .ha-strip-top .about-img-strip{margin-top:0;margin-bottom:40px}
  .ha-strip-bottom .about-img-strip{margin-top:44px}
  .ha-vals-cols .about-vals{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .ha-vals-cols .about-val{flex-direction:column;gap:10px;border:0!important;padding:0}
  @media(max-width:768px){.ha-vals-cols .about-vals{grid-template-columns:1fr;gap:20px}}
  .ha-serif .about-p{font-family:var(--font-d);font-size:calc(var(--t-lead)*var(--s-t,1));line-height:1.6;color:var(--ink2);letter-spacing:0}
  .ha-dropcap .about-p:first-of-type::first-letter{font-size:3.2em;float:left;line-height:.82;padding-right:12px;color:var(--ink);font-style:italic}
  .ha-nolead .about-p:first-of-type{font-size:calc(var(--t-body)*var(--s-t,1));line-height:var(--lh-body);letter-spacing:.018em;color:var(--ink3);max-width:560px}
  .ha-nolead .about-p:first-of-type + .about-p{margin-top:20px}
  /* Carousel motion for the rotating strip (style.css keeps the base 1.4 s
     crossfade for anything else). Resting slides sit 8px to the right at
     opacity 0; the one switched on drifts to 0 as it fades in, on top; the
     one switched off holds still while it fades so nothing moves against
     the conveyor. */
  .about-strip-rotate .about-slide{opacity:0;transform:translateX(8px);transition:opacity .7s var(--ease2),transform .7s var(--ease2)}
  .about-strip-rotate .about-slide.is-on{opacity:1;transform:none;z-index:1}
  .about-strip-rotate .about-slide.is-out{transform:none}
  @media (prefers-reduced-motion: reduce){
    .about-strip-rotate .about-slide,
    .about-strip-rotate .about-slide.is-out{transition:none;transform:none}
  }
  /* Arrows: the photo gallery carousel's round buttons, over the strip's
     edges. A backward step drifts in from the left. */
  .about-img-strip{position:relative}
  .about-arrow{position:absolute;top:50%;z-index:3;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;border:1px solid rgba(var(--gold2-rgb),.5);background:rgba(var(--dark-rgb),.55);color:var(--gold2);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;line-height:1;font-family:var(--font-u);opacity:.85;transition:background .3s,opacity .3s}
  .about-img-strip:hover .about-arrow,.about-arrow:focus-visible{opacity:1}
  .about-arrow:hover{background:rgba(var(--dark-rgb),.82)}
  .about-arrow:focus-visible,.about-img-strip [role="button"]:focus-visible{outline:2px solid var(--gold2);outline-offset:3px}
  .about-arrow-prev{left:10px}
  .about-arrow-next{right:10px}
  .about-arrow[hidden]{display:none}
  @media(max-width:768px){.about-arrow{width:36px;height:36px;font-size:14px}.about-arrow-prev{left:8px}.about-arrow-next{right:8px}}
  .about-img-strip[data-lightbox] img{cursor:zoom-in}
  .about-strip-rotate.is-back .about-slide{transform:translateX(-8px)}
  .about-strip-rotate.is-back .about-slide.is-on,.about-strip-rotate.is-back .about-slide.is-out{transform:none}
  /* The full-screen viewer uses the gallery's .lb styles from style.css. */
  .about-lb[hidden],.about-lb [hidden]{display:none}
  .about-lb .lb-count{opacity:.7}
</style>

<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function list(nodes) { return Array.prototype.slice.call(nodes); }
    // A photo's file name without the CDN folder, size or version, so the same
    // photograph matches whatever width another section asked for.
    function fileName(u) {
      u = String(u || '').trim().split(/\s+/)[0].split('#')[0].split('?')[0];
      var f = u.slice(u.lastIndexOf('/') + 1);
      try { f = decodeURIComponent(f); } catch (e) {}
      return f.toLowerCase().replace(/(_\d+x\d*|_x\d+|@\dx)(?=\.\w+$)/, '');
    }
    // Every photograph the sections above this one already show.
    function shownAbove(wrap) {
      var seen = {};
      function add(u) { var f = fileName(u); if (/\.\w+$/.test(f)) seen[f] = true; }
      for (var el = wrap && wrap.previousElementSibling; el; el = el.previousElementSibling) {
        list(el.querySelectorAll('img,source,video')).forEach(function (m) {
          add(m.getAttribute('src')); add(m.getAttribute('poster')); add(m.getAttribute('data-src'));
          (m.getAttribute('srcset') || '').split(',').forEach(add);
        });
        list(el.querySelectorAll('[style*="url("]')).forEach(function (m) {
          (m.getAttribute('style').match(/url\([^)]+\)/g) || []).forEach(function (x) { add(x.slice(4, -1).replace(/["']/g, '')); });
        });
      }
      return seen;
    }

    list(document.querySelectorAll('.about-img-strip')).forEach(function (strip) {
      if (strip.dataset.init) return;
      strip.dataset.init = '1';
      var wrap = strip.closest('.shopify-section') || strip.closest('section');
      var slots = list(strip.querySelectorAll('.about-slot'));
      var lists = slots.length
        ? slots.map(function (slot) { return list(slot.querySelectorAll('.about-slide')); })
        : [list(strip.querySelectorAll(':scope > img'))];

      // Leave out any photograph a section above already shows (the Featured
      // residence photo, say), as long as enough remain to fill the slots.
      if (strip.hasAttribute('data-skip-used')) {
        var seen = shownAbove(wrap);
        var keep = lists[0].map(function (img) { return !seen[fileName(img.getAttribute('src'))]; });
        var kept = keep.filter(Boolean).length;
        if (kept < keep.length && kept >= Math.max(1, slots.length)) {
          lists = lists.map(function (imgs, k) {
            imgs = imgs.filter(function (img, i) { if (!keep[i]) img.remove(); return keep[i]; });
            imgs.forEach(function (img, i) {
              img.classList.toggle('is-on', i === k);
              if (i === k) img.setAttribute('loading', 'eager');
            });
            return imgs;
          });
        }
      }

      var n = lists[0].length;
      var carousel = slots.length > 0 && n > slots.length;
      var auto = carousel && strip.hasAttribute('data-every');
      // data-every is seconds, possibly fractional ("2.5"); never faster than 1 s.
      var every = Math.max(1, parseFloat(strip.dataset.every) || 2.5) * 1000;
      var offset = 0, timer = null, hover = false, inView = true, hidden = !!document.hidden, viewing = false, pinned = false;
      var prev = strip.querySelector('[data-about-prev]'), next = strip.querySelector('[data-about-next]');
      if (!carousel) { if (prev) prev.hidden = true; if (next) next.hidden = true; }

      function wrapIndex(i) { return ((i % n) + n) % n; }
      // A step ahead: make sure the photo about to enter each slot is fetching.
      function warm(dir) {
        slots.forEach(function (slot, k) {
          var img = lists[k][wrapIndex(offset + dir + k)];
          if (img && !img.complete && img.getAttribute('loading') === 'lazy') img.setAttribute('loading', 'eager');
        });
      }
      // Slot k shows photo (offset + k) mod n, so going forward the right-hand
      // photo moves into the left-hand slot.
      function show(back) {
        strip.classList.toggle('is-back', !!back);
        lists.forEach(function (imgs, k) {
          var want = wrapIndex(offset + k);
          imgs.forEach(function (img, i) {
            var was = img.classList.contains('is-on'), on = i === want;
            img.classList.toggle('is-out', was && !on && !reduce);
            img.classList.toggle('is-on', on);
          });
        });
      }
      function go(dir) { if (!carousel) return; offset = wrapIndex(offset + dir); show(dir < 0); warm(dir < 0 ? -1 : 1); }
      function start() { if (auto && !timer) { warm(1); timer = setInterval(function () { go(1); }, every); } }
      function stop() { clearInterval(timer); timer = null; }
      // Runs only while pointed away from, on screen, in a visible tab, with the
      // viewer closed and no Strip image block selected in the editor.
      function sync() { if (!strip.isConnected) return stop(); (hover || hidden || !inView || viewing || pinned) ? stop() : start(); }
      // A step by hand restarts the wait, so the next photo gets its full time.
      function step(dir) { go(dir); stop(); sync(); }

      if (prev) prev.addEventListener('click', function () { step(-1); });
      if (next) next.addEventListener('click', function () { step(1); });
      // A swipe steps too. Only a click in the moment straight after a swipe is
      // ignored (so the swipe never opens the viewer); the next tap always works.
      var tx = null, ty = 0, swipedAt = 0;
      strip.addEventListener('touchstart', function (e) { tx = e.changedTouches[0].clientX; ty = e.changedTouches[0].clientY; }, { passive: true });
      strip.addEventListener('touchend', function (e) {
        if (tx === null) return;
        var dx = e.changedTouches[0].clientX - tx, dy = e.changedTouches[0].clientY - ty; tx = null;
        if (carousel && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { swipedAt = Date.now(); step(dx < 0 ? 1 : -1); }
      }, { passive: true });

      var lb = strip.hasAttribute('data-lightbox') && wrap ? wrap.querySelector('.about-lb') : null;
      if (lb) {
        // The viewer lives on <body>, clear of the reveal clip and the sticky
        // column; one left there by an earlier editor re-render is replaced.
        list(document.querySelectorAll('.about-lb')).forEach(function (other) { if (other !== lb && other.id === lb.id) other.remove(); });
        document.body.appendChild(lb);
        var lbImg = lb.querySelector('img'), cap = lb.querySelector('.lb-cap'), count = lb.querySelector('.lb-count');
        var at = 0, lastFocus = null, closing = null;
        var full = function (i) { var img = lists[0][wrapIndex(i)]; return img.getAttribute('data-full') || img.currentSrc || img.src; };
        function view(i) {
          at = wrapIndex(i);
          var img = lists[0][at];
          lbImg.src = full(at); lbImg.alt = img.alt; cap.textContent = img.alt; count.textContent = (at + 1) + ' / ' + n;
          if (n > 1) { new Image().src = full(at + 1); new Image().src = full(at - 1); }
        }
        function open(i) {
          clearTimeout(closing);
          lastFocus = document.activeElement;
          view(i);
          lb.hidden = false; void lb.offsetWidth; lb.classList.add('open');
          document.documentElement.style.overflow = 'hidden';
          viewing = true; sync();
          lb.querySelector('.lb-close').focus({ preventScroll: true });
        }
        function close() {
          if (!viewing) return;
          viewing = false;
          lb.classList.remove('open');
          document.documentElement.style.overflow = '';
          // The strip carries on from the photo last looked at.
          if (carousel && at !== offset) { offset = at; show(false); warm(1); }
          closing = setTimeout(function () { lb.hidden = true; }, 350);
          if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
          sync();
        }
        function openFrom(target) {
          var slot = target.closest('.about-slot');
          var img = target.closest('img') || (slot && slot.querySelector('.about-slide.is-on'));
          if (!img) return;
          for (var k = 0; k < lists.length; k++) { var i = lists[k].indexOf(img); if (i !== -1) return open(i); }
        }
        strip.addEventListener('click', function (e) {
          if (Date.now() - swipedAt < 350) return;
          if (e.target.closest('.about-arrow')) return;
          openFrom(e.target);
        });
        (slots.length ? slots : lists[0]).forEach(function (el) {
          el.tabIndex = 0; el.setAttribute('role', 'button'); el.setAttribute('aria-label', 'View this photo full screen');
        });
        strip.addEventListener('keydown', function (e) {
          if ((e.key === 'Enter' || e.key === ' ') && !e.target.closest('.about-arrow')) { e.preventDefault(); openFrom(e.target); }
        });
        lb.querySelector('.lb-prev').addEventListener('click', function () { view(at - 1); });
        lb.querySelector('.lb-next').addEventListener('click', function () { view(at + 1); });
        lb.querySelector('.lb-close').addEventListener('click', close);
        lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
        if (n < 2) { lb.querySelector('.lb-prev').hidden = true; lb.querySelector('.lb-next').hidden = true; }
        document.addEventListener('keydown', function (e) {
          if (!viewing) return;
          if (e.key === 'Escape') close();
          else if (e.key === 'ArrowRight') view(at + 1);
          else if (e.key === 'ArrowLeft') view(at - 1);
