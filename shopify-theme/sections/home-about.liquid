{%- comment -%}
  Port of the homepage About section — sticky heading + image strip on
  the left, paragraphs, signature, numbered values and CTA on the right.
{%- endcomment -%}
<section class="sp" id="about">
  <div class="inner about-grid">
    <div class="about-sticky">
      <div class="slabel reveal">{{ section.settings.label }}</div>
      <h2 class="about-h reveal d1">{{ section.settings.heading_html }}</h2>
      <div class="about-img-strip reveal-wipe d2">
        {%- assign img_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            {%- liquid
              if img_i == 0
                assign iw = 900
                assign ih = 600
              else
                assign iw = 500
                assign ih = 600
              endif
              assign img_i = img_i | plus: 1
            -%}
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: iw, height: ih, crop: 'center' }}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" {{ block.shopify_attributes }}>
            {%- elsif block.settings.ext != blank -%}
              <img src="{% render 'ext-variant', src: block.settings.ext, w: iw, h: ih %}" alt="{{ block.settings.alt | escape }}" loading="lazy" decoding="async" {{ block.shopify_attributes }}>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'paragraph' -%}
          <p class="about-p reveal d2" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}
      <div class="sig reveal d3">
        <div class="sig-name">{{ section.settings.sig_name }}</div>
        <div class="sig-title">{{ section.settings.sig_title }}</div>
      </div>
      <div class="about-vals reveal d4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div class="about-val" {{ block.shopify_attributes }}>
              <span class="about-val-n">{{ block.settings.n }}</span>
              <div><div class="about-val-t">{{ block.settings.title }}</div><div class="about-val-d">{{ block.settings.desc }}</div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="reveal d5" style="margin-top:40px">
        <a href="{{ section.settings.cta_link }}" class="btn-g">{{ section.settings.cta_label }} &rarr;</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "About Sabdia"
    },
    {
      "type": "html",
      "id": "heading_html",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "sig_name",
      "label": "Signature name"
    },
    {
      "type": "text",
      "id": "sig_title",
      "label": "Signature title"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "About Sabdia"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Button link",
      "default": "/pages/about"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Strip image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "ext",
          "label": "Current photo (URL)",
          "info": "The photo showing now is loaded from this address. Choose an image above and it takes over — you never need to edit this field."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "n",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
