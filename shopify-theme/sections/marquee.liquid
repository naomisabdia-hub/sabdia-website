{%- comment -%} Port of the scrolling marquee band - items duplicated for the seamless loop. {%- endcomment -%}
<div class="mq-band">
  <div class="mq-track">
    {%- for dup in (1..2) -%}
      <div class="mq-group" {% if dup == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          {%- unless forloop.first -%}<div class="mq-sep"></div>{%- endunless -%}
          <div class="mq-item" {% if dup == 1 %}{{ block.shopify_attributes }}{% endif %}><svg width="10" height="10" viewBox="0 0 14 14" fill="#A8874A" aria-hidden="true"><polygon points="7,1 8.8,5.6 13.7,5.6 9.9,8.5 11.2,13.4 7,10.5 2.8,13.4 4.1,8.5 0.3,5.6 5.2,5.6"/></svg>{{ block.settings.text }}</div>
        {%- endfor -%}
        <div class="mq-sep"></div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Multi-Award Winning" }
      ]
    }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
