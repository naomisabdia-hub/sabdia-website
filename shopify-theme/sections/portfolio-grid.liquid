{%- comment -%}
  Collection - the completed residences only (For Sale has its own page;
  sold and completed are the same thing here). One editorial grid: wide
  and portrait tiles alternate, films play on hover, and a filter bar
  narrows by architectural style (Mediterranean, Palm Springs, Hamptons,
  Contemporary, Moroccan…) and by suburb.

  Each Residence block points at the residence's page (Content › Pages,
  template "collection-item"); its name, location, style, completed
  year, photo and film all come from that page's metafields, so a page
  edited in Pages updates the card too. The block's own fields only
  override.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign pcount = 0
  capture styles_raw
    for block in section.blocks
      assign rp = block.settings.page
      if rp == blank and block.settings.link contains '/pages/'
        assign rp_handle = block.settings.link | split: '/pages/' | last | split: '?' | first | split: '#' | first
        assign rp = pages[rp_handle]
      endif
      assign r_style = block.settings.style | default: rp.metafields.custom.style.value | strip
      if r_style != blank
        echo r_style | append: '¦'
      endif
    endfor
  endcapture
  assign styles = styles_raw | strip | split: '¦' | uniq | sort
  capture suburbs_raw
    for block in section.blocks
      assign rp = block.settings.page
      if rp == blank and block.settings.link contains '/pages/'
        assign rp_handle = block.settings.link | split: '/pages/' | last | split: '?' | first | split: '#' | first
        assign rp = pages[rp_handle]
      endif
      assign r_loc = block.settings.loc | default: rp.metafields.custom.loc.value
      assign r_suburb = r_loc | split: ',' | first | replace: ' QLD', '' | replace: ' Qld', '' | strip
      if r_suburb != blank
        echo r_suburb | append: '¦'
      endif
    endfor
  endcapture
  assign suburbs = suburbs_raw | strip | split: '¦' | uniq | sort
-%}

{%- if section.settings.show_filter and section.blocks.size > 3 -%}
<div class="pf-bar" data-pf-bar="{{ sid }}">
  <div class="inner pf-bar-inner">
    <div class="pf-chips" role="group" aria-label="Filter by style">
      <span class="pf-bar-l">{{ section.settings.filter_label }}</span>
      <button type="button" class="pfilter on" data-style="">{{ section.settings.filter_all }}</button>
      {%- for s in styles -%}
        <button type="button" class="pfilter" data-style="{{ s | escape }}">{{ s }}</button>
      {%- endfor -%}
    </div>
    {%- if suburbs.size > 1 -%}
    <select class="pf-sel" id="pfSuburb-{{ sid }}" aria-label="Filter by suburb">
      <option value="">{{ section.settings.all_suburbs | default: "All Suburbs" }}</option>
      {%- for s in suburbs -%}<option value="{{ s | escape }}">{{ s }}</option>{%- endfor -%}
    </select>
    {%- endif -%}
    <span class="pf-count" id="pfCount-{{ sid }}" aria-live="polite"></span>
  </div>
</div>
{%- endif -%}

<section class="pf-wrap" id="port-{{ sid }}">
  <div class="inner">
    <div class="pf-grid" id="pfGrid-{{ sid }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign rp = block.settings.page
          if rp == blank and block.settings.link contains '/pages/'
            assign rp_handle = block.settings.link | split: '/pages/' | last | split: '?' | first | split: '#' | first
            assign rp = pages[rp_handle]
          endif
          assign r_name = block.settings.name | default: rp.title
          assign r_loc = block.settings.loc | default: rp.metafields.custom.loc.value
          assign r_suburb = r_loc | split: ',' | first | replace: ' QLD', '' | replace: ' Qld', '' | strip
          assign r_style = block.settings.style | default: rp.metafields.custom.style.value | strip
          assign r_year = rp.metafields.custom.year.value
          assign r_image_ext = rp.metafields.custom.image.value | default: block.settings.image_ext
          if rp.metafields.custom.gallery.value.size > 0
            if r_image_ext == blank or r_image_ext contains '/films/'
              assign r_image_ext = rp.metafields.custom.gallery.value | first
            endif
          endif
          assign r_video = block.settings.video | default: rp.metafields.custom.video.value
          if block.settings.video_file
            assign pmp4 = block.settings.video_file.sources | where: 'format', 'mp4' | first
            if pmp4
              assign r_video = pmp4.url
            endif
          endif
          assign r_link = block.settings.link | default: rp.url
          assign pcount = pcount | plus: 1
          assign di = forloop.index0 | modulo: 3
        -%}
        {%- capture card_inner -%}
          <div class="pf-media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 1200, height: 900, crop: 'center' }}" alt="{{ r_name | escape }}{% if r_suburb != blank %}, {{ r_suburb | escape }}{% endif %}" width="1200" height="900" loading="lazy" decoding="async">
            {%- elsif r_image_ext != blank -%}
              <img src="{% render 'ext-variant', src: r_image_ext, w: 1200, h: 900 %}" alt="{{ r_name | escape }}{% if r_suburb != blank %}, {{ r_suburb | escape }}{% endif %}" width="1200" height="900" loading="lazy" decoding="async">
            {%- endif -%}
            {%- if r_video != blank -%}
              <video src="{{ r_video }}" muted loop playsinline preload="none" data-port-video></video>
              <span class="port-film-tag">{{ section.settings.film_tag | default: "Film" }}</span>
            {%- endif -%}
            {%- if r_style != blank and section.settings.style_on_card -%}
              <span class="pf-style">{{ r_style }}</span>
            {%- endif -%}
          </div>
          <div class="pf-info">
            <div class="pf-name">{{ r_name }}{% if r_link != blank %} <span aria-hidden="true">&rarr;</span>{% endif %}</div>
            <div class="pf-meta">{{ r_suburb }}{% if r_style != blank %} <i>&middot;</i> {{ r_style }}{% endif %}{% if r_year != blank %} <i>&middot;</i> {{ r_year }}{% endif %}</div>
          </div>
        {%- endcapture -%}
        {%- if r_link != blank -%}
          <a href="{{ r_link }}" class="pf-card reveal{% if di == 1 %} d1{% elsif di == 2 %} d2{% endif %}" data-port-card data-style="{{ r_style | escape }}" data-suburb="{{ r_suburb | escape }}" {{ block.shopify_attributes }}>{{ card_inner }}</a>
        {%- else -%}
          <div class="pf-card reveal{% if di == 1 %} d1{% elsif di == 2 %} d2{% endif %}" data-port-card data-style="{{ r_style | escape }}" data-suburb="{{ r_suburb | escape }}" {{ block.shopify_attributes }}>{{ card_inner }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <p class="pf-empty" id="pfEmpty-{{ sid }}" hidden>{{ section.settings.empty_text }}</p>
  </div>
</section>

<script>
  (function () {
    var grid = document.getElementById('pfGrid-{{ sid }}');
    if (!grid || grid.dataset.init) return;
    grid.dataset.init = '1';
    var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-port-card]'));
    var bar = document.querySelector('[data-pf-bar="{{ sid }}"]');
    var chips = bar ? Array.prototype.slice.call(bar.querySelectorAll('.pfilter')) : [];
    var suburb = document.getElementById('pfSuburb-{{ sid }}');
    var count = document.getElementById('pfCount-{{ sid }}');
    var empty = document.getElementById('pfEmpty-{{ sid }}');
    var style = '';
    /* Editorial rhythm: of every seven visible tiles the first and the
       last run wide (two columns); the rest stand portrait. Recomputed
       after each filter so the pattern never breaks on a hidden card. */
    function layout() {
      var n = 0;
      cards.forEach(function (c) {
        if (c.hidden) return;
        var k = n % 7;
        c.classList.toggle('is-wide', k === 0 || k === 6);
        n++;
      });
      return n;
    }
    function apply() {
      var sub = suburb ? suburb.value : '';
      cards.forEach(function (c) {
        var ok = true;
        if (style && c.dataset.style !== style) ok = false;
        if (ok && sub && c.dataset.suburb !== sub) ok = false;
        c.hidden = !ok;
        if (ok) c.classList.add('vis');
      });
      var n = layout();
      if (empty) empty.hidden = n > 0;
      if (count) count.textContent = (style || sub) ? n + (n === 1 ? ' Residence' : ' Residences') : '';
    }
    chips.forEach(function (b) {
      b.addEventListener('click', function () {
        chips.forEach(function (x) { x.classList.remove('on'); });
        b.classList.add('on');
        style = b.dataset.style || '';
        apply();
      });
    });
    if (suburb) suburb.addEventListener('change', apply);
    layout();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    cards.forEach(function (card) {
      var video = card.querySelector('[data-port-video]');
      if (!video) return;
      card.addEventListener('mouseenter', function () { video.play().then(function () { video.classList.add('playing'); }).catch(function () {}); });
      card.addEventListener('mouseleave', function () { video.pause(); video.classList.remove('playing'); });
    });
  })();
</script>


{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "paragraph", "content": "Completed residences only. Homes for sale live on their own page (For Sale); nothing from Products appears here. Add one Residence block per completed home and pick its page - the card fills itself from that page's metafields (Content › Pages › the residence › Metafields: Style, Completed year, Hero image, Film)." },
    { "type": "header", "content": "Filter bar" },
    { "type": "checkbox", "id": "show_filter", "label": "Show the filter bar", "default": true, "info": "Style chips come from each residence page's Style field; the suburb list from its Location line. Appears once there are four or more residences." },
    { "type": "checkbox", "id": "style_on_card", "label": "Show the style on the photo on hover", "default": true },
    { "type": "text", "id": "filter_label", "label": "Filter label", "default": "Style" },
    { "type": "text", "id": "filter_all", "label": "All chip", "default": "All" },
    { "type": "text", "id": "all_suburbs", "label": "All-suburbs option", "default": "All Suburbs" },
    { "type": "text", "id": "empty_text", "label": "No-matches text", "default": "Nothing matches those filters. Try widening them." },
    { "type": "text", "id": "film_tag", "label": "Film tag", "default": "Film" },
    { "type": "checkbox", "id": "show_current", "label": "(Retired) Include residences from Products", "default": false, "info": "No longer used - For Sale has its own page." }
  ],
  "blocks": [
    {
      "type": "residence",
      "name": "Residence",
      "settings": [
        { "type": "page", "id": "page", "label": "Residence page", "info": "Pick the completed residence's page (Content › Pages, theme template \"collection-item\"). Its name, location line, style, year, photo, film and link then fill in by themselves - the fields below only override." },
        { "type": "text", "id": "name", "label": "Name", "info": "Leave empty to use the page title." },
        { "type": "text", "id": "loc", "label": "Location line" },
        { "type": "text", "id": "style", "label": "Style (override)", "info": "Normally set on the page itself (Metafields › Style) so the residence page shows it too." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_ext", "label": "Current photo (URL)", "info": "The photo showing now is loaded from this address. Choose an image above and it takes over - you never need to edit this field." },
        { "type": "video", "id": "video_file", "label": "Hover film (upload, optional)" },
        { "type": "text", "id": "video", "label": "Current hover film (URL)", "info": "Upload a film above and it takes over." },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Collection grid" }
  ]
}
{% endschema %}
