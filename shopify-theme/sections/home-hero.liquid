{%- comment -%}
  Port of the homepage hero - full-screen slideshow, word-by-word title,
  description bar, slide dots, award line and CTAs. Slides are blocks:
  pick a Shopify image, or leave the external URL that carries today's
  image over from the Sabdia media pipeline.

  "Header media" switches the backdrop to a looping film instead of the
  slides. The slide blocks stay in place while the film shows, so
  switching back loses nothing. The film must be real footage (see
  CLAUDE.md - no generated architecture).
{%- endcomment -%}
{%- liquid
  # An uploaded film (Shopify-hosted) wins over the URL fallback.
  assign film_src = section.settings.video_url
  if section.settings.video
    assign mp4 = section.settings.video.sources | where: 'format', 'mp4' | first
    if mp4
      assign film_src = mp4.url
    endif
  endif
  assign use_video = false
  if section.settings.media == 'video' and film_src != blank
    assign use_video = true
  endif

  # Poster: the chosen poster, else the first slide's picture.
  assign poster_src = ''
  if section.settings.video_poster
    assign poster_src = section.settings.video_poster | image_url: width: 1920
  else
    assign first_slide = section.blocks | first
    if first_slide.settings.image
      assign poster_src = first_slide.settings.image | image_url: width: 1920
    elsif first_slide.settings.ext != blank
      capture poster_src
        render 'ext-variant', src: first_slide.settings.ext, w: 1920, h: 1080, q: 80
      endcapture
      assign poster_src = poster_src | strip
    endif
  endif
-%}
{%- assign dim = section.settings.overlay | default: 55 | divided_by: 100.0 -%}
{% render 'section-look', section: section, mode: 'hero' %}
{%- liquid
  case section.settings.height
    when 'tall'
      assign hero_h = '85svh'
    when 'standard'
      assign hero_h = '72svh'
    else
      assign hero_h = '100svh'
  endcase
-%}
<section class="hero{% if use_video %} hero-video{% endif %}{% if section.settings.ken_burns == false %} hero-still{% endif %}{% if section.settings.title_font == 'serif' %} h-title-serif{% endif %}{% if section.settings.show_bottom_rule == false %} h-norule{% endif %}" id="hero" style="--h-dim:{{ dim }};--hero-h:{{ hero_h }};--h-title:{{ section.settings.words_size | default: 30 }}px;--h-title-track:{{ section.settings.words_tracking | default: 28 }}">
  {%- if use_video -%}
  <div class="h-video" id="hVideo">
    <video
      src="{{ film_src }}"
      {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    ></video>
  </div>
  {%- else -%}
  <div class="h-slides" id="hSlides" data-every="{{ section.settings.slide_every | default: 6.2 | times: 1000 | round }}">
    {%- for block in section.blocks -%}
      <div class="h-slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img
            src="{{ block.settings.image | image_url: width: 1920 }}"
            srcset="{{ block.settings.image | image_url: width: 768 }} 768w, {{ block.settings.image | image_url: width: 1280 }} 1280w, {{ block.settings.image | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            alt="{{ block.settings.alt | escape }}" width="1920" height="1080"
            {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
        {%- elsif block.settings.ext != blank -%}
          {%- capture src -%}{% render 'ext-variant', src: block.settings.ext, w: 1920, h: 1080, q: 80 %}{%- endcapture -%}
          <picture>
            <source media="(max-width: 767px)" srcset="{% render 'ext-variant', src: block.settings.ext, w: 768, h: 1365, q: 80 %}" sizes="100vw">
            <img src="{{ src | strip }}" sizes="100vw" alt="{{ block.settings.alt | escape }}" width="1920" height="1080"
              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
          </picture>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}
  <div class="h-overlay"></div>

  {%- liquid
    assign hold = 0
    assign wpos = section.settings.words_position | default: 'centre'
    assign show_mark = false
    assign mark_hold = 0
    if use_video
      assign hold = section.settings.words_delay | default: 0
      if section.settings.show_wordmark
        assign show_mark = true
        assign mark_hold = section.settings.wordmark_delay | default: 0
      endif
    endif
    assign mark_src = 'logo.png' | asset_url
    if settings.logo
      assign mark_src = settings.logo | image_url: width: 800
    endif
  -%}
  {%- liquid
    assign loop_words = false
    if use_video and section.settings.words_loop
      assign loop_words = true
    endif
  -%}
  <div class="h-mid{% if wpos == 'low' %} h-mid-low{% elsif wpos == 'high' %} h-mid-high{% endif %}{% if loop_words %} h-js-words{% endif %}{% if show_mark %} has-mark{% endif %}" style="{% if hold > 0 %}--h-hold:{{ hold }}s;{% endif %}{% if show_mark %}--h-mark-hold:{{ mark_hold }}s;--h-mark-h:{{ section.settings.wordmark_size | default: 44 }}px;{% endif %}--h-eyebrow:{{ section.settings.eyebrow_size | default: 11 }}px;"{% if loop_words %} data-loop-words data-hold="{{ hold }}" data-mark-hold="{{ mark_hold }}" data-lead="{{ section.settings.words_fade_lead | default: 1 }}"{% endif %}>
    <div class="h-mid-content">
      {%- if show_mark -%}
        <img class="h-mark" src="{{ mark_src }}" alt="{{ settings.site_name | default: 'Sabdia' }}" width="800" height="160" loading="eager">
      {%- endif -%}
      {%- assign words_txt = section.settings.words | strip -%}
      {%- if section.settings.show_words == false -%}{%- assign words_txt = '' -%}{%- endif -%}
      {%- if words_txt == blank -%}
        <h1 class="sr-only">{{ settings.site_name | default: 'Sabdia' }} - {{ section.settings.eyebrow }}</h1>
      {%- else -%}
      <h1 class="h-title">
        {%- assign words = section.settings.words | split: ',' -%}
        {%- for word in words -%}
          {%- assign wi = forloop.index0 | times: 2 -%}
          {%- unless forloop.first -%}
            {%- assign di = wi | minus: 1 -%}
            <span class="h-title-dot h-w"><span class="h-w-in" style="--wi:{{ di }}">&nbsp;&middot;&nbsp;</span></span>
          {%- endunless -%}
          <span class="h-w"><span class="h-w-in" style="--wi:{{ wi }}">{{ word | strip }}</span></span>
        {%- endfor -%}
      </h1>
      {%- endif -%}
      <p class="h-eyebrow-txt">{{ section.settings.eyebrow }}</p>
    </div>
  </div>

  <div class="h-bottom">
    <div class="h-desc-bar inner">
      {%- if section.settings.show_description -%}<p class="h-desc">{{ section.settings.description }}</p>{%- endif -%}
    </div>
    <div class="h-bottom-rule"></div>
    <div class="h-bottom-inner inner">
      <div class="h-bottom-left">
        {%- unless use_video or section.settings.show_dots == false -%}
        <div class="h-dots" id="hDots">
          {%- for block in section.blocks -%}
            <button type="button" class="h-dot{% if forloop.first %} active{% endif %}" aria-label="Show slide {{ forloop.index }} of {{ section.blocks.size }}"></button>
          {%- endfor -%}
        </div>
        {%- endunless -%}
        {%- if section.settings.show_award and section.settings.award != blank -%}<p class="h-award"><em>{{ section.settings.award }}</em></p>{%- endif -%}
      </div>
      {%- if section.settings.show_buttons -%}
      <div class="h-actions">
        {%- if section.settings.cta1_label != blank -%}<a href="{{ section.settings.cta1_link }}" class="btn-p">{{ section.settings.cta1_label }} &rarr;</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link }}" class="btn-g btn-g-light">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.show_scroll_cue -%}
  <div class="h-scroll-wrap">
    {%- unless use_video -%}<span class="h-scroll-num">01 / {{ section.blocks.size | prepend: '00' | slice: -2, 2 }}</span>{%- endunless -%}
    <div class="h-scroll-line"></div>
  </div>
  {%- endif -%}
</section>
{%- if use_video -%}
<script>
  (function () {
    var v = document.querySelector('#hVideo video');
    if (!v) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
      v.pause();
      return;
    }
    // Some browsers ignore the autoplay attribute on late-loading media.
    var p = v.play();
    if (p && p.catch) p.catch(function () {});

    // "Replay with the film": the words and wordmark follow the film's
    // clock instead of a one-off CSS delay - they fade in at their set
    // second, fade out just before the film ends, and come back with
    // every loop, so they never sit on top of the film's own wordmark.
    var mid = document.querySelector('#hero .h-mid[data-loop-words]');
    if (mid && !mid.dataset.loopInit) {
      mid.dataset.loopInit = '1';
      var hold = Number(mid.dataset.hold || 0);
      var markHold = Number(mid.dataset.markHold || 0);
      var lead = Number(mid.dataset.lead || 1);
      function tick() {
        var d = v.duration;
        if (!d || !isFinite(d)) return;
        var t = v.currentTime;
        var ending = t > d - lead;
        mid.classList.toggle('words-on', t >= hold && !ending);
        mid.classList.toggle('mark-on', t >= markHold && !ending);
      }
      v.addEventListener('timeupdate', tick);
      v.addEventListener('seeked', tick);
      v.addEventListener('loadedmetadata', tick);
      // If the film never starts (autoplay refused, slow network), show the words anyway.
      setTimeout(function () { if (v.paused || !v.duration) mid.classList.add('words-on', 'mark-on'); }, 6000);
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    {
      "type": "header",
      "content": "Header media"
    },
    {
      "type": "select",
      "id": "media",
      "label": "Show",
      "options": [
        { "value": "slides", "label": "Slideshow" },
        { "value": "video", "label": "Video instead" }
      ],
      "default": "slides",
      "info": "Your slides are kept either way - switch back any time."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload the mp4 here. Landscape 16:9, real footage only, no sound needed (it plays muted). Under 20 MB keeps the page fast."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video (URL)",
      "info": "Used only when no video is uploaded above - e.g. a film already on the Sabdia media library."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video poster",
      "info": "Shown while the video loads. Leave empty to use the first slide."
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darken the film",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55,
      "info": "Lower = brighter footage. The words stay readable down to about 40%."
    },
    {
      "type": "range",
      "id": "words_delay",
      "label": "Hold the words back (video only)",
      "min": 0, "max": 60, "step": 1, "unit": "s", "default": 0,
      "info": "If the film carries its own SABDIA wordmark, wait this many seconds before the title words and eyebrow fade in - so they appear after that moment rather than on top of it."
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show the SABDIA wordmark over the film",
      "default": false,
      "info": "Video only. Draws the site logo in the hero (Theme settings › Brand › Logo) and fades it in after the delay below - set the delay to the moment the film's own wordmark disappears, so ours takes its place and stays. The title words sit underneath."
    },
    {
      "type": "range",
      "id": "wordmark_delay",
      "label": "Wordmark fades in after",
      "min": 0, "max": 60, "step": 1, "unit": "s", "default": 4
    },
    {
      "type": "checkbox",
      "id": "words_loop",
      "label": "Fade out at the end of the film and replay with it",
      "default": true,
      "info": "Video only. The title words and wordmark follow the film: in at their set seconds, out just before the film ends, back again on every loop."
    },
    {
      "type": "range",
      "id": "words_fade_lead",
      "label": "Fade out this long before the film ends",
      "min": 0.5, "max": 30, "step": 0.5, "unit": "s", "default": 1
    },
    {
      "type": "range",
      "id": "wordmark_size",
      "label": "Wordmark height",
      "min": 24, "max": 120, "step": 4, "unit": "px", "default": 44
    },
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "select",
      "id": "words_position",
      "label": "Where the words sit",
      "options": [
        { "value": "centre", "label": "Centre" },
        { "value": "low", "label": "Lower (clear of a centred wordmark)" },
        { "value": "high", "label": "Upper" }
      ],
      "default": "centre"
    },
    {
      "type": "checkbox",
      "id": "show_words",
      "label": "Show the title words",
      "default": true,
      "info": "Off since 10 Sep 2026 (Tamsin): the wordmark stands alone. The words below are kept so this can come back."
    },
    {
      "type": "text",
      "id": "words",
      "label": "Title words",
      "info": "Comma-separated - rendered word · by · word.",
      "default": "Design, Develop, Construct"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow line",
      "info": "With the wordmark on, this line fades in after the wordmark rather than with it."
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 9,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 11,
      "info": "Tamsin, 10 Sep 2026: a smidge bigger than the 10.5px labels."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the description line",
      "default": true,
      "info": "Off since 10 Sep 2026 (Tamsin): the \"since 2013\" line felt unanchored here and now opens the About paragraph. Kept below so it can come back."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "award",
      "label": "Award line"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Primary button label",
      "default": "View Properties"
    },
    {
      "type": "text",
      "id": "cta1_link",
      "label": "Primary button link",
      "default": "/collections/for-sale"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Enquire"
    },
    {
      "type": "text",
      "id": "cta2_link",
      "label": "Secondary button link",
      "default": "/pages/contact"
    },
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."},
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_dots", "label": "Slide dots (slideshow)", "default": true},
    {"type": "checkbox", "id": "show_scroll_cue", "label": "Scroll cue on the right", "default": true},
    {"type": "checkbox", "id": "show_award", "label": "Award line", "default": true},
    {"type": "checkbox", "id": "show_buttons", "label": "The two buttons", "default": true},
    {"type": "checkbox", "id": "show_bottom_rule", "label": "Gold rule above the buttons", "default": true},
    {"type": "header", "content": "Slideshow"},
    {"type": "range", "id": "slide_every", "label": "Change slides every", "min": 3, "max": 15, "step": 0.2, "default": 6.2, "unit": "s"},
    {"type": "checkbox", "id": "ken_burns", "label": "Slow drift on each slide (Ken Burns)", "default": true},
    {"type": "header", "content": "Size"},
    {"type": "select", "id": "height", "label": "Height", "options": [{"value": "full", "label": "Full screen (as designed)"}, {"value": "tall", "label": "Tall"}, {"value": "standard", "label": "Standard"}], "default": "full"},
    {"type": "select", "id": "title_font", "label": "Title words set in", "options": [{"value": "caps", "label": "Tracked capitals (as designed)"}, {"value": "serif", "label": "The display serif"}], "default": "caps"},
    {"type": "range", "id": "words_size", "label": "Title words size", "min": 14, "max": 56, "step": 1, "default": 30, "unit": "px"},
    {"type": "range", "id": "words_tracking", "label": "Title words letter spacing", "min": 0, "max": 40, "step": 2, "default": 28, "info": "Hundredths of an em."}
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "ext",
          "label": "Current photo (URL)",
          "info": "The photo showing now is loaded from this address. Choose an image above and it takes over - you never need to edit this field."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow"
    }
  ]
}
{% endschema %}
