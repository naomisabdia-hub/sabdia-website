{%- liquid
  # "SABDIA" in capitals inside captions (Tamsin, 10 Sep 2026) - a switch.
  assign brand_from = 'Sabdia'
  assign brand_to = 'SABDIA'
  if section.settings.brand_caps == false
    assign brand_to = 'Sabdia'
  endif
-%}
{%- comment -%}
  "The Series" - the horizontally scrolling strip of Instagram posts
  documenting this residence, from first render to final reveal (port of
  SeriesStrip.astro). Posts come from the product's custom.series_posts
  JSON metafield: [{ "date", "thumb", "caption", "url"?, "video"?,
  "slides"?, "type"?, "hidden"? }, …] - real captures of the published
  posts. The Instagram sync (shopify-app/sync-instagram.mjs, run daily by
  GitHub Actions) fills this automatically from @_sabdia: reels bring a
  "video", carousels bring "slides", every post its Instagram "url".
  Renders nothing when the residence has no posts and no Post blocks.

  Post blocks (theme editor): a block whose Instagram link matches a
  synced post replaces that post's photo, film, caption, date or link (or
  hides it); a block with any other link adds a tile of its own, slotted
  by date. Clicking a tile in the editor selects its block.

  A reel's film plays silently while the pointer rests on the tile (while
  in view on touch screens). Clicking a tile: the "Reels and carousels"
  setting decides whether it plays here on the site (with a "View on
  Instagram" link in the player) or opens the real post on Instagram.
{%- endcomment -%}
{%- liquid
  # Works on product pages AND on collection-item pages: the posts and
  # the residence name come from whichever the template provides.
  assign posts = product.metafields.custom.series_posts.value
  assign series_name = product.title
  capture series_name_html
    render 'residence-name', product: product
  endcapture
  if posts == blank and page
    assign posts = page.metafields.custom.series_posts.value
    assign series_name = page.title
    assign series_name_html = page.title
    if page.metafields.custom.status != blank
      # A residence page (15 Sep 2026): the name in its brochure face, as on the product.
      capture series_name_html
        render 'residence-name', product: page
      endcapture
    endif
  endif
  assign visible = 0
  for item in posts
    unless item.hidden == true
      if item.thumb != blank or item.video != blank or item.slides.first != blank
        assign visible = visible | plus: 1
      endif
    endunless
  endfor
  # A Post block left in place with its photo and film removed adds no tile,
  # so it must not keep an empty band on the page (15 Sep 2026). In the
  # editor it still counts, to show its "add a photo" card.
  for block in section.blocks
    if block.type == 'post' and block.settings.hidden == false
      if request.design_mode or block.settings.image != blank or block.settings.photo_url != blank or block.settings.video != blank or block.settings.video_url != blank
        assign visible = visible | plus: 1
      endif
    endif
  endfor
-%}
{%- if visible > 0 -%}
{%- liquid
  assign look_designed = 'light'
  if section.settings.dark
    assign look_designed = 'dark'
  endif
-%}
{% render 'section-look', section: section, designed: look_designed %}
{%- liquid
  assign ss_limit = section.settings.limit | default: 0
  assign ss_reverse = false
  if section.settings.order == 'reverse'
    assign ss_reverse = true
  endif
  assign ss_posts = posts
  if ss_reverse
    assign ss_posts = posts | reverse
  endif
  assign ss_shown = 0
  assign ig_home = section.settings.instagram_url | default: settings.instagram_url
  # Every block's slot date as a number (20260911) so tiles can be merged
  # in date order without building arrays. No date = newest.
  assign has_blocks = false
  for block in section.blocks
    if block.type == 'post'
      assign has_blocks = true
    endif
  endfor
-%}
<section class="series-band{% if section.settings.dark %} on-dark{% endif %}{% if section.settings.show_arrows == false %} series-noarrows{% endif %}{% if section.settings.show_kind == false %} series-nokind{% endif %}" data-series style="--series-w:{% if section.settings.card_width > 0 %}{{ section.settings.card_width }}px{% else %}clamp(200px,22vw,270px){% endif %};--series-ar:{{ section.settings.card_shape | default: '9/14' }};--series-gap:{{ section.settings.gap | default: 14 }}px;--series-lines:{{ section.settings.caption_lines | default: 3 }}">
  <div class="series-hdr">
    <div>
      {%- if section.settings.show_label -%}<div class="slabel {% if section.settings.dark %}slabel-dark {% endif %}reveal">{{ section.settings.label }}</div>{%- endif -%}
      {%- if section.settings.show_heading -%}<h2 class="series-h reveal d1">{{ section.settings.heading_prefix }} <em>{{ series_name_html }}</em>.</h2>{%- endif -%}
      {%- if section.settings.show_handle -%}
      <a href="{{ ig_home }}" target="_blank" rel="noopener" class="series-handle reveal d2">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        {{ section.settings.handle_line }} {{ section.settings.handle | default: settings.instagram_label }}
      </a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_sub and section.settings.sub != blank -%}<p class="series-sub reveal d2">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <div class="series-track-wrap">
    <button class="series-nav series-prev" type="button" aria-label="Scroll back" data-series-prev>&larr;</button>
    <button class="series-nav series-next" type="button" aria-label="Scroll forward" data-series-next>&rarr;</button>
    <div class="series-track" data-series-track>
      {%- liquid
        if ss_reverse
          assign prev_num = 0
        else
          assign prev_num = 99999999
        endif
      -%}
      {%- for item in ss_posts -%}
        {%- if item.hidden == true -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign item_num = item.date | remove: '-' | plus: 0
          assign item_url = item.url | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove_last: '/' | downcase
        -%}
        {%- comment -%} Own blocks that sit between the previous synced post and this one. {%- endcomment -%}
        {%- if has_blocks -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'post' or block.settings.hidden -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign b_url = block.settings.url | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove_last: '/' | downcase
              assign b_is_override = false
              if b_url != blank
                for p in posts
                  assign p_url = p.url | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove_last: '/' | downcase
                  if p_url == b_url
                    assign b_is_override = true
                    break
                  endif
                endfor
              endif
              if b_is_override
                continue
              endif
              assign b_num = block.settings.date | remove: '-' | plus: 0
              if block.settings.date == blank
                assign b_num = 99999999
              endif
              assign slot = false
              if ss_reverse
                if b_num < item_num and b_num >= prev_num
                  assign slot = true
                endif
              else
                if b_num > item_num and b_num <= prev_num
                  assign slot = true
                endif
              endif
            -%}
            {%- if slot -%}
              {%- if ss_limit > 0 and ss_shown >= ss_limit -%}{%- break -%}{%- endif -%}
              {%- comment -%} Only a block that makes a tile counts toward Most posts shown (15 Sep 2026). {%- endcomment -%}
              {%- if block.settings.image != blank or block.settings.photo_url != blank or block.settings.video != blank or block.settings.video_url != blank -%}{%- assign ss_shown = ss_shown | plus: 1 -%}{%- endif -%}
              {%- render 'series-tile-block', block: block, section: section, ig_home: ig_home, brand_from: brand_from, brand_to: brand_to -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if ss_limit > 0 and ss_shown >= ss_limit -%}{%- break -%}{%- endif -%}
        {%- comment -%} The synced post, with any block that overrides it. {%- endcomment -%}
        {%- liquid
          assign t_thumb = item.thumb
          assign t_video = item.video
          assign t_slides = item.slides
          assign t_caption = item.caption
          assign t_date = item.date
          assign t_kind = item.type
          assign t_link = item.url | default: ig_home
          assign t_attrs = ''
          assign t_hidden = false
          if has_blocks
            for block in section.blocks
              if block.type != 'post'
                continue
              endif
              assign b_url = block.settings.url | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove_last: '/' | downcase
              if b_url == blank or b_url != item_url
                continue
              endif
              assign t_attrs = block.shopify_attributes
              if block.settings.hidden
                assign t_hidden = true
              endif
              if block.settings.image != blank
                assign t_thumb = block.settings.image | image_url: width: 810
              elsif block.settings.photo_url != blank
                assign t_thumb = block.settings.photo_url
              endif
              if block.settings.video != blank
                assign mp4 = block.settings.video.sources | where: 'format', 'mp4' | first
                if mp4
                  assign t_video = mp4.url
                endif
              elsif block.settings.video_url != blank
                assign t_video = block.settings.video_url
              endif
              if block.settings.caption != blank
                assign t_caption = block.settings.caption
              endif
              if block.settings.date != blank
                assign t_date = block.settings.date
              endif
              if block.settings.kind != blank and block.settings.kind != 'auto'
                assign t_kind = block.settings.kind
              endif
              if block.settings.link != blank
                assign t_link = block.settings.link
              endif
              break
            endfor
          endif
          assign on_site = false
          if section.settings.reel_mode == 'site'
            if t_video != blank or t_slides.size > 0
              assign on_site = true
            endif
          endif
        -%}
        {%- comment -%} No photo, slide or film left on a post (its block's photo removed, nothing synced beneath): series-tile prints no tile, so it takes no slot (15 Sep 2026). {%- endcomment -%}
        {%- if t_thumb == blank and t_video == blank and t_slides.first == blank -%}{%- assign t_hidden = true -%}{%- endif -%}
        {%- unless t_hidden -%}
          {%- assign ss_shown = ss_shown | plus: 1 -%}
          {%- render 'series-tile', thumb: t_thumb, video: t_video, slides: t_slides, url: item.url, link: t_link, caption: t_caption, date: t_date, kind: t_kind, alt: series_name, on_site: on_site, attrs: t_attrs, synced: true, section: section, brand_from: brand_from, brand_to: brand_to -%}
        {%- endunless -%}
        {%- assign prev_num = item_num -%}
      {%- endfor -%}
      {%- comment -%} Own blocks older than every synced post (or all of them when nothing is synced). {%- endcomment -%}
      {%- if has_blocks -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'post' or block.settings.hidden -%}{%- continue -%}{%- endif -%}
          {%- if ss_limit > 0 and ss_shown >= ss_limit -%}{%- break -%}{%- endif -%}
          {%- liquid
            assign b_url = block.settings.url | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove_last: '/' | downcase
            assign b_is_override = false
            if b_url != blank
              for p in posts
                assign p_url = p.url | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove_last: '/' | downcase
                if p_url == b_url
                  assign b_is_override = true
                  break
                endif
              endfor
            endif
            if b_is_override
              continue
            endif
            assign b_num = block.settings.date | remove: '-' | plus: 0
            if block.settings.date == blank
              assign b_num = 99999999
            endif
            assign slot = false
            if ss_reverse
              if b_num >= prev_num
                assign slot = true
              endif
            else
              if b_num <= prev_num
                assign slot = true
              endif
            endif
          -%}
          {%- if slot -%}
            {%- if block.settings.image != blank or block.settings.photo_url != blank or block.settings.video != blank or block.settings.video_url != blank -%}{%- assign ss_shown = ss_shown | plus: 1 -%}{%- endif -%}
            {%- render 'series-tile-block', block: block, section: section, ig_home: ig_home, brand_from: brand_from, brand_to: brand_to -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<div class="lbv" id="lbv" role="dialog" aria-modal="true" aria-label="Post viewer">
  <video id="lbvVideo" controls playsinline preload="none" hidden></video>
  <div class="lbv-slides" id="lbvSlides" hidden>
    <img id="lbvSlide" alt="" width="1080" height="1350">
    <button class="lbv-arrow lbv-arrow-prev" id="lbvPrev" type="button" aria-label="Previous slide">&larr;</button>
    <button class="lbv-arrow lbv-arrow-next" id="lbvNext" type="button" aria-label="Next slide">&rarr;</button>
    <div class="lbv-dots" id="lbvDots" aria-hidden="true"></div>
  </div>
  <button class="lb-close" id="lbvClose" aria-label="Close">&#10005;</button>
  <div class="lbv-cap" id="lbvCap">
    <span id="lbvCapText"></span>
    <a class="lbv-ig" id="lbvIg" target="_blank" rel="noopener" hidden>{{ section.settings.view_on_instagram | default: 'View on Instagram' }} &nearr;</a>
  </div>
</div>

<style>
  .series-card .series-vid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .45s;pointer-events:none}
  .series-card.is-playing .series-vid{opacity:1}
  .series-card.is-playing img{filter:saturate(1)}
  .series-synced{position:absolute;top:14px;left:14px;z-index:3;font-size:9px;letter-spacing:.2em;text-transform:uppercase;padding:4px 7px;background:rgba(10,9,8,.6);color:rgba(var(--white-rgb),.8);border:1px solid rgba(var(--white-rgb),.25);cursor:help}
  .series-card-empty{display:flex;align-items:flex-end;background:repeating-linear-gradient(45deg,var(--bg3),var(--bg3) 10px,var(--bg2) 10px,var(--bg2) 20px)}
  .lbv [hidden]{display:none!important}
  .lbv-slides{position:relative;display:flex;align-items:center;justify-content:center;max-width:calc(100vw - 100px);max-height:calc(100vh - 120px)}
  .lbv-slides img{display:block;width:auto;height:auto;max-width:calc(100vw - 100px);max-height:calc(100vh - 190px);object-fit:contain;background:#000;box-shadow:0 30px 90px rgba(0,0,0,.7);border:1px solid rgba(var(--gold2-rgb),.25)}
  .lbv video{max-height:calc(100vh - 190px)}
  #lbvCapText{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .lbv-arrow{position:absolute;top:50%;transform:translateY(-50%);width:44px;height:44px;border-radius:50%;border:1px solid rgba(var(--white-rgb),.25);background:rgba(10,9,8,.55);color:rgba(var(--white-rgb),.75);font-size:15px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:var(--font-u);transition:border-color .3s,color .3s}
  .lbv-arrow:hover{border-color:var(--gold2);color:var(--gold2)}
  .lbv-arrow-prev{left:-22px}.lbv-arrow-next{right:-22px}
  .lbv-arrow[disabled]{opacity:.25;cursor:default}
  .lbv-dots{position:absolute;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:6px}
  .lbv-dots i{width:5px;height:5px;border-radius:50%;background:rgba(var(--white-rgb),.35)}
  .lbv-dots i.on{background:var(--gold2)}
  .lbv-ig{display:inline-block;margin-top:10px;color:var(--gold2);text-decoration:none;font-size:9px;letter-spacing:.22em;text-transform:uppercase;white-space:nowrap}
  .lbv-ig:hover{text-decoration:underline}
  @media (max-width:640px){
    .lbv-slides,.lbv-slides img{max-width:calc(100vw - 24px)}
    .lbv-arrow-prev{left:6px}.lbv-arrow-next{right:6px}
  }
</style>

<script>
  (function () {
    // Films play silently while the pointer rests on a tile; on touch
    // screens the tile that is mostly in view plays. Clicks are untouched.
    // (15 Sep 2026: this sat inside the keydown listener below, so hover
    // play only began after the first key press.)
    var vids = document.querySelectorAll('[data-series] .series-card .series-vid');
    if (vids.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      function playCard(card) {
        var v = card.querySelector('.series-vid');
        if (!v) return;
        if (!v.getAttribute('src')) v.src = v.dataset.src;
        var p = v.play();
        if (p && p.then) p.then(function () { card.classList.add('is-playing'); }).catch(function () {});
        else card.classList.add('is-playing');
      }
      function stopCard(card) {
        var v = card.querySelector('.series-vid');
        if (!v) return;
        v.pause();
        card.classList.remove('is-playing');
      }
      vids.forEach(function (v) {
        var card = v.closest('.series-card');
        if (!card || card.dataset.hover) return;
        card.dataset.hover = '1';
        if (fine) {
          card.addEventListener('pointerenter', function () { playCard(card); });
          card.addEventListener('pointerleave', function () { stopCard(card); });
          card.addEventListener('focus', function () { playCard(card); });
          card.addEventListener('blur', function () { stopCard(card); });
        }
      });
      if (!fine && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var card = e.target;
            if (e.isIntersecting && e.intersectionRatio >= 0.75) playCard(card); else stopCard(card);
          });
        }, { threshold: [0, 0.75] });
        vids.forEach(function (v) { var card = v.closest('.series-card'); if (card) io.observe(card); });
      }
    }

    // The film viewer answers Escape and the arrow keys while it is open.
    document.addEventListener('keydown', function (e) {
      var lbv = document.getElementById('lbv');
      if (!lbv || !lbv.classList.contains('open')) return;
      if (e.key === 'Escape') closeSeriesFilm(lbv);
      if (e.key === 'ArrowLeft') lbv.dispatchEvent(new CustomEvent('lbv:step', { detail: -1 }));
      if (e.key === 'ArrowRight') lbv.dispatchEvent(new CustomEvent('lbv:step', { detail: 1 }));
    });

    function closeSeriesFilm(lbv) {
      var video = document.getElementById('lbvVideo');
      lbv.classList.remove('open');
      document.body.style.overflow = '';
      if (video) {
        video.pause();
        video.removeAttribute('src');
        video.load();
      }
    }

    document.querySelectorAll('[data-series]').forEach(function (band) {
      if (band.dataset.init) return;
      band.dataset.init = '1';
      var track = band.querySelector('[data-series-track]');
      var prev = band.querySelector('[data-series-prev]');
      var next = band.querySelector('[data-series-next]');

      function step() { return Math.min(track.clientWidth * 0.7, 560); }
      function update() {
        prev.disabled = track.scrollLeft < 40;
        next.disabled = track.scrollLeft > track.scrollWidth - track.clientWidth - 40;
      }
      prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', update, { passive: true });
      update();
    });

    var lbv = document.getElementById('lbv');
    if (lbv && !lbv.dataset.init) {
      lbv.dataset.init = '1';
      var video = document.getElementById('lbvVideo');
      var slides = document.getElementById('lbvSlides');
      var slideImg = document.getElementById('lbvSlide');
      var dots = document.getElementById('lbvDots');
      var prevBtn = document.getElementById('lbvPrev');
      var nextBtn = document.getElementById('lbvNext');
      var capText = document.getElementById('lbvCapText');
      var igLink = document.getElementById('lbvIg');
      var list = [];
      var idx = 0;

      function show(i) {
        if (!list.length) return;
        idx = Math.max(0, Math.min(list.length - 1, i));
        slideImg.src = list[idx];
        prevBtn.disabled = idx === 0;
        nextBtn.disabled = idx === list.length - 1;
        // a single slide has nothing to step to: no arrows, no dots (15 Sep 2026)
        prevBtn.hidden = nextBtn.hidden = dots.hidden = list.length < 2;
        dots.innerHTML = '';
        list.forEach(function (_, n) {
          var d = document.createElement('i');
          if (n === idx) d.className = 'on';
          dots.appendChild(d);
        });
        // warm the neighbours
        [idx + 1, idx - 1].forEach(function (n) { if (list[n]) { var im = new Image(); im.src = list[n]; } });
      }

      function open(card) {
        var src = card.dataset.video;
        // empty slide addresses are dropped, so no blank slide or dead dot;
        // nothing left to play opens the post instead of an empty viewer (15 Sep 2026)
        list = card.dataset.slides ? card.dataset.slides.split('|').filter(Boolean) : [];
        if (!src && !list.length) { if (card.dataset.url) window.open(card.dataset.url, '_blank', 'noopener'); return; }
        capText.textContent = card.dataset.caption || '';
        if (card.dataset.url) { igLink.href = card.dataset.url; igLink.hidden = false; } else { igLink.hidden = true; }
        video.hidden = !src;
        slides.hidden = !!src || !list.length;
        lbv.classList.add('open');
        document.body.style.overflow = 'hidden';
        if (src) {
          video.src = src;
          video.play().catch(function () {});
        } else if (list.length) {
          show(0);
        }
      }
      function close() { closeSeriesFilm(lbv); }

      document.querySelectorAll('[data-series-card]').forEach(function (card) {
        card.addEventListener('click', function () { open(card); });
        card.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(card); } });
      });
      prevBtn.addEventListener('click', function () { show(idx - 1); });
      nextBtn.addEventListener('click', function () { show(idx + 1); });
      lbv.addEventListener('lbv:step', function (e) { if (!slides.hidden) show(idx + e.detail); });
      var tx = null;
      slides.addEventListener('touchstart', function (e) { tx = e.touches[0].clientX; }, { passive: true });
      slides.addEventListener('touchend', function (e) {
        if (tx === null) return;
        var dx = e.changedTouches[0].clientX - tx;
        tx = null;
        if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
      }, { passive: true });
      document.getElementById('lbvClose').addEventListener('click', close);
      lbv.addEventListener('click', function (e) { if (e.target === lbv) close(); });
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "The Series",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "The Series" },
    { "type": "text", "id": "heading_prefix", "label": "Heading before the name", "default": "The story of", "info": "Renders as “The story of <name>.”" },
    { "type": "text", "id": "handle_line", "label": "Handle line prefix", "default": "As documented on" },
    { "type": "text", "id": "handle", "label": "Instagram handle", "info": "Defaults to the theme's Instagram label" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL", "info": "Defaults to the theme's Instagram URL" },
    { "type": "text", "id": "sub", "label": "Sub-line", "default": "The build, as it was posted." },
    {
      "type": "select",
      "id": "reel_mode",
      "label": "Reels and carousels",
      "options": [
        { "value": "instagram", "label": "Open the post on Instagram" },
        { "value": "site", "label": "Play here on the site (with a link to the post)" }
      ],
      "default": "instagram",
      "info": "Posts arrive automatically from @_sabdia via the Instagram sync - see docs/INSTAGRAM-SERIES.md. A post without its own link opens the @_sabdia profile."
    },
    { "type": "text", "id": "view_on_instagram", "label": "Player link text", "default": "View on Instagram" },
