{%- comment -%}
  Featured residence - the flagship band the 11 Sep 2026 review asked for
  ("pop a feature project up front, let's do AETHER and really force that,
  then go into current"). One residence, full width, its own photo or film
  behind, name, suburb, the headline from its product, the four facts and
  two buttons. Pick the residence in Customize; leave it empty and the band
  takes the first residence in the For Sale order, so it follows the Status
  field like every other list. Real photographs and real footage only.
{%- endcomment -%}
{%- liquid
  assign res = section.settings.residence
  if res == blank
    capture live_csv
      render 'residence-handles', col: collections['for-sale'], group: 'live'
    endcapture
    assign first_h = live_csv | split: ',' | first
    # The residence's page leads (15 Sep 2026: the residences moved from $0
    # products to pages); a residence still only in Products is found there.
    assign res = pages[first_h]
    if res == blank
      for p in collections.all.products
        if p.handle == first_h
          assign res = p
          break
        endif
      endfor
    endif
  endif
-%}
{%- if res -%}
{%- liquid
  assign m = res.metafields.custom
  assign fr_label = section.settings.label
  assign fr_heading = section.settings.heading_html
  if fr_heading == blank
    assign fr_heading = m.headline.value
  endif
  if fr_heading == blank
    assign fr_heading = res.title
  endif
  assign fr_text = section.settings.text
  if fr_text == blank and section.settings.text_source == 'description'
    assign fr_text = res.description | default: res.content | strip_html | split: '. ' | first | append: '.'
  endif
  assign fr_video = section.settings.video_url
  if section.settings.video
    assign vmp4 = section.settings.video.sources | where: 'format', 'mp4' | first
    if vmp4
      assign fr_video = vmp4.url
    endif
  endif
  if fr_video == blank and section.settings.use_product_film and m.film_video.value != blank
    assign fr_video = m.film_video.value
  endif
  assign fr_img = section.settings.image
  if fr_img == blank
    assign fr_img = res.featured_image
    if fr_img == blank
      # A residence page has no product photo: its main photo by name in Content › Files.
      assign fr_hero = res.handle | append: '-hero.jpg'
      assign fr_img = images[fr_hero]
    endif
  endif
  assign fr_focus = section.settings.focus | default: 'center'
  assign fr_dim = section.settings.dim | default: 45 | divided_by: 100.0
  case section.settings.height
    when 'short'
      assign fr_h = '56vh'
      assign fr_hm = '52vh'
    when 'full'
      assign fr_h = '100svh'
      assign fr_hm = '100svh'
    else
      assign fr_h = 'max(520px,78vh)'
      assign fr_hm = 'max(420px,64vh)'
  endcase
  assign name_tok = '{' | append: 'name' | append: '}'
  assign fr_cta1 = section.settings.cta1_label | replace: name_tok, res.title
  assign fr_cta2 = section.settings.cta2_label | replace: name_tok, res.title
  assign fr_reel_cap = section.settings.reel_caption | replace: name_tok, res.title
  assign fr_cta2_link = section.settings.cta2_link
  if fr_cta2_link == blank
    assign fr_cta2_link = '/pages/contact?interest=Request%20a%20Viewing&property=' | append: res.title | url_encode
  endif
  capture fr_status
    render 'residence-status', product: res
  endcapture
  assign fr_layout = section.settings.layout | default: 'editorial'
  # The residence's own brochure face (Products › the residence › Residence
  # name font / font file / capitals), the same fields the cards read.
  assign fr_nf = m.name_font.value | strip
  assign fr_nff = m.name_font_file.value | strip
  assign fr_name = res.title
  assign fr_name_style = ''
  if fr_nf != blank or fr_nff != blank
    assign fr_fam = fr_nf
    if fr_fam == blank
      assign fr_fam = 'ResidenceFace-' | append: res.handle
    endif
    capture fr_scale
      render 'residence-face-scale', product: res
    endcapture
    assign fr_name_style = "font-family:'" | append: fr_fam | append: "',var(--font-d);font-weight:" | append: m.name_font_weight.value | default: 400 | append: ';letter-spacing:.01em;--face-scale:' | append: fr_scale | strip
    if m.name_font_caps.value
      assign fr_name_style = fr_name_style | append: ';text-transform:uppercase'
    else
      assign fr_name = res.title | downcase | capitalize
      assign fr_name_style = fr_name_style | append: ';text-transform:none'
    endif
  endif
  assign fr_reel = section.settings.reel_url
  if section.settings.reel
    assign rmp4 = section.settings.reel.sources | where: 'format', 'mp4' | first
    if rmp4
      assign fr_reel = rmp4.url
    endif
  endif
  if fr_reel == blank and section.settings.show_reel and m.film_video.value != blank
    assign fr_reel = m.film_video.value
  endif
  assign fr_reel_poster = section.settings.reel_poster_url | default: m.film_poster.value
  assign fr_side = section.settings.side | default: 'right'
-%}
{% render 'residence-faces' %}
{%- if fr_layout == 'editorial' -%}
{%- comment -%}
  Editorial band (as designed, 14 Sep 2026 - one flagship, presented with
  care): a warm-grey band, the name set large on the left with the headline,
  a line, the facts and two buttons; on the right the residence's photograph
  bleeds off the page edge and its own film reel overlaps the corner. Not a
  hero: no scrim, no words over the photo.
{%- endcomment -%}
{% render 'section-look', section: section %}
{%- comment -%} No photo on the band or the residence (15 Sep 2026): the photograph and the reel that overlaps it step aside and the words take the width, never an empty grey frame. {%- endcomment -%}
<section class="sp fre fre-{{ fr_side }}{% if fr_reel == blank %} fre-noreel{% endif %}{% unless fr_img %} fre-nophoto{% endunless %}" id="featured" style="--fre-ar:{{ section.settings.shape | default: '4/3' }}">
  <div class="inner fre-grid">
    <div class="fre-words">
      {%- if section.settings.show_label and fr_label != blank -%}<div class="slabel reveal">{{ fr_label }}{% if section.settings.show_status and fr_status != blank %}<span class="fre-status">{{ fr_status }}</span>{% endif %}</div>{%- endif -%}
      <h2 class="fre-name reveal d1"{% if fr_name_style != blank %} style="{{ fr_name_style }}"{% endif %}>{{ fr_name }}</h2>
      {%- if m.suburb.value != blank -%}<div class="fre-loc reveal d1">{{ m.suburb.value }}{% if m.state.value != blank %}, {{ m.state.value }}{% endif %}</div>{%- endif -%}
      <div class="fre-rule reveal d2"></div>
      {%- if fr_heading != blank and fr_heading != res.title -%}<p class="fre-h reveal d2">{{ fr_heading }}</p>{%- endif -%}
      {%- if fr_text != blank and section.settings.show_text -%}<p class="about-p reveal d2">{{ fr_text }}</p>{%- endif -%}
      {%- if section.settings.show_facts -%}
      <dl class="fre-facts reveal d3">
        {%- if m.beds.value != blank -%}<div>{% if section.settings.fact_beds != blank %}<dt>{{ section.settings.fact_beds }}</dt>{% endif %}<dd>{{ m.beds.value }}</dd></div>{%- endif -%}
        {%- if m.baths.value != blank -%}<div>{% if section.settings.fact_baths != blank %}<dt>{{ section.settings.fact_baths }}</dt>{% endif %}<dd>{{ m.baths.value }}</dd></div>{%- endif -%}
        {%- if m.cars.value != blank -%}<div>{% if section.settings.fact_cars != blank %}<dt>{{ section.settings.fact_cars }}</dt>{% endif %}<dd>{{ m.cars.value }}</dd></div>{%- endif -%}
        {%- if m.build_size.value != blank -%}<div>{% if section.settings.fact_build != blank %}<dt>{{ section.settings.fact_build }}</dt>{% endif %}<dd>{{ m.build_size.value }}{% if section.settings.fact_unit != blank %}<span>{{ section.settings.fact_unit }}</span>{% endif %}</dd></div>{%- endif -%}
        {%- if m.land.value != blank -%}<div>{% if section.settings.fact_land != blank %}<dt>{{ section.settings.fact_land }}</dt>{% endif %}<dd>{{ m.land.value }}{% if section.settings.fact_unit != blank %}<span>{{ section.settings.fact_unit }}</span>{% endif %}</dd></div>{%- endif -%}
      </dl>
      {%- endif -%}
      {%- if section.settings.show_buttons -%}
      <div class="fre-btns reveal d3">
        {%- if fr_cta1 != blank -%}<a href="{{ res.url }}" class="btn-p">{{ fr_cta1 }} &rarr;</a>{%- endif -%}
        {%- if fr_cta2 != blank -%}<a href="{{ fr_cta2_link }}" class="btn-g">{{ fr_cta2 }}</a>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
    {%- if fr_img -%}
    <div class="fre-media">
      <a href="{{ res.url }}" class="fre-photo reveal-wipe d1" aria-label="{{ res.title }}">
        {%- if fr_img -%}
          <img src="{{ fr_img | image_url: width: 1400 }}" srcset="{{ fr_img | image_url: width: 800 }} 800w, {{ fr_img | image_url: width: 1400 }} 1400w, {{ fr_img | image_url: width: 2000 }} 2000w" sizes="(max-width: 900px) 100vw, 60vw" alt="{{ res.title }}, {{ m.suburb.value }}" loading="lazy" decoding="async" width="1400" height="1050" style="object-position:{{ fr_focus }}">
        {%- endif -%}
      </a>
      {%- if fr_reel != blank -%}
      <div class="fre-reel reveal d3" data-film>
        <video src="{{ fr_reel }}"{% if fr_reel_poster != blank %} poster="{{ fr_reel_poster }}"{% endif %} muted loop playsinline preload="none" aria-hidden="true"></video>
        {%- if section.settings.reel_caption != blank -%}<span class="fre-reel-cap">{{ fr_reel_cap }}</span>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
<style>
  .fre{background:var(--bg2);overflow:hidden}
  .fre-grid{display:grid;grid-template-columns:5fr 7fr;gap:clamp(36px,5vw,80px);align-items:center}
  .fre-nophoto .fre-grid{grid-template-columns:1fr}
  .fre-left .fre-words{order:2}.fre-left .fre-media{order:1}
  .fre-words{padding:8px 0}
  .fre-status{margin-left:14px;padding-left:14px;border-left:1px solid var(--border);font-weight:300;color:var(--ink3)}
  .fre-name{font-family:var(--font-d);font-size:calc(clamp(56px,7.5vw,116px)*var(--s-h,1)*var(--face-scale,1));font-weight:500;line-height:.92;letter-spacing:.03em;text-transform:uppercase;color:var(--ink);margin:0}
  .fre-loc{margin-top:14px;font-size:var(--t-label);font-weight:400;letter-spacing:.32em;text-transform:uppercase;color:var(--ink3)}
  .fre-rule{width:48px;height:1px;background:var(--ink);margin:28px 0 24px;opacity:.6}
  .fre-h{font-family:var(--font-d);font-size:calc(var(--t-h2)*var(--s-h,1));font-weight:400;line-height:1.15;color:var(--ink);margin:0 0 14px;letter-spacing:-.01em}
  .fre-words .about-p{max-width:460px}
  .fre-facts{margin:28px 0 0;padding:20px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);display:grid;grid-template-columns:repeat(4,auto);justify-content:start;gap:12px clamp(20px,3vw,44px)}
  .fre-facts dt{font-size:var(--t-micro);font-weight:400;letter-spacing:.26em;text-transform:uppercase;color:var(--ink3);margin-bottom:6px}
  .fre-facts dd{margin:0;font-family:var(--font-d);font-size:calc(var(--t-h3)*var(--s-h,1));font-weight:400;color:var(--ink);line-height:1}
  .fre-facts dd span{font-size:.6em;margin-left:2px;font-weight:400;color:var(--ink3)}
  .fre-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
  /* The photograph runs off the right edge of the page; the reel sits over its lower-left corner. */
  .fre-media{position:relative;margin-right:calc(-1 * var(--page-pad));padding-bottom:clamp(36px,4vw,56px);padding-left:clamp(40px,5vw,72px)}
  .fre-left .fre-media{margin-right:0;margin-left:calc(-1 * var(--page-pad));padding-left:0;padding-right:clamp(40px,5vw,72px)}
  .fre-photo{display:block;position:relative;aspect-ratio:var(--fre-ar,4/3);overflow:hidden;background:var(--bg3)}
  .fre-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.95);transition:transform 1.1s var(--ease)}
  .fre-photo:hover img{transform:scale(1.03)}
  .fre-reel{position:absolute;left:0;bottom:0;width:clamp(120px,22%,190px);aspect-ratio:9/16;background:var(--dark);border:1px solid rgba(var(--white-rgb),.6);box-shadow:0 30px 60px -28px rgba(var(--dark-rgb),.55);overflow:hidden}
  .fre-left .fre-reel{left:auto;right:0}
  .fre-reel video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .fre-reel-cap{position:absolute;left:0;right:0;bottom:0;padding:10px 12px;font-size:var(--t-micro);letter-spacing:.26em;text-transform:uppercase;color:rgba(var(--white-rgb),.9);background:linear-gradient(to top,rgba(var(--dark-rgb),.6),transparent)}
  .fre-noreel .fre-media{padding-bottom:0;padding-left:0}
  @media(max-width:1100px){.fre-grid{grid-template-columns:1fr 1fr}.fre-name{font-size:calc(clamp(48px,6.5vw,90px)*var(--s-h,1)*var(--face-scale,1))}}
  @media(max-width:900px){
    .fre-grid{grid-template-columns:1fr;gap:28px}
    .fre-left .fre-words,.fre-words{order:2}.fre-left .fre-media,.fre-media{order:1;margin:0 calc(-1 * var(--page-pad));padding:0 0 0 0}
    .fre-photo{aspect-ratio:4/3}
    .fre-reel{left:auto;right:16px;bottom:-24px;width:96px;border-width:1px}
    .fre-noreel .fre-media{margin:0 calc(-1 * var(--page-pad))}
    .fre-words{padding-top:8px}
    .fre-facts{grid-template-columns:repeat(2,1fr)}
  }
  @media(prefers-reduced-motion:reduce){.fre-reel{display:none}}
</style>
{%- elsif fr_layout == 'split' -%}
{%- comment -%}
  Split card (as designed, Naomi 14 Sep 2026: "having another header just
  looks weird"): the photo on one side, a stone panel with the words on the
  other. Never full-bleed, never a hero.
{%- endcomment -%}
{% render 'section-look', section: section %}
{%- comment -%} No film and no photo (15 Sep 2026): the photo half steps aside and the stone panel takes the width, never an empty grey half. {%- endcomment -%}
{%- assign frs_media = false -%}
{%- if fr_video != blank or fr_img -%}{%- assign frs_media = true -%}{%- endif -%}
<section class="sp frs frs-{{ fr_side }}{% unless frs_media %} frs-nomedia{% endunless %}" style="--frs-ar:{{ section.settings.shape | default: '4/5' }}">
  <div class="inner frs-grid">
    {%- if frs_media -%}
    <div class="frs-media reveal-wipe d1">
      {%- if fr_video != blank -%}
        <video src="{{ fr_video }}" autoplay muted loop playsinline preload="metadata" aria-hidden="true"{% if fr_img %} poster="{{ fr_img | image_url: width: 1200 }}"{% endif %}></video>
      {%- elsif fr_img -%}
        <img src="{{ fr_img | image_url: width: 1200 }}" srcset="{{ fr_img | image_url: width: 700 }} 700w, {{ fr_img | image_url: width: 1200 }} 1200w, {{ fr_img | image_url: width: 1600 }} 1600w" sizes="(max-width: 900px) 100vw, 58vw" alt="{{ res.title }}, {{ m.suburb.value }}" loading="lazy" decoding="async" width="1200" height="1500" style="object-position:{{ fr_focus }}">
      {%- endif -%}
      {%- if section.settings.show_status and fr_status != blank -%}<span class="pc-status-chip"><span class="pc-dot"></span>{{ fr_status }}</span>{%- endif -%}
    </div>
    {%- endif -%}
    <div class="frs-panel">
      {%- if section.settings.show_label and fr_label != blank -%}<div class="slabel reveal">{{ fr_label }}</div>{%- endif -%}
      <div class="frs-name reveal d1"{% if fr_name_style != blank %} style="{{ fr_name_style }}"{% endif %}>{{ fr_name }}</div>
      {%- if m.suburb.value != blank -%}<div class="frs-loc reveal d1">{{ m.suburb.value }}{% if m.state.value != blank %}, {{ m.state.value }}{% endif %}</div>{%- endif -%}
      <h2 class="frs-h reveal d1">{{ fr_heading }}</h2>
      {%- if fr_text != blank and section.settings.show_text -%}<p class="about-p reveal d2">{{ fr_text }}</p>{%- endif -%}
      {%- if section.settings.show_facts -%}
      <ul class="frs-facts reveal d2">
        {%- if m.beds.value != blank -%}<li><b>{{ m.beds.value }}</b>{% if section.settings.unit_bed != blank %} {{ section.settings.unit_bed }}{% endif %}</li>{%- endif -%}
        {%- if m.baths.value != blank -%}<li><b>{{ m.baths.value }}</b>{% if section.settings.unit_bath != blank %} {{ section.settings.unit_bath }}{% endif %}</li>{%- endif -%}
        {%- if m.cars.value != blank -%}<li><b>{{ m.cars.value }}</b>{% if section.settings.unit_cars != blank %} {{ section.settings.unit_cars }}{% endif %}</li>{%- endif -%}
        {%- if m.build_size.value != blank -%}<li><b>{{ m.build_size.value }}</b>{{ section.settings.unit_build }}</li>{%- endif -%}{%- if m.land.value != blank -%}<li><b>{{ m.land.value }}</b>{{ section.settings.unit_land }}</li>{%- endif -%}
      </ul>
      {%- endif -%}
      {%- if section.settings.show_buttons -%}
      <div class="frs-btns reveal d3">
        {%- if fr_cta1 != blank -%}<a href="{{ res.url }}" class="btn-p">{{ fr_cta1 }} &rarr;</a>{%- endif -%}
        {%- if fr_cta2 != blank -%}<a href="{{ fr_cta2_link }}" class="btn-g">{{ fr_cta2 }}</a>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .frs-grid{display:grid;grid-template-columns:7fr 5fr;gap:0;align-items:stretch;background:var(--bg2)}
  .frs-nomedia .frs-grid{grid-template-columns:1fr}
  .frs-right .frs-media{order:2}.frs-right .frs-panel{order:1}
  .frs-media{position:relative;aspect-ratio:var(--frs-ar,4/5);min-height:100%;overflow:hidden;background:var(--bg3)}
  .frs-media img,.frs-media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.95)}
  .frs-media .pc-status-chip{opacity:1;transform:none}
  .frs-panel{padding:clamp(32px,4.5vw,64px);display:flex;flex-direction:column;justify-content:center}
  .frs-name{font-family:var(--font-d);font-size:calc(clamp(30px,3.6vw,52px)*var(--s-h,1)*var(--face-scale,1));font-weight:500;line-height:1;letter-spacing:.02em;text-transform:uppercase;color:var(--ink)}
  .frs-loc{margin-top:8px;font-size:var(--t-label);font-weight:400;letter-spacing:.28em;text-transform:uppercase;color:var(--ink3)}
  .frs-h{font-family:var(--font-d);font-size:calc(var(--t-h2)*var(--s-h,1));font-weight:400;line-height:1.12;color:var(--ink);margin:26px 0 14px;letter-spacing:-.01em}
  .frs-panel .about-p{max-width:none}
  .frs-facts{list-style:none;margin:22px 0 0;padding:18px 0 0;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:8px 26px;font-size:var(--t-small);letter-spacing:.06em;color:var(--ink3)}
  .frs-facts b{font-weight:400;color:var(--ink)}
  .frs-btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
  @media(prefers-reduced-motion:reduce){.frs-media video{display:none}}
  @media(max-width:900px){.frs-grid{grid-template-columns:1fr}.frs-right .frs-media{order:1}.frs-right .frs-panel{order:2}.frs-media{aspect-ratio:4/3;min-height:0}.frs-panel{padding:28px 22px 36px}}
</style>
{%- else -%}
{% render 'section-look', section: section, mode: 'hero' %}
{%- comment -%} No film and no photo (15 Sep 2026): the band stands on the dark ground so its light words still read. {%- endcomment -%}
<section class="page-hero ph-sized fr ph-pos-{{ section.settings.words | default: 'base-left' }} ph-scrim-{{ section.settings.scrim | default: 'corner' }}" style="--ph-h:{{ fr_h }};--ph-hm:{{ fr_hm }};--ph-dim:{{ fr_dim }}{% if fr_video == blank and fr_img == blank %};background:var(--dark){% endif %}">
  {%- if fr_video != blank -%}
    <video class="page-hero-video" src="{{ fr_video }}" autoplay muted loop playsinline preload="metadata" aria-hidden="true"{% if fr_img %} poster="{{ fr_img | image_url: width: 1920, height: 1080, crop: fr_focus }}"{% endif %}></video>
  {%- elsif fr_img -%}
    <img src="{{ fr_img | image_url: width: 1920, height: 1080, crop: fr_focus }}" srcset="{{ fr_img | image_url: width: 900, height: 1125, crop: fr_focus }} 900w, {{ fr_img | image_url: width: 1440, height: 810, crop: fr_focus }} 1440w, {{ fr_img | image_url: width: 1920, height: 1080, crop: fr_focus }} 1920w" sizes="100vw" alt="{{ res.title }}, {{ m.suburb.value }}" loading="lazy" decoding="async" width="1920" height="1080" style="object-position:{{ fr_focus }}">
  {%- endif -%}
  <div class="page-hero-ov"></div>
  <div class="page-hero-content inner">
    {%- if section.settings.show_label and fr_label != blank -%}
      <div class="slabel slabel-dark reveal">{{ fr_label }}{% if section.settings.show_status and fr_status != blank %} <span class="fr-status">&middot; {{ fr_status }}</span>{% endif %}</div>
    {%- endif -%}
    <h2 class="page-h reveal d1">{{ fr_heading }}</h2>
    <div class="fr-name reveal d1">{% render 'residence-name', product: res %}{% if m.suburb.value != blank %} <span>{{ m.suburb.value }}</span>{% endif %}</div>
    {%- if fr_text != blank and section.settings.show_text -%}<p class="page-hero-sub reveal d2">{{ fr_text }}</p>{%- endif -%}
    {%- if section.settings.show_facts -%}
    <ul class="fr-facts reveal d2">
      {%- if m.beds.value != blank -%}<li><b>{{ m.beds.value }}</b>{% if section.settings.unit_bed != blank %} {{ section.settings.unit_bed }}{% endif %}</li>{%- endif -%}
      {%- if m.baths.value != blank -%}<li><b>{{ m.baths.value }}</b>{% if section.settings.unit_bath != blank %} {{ section.settings.unit_bath }}{% endif %}</li>{%- endif -%}
      {%- if m.cars.value != blank -%}<li><b>{{ m.cars.value }}</b>{% if section.settings.unit_cars != blank %} {{ section.settings.unit_cars }}{% endif %}</li>{%- endif -%}
      {%- if m.build_size.value != blank -%}<li><b>{{ m.build_size.value }}</b>{{ section.settings.unit_build }}</li>{%- endif -%}{%- if m.land.value != blank -%}<li><b>{{ m.land.value }}</b>{{ section.settings.unit_land }}</li>{%- endif -%}
    </ul>
    {%- endif -%}
    {%- if section.settings.show_buttons -%}
    <div class="fr-btns reveal d3">
      {%- if fr_cta1 != blank -%}<a href="{{ res.url }}" class="btn-p">{{ fr_cta1 }} &rarr;</a>{%- endif -%}
      {%- if fr_cta2 != blank -%}<a href="{{ fr_cta2_link }}" class="btn-g btn-g-light">{{ fr_cta2 }}</a>{%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>
<style>
  .fr .page-hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(calc(1 - var(--ph-dim,.45) * .5)) saturate(.95)}
  .fr .page-h{font-size:calc(var(--t-h1)*1.15*var(--s-h,1));line-height:1.05;max-width:12em}
  .fr-name{margin-top:16px;font-size:var(--t-label);font-weight:500;letter-spacing:.3em;text-transform:uppercase;color:var(--white)}
  .fr-name span{font-weight:300;letter-spacing:.2em;opacity:.7;margin-left:12px}
  .fr-status{font-weight:300;opacity:.75}
  .fr-facts{list-style:none;margin:22px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:10px 28px;font-size:var(--t-small);letter-spacing:.06em;color:rgba(var(--white-rgb),.8)}
  .fr-facts b{font-weight:400;color:var(--white)}
  .fr-btns{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px}
  .ph-pos-base-centre.fr .fr-facts,.ph-pos-centre.fr .fr-facts,.ph-pos-base-centre.fr .fr-btns,.ph-pos-centre.fr .fr-btns{justify-content:center}
  @media(prefers-reduced-motion:reduce){.fr .page-hero-video{display:none}}
  @media(max-width:900px){.fr.page-hero.ph-sized{height:auto;min-height:max(360px,var(--ph-hm,60vh))}}
</style>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Featured residence",
  "settings": [
    {"type": "paragraph", "content": "The flagship band: one residence, full width, up front. Leave the residence empty and it takes the first home in the For Sale order."},
    {"type": "product", "id": "residence", "label": "Residence"},
    {"type": "header", "content": "Words"},
    {"type": "text", "id": "label", "label": "Small label", "default": "Featured Residence"},
    {"type": "checkbox", "id": "show_status", "label": "Add the residence's Status after the label", "default": true},
    {"type": "html", "id": "heading_html", "label": "Heading", "info": "Empty = the residence's own headline (Products › the residence › Headline), else its name."},
    {"type": "select", "id": "text_source", "label": "Line under the heading", "options": [{"value": "description", "label": "First sentence of the residence's description"}, {"value": "none", "label": "None"}], "default": "description"},
    {"type": "textarea", "id": "text", "label": "Your own line instead", "info": "Overrides the choice above."},
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_label", "label": "Small label", "default": true},
    {"type": "checkbox", "id": "show_text", "label": "The line", "default": true},
    {"type": "checkbox", "id": "show_facts", "label": "Bed, bath, garage, build, land", "default": true},
    {"type": "checkbox", "id": "show_buttons", "label": "The two buttons", "default": true},
    {"type": "text", "id": "cta1_label", "label": "Button 1 (to the residence)", "default": "Explore {name}", "info": "{name} becomes the residence's name."},
    {"type": "text", "id": "cta2_label", "label": "Button 2", "default": "Arrange an Inspection"},
    {"type": "url", "id": "cta2_link", "label": "Button 2 goes to", "info": "Empty = the contact form with a viewing of this residence already chosen."},
    {"type": "header", "content": "Photo or film behind the words"},
    {"type": "paragraph", "content": "The residence's photo or film for this band (not the Look backdrop below). Real photographs and real footage only. Empty = the residence's main photo."},
    {"type": "image_picker", "id": "image", "label": "Photo"},
    {"type": "video", "id": "video", "label": "Film (upload)"},
    {"type": "text", "id": "video_url", "label": "Current film (URL)"},
    {"type": "checkbox", "id": "use_product_film", "label": "Use the residence's own film when no film is chosen", "default": false},
    {"type": "select", "id": "focus", "label": "Crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center"},
    {"type": "range", "id": "dim", "label": "Darken", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 45},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "layout", "label": "Layout", "options": [{"value": "editorial", "label": "Editorial band (as designed)"}, {"value": "split", "label": "Split card, photo beside the words"}, {"value": "band", "label": "Full-width band"}], "default": "editorial"},
    {"type": "header", "content": "Film reel (editorial band)"},
    {"type": "checkbox", "id": "show_reel", "label": "Show the residence's own film reel over the photo", "default": true, "info": "Uses Products › the residence › Film. Real footage only."},
    {"type": "video", "id": "reel", "label": "A different reel (upload)"},
    {"type": "text", "id": "reel_url", "label": "A different reel (URL)"},
    {"type": "text", "id": "reel_poster_url", "label": "Reel poster (URL)"},
    {"type": "text", "id": "reel_caption", "label": "Caption on the reel", "default": "{name}, on film"},
    {"type": "select", "id": "side", "label": "Photo sits", "options": [{"value": "right", "label": "Right (as designed)"}, {"value": "left", "label": "Left"}], "default": "right"},
    {"type": "select", "id": "shape", "label": "Photo shape", "options": [{"value": "4/5", "label": "Portrait 4:5 (as designed)"}, {"value": "1/1", "label": "Square"}, {"value": "4/3", "label": "Landscape 4:3"}, {"value": "3/2", "label": "Landscape 3:2"}], "default": "4/5"},
    {"type": "select", "id": "height", "label": "Height (full-width band)", "options": [{"value": "standard", "label": "Standard (as designed)"}, {"value": "short", "label": "Short"}, {"value": "full", "label": "Full screen"}], "default": "standard"},
    {"type": "select", "id": "words", "label": "Words sit", "options": [{"value": "base-left", "label": "Bottom left (as designed)"}, {"value": "base-centre", "label": "Bottom centre"}, {"value": "centre", "label": "Centre"}], "default": "base-left"},
    {"type": "select", "id": "scrim", "label": "Darkening shape", "options": [{"value": "corner", "label": "Corner (as designed)"}, {"value": "base", "label": "Bottom only"}, {"value": "even", "label": "Even"}, {"value": "none", "label": "None"}], "default": "corner"},
    {"type": "header", "content": "Fact words", "visible_if": "{{ section.settings.show_facts }}"},
    {"type": "text", "id": "fact_beds", "label": "Bedrooms label (editorial band)", "default": "Bedrooms", "visible_if": "{{ section.settings.show_facts and section.settings.layout == 'editorial' }}"},
    {"type": "text", "id": "fact_baths", "label": "Bathrooms label (editorial band)", "default": "Bathrooms", "visible_if": "{{ section.settings.show_facts and section.settings.layout == 'editorial' }}"},
    {"type": "text", "id": "fact_cars", "label": "Garage label (editorial band)", "default": "Garage", "visible_if": "{{ section.settings.show_facts and section.settings.layout == 'editorial' }}"},
    {"type": "text", "id": "fact_build", "label": "Build size label (editorial band)", "default": "Build", "visible_if": "{{ section.settings.show_facts and section.settings.layout == 'editorial' }}"},
    {"type": "text", "id": "fact_land", "label": "Land size label (editorial band)", "default": "Land", "visible_if": "{{ section.settings.show_facts and section.settings.layout == 'editorial' }}"},
    {"type": "text", "id": "fact_unit", "label": "Size unit (editorial band)", "default": "m²", "visible_if": "{{ section.settings.show_facts and section.settings.layout == 'editorial' }}"},
    {"type": "text", "id": "unit_bed", "label": "Word after the bedrooms (split card, full-width band)", "default": "Bed", "visible_if": "{{ section.settings.show_facts and section.settings.layout != 'editorial' }}"},
    {"type": "text", "id": "unit_bath", "label": "Word after the bathrooms (split card, full-width band)", "default": "Bath", "visible_if": "{{ section.settings.show_facts and section.settings.layout != 'editorial' }}"},
    {"type": "text", "id": "unit_cars", "label": "Word after the garage count (split card, full-width band)", "default": "Garage", "visible_if": "{{ section.settings.show_facts and section.settings.layout != 'editorial' }}"},
    {"type": "text", "id": "unit_build", "label": "Build size unit (split card, full-width band)", "default": "m² build", "visible_if": "{{ section.settings.show_facts and section.settings.layout != 'editorial' }}"},
    {"type": "text", "id": "unit_land", "label": "Land size unit (split card, full-width band)", "default": "m² land", "visible_if": "{{ section.settings.show_facts and section.settings.layout != 'editorial' }}"},
    {"type": "header", "content": "Look"},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}], "default": "design"},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#E5E2DF", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name"}
  ],
  "presets": [{"name": "Featured residence"}]
}
{% endschema %}
