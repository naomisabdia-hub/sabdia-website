{%- comment -%}
  Port of the homepage properties section - one hero card, two small
  cards, then a row of remaining live plus sold residences. Which group
  a residence is in comes from its Status (see residence-status); the two
  collections chosen in the customizer set the order.
{%- endcomment -%}
{%- liquid
  assign for_sale = collections[section.settings.for_sale_collection]
  assign sold = collections[section.settings.sold_collection]
  capture live_csv
    render 'residence-handles', col: for_sale, group: 'live'
  endcapture
  assign live_handles = live_csv | split: ','
  capture sold_csv
    render 'residence-handles', col: sold, group: 'sold'
  endcapture
  assign sold_handles = sold_csv | split: ','
  # Everything after the first three live residences flows into rows of
  # three (live first, then sold), capped by "Most residences to show".
  assign max_cards = section.settings.max_cards | default: 12
  assign rest_limit = max_cards | minus: 3
  assign rest_handles = sold_handles
  if live_handles.size > 3
    assign live_rest = live_handles | slice: 3, 60
    assign rest_handles = live_rest | concat: sold_handles
  endif
  assign admin_base = 'https://admin.shopify.com/store/' | append: shop.permanent_domain | remove: '.myshopify.com' | append: '/products/'
-%}
<section id="properties" style="padding:0 0 clamp(80px,12vw,160px)">
  <div class="inner" style="padding:clamp(80px,12vw,160px) clamp(22px,5vw,80px) clamp(44px,5vw,60px)">
    <div class="proj-hdr">
      <div>
        <div class="slabel reveal">{{ section.settings.label }}</div>
        <h2 class="proj-h reveal d1">{{ section.settings.heading_html }}</h2>
      </div>
      <a href="{{ section.settings.cta_link }}" class="btn-g reveal d2">{{ section.settings.cta_label }} &rarr;</a>
    </div>
  </div>

  <div class="inner" style="padding:0 clamp(22px,5vw,80px)">
    {%- if request.design_mode -%}
      {%- comment -%} Editor-only: For Sale / Sold is each residence's Status field, so link straight to it. {%- endcomment -%}
      <div class="editor-note">
        <strong>For Sale / Sold is set on each residence, not here.</strong> Open one, change <em>Status</em> near the bottom, Save - every page follows.
        {%- assign all_handles = live_handles | concat: sold_handles -%}
        {%- for h in all_handles -%}{%- for product in collections.all.products -%}{%- if product.handle != h -%}{%- continue -%}{%- endif -%}
          <a href="{{ admin_base }}{{ product.id }}" target="_blank" rel="noopener">{{ product.title }}: {% render 'residence-status', product: product %} &#8599;</a>
        {%- break -%}{%- endfor -%}{%- endfor -%}
      </div>
    {%- endif -%}
    <div class="proj-grid proj-grid-main">
      {%- for h in live_handles limit: 3 -%}
        {%- assign i = forloop.index -%}
        {%- for product in collections.all.products -%}
          {%- if product.handle != h -%}{%- continue -%}{%- endif -%}
          {%- if i == 1 -%}
            {% render 'property-card', product: product, class: 'pc-hero reveal-wipe', img_w: 1400, img_h: 900, show_cars: true %}
          {%- elsif i == 2 -%}
            {% render 'property-card', product: product, class: 'pc-sm-a reveal-wipe d1', style: 'aspect-ratio:4/3', img_w: 900, img_h: 680 %}
          {%- else -%}
            {% render 'property-card', product: product, class: 'pc-sm-b reveal-wipe d2', style: 'aspect-ratio:4/3', img_w: 900, img_h: 680 %}
          {%- endif -%}
          {%- break -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if rest_handles.size > 0 and rest_limit > 0 -%}
      <div class="proj-grid-3 proj-grid-flow" style="margin-top:10px">
        {%- assign delays = ',d1,d2' | split: ',' -%}
        {%- for h in rest_handles limit: rest_limit -%}
          {%- assign di = forloop.index0 | modulo: 3 -%}
          {%- assign card_class = 'pc-row reveal-wipe ' | append: delays[di] -%}
          {%- for product in collections.all.products -%}
            {%- if product.handle != h -%}{%- continue -%}{%- endif -%}
            {%- capture pstatus -%}{% render 'residence-status', product: product %}{%- endcapture -%}
            {%- if pstatus contains 'Sold' -%}
              {% render 'sold-card', product: product, class: card_class, img_w: 900, img_h: 560, show_suburb: false %}
            {%- else -%}
              {% render 'property-card', product: product, class: card_class, img_w: 900, img_h: 560 %}
            {%- endif -%}
            {%- break -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Properties grid",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "The Portfolio" },
    { "type": "html", "id": "heading_html", "label": "Heading" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View All" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "/collections/for-sale" },
    { "type": "header", "content": "Which residences" },
    { "type": "paragraph", "content": "For Sale or Sold is NOT chosen here. It is each residence's Status field: Products › the residence › Status (near the bottom) › Save. Every page follows it. The first three live residences fill the large layout; the rest flow in rows of three, live first, then sold." },
    { "type": "range", "id": "max_cards", "label": "Most residences to show", "min": 3, "max": 30, "step": 1, "default": 12, "info": "Past this number the button above leads to the full list." },
    { "type": "header", "content": "Order" },
    { "type": "paragraph", "content": "These two pickers only set the drag order (Products › Collections › the collection › sort Manually). They never move a house between For Sale and Sold." },
    { "type": "collection", "id": "for_sale_collection", "label": "Order of For Sale cards" },
    { "type": "collection", "id": "sold_collection", "label": "Order of Sold cards" }
  ],
  "presets": [{ "name": "Properties grid" }]
}
{% endschema %}
