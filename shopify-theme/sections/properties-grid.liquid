{%- comment -%}
  Port of the homepage properties section - one hero card, two small
  cards, then a row of remaining live plus sold residences. Which group
  a residence is in comes from its Status (see residence-status); the two
  collections chosen in the customizer set the order.

  Since 14 Sep 2026 every card can be its own block (Residence card: the
  residence, its photo, where a click goes, the crop), like the photos of
  the residence Gallery. With blocks, the grid is the blocks in sidebar
  order; with none it fills itself from Status as before.
  shopify-app/add-residence-card-blocks.py seeds one block per card.
{%- endcomment -%}
{%- comment -%} The residences' own brochure faces, so a card name prints in its house's face. {%- endcomment -%}
{% render 'residence-faces' %}
{%- liquid
  assign for_sale = collections[section.settings.for_sale_collection]
  assign sold = collections[section.settings.sold_collection]
  capture live_csv
    render 'residence-handles', col: for_sale, group: 'live'
  endcapture
  assign live_handles = live_csv | split: ','
  # A residence shown in the Featured residence band above is left out here
  # so the page never opens on the same house twice (Customize › Leave out).
  if section.settings.exclude != blank
    assign ex_key = ',' | append: section.settings.exclude.handle | append: ','
    assign ex_csv = ',' | append: live_csv | replace: ex_key, ','
    assign live_handles = ex_csv | remove_first: ',' | split: ','
  endif
  capture sold_csv
    render 'residence-handles', col: sold, group: 'sold'
  endcapture
  assign sold_handles = sold_csv | split: ','
  # Everything after the first three live residences flows into rows of
  # three (live first, then sold), capped by "Most residences to show".
  assign max_cards = section.settings.max_cards | default: 12
  assign pg_layout = section.settings.layout | default: 'editorial'
  unless section.settings.include_sold
    assign sold_handles = '' | split: ','
  endunless
  if pg_layout == 'editorial'
    assign rest_limit = max_cards | minus: 3
    assign rest_handles = sold_handles
    if live_handles.size > 3
      assign live_rest = live_handles | slice: 3, 60
      assign rest_handles = live_rest | concat: sold_handles
    endif
  else
    assign rest_limit = max_cards
    assign rest_handles = live_handles | concat: sold_handles
  endif
-%}
{% render 'section-look', section: section %}
<section id="properties" class="sp pgrid pgrid-{{ pg_layout }}" style="--proj-gap:{{ section.settings.gap | default: 10 }}px;--pg-hero-min:{{ section.settings.hero_height | default: 680 }}px;--pg-row-ar:{{ section.settings.row_shape | default: '16/10' }};--pc-status:{{ section.settings.card_status_size | default: 100 | divided_by: 100.0 }};--pc-name-scale:{{ section.settings.card_name_size | default: 100 | divided_by: 100.0 }};--pc-chip:{{ section.settings.card_chip_size | default: 100 | divided_by: 100.0 }}">
  {%- if section.settings.show_label or section.settings.show_heading or section.settings.show_button -%}
  {%- comment -%} Side padding lives on the section (.sp) like every other band, so the heading and the cards line up with the sections above and below. {%- endcomment -%}
  <div class="inner">
    <div class="proj-hdr">
      <div>
        {%- if section.settings.show_label -%}<div class="slabel reveal">{{ section.settings.label }}</div>{%- endif -%}
        {%- if section.settings.show_heading -%}<h2 class="proj-h reveal d1">{{ section.settings.heading_html }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.show_button and section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link }}" class="btn-g reveal d2">{{ section.settings.cta_label }} &rarr;</a>{%- endif -%}
    </div>
  </div>
  {%- endif -%}

  <div class="inner">
    {%- if section.blocks.size > 0 -%}
      {%- comment -%} Every card its own block (Customize › Properties grid › ⊕ Add block › Residence card), in the sidebar's order. A block with no residence chosen is skipped. {%- endcomment -%}
      {%- liquid
        assign cards = 0
        for block in section.blocks
          assign pgb = block.settings.residence_page | default: block.settings.residence
          if pgb != blank
            assign cards = cards | plus: 1
          endif
        endfor
      -%}
      {%- if pg_layout == 'editorial' -%}
      <div class="proj-grid proj-grid-main">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign pgb = block.settings.residence_page | default: block.settings.residence -%}{%- if pgb == blank -%}{%- continue -%}{%- endif -%}
          {%- assign n = n | plus: 1 -%}
          {%- if n > 3 -%}{%- break -%}{%- endif -%}
          {%- assign slots = 'hero,a,b' | split: ',' -%}
          {%- assign si = n | minus: 1 -%}
          {% render 'residence-card', product: pgb, slot: slots[si], s: section.settings, block: block %}
        {%- endfor -%}
      </div>
      {%- endif -%}
      {%- assign skip = 0 -%}
      {%- if pg_layout == 'editorial' -%}{%- assign skip = 3 -%}{%- endif -%}
      {%- if cards > skip -%}
        <div class="{% if pg_layout == 'two' %}proj-grid-2{% else %}proj-grid-3 proj-grid-flow{% endif %}" style="{% if pg_layout == 'editorial' %}margin-top:var(--proj-gap,10px){% endif %}">
          {%- assign n = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign pgb = block.settings.residence_page | default: block.settings.residence -%}{%- if pgb == blank -%}{%- continue -%}{%- endif -%}
            {%- assign n = n | plus: 1 -%}
            {%- if n <= skip -%}{%- continue -%}{%- endif -%}
            {%- assign di = n | minus: skip | minus: 1 | modulo: 3 -%}
            {% render 'residence-card', product: pgb, slot: 'row', di: di, s: section.settings, block: block %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
    {%- if pg_layout == 'editorial' -%}
    <div class="proj-grid proj-grid-main">
      {%- for h in live_handles limit: 3 -%}
        {%- assign i = forloop.index -%}
        {%- assign pg_res = pages[h] -%}{%- if pg_res == blank -%}{%- for cand in collections.all.products -%}{%- if cand.handle == h -%}{%- assign pg_res = cand -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
        {%- if pg_res == blank -%}{%- continue -%}{%- endif -%}
          {%- if i == 1 -%}
            {% render 'residence-card', product: pg_res, slot: 'hero', s: section.settings %}
          {%- elsif i == 2 -%}
            {% render 'residence-card', product: pg_res, slot: 'a', s: section.settings %}
          {%- else -%}
            {% render 'residence-card', product: pg_res, slot: 'b', s: section.settings %}
          {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if rest_handles.size > 0 and rest_limit > 0 -%}
      <div class="{% if pg_layout == 'two' %}proj-grid-2{% else %}proj-grid-3 proj-grid-flow{% endif %}" style="{% if pg_layout == 'editorial' %}margin-top:var(--proj-gap,10px){% endif %}">
        {%- for h in rest_handles limit: rest_limit -%}
          {%- assign di = forloop.index0 | modulo: 3 -%}
          {%- assign pg_res = pages[h] -%}{%- if pg_res == blank -%}{%- for cand in collections.all.products -%}{%- if cand.handle == h -%}{%- assign pg_res = cand -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
          {%- if pg_res != blank -%}{% render 'residence-card', product: pg_res, slot: 'row', di: di, s: section.settings %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Properties grid",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "The Portfolio" },
    { "type": "html", "id": "heading_html", "label": "Heading" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View All" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "/collections/for-sale" },
    { "type": "header", "content": "Which residences" },
    { "type": "paragraph", "content": "For Sale or Sold is NOT chosen here. It is each residence's Status field: Products › the residence › Status (near the bottom) › Save. Every page follows it, and a card in the rows turns into a sold card by itself. The first three cards fill the large layout; the rest flow in rows of three. The settings below only matter while the grid has no card blocks." },
    { "type": "range", "id": "max_cards", "label": "Most residences to show", "min": 3, "max": 30, "step": 1, "default": 12, "info": "Past this number the button above leads to the full list." },
    { "type": "header", "content": "Order" },
    { "type": "paragraph", "content": "These two pickers only set the drag order (Products › Collections › the collection › sort Manually). They never move a house between For Sale and Sold." },
    { "type": "product", "id": "exclude", "label": "Leave out", "info": "The residence the Featured residence band already shows, so it is not the first card as well." },
    { "type": "collection", "id": "for_sale_collection", "label": "Order of For Sale cards" },
    { "type": "collection", "id": "sold_collection", "label": "Order of Sold cards" },
    { "type": "header", "content": "The cards" },
    { "type": "paragraph", "content": "Each card is a block: click a card, or ⊕ Add block › Residence card, to choose the residence, its photo, where a click goes and the crop. Drag the blocks to reorder. With no blocks at all, the grid fills itself: the residences for sale (Status), then the sold ones, main photo and own page each." },
    {"type": "header", "content": "Show"},
    {"type": "checkbox", "id": "show_label", "label": "Show the small label", "default": true},
    {"type": "checkbox", "id": "show_heading", "label": "Show the heading", "default": true},
    {"type": "checkbox", "id": "show_button", "label": "Show the button", "default": true},
    {"type": "checkbox", "id": "show_cars", "label": "Garage count on the large card", "default": true},
    {"type": "checkbox", "id": "show_cars_small", "label": "Garage count on the smaller cards", "default": false},
    {"type": "checkbox", "id": "show_build", "label": "Build size on the cards", "default": true, "info": "The house icon. Products › the residence › Metafields › Build size (m²)."},
    {"type": "checkbox", "id": "show_land", "label": "Land size on the cards", "default": true, "info": "The lot icon. Products › the residence › Metafields › Land size (m²)."},
    {"type": "checkbox", "id": "include_sold", "label": "Sold residences after the live ones", "default": true, "info": "Off = live residences only."},
    {"type": "checkbox", "id": "sold_suburb", "label": "Suburb on sold cards", "default": false},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "layout", "label": "Layout", "options": [{"value": "editorial", "label": "One large, two small, then rows (as designed)"}, {"value": "rows", "label": "Rows of three"}, {"value": "two", "label": "Two across"}], "default": "editorial"},
    {"type": "range", "id": "hero_height", "label": "Large card height", "min": 360, "max": 800, "step": 20, "default": 680, "unit": "px", "info": "Editorial layout. 680 = as designed (the card grows with the window up to 680px); lower caps it. The two small cards share it."},
    {"type": "select", "id": "row_shape", "label": "Shape of the row cards", "options": [{"value": "16/10", "label": "Landscape 16:10"}, {"value": "4/3", "label": "Landscape 4:3"}, {"value": "3/2", "label": "Landscape 3:2"}, {"value": "16/9", "label": "Wide 16:9"}, {"value": "1/1", "label": "Square"}, {"value": "4/5", "label": "Portrait 4:5"}], "default": "16/10"},
    {"type": "range", "id": "gap", "label": "Gap between cards", "min": 0, "max": 40, "step": 2, "default": 10, "unit": "px"},
    {"type": "header", "content": "Card words"},
    {"type": "range", "id": "card_status_size", "label": "Status chip size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "The For Sale / Sold chip. 100% = as designed."},
    {"type": "range", "id": "card_name_size", "label": "Name size", "min": 60, "max": 180, "step": 5, "unit": "%", "default": 100, "info": "The residence name on every card (brochure faces follow it)."},
    {"type": "range", "id": "card_chip_size", "label": "Spec chip size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "The bed, bath, garage and size chips."},
    {"type": "header", "content": "Look"},
    {"type": "paragraph", "content": "The same dials the home hero has, for this section. Leave everything as designed and nothing changes; every dial is undoable."},
    {"type": "select", "id": "look_surface", "label": "Background", "options": [{"value": "design", "label": "As designed"}, {"value": "cream", "label": "Cream (the page colour)"}, {"value": "stone", "label": "Stone (soft panel)"}, {"value": "obsidian", "label": "Obsidian (dark)"}, {"value": "custom", "label": "A colour of your own (below)"}, {"value": "media", "label": "A photo or film behind it (below)"}], "default": "design", "info": "Obsidian turns the words light; cream and stone keep them dark. Buttons, rules, panels and cards follow the surface."},
    {"type": "color", "id": "look_color", "label": "Your colour", "default": "#F0EADE", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "select", "id": "look_tone", "label": "Words on your colour", "options": [{"value": "light", "label": "Dark words (for a light colour)"}, {"value": "dark", "label": "Light words (for a dark colour)"}], "default": "light", "visible_if": "{{ section.settings.look_surface == 'custom' }}"},
    {"type": "header", "content": "Backdrop photo or film", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "paragraph", "content": "A backdrop behind this section's words, used only while Background is a photo or film. It is not the residence film. Real photographs and real footage only, never generated.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "image_picker", "id": "look_image", "label": "Backdrop photo", "info": "Also the poster while a backdrop film loads.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "video", "id": "look_video", "label": "Backdrop film (upload)", "info": "Plays silently on a loop. Landscape 16:9, under 20 MB keeps the page fast.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "checkbox", "id": "look_media_link", "label": "Use a film link instead of an upload", "default": false, "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "text", "id": "look_video_url", "label": "Backdrop film (URL)", "info": "A direct .mp4 link, used when no backdrop film is uploaded above.", "visible_if": "{{ section.settings.look_surface == 'media' and section.settings.look_media_link }}"},
    {"type": "range", "id": "look_dim", "label": "Darken the backdrop", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55, "info": "Lower = brighter. The words stay readable down to about 40%.", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_focus", "label": "Backdrop crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "select", "id": "look_media_tone", "label": "Words over the backdrop", "options": [{"value": "dark", "label": "Light words on a darkened backdrop"}, {"value": "light", "label": "Dark words on a pale backdrop"}], "default": "dark", "visible_if": "{{ section.settings.look_surface == 'media' }}"},
    {"type": "header", "content": "Space"},
    {"type": "range", "id": "look_space_top", "label": "Space above", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "100 = as designed. Theme settings › Layout › Space above and below sections still scales the whole site; this dial is for this section only."},
    {"type": "range", "id": "look_space_bottom", "label": "Space below", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100},
    {"type": "select", "id": "look_width", "label": "Content width", "options": [{"value": "theme", "label": "Theme setting (Layout › Content width)"}, {"value": "720", "label": "Narrow (720px)"}, {"value": "900", "label": "Reading (900px)"}, {"value": "1100", "label": "Medium (1100px)"}, {"value": "1300", "label": "Wide (1300px)"}, {"value": "1600", "label": "Very wide (1600px)"}, {"value": "edge", "label": "Edge to edge"}], "default": "theme"},
    {"type": "range", "id": "look_margins", "label": "Side margins", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "A share of the site's side margins (Theme settings › Layout). 0 runs to the edges."},
    {"type": "header", "content": "Type"},
    {"type": "range", "id": "look_heading", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100, "info": "Scales the serif headings and titles in this section."},
    {"type": "range", "id": "look_text", "label": "Text size", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100, "info": "Paragraphs, captions and standfirsts."},
    {"type": "range", "id": "look_label", "label": "Small label size", "min": 0, "max": 20, "step": 0.5, "unit": "px", "default": 0, "info": "0 = the site-wide size (Theme settings › Layout › Section label size)."},
    {"type": "header", "content": "Finishing"},
    {"type": "checkbox", "id": "look_animate", "label": "Fade in as it scrolls into view", "default": true, "info": "Off = the section is simply there, no entrance."},
    {"type": "checkbox", "id": "look_rule_top", "label": "Hairline above", "default": false},
    {"type": "checkbox", "id": "look_rule_bottom", "label": "Hairline below", "default": false},
    {"type": "text", "id": "look_anchor", "label": "Anchor name", "info": "Lets a link jump straight here: with the word story, a link to /#story lands on this section."}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Residence card",
      "settings": [
        { "type": "page", "id": "residence_page", "label": "Residence page", "info": "The residence's page (Content › Pages). Leads over the product below; the residences moved to pages on 15 Sep 2026." },
        { "type": "product", "id": "residence", "label": "Residence" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Empty = the residence's main photo (Products › the residence › Media, first photo). Its other photos are in the picker's library. Real photographs and renders only, never generated." },
        { "type": "url", "id": "link", "label": "Send clicks to", "info": "Empty = the residence's own page." },
        { "type": "select", "id": "focus", "label": "Crop focus", "options": [{"value": "center", "label": "Centre"}, {"value": "top", "label": "Top"}, {"value": "bottom", "label": "Bottom"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center" }
      ]
    }
  ]
}
{% endschema %}
