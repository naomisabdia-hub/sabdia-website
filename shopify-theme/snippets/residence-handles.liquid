{%- comment -%}
  Prints the ordered, comma-separated handles of every residence in one
  status group, so a list can never disagree with the Status field:

    group: 'live' - For Sale, Under Offer, Coming Soon … (no "Sold")
    group: 'sold' - any status containing "Sold"
    Status "Completed" (the Collection homes that live in Products since
    14 Sep 2026: MILOS, PETRA, KIRRA, HERMOSA, ENCANTO, HAVEN, SPECTRE) is
    in neither group: those residences belong to the Collection page only.
    col:   the collection whose manual drag-order leads the list
           (For Sale or Sold). Residences whose Status puts them in this
           group but who are not in that collection are swept in after,
           so a house moved with the Status dropdown alone still shows.

  Usage:
    {% capture h %}{% render 'residence-handles', col: collections['for-sale'], group: 'live' %}{% endcapture %}
    {% assign handles = h | split: ',' %}
  then find each product with a loop over collections.all.products.
{%- endcomment -%}
{%- liquid
  assign out = ','
  # Residence pages lead (15 Sep 2026: the residences moved from $0 products
  # to pages), in the order set in Theme settings › Residences › Residence
  # pages, each placed by its own Status exactly like a product below.
  assign rp_csv = settings.residence_pages | default: 'aether,sierra,solace,caspian,qasr,capri' | newline_to_br | replace: '<br />', ','
  assign rp_list = rp_csv | split: ','
  for rp_h in rp_list
    assign rp_hs = rp_h | strip
    if rp_hs == blank
      continue
    endif
    assign rp = pages[rp_hs]
    if rp == blank
      continue
    endif
    capture st
      render 'residence-status', product: rp
    endcapture
    if st contains 'Completed'
      continue
    endif
    assign in_sold = false
    if st contains 'Sold'
      assign in_sold = true
    endif
    if group == 'sold' and in_sold == false
      continue
    endif
    if group != 'sold' and in_sold
      continue
    endif
    assign key = ',' | append: rp_hs | append: ','
    unless out contains key
      assign out = out | append: rp_hs | append: ','
    endunless
  endfor
  if col
    for p in col.products
      capture st
        render 'residence-status', product: p
      endcapture
      if st contains 'Completed'
        continue
      endif
      assign in_sold = false
      if st contains 'Sold'
        assign in_sold = true
      endif
      if group == 'sold' and in_sold == false
        continue
      endif
      if group != 'sold' and in_sold
        continue
      endif
      assign key = ',' | append: p.handle | append: ','
      unless out contains key
        assign out = out | append: p.handle | append: ','
      endunless
    endfor
  endif
  for p in collections.all.products
    capture st
      render 'residence-status', product: p
    endcapture
    if st contains 'Completed'
      continue
    endif
    assign in_sold = false
    if st contains 'Sold'
      assign in_sold = true
    endif
    if group == 'sold' and in_sold == false
      continue
    endif
    if group != 'sold' and in_sold
      continue
    endif
    assign key = ',' | append: p.handle | append: ','
    unless out contains key
      assign out = out | append: p.handle | append: ','
    endunless
  endfor
  echo out | remove_first: ','
-%}
