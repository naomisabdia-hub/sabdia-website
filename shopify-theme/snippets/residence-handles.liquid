{%- comment -%}
  Prints the ordered, comma-separated handles of every residence in one
  status group, so a list can never disagree with the Status field:

    group: 'live'  — For Sale, Under Offer, Coming Soon … (no "Sold")
    group: 'sold'  — any status containing "Sold"
    col:   the collection whose manual drag-order leads the list
           (For Sale or Sold). Residences whose Status puts them in this
           group but who are not in that collection are swept in after,
           so a house moved with the Status dropdown alone still shows.

  Usage:
    {% capture h %}{% render 'residence-handles', col: collections['for-sale'], group: 'live' %}{% endcapture %}
    {% assign handles = h | split: ',' %}
  then find each product with a loop over collections.all.products.
{%- endcomment -%}
{%- liquid
  assign out = ','
  if col
    for p in col.products
      capture st
        render 'residence-status', product: p
      endcapture
      assign in_sold = false
      if st contains 'Sold'
        assign in_sold = true
      endif
      if group == 'sold' and in_sold == false
        continue
      endif
      if group != 'sold' and in_sold
        continue
      endif
      assign key = ',' | append: p.handle | append: ','
      unless out contains key
        assign out = out | append: p.handle | append: ','
      endunless
    endfor
  endif
  for p in collections.all.products
    capture st
      render 'residence-status', product: p
    endcapture
    assign in_sold = false
    if st contains 'Sold'
      assign in_sold = true
    endif
    if group == 'sold' and in_sold == false
      continue
    endif
    if group != 'sold' and in_sold
      continue
    endif
    assign key = ',' | append: p.handle | append: ','
    unless out contains key
      assign out = out | append: p.handle | append: ','
    endunless
  endfor
  echo out | remove_first: ','
-%}
