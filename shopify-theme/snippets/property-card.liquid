{%- comment -%}
  Port of PropertyCard.astro, fed by a product. Specs come from the
  product's metafields (custom.beds / baths / cars / land / land_over /
  suburb); the image crops around the focal point set on it in Shopify.

  Params: product, class, style, img_w, img_h, show_cars (optional), show_land (default true)
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign img_w2 = img_w | times: 2
  assign img_h2 = img_h | times: 2
-%}
<a href="{{ product.url }}" class="pc {{ class }}" {% if style != blank %}style="{{ style }}"{% endif %}>
  {%- if product.featured_image -%}
    <img
      src="{{ product.featured_image | image_url: width: img_w, height: img_h, crop: 'center' }}"
      srcset="{{ product.featured_image | image_url: width: img_w, height: img_h, crop: 'center' }} 1x, {{ product.featured_image | image_url: width: img_w2, height: img_h2, crop: 'center' }} 2x"
      alt="{{ product.title | escape }}" loading="lazy" decoding="async" width="{{ img_w }}" height="{{ img_h }}">
  {%- endif -%}
  <div class="pc-ov"></div>
  <div class="pc-status-chip"><span class="pc-dot"></span>For Sale</div>
  <div class="pc-info">
    <div class="pc-name">{{ product.title }}</div>
    {%- if mf.suburb.value != blank -%}
      <div class="pc-loc">{% render 'spec-icon', icon: 'pin' %}{{ mf.suburb.value }}, QLD</div>
    {%- endif -%}
    <ul class="pc-specs">
      {%- if mf.beds.value != blank -%}
        <li class="pc-spec">{% render 'spec-icon', icon: 'beds' %}<span>{{ mf.beds.value }} Bed</span></li>
      {%- endif -%}
      {%- if mf.baths.value != blank -%}
        <li class="pc-spec">{% render 'spec-icon', icon: 'baths' %}<span>{{ mf.baths.value }} Bath</span></li>
      {%- endif -%}
      {%- if show_cars and mf.cars.value != blank -%}
        <li class="pc-spec">{% render 'spec-icon', icon: 'cars' %}<span>{{ mf.cars.value }} Garage</span></li>
      {%- endif -%}
      {%- if mf.land.value != blank and show_land != false -%}
        <li class="pc-spec">{% render 'spec-icon', icon: 'land' %}<span>{{ mf.land.value }}m&sup2;{% if mf.land_over.value %}+{% endif %}</span></li>
      {%- endif -%}
    </ul>
  </div>
  <div class="pc-arrow">&rarr;</div>
</a>
