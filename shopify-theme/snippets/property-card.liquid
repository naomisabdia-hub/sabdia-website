{%- comment -%}
  Port of PropertyCard.astro, fed by a product. Specs come from the
  product's metafields (custom.beds / baths / cars / build_size / land / land_over /
  suburb); the image crops around the focal point set on it in Shopify.
  The chip prints the residence's Status word (see residence-status).

  The name is set in the residence's own brochure face when the product
  carries one (metafields custom.name_font, a Google Fonts family, or
  custom.name_font_file, a font file link; weight from name_font_weight,
  capitals from name_font_caps). The card only writes the font-family
  inline: the page that lists the cards loads the face once (the For Sale
  page does; a page without the <link> simply falls back to the serif).

  Data attributes on the card (beds, baths, status, feats, year) feed the
  For Sale toolbar; feats are the normalised tokens from residence-feats.

  Params: product, class, style, img_w, img_h, show_cars (optional), show_build (default true), show_land (default true)
  Overrides from a section's Residence card block (properties-grid, the
  For Sale grid, the Sold band): image (a Shopify image), url (where the
  card sends clicks), focus (crop: center/top/bottom/left/right), name,
  suburb, status (the chip word), beds, baths, cars, build, land (each replaces
  the residence's own line when given, 15 Sep 2026) and attrs
  (block.shopify_attributes, so the card is clickable in Customize).
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign img_w2 = img_w | times: 2
  assign img_h2 = img_h | times: 2
  capture pstatus
    render 'residence-status', product: product
  endcapture
  if status != blank
    assign pstatus = status | strip
  endif
  assign v_suburb = suburb | default: mf.suburb.value
  assign v_beds = beds | default: mf.beds.value
  assign v_baths = baths | default: mf.baths.value
  assign v_cars = cars | default: mf.cars.value
  assign v_build = build | default: mf.build_size.value
  assign v_land = land | default: mf.land.value
  assign chip = pstatus
  if pstatus == 'For Sale' and settings.label_for_sale != blank
    assign chip = settings.label_for_sale
  endif
  assign dot_class = ''
  if pstatus contains 'Sold'
    assign dot_class = 'sold'
  elsif pstatus != 'For Sale'
    assign dot_class = 'still'
  endif
  capture feats
    render 'residence-feats', product: product
  endcapture

  # Brochure face (see the comment above). Nothing is written unless the
  # residence has a face of its own.
  assign nf = mf.name_font.value | strip
  assign nf_file = mf.name_font_file.value | strip
  assign nf_style = ''
  if nf != blank or nf_file != blank
    assign nf_family = nf
    if nf_family == blank
      assign nf_family = 'ResidenceFace-' | append: product.handle
    endif
    assign nf_weight = mf.name_font_weight.value | default: 400
    capture nf_scale
      render 'residence-face-scale', product: product
    endcapture
    assign nf_style = "font-family:'" | append: nf_family | append: "',var(--font-d);font-weight:" | append: nf_weight | append: ';font-size:calc(var(--pc-name,var(--t-h3))*1.25*var(--s-h,1)*var(--pc-name-scale,1)*' | append: nf_scale | append: ');letter-spacing:0;text-transform:none;line-height:1' 
    if mf.name_font_caps.value
      assign nf_style = nf_style | append: ';text-transform:uppercase'
    endif
  endif
  # The face decides the case: a brochure that sets "Sierra" in a script
  # keeps it that way on the card; capitals on = the name as written.
  assign pc_name = product.title
  if nf_style != blank and mf.name_font_caps.value != true
    assign pc_name = product.title | downcase | capitalize
  endif
  if name != blank
    assign pc_name = name
  endif
-%}
{%- liquid
  assign pc_focus = focus | default: 'center'
  assign pc_img = image | default: product.featured_image | default: product.featured_media.preview_image
-%}
<a href="{{ url | default: product.url }}" class="pc {{ class }}" {% if style != blank %}style="{{ style }}"{% endif %} data-beds="{{ v_beds }}" data-baths="{{ v_baths }}" data-status="{{ pstatus | escape }}" data-feats="{{ feats }}" data-year="{{ mf.year.value }}" {{ attrs }}>
  {%- if pc_img -%}
    {%- comment -%} Phones show every card 4:5 (style.css, max-width 768px): a portrait crop there, sized for a 2x screen, so the photo is never upscaled or soft. {%- endcomment -%}
    <picture>
      <source media="(max-width: 768px)" srcset="{{ pc_img | image_url: width: 800, height: 1000, crop: pc_focus }} 800w, {{ pc_img | image_url: width: 1200, height: 1500, crop: pc_focus }} 1200w" sizes="100vw">
      <img
        src="{{ pc_img | image_url: width: img_w, height: img_h, crop: pc_focus }}"
        srcset="{{ pc_img | image_url: width: img_w, height: img_h, crop: pc_focus }} 1x, {{ pc_img | image_url: width: img_w2, height: img_h2, crop: pc_focus }} 2x"
        alt="{{ product.title | escape }}" loading="lazy" decoding="async" width="{{ img_w }}" height="{{ img_h }}">
    </picture>
  {%- endif -%}
  <div class="pc-ov"></div>
  <div class="pc-status-chip"><span class="pc-dot {{ dot_class }}"></span>{{ chip }}</div>
  <div class="pc-info">
    <div class="pc-name"{% if nf_style != blank %} style="{{ nf_style | escape }}"{% endif %}>{{ pc_name }}</div>
    {%- if v_suburb != blank -%}
      <div class="pc-loc">{% render 'spec-icon', icon: 'pin' %}{{ v_suburb }}{% unless suburb != blank %}, QLD{% endunless %}</div>
    {%- endif -%}
    <ul class="pc-specs">
      {%- if v_beds != blank -%}
        <li class="pc-spec">{% render 'spec-icon', icon: 'beds' %}<span>{{ v_beds }} Bed</span></li>
      {%- endif -%}
      {%- if v_baths != blank -%}
        <li class="pc-spec">{% render 'spec-icon', icon: 'baths' %}<span>{{ v_baths }} Bath</span></li>
      {%- endif -%}
      {%- if show_cars and v_cars != blank -%}
        <li class="pc-spec">{% render 'spec-icon', icon: 'cars' %}<span>{{ v_cars }} Garage</span></li>
      {%- endif -%}
      {%- comment -%} Build size (the house icon) then land size (the lot icon), both when the residence has them (Naomi, 15 Sep 2026): Products › the residence › Metafields › Build size (m²) and Land size (m²). The word after the number is for screen readers, and prints on phones where the icons are hidden. {%- endcomment -%}
      {%- if v_build != blank and show_build != false -%}
        <li class="pc-spec" title="Build size">{% render 'spec-icon', icon: 'house' %}<span>{{ v_build }}m&sup2;<span class="pc-spec-k"> build</span></span></li>
      {%- endif -%}
      {%- if v_land != blank and show_land != false -%}
        <li class="pc-spec" title="Land size">{% render 'spec-icon', icon: 'land' %}<span>{{ v_land }}m&sup2;{% if mf.land_over.value and land == blank %}+{% endif %}<span class="pc-spec-k"> land</span></span></li>
      {%- endif -%}
    </ul>
  </div>
  <div class="pc-arrow">&rarr;</div>
</a>
