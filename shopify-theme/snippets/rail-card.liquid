{%- comment -%}
  One card of the Residence rail (sections/residence-rail.liquid).
  Params: product, featured (true = the wider first card), section
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
  capture st
    render 'residence-status', product: product
  endcapture
  assign chip = st
  if st == 'For Sale' and settings.label_for_sale != blank
    assign chip = settings.label_for_sale
  endif
  assign img = product.featured_image
  if featured
    assign iw = 900
  else
    assign iw = 600
  endif
  assign ar_parts = section.settings.shape | default: '3/4' | split: '/'
  assign ih = iw | times: ar_parts[1] | divided_by: ar_parts[0]
  assign iw2 = iw | times: 2
  assign ih2 = ih | times: 2
  assign line = ''
  if featured and section.settings.show_headline
    assign line = m.headline.value
  endif
-%}
<li class="rr-card{% if featured %} rr-featured{% endif %} reveal{% if featured %}{% else %} d1{% endif %}">
  <a href="{{ product.url }}" aria-label="{{ product.title }}{% if m.suburb.value != blank %}, {{ m.suburb.value }}{% endif %}">
    <div class="rr-media">
      {%- if img -%}
        <img src="{{ img | image_url: width: iw, height: ih, crop: 'center' }}" srcset="{{ img | image_url: width: iw, height: ih, crop: 'center' }} 1x, {{ img | image_url: width: iw2, height: ih2, crop: 'center' }} 2x" alt="{{ product.title }}, {{ m.suburb.value }}" loading="lazy" decoding="async" width="{{ iw }}" height="{{ ih }}">
      {%- endif -%}
      {%- if section.settings.show_status and st != blank -%}<span class="pc-status-chip"><span class="pc-dot{% if st contains 'Sold' %} sold{% elsif st != 'For Sale' %} still{% endif %}"></span>{{ chip }}</span>{%- endif -%}
    </div>
    <div class="rr-body">
      <div class="rr-name">{{ product.title }}</div>
      {%- if m.suburb.value != blank -%}<div class="rr-loc">{{ m.suburb.value }}</div>{%- endif -%}
      {%- if line != blank -%}<p class="rr-line">{{ line }}</p>{%- endif -%}
      {%- if section.settings.show_facts -%}
      <ul class="rr-facts">
        {%- if m.beds.value != blank -%}<li><b>{{ m.beds.value }}</b> Bed</li>{%- endif -%}
        {%- if m.baths.value != blank -%}<li><b>{{ m.baths.value }}</b> Bath</li>{%- endif -%}
        {%- if m.cars.value != blank -%}<li><b>{{ m.cars.value }}</b> Garage</li>{%- endif -%}
        {%- if m.land.value != blank -%}<li><b>{{ m.land.value }}</b>m&sup2;</li>{%- endif -%}
      </ul>
      {%- endif -%}
      {%- if section.settings.card_cta != blank -%}<span class="rr-cta">{{ section.settings.card_cta }}</span>{%- endif -%}
    </div>
  </a>
</li>
