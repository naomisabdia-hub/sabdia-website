{%- comment -%}
  Complete share card on every page — pages may override parts (product
  pages share their hero image) but nothing renders bare when shared.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description
  if template.name == 'index' and settings.seo_home_description != blank
    assign og_description = settings.seo_home_description
  endif
  assign og_image = blank
  if settings.share_image
    assign og_image = settings.share_image | image_url: width: 1200, height: 630, crop: 'center'
  endif
  if template.name == 'product' and product.featured_image
    assign og_image = product.featured_image | image_url: width: 1200, height: 630, crop: 'center'
  endif
-%}
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="Sabdia Constructions">
<meta property="og:locale" content="en_AU">
{%- comment -%}
  Never ship a bare share card: with no Social share image chosen in
  Theme settings, fall back to the bundled home-hero crop (1200×630).
{%- endcomment -%}
{%- if og_image == blank -%}
  {%- assign og_image = 'share-default.jpg' | asset_url -%}
{%- endif -%}
{%- assign og_image_abs = og_image -%}
{%- unless og_image_abs contains 'https:' -%}{%- assign og_image_abs = og_image_abs | prepend: 'https:' -%}{%- endunless -%}
<meta property="og:image" content="{{ og_image_abs }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content="{{ og_image_abs }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
