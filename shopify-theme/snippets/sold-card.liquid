{%- comment -%}
  Port of SoldCard.astro, fed by a residence whose Status is in the Sold
  group (see residence-status). The badge prints that Status word. The
  name is set in the residence's own brochure face when the product carries
  one (see property-card for the metafields), and the card carries the same
  data attributes as property-card so a mixed grid filters the same way.
  Params: product, class, img_w, img_h, show_suburb (default false here)
  Overrides (see property-card): image, url, focus, name, suburb, status
  (the badge word), beds, baths, cars, build, land, attrs, and
  show_build / show_land (default true).
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign img_w2 = img_w | times: 2
  assign img_h2 = img_h | times: 2
  capture pstatus
    render 'residence-status', product: product
  endcapture
  if status != blank
    assign pstatus = status | strip
  endif
  assign v_suburb = suburb | default: mf.suburb.value
  assign v_beds = beds | default: mf.beds.value
  assign v_baths = baths | default: mf.baths.value
  assign v_cars = cars | default: mf.cars.value
  assign v_build = build | default: mf.build_size.value
  assign v_land = land | default: mf.land.value
  assign badge = pstatus
  if pstatus == 'Sold Prior to Completion' and settings.label_sold_badge != blank
    assign badge = settings.label_sold_badge
  endif
  capture feats
    render 'residence-feats', product: product
  endcapture
  assign nf = mf.name_font.value | strip
  assign nf_file = mf.name_font_file.value | strip
  assign nf_style = ''
  if nf != blank or nf_file != blank
    assign nf_family = nf
    if nf_family == blank
      assign nf_family = 'ResidenceFace-' | append: product.handle
    endif
    assign nf_weight = mf.name_font_weight.value | default: 400
    capture nf_scale
      render 'residence-face-scale', product: product
    endcapture
    assign nf_style = "font-family:'" | append: nf_family | append: "',var(--font-d);font-weight:" | append: nf_weight | append: ';font-size:calc(var(--pc-name,var(--t-h3))*1.25*var(--s-h,1)*var(--pc-name-scale,1)*' | append: nf_scale | append: ');letter-spacing:0;text-transform:none;line-height:1'
    if mf.name_font_caps.value
      assign nf_style = nf_style | append: ';text-transform:uppercase'
    endif
  endif
  assign sc_name = product.title
  if nf_style != blank and mf.name_font_caps.value != true
    assign sc_name = product.title | downcase | capitalize
  endif
  if name != blank
    assign sc_name = name
  endif
-%}
{%- liquid
  assign sc_focus = focus | default: 'center'
  assign sc_img = image | default: product.featured_image | default: product.featured_media.preview_image
-%}
<a href="{{ url | default: product.url }}" class="sc-card {{ class }}" data-beds="{{ v_beds }}" data-baths="{{ v_baths }}" data-status="{{ pstatus | escape }}" data-feats="{{ feats }}" data-year="{{ mf.year.value }}" {{ attrs }}>
  {%- if sc_img -%}
    {%- comment -%} Phones show every card 4:5 (style.css, max-width 768px): a portrait crop there, sized for a 2x screen, so the photo is never upscaled or soft. {%- endcomment -%}
    <picture>
      <source media="(max-width: 768px)" srcset="{{ sc_img | image_url: width: 800, height: 1000, crop: sc_focus }} 800w, {{ sc_img | image_url: width: 1200, height: 1500, crop: sc_focus }} 1200w" sizes="100vw">
      <img
        src="{{ sc_img | image_url: width: img_w, height: img_h, crop: sc_focus }}"
        srcset="{{ sc_img | image_url: width: img_w, height: img_h, crop: sc_focus }} 1x, {{ sc_img | image_url: width: img_w2, height: img_h2, crop: sc_focus }} 2x"
        alt="{{ product.title | escape }}" loading="lazy" decoding="async" width="{{ img_w }}" height="{{ img_h }}">
    </picture>
  {%- endif -%}
  <div class="sc-ov"></div>
  <div class="sc-badge">{{ badge }}</div>
  <div class="sc-info">
    <div class="sc-name"{% if nf_style != blank %} style="{{ nf_style | escape }}"{% endif %}>{{ sc_name }}</div>
    {%- if show_suburb and v_suburb != blank -%}
      <div class="pc-loc">{% render 'spec-icon', icon: 'pin' %}{{ v_suburb }}{% unless suburb != blank %}, QLD{% endunless %}</div>
    {%- endif -%}
    <ul class="pc-specs">
      {%- if v_beds != blank -%}<li class="pc-spec">{% render 'spec-icon', icon: 'beds' %}<span>{{ v_beds }} Bed</span></li>{%- endif -%}
      {%- if v_baths != blank -%}<li class="pc-spec">{% render 'spec-icon', icon: 'baths' %}<span>{{ v_baths }} Bath</span></li>{%- endif -%}
      {%- if v_cars != blank -%}<li class="pc-spec">{% render 'spec-icon', icon: 'cars' %}<span>{{ v_cars }} Garage</span></li>{%- endif -%}
      {%- if v_build != blank and show_build != false -%}<li class="pc-spec" title="Build size">{% render 'spec-icon', icon: 'house' %}<span>{{ v_build }}m&sup2;<span class="pc-spec-k"> build</span></span></li>{%- endif -%}
      {%- if v_land != blank and show_land != false -%}<li class="pc-spec" title="Land size">{% render 'spec-icon', icon: 'land' %}<span>{{ v_land }}m&sup2;{% if mf.land_over.value and land == blank %}+{% endif %}<span class="pc-spec-k"> land</span></span></li>{%- endif -%}
    </ul>
  </div>
</a>
