{%- comment -%}
  Resized/cropped variant of an image that still lives on the Sabdia
  media pipeline (local /images master or Supabase media) - served via
  the existing /api/img endpoint so crops and focal points render exactly
  as on the Vercel site. Shopify-hosted images should use image_url
  instead; this exists so externally-hosted content renders identically
  until it is migrated.

  Accepts: src (path or URL), w, h, focus (optional "fp_x_y"), q (optional)

  Built entirely inside one liquid block with echo - a stray newline in
  the template would land inside the src="…" attribute.
{%- endcomment -%}
{%- liquid
  assign base = settings.forms_endpoint
  # The old site's /images/ photos live in Supabase media/images/ since
  # 15 Sep 2026: the Vercel copies sit behind Deployment Protection and never
  # load, so a leftover "Current photo (URL)" behind a removed photo broke.
  assign images_prefix = src | slice: 0, 8
  if images_prefix == '/images/'
    assign src = src | replace_first: '/images/', 'https://fvczsjcrvwzqtcbforgo.supabase.co/storage/v1/object/public/media/images/'
  endif
  assign is_svg = false
  if src contains '.svg'
    assign is_svg = true
  endif
  assign is_media = false
  if src contains '.supabase.co/storage/v1/object/public/'
    assign is_media = true
  endif
  assign first_char = src | slice: 0, 1
  if first_char == '/'
    assign is_media = true
  endif
  # A Shopify CDN address (image_url gives //www.sabdia.com.au/cdn/shop/…)
  # is served as it is: Shopify already sized it.
  assign first_two = src | slice: 0, 2
  if first_two == '//' or src contains '/cdn/shop/'
    assign is_media = false
  endif
  # Supabase photos are served straight from Supabase (14 Sep 2026): the
  # Vercel project behind /api/img sits behind Deployment Protection, so
  # its crops redirect to a Vercel sign-in and the picture never loads.
  assign is_supabase = false
  if src contains '.supabase.co/storage/v1/object/public/'
    assign is_supabase = true
  endif
  if src == blank
    # nothing to output
  elsif is_svg or is_media == false or is_supabase
    echo src
  else
    assign enc = src | url_encode
    assign out = base | append: '/api/img?src=' | append: enc | append: '&w=' | append: w | append: '&h=' | append: h
    if focus != blank
      assign fenc = focus | url_encode
      assign out = out | append: '&fp=' | append: fenc
    endif
    if q != blank
      assign out = out | append: '&q=' | append: q
    endif
    echo out
  endif
-%}
