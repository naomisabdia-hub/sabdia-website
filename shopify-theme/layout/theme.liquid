{%- comment -%}
  Sabdia theme shell - a faithful port of the Astro site's Base.astro.
  Same stylesheet, same fonts, same body structure (skip link → nav →
  main → footer → main.js), so every page renders identically to the
  Vercel site. Header/footer live in section groups so they are editable
  in the theme customizer.
{%- endcomment -%}
<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#F7F3EB">
{%- liquid
  # Routes the site does not use still exist on every store; give them a
  # neutral title instead of Shopify's "Your Shopping Cart".
  assign title_text = page_title
  case template.name
    when 'cart'
      assign title_text = 'Not in use'
    when 'search'
      assign title_text = 'Search'
    when 'list-collections'
      assign title_text = 'Residences'
  endcase
-%}
<title>{{ title_text }}{% unless title_text contains 'Sabdia' or title_text == blank %} | Sabdia Constructions{% endunless %}</title>
{%- liquid
  # Customizer-driven logo size (Brand → Logo size); the stylesheet falls
  # back to the reviewed 38px/30px when the vars are absent.
  assign lh = settings.logo_height | default: 38
  assign lhm = lh | times: 0.79 | round
-%}
<style>:root{--logo-h:{{ lh }}px;--logo-h-m:{{ lhm }}px}</style>
{%- liquid
  # The homepage has no page-level SEO fields of its own, so its meta
  # description is a theme setting (Search & sharing) - editable in the
  # customizer like everything else.
  assign meta_description = page_description
  if template.name == 'index' and settings.seo_home_description != blank
    assign meta_description = settings.seo_home_description
  endif
  # Never ship a page without a description: fall back to the store's
  # own description (Settings › Store details) or the homepage one.
  if meta_description == blank
    assign meta_description = shop.description | default: settings.seo_home_description
  endif
-%}
{%- if meta_description -%}<meta name="description" content="{{ meta_description | escape }}">{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
<script>
document.documentElement.classList.add('js');
/* Runs before first paint so the loader never flashes on a repeat visit.
   sessionStorage, not localStorage: the opening is worth seeing once per
   visit, not once per lifetime. Wrapped because Safari private mode throws
   on storage access - a failure here just means the loader plays. */
try {
  if (sessionStorage.getItem('sabdia:seen')) document.documentElement.classList.add('no-loader');
  else sessionStorage.setItem('sabdia:seen', '1');
} catch (e) {}
</script>
{% render 'meta-tags' %}
{% render 'structured-data' %}
<link rel="preconnect" href="https://fvczsjcrvwzqtcbforgo.supabase.co" crossorigin>
{%- liquid
  # Two typefaces only: Cormorant Garamond (self-hosted) for the large
  # headings, and the body/interface font from Theme settings › Design
  # (Open Sans by default) for everything else, served by Shopify.
  assign body_font = settings.font_body
  assign body_font_light = body_font | font_modify: 'weight', '300'
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
-%}
<link rel="preload" as="font" type="font/woff2" href="{{ 'cormorant-garamond-var.woff2' | asset_url }}" crossorigin>
{%- if body_font -%}<link rel="preload" as="font" type="font/woff2" href="{{ body_font | font_url }}" crossorigin>{%- endif -%}
{{ 'style.css' | asset_url | stylesheet_tag }}
{%- if body_font -%}
<style>
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_light | font_face: font_display: 'swap' }}
  {{ body_font_medium | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  :root{--font-u:{{ body_font.family }},{{ body_font.fallback_families }}}
</style>
{%- endif -%}
{%- comment -%}
  Theme settings → Design. Must come AFTER the stylesheet: style.css sets
  the same :root variables, and the later declaration wins.
{%- endcomment -%}
{%- if settings.design_override -%}
<style>:root{--bg:{{ settings.c_bg }};--bg2:{{ settings.c_bg2 }};--dark:{{ settings.c_dark }};--ink:{{ settings.c_ink }};--gold:{{ settings.c_gold }};--gold2:{{ settings.c_gold2 }}}</style>
{%- endif -%}
{%- comment -%} Theme settings › Layout: side margins, content width, section spacing. {%- endcomment -%}
{%- liquid
  assign lay_pad = settings.page_pad | default: 80
  assign lay_pad_m = settings.page_pad_mobile | default: 22
  assign lay_max = settings.page_max | default: 1400
  assign lay_sp = settings.section_space | default: 100
-%}
<style>:root{--page-pad:clamp({{ lay_pad_m }}px,5vw,{{ lay_pad }}px);--page-max:{{ lay_max }}px;--sp-scale:{{ lay_sp | divided_by: 100.0 }}}</style>
{{ content_for_header }}
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

{% sections 'header-group' %}

<main id="main">
{{ content_for_layout }}
</main>

{% sections 'footer-group' %}
{%- comment -%} Ask Sabdia chat (sections/concierge.liquid) is switched off: Naomi chose Shopify Inbox as the single chat (2026-09-10). To bring it back, add {% section 'concierge' %} here. {%- endcomment -%}
{%- capture res_handles -%}{%- for p in collections.all.products -%}{%- if p.tags contains 'property' -%}{{ p.handle }},{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- capture res_map -%}[{%- for p in collections.all.products -%}{%- if p.tags contains 'property' -%}{"handle":{{ p.handle | json }},"title":{{ p.title | json }},"suburb":{{ p.metafields.custom.suburb.value | default: '' | json }}},{%- endif -%}{%- endfor -%}]{%- endcapture -%}
<script>window.SabdiaForms={residences:{{ res_handles | split: ',' | compact | json }},residenceMap:{{ res_map | replace: ',]', ']' }},mode:{{ settings.form_backend | json }},mirror:{% if settings.forms_endpoint != blank %}{{ settings.forms_endpoint | append: '/api/contact' | json }}{% else %}null{% endif %},thanks:{"heading":"Thank you","text":"Thank you for your interest - we appreciate you reaching out. A member of our team will be in touch with you as soon as possible."},replies:[
{"match":"renovat|custom|client build|build (my|our|a) |our block|my block|our land|my land|knock ?down|extension|quote","text":"Thank you so much for reaching out and for thinking of us for your project. At the moment we aren't taking on client builds or renovations - our focus is solely on designing and building our own development projects. We really appreciate your interest and support, and hopefully our paths cross in the future."},
{"match":"agent|agency|licen","text":"Thank you for reaching out. We will review your details and be in touch about agent access as soon as possible."},
{"match":"inspect|view|walk ?through|open home","text":"Thank you for your interest - we appreciate you reaching out. Inspections are by private appointment. To help us provide the most relevant information, could you please share your approximate budget range and your intended timeline for purchase? A member of our team will then be in touch to arrange a time."},
{"match":"price|guide|cost|how much|budget","text":"Thank you for your interest - we appreciate you reaching out. We talk through pricing directly rather than publishing a guide. To help us provide the most relevant information, could you please share your approximate budget range and your intended timeline for purchase? A member of our team will then be in touch with you as soon as possible."},
{"match":"about sabdia|tell me more|who (are|is) sabdia|your company|your team|history","text":"Thank you for reaching out. Sabdia is a boutique Brisbane developer, in-house from the first sketch to handover, with more than 100 homes since 2013. A member of our team will be in touch with you as soon as possible."}
]};</script>
<script src="{{ 'main.js' | asset_url }}"></script>
</body>
</html>
