---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getContent } from '../lib/content.js';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  preloadImage?: string;
  preloadImageSet?: string;
  preloadImageSizes?: string;
  /* Optional media query gating the preload (e.g. desktop-only hero crop). */
  preloadImageMedia?: string;
  /* Pass on pages that open on a light surface instead of a photograph
     or dark band, so the nav renders dark-on-light from the top. */
  lightNav?: boolean;
}

const { title: titleProp, description: descriptionProp, ogTitle, ogDescription, ogImage, preloadImage, preloadImageSet, preloadImageSizes, preloadImageMedia, lightNav } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/* Per-page search listings, editable in the admin (Site Content →
   Search engine listings). A non-empty override wins over the title
   and description baked into the page component. */
const SEO_KEY: Record<string, string> = {
  '/': 'home', '/properties/': 'properties', '/about/': 'about',
  '/services/': 'services', '/projects/': 'projects', '/collection/': 'collection',
  '/contact/': 'contact', '/agent-access/': 'agent_access', '/find-your-home/': 'find_your_home',
};
let seoOverride: { title?: string; description?: string } = {};
const seoKey = SEO_KEY[Astro.url.pathname];
if (seoKey) {
  const { seo_pages } = await getContent('seo_pages');
  seoOverride = seo_pages?.[seoKey] ?? {};
}
const title = seoOverride.title?.trim() || titleProp;
const description = seoOverride.description?.trim() || descriptionProp;
/* Every page ships a complete share card: pages may override any part,
   but nothing renders bare when shared. Crawlers need og:image absolute;
   pages pass site-relative paths. */
const ogT = ogTitle ?? title;
const ogD = ogDescription ?? description;
const OG_DEFAULT = '/api/img?src=%2Fimages%2Fhome-hero-1.jpg&w=1200&h=630&q=85';
/* og:image must actually RESOLVE for share cards to render, so it is
   built on the host that serves this deployment — not Astro.site, which
   is the canonical domain and still points at Wix until the DNS move
   (every share card 404'd). VERCEL_PROJECT_PRODUCTION_URL follows the
   project's production alias, so this heals itself when the domain
   lands. canonical/og:url stay on Astro.site deliberately. */
const publicHost = import.meta.env.VERCEL_PROJECT_PRODUCTION_URL ?? process.env.VERCEL_PROJECT_PRODUCTION_URL;
const ogBase = publicHost ? `https://${publicHost}` : Astro.site;
const ogImageAbs = new URL(ogImage ?? OG_DEFAULT, ogBase).href;
const gaId = import.meta.env.PUBLIC_GA4_ID;
/* Deploy-stamped asset URLs. Without a version, a visitor's browser can
   keep serving its cached main.js/style.css across deploys — fixes ship
   but never reach them until a manual hard refresh. The commit sha makes
   each deploy a new URL; main.js's own init guard makes a mid-session
   re-execution (head swap after a deploy) harmless. */
const assetV = (import.meta.env.VERCEL_GIT_COMMIT_SHA ?? process.env.VERCEL_GIT_COMMIT_SHA ?? '').slice(0, 8);
const withV = (p) => (assetV ? `${p}?v=${assetV}` : p);
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#F7F3EB">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" sizes="32x32" href={withV('/favicon-32.png')}>
<link rel="icon" type="image/png" sizes="16x16" href={withV('/favicon-16.png')}>
<link rel="apple-touch-icon" href={withV('/apple-touch-icon.png')}>
<script is:inline>
document.documentElement.classList.add('js');
/* Runs before first paint so the loader never flashes on a repeat visit.
   sessionStorage, not localStorage: the opening is worth seeing once per
   visit, not once per lifetime. Wrapped because Safari private mode throws
   on storage access — a failure here just means the loader plays. */
try {
  if (sessionStorage.getItem('sabdia:seen')) document.documentElement.classList.add('no-loader');
  else sessionStorage.setItem('sabdia:seen', '1');
} catch (e) {}
</script>
<meta property="og:title" content={ogT}>
<meta property="og:description" content={ogD}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Sabdia Constructions">
<meta property="og:locale" content="en_AU">
<meta property="og:image" content={ogImageAbs}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogT}>
<meta name="twitter:description" content={ogD}>
<meta name="twitter:image" content={ogImageAbs}>
{/* Google Consent Mode v2. Storage starts denied for everyone; the
    notice in CookieConsent.astro is the only thing that grants it, and a
    visitor who ignores it is never tracked. The default must be queued
    before the config call, so this inline snippet precedes gtag.js. */}
{gaId && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'granted',security_storage:'granted',wait_for_update:500});
try{if(localStorage.getItem('sabdia:consent')==='granted')gtag('consent','update',{analytics_storage:'granted'})}catch(e){}
gtag('js',new Date());gtag('config','${gaId}',{anonymize_ip:true});`}></script>}
{gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
<link rel="preconnect" href="https://fvczsjcrvwzqtcbforgo.supabase.co" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/jost-var.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-var.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/eb-garamond-var-italic.woff2" crossorigin>
{preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadImageSet} imagesizes={preloadImageSet ? (preloadImageSizes ?? '100vw') : undefined} media={preloadImageMedia}>}
<link rel="stylesheet" href={withV('/css/style.css')}>
<ClientRouter />
<slot name="head" />
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<Nav lightNav={lightNav} />

<main id="main">
<slot />
</main>

<Footer />

{gaId && <CookieConsent />}
<script is:inline>
/* Staff-only edit shortcut: a browser that has signed in to /admin
   carries a local flag, and for it every public page shows a small
   "Edit this page" pill linking to the screen that edits it. Plain
   visitors never see it; the admin itself still requires sign-in. */
(() => {
  const place = () => {
    let ok = false;
    try { ok = localStorage.getItem('sabdia:staff') === '1'; } catch {}
    if (!ok) return;
    let pill = document.getElementById('sbEditPill');
    if (!pill) {
      pill = document.createElement('a');
      pill.id = 'sbEditPill';
      pill.textContent = '✎ Edit this page';
      document.body.appendChild(pill);
    }
    pill.href = '/admin/content/?page=' + encodeURIComponent(location.pathname);
  };
  place();
  document.addEventListener('astro:page-load', place);
})();
</script>
<script>
  /* Edit on page — staff only. The editor itself is a separate chunk,
     dynamically imported on first use so public visitors never load it. */
  const wireInline = () => {
    let ok = false;
    try { ok = localStorage.getItem('sabdia:staff') === '1'; } catch {}
    if (!ok || document.getElementById('sbInlinePill')) return;
    const pill = document.createElement('button');
    pill.id = 'sbInlinePill';
    pill.type = 'button';
    pill.textContent = '⚡ Edit on page';
    pill.addEventListener('click', async () => {
      const mod = await import('../lib/admin/inline.js');
      mod.toggleInlineEdit();
    });
    document.body.appendChild(pill);
  };
  wireInline();
  document.addEventListener('astro:page-load', wireInline);
</script>
<script src={withV('/js/main.js')} is:inline></script>
</body>
</html>
