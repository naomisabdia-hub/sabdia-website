---
import AdminShell from '../../layouts/AdminShell.astro';
export const prerender = true;
---
<AdminShell title="Site Content" active="content">
  <!-- INDEX -->
  <div id="indexView">
    <div class="ad-hdr">
      <div>
        <h1 class="ad-h1">Site Content</h1>
        <p class="ad-sub">Every section of every page, editable. Pick a section below — changes go live when you save.</p>
      </div>
    </div>
    <div id="groups"></div>
  </div>

  <!-- EDITOR -->
  <div id="editView" style="display:none">
    <div class="ad-hdr">
      <div>
        <h1 class="ad-h1" id="editTitle"></h1>
        <p class="ad-sub" id="editDesc"></p>
      </div>
      <div style="display:flex;gap:10px">
        <button class="ad-btn ad-btn-ghost" id="histBtn" type="button">History</button>
        <button class="ad-btn ad-btn-ghost" id="prevBtn" type="button">Hide preview</button>
        <a class="ad-btn ad-btn-ghost" id="viewBtn" target="_blank" style="display:none">View page ↗</a>
        <button class="ad-btn ad-btn-ghost" id="backBtn">← All content</button>
      </div>
    </div>
    <div class="ad-editwrap" id="editWrap">
      <div>
        <div class="ad-card" id="histPanel" style="display:none">
          <div class="ad-card-h">Version history — every save is kept</div>
          <div id="histRows"></div>
        </div>
        <div class="ad-form" id="contentForm"></div>
        <div class="ad-savebar" id="saveBar">
          <button class="ad-btn ad-btn-gold" data-save>Save &amp; publish</button>
          <span class="ad-dirty">Unsaved changes</span>
          <span class="spacer"></span>
          <button class="ad-btn ad-btn-danger" id="resetBtn">Reset to original</button>
        </div>
      </div>
      <aside class="ad-prev" id="prevPane">
        <div class="ad-prev-bar">
          <span class="ad-prev-t">Live preview</span>
          <span class="spacer"></span>
          <button type="button" class="ad-prev-mode on" data-pw="desktop">Desktop</button>
          <button type="button" class="ad-prev-mode" data-pw="mobile">Mobile</button>
          <button type="button" class="ad-prev-mode" id="prevReload" title="Refresh preview">↻</button>
        </div>
        <div class="ad-prev-frame" id="prevFrame">
          <iframe id="prevIfr" title="Page preview" loading="lazy"></iframe>
        </div>
      </aside>
    </div>
  </div>
</AdminShell>

<script>
  import { supabase, requireAuth, el, toast } from '../../lib/admin/client.js';
  import { buildForm, readForm, saveBar } from '../../lib/admin/forms.js';
  import { contentSchemas, contentGroups } from '../../lib/admin/schemas.js';
  import seed from '../../lib/seed-content.json';

  await requireAuth();

  const indexView = document.getElementById('indexView');
  const editView = document.getElementById('editView');
  let currentKey = null;
  let currentData = null;

  // Where each content document appears, for the "View page ↗" link.
  const pageFor = {
    settings: '/', home_hero: '/', home_stats: '/', home_marquee: '/', home_about: '/',
    home_properties: '/', home_services: '/', home_process: '/', home_agent: '/', home_contact: '/',
    nav: '/', footer: '/', films: '/', newsletter: '/', series: '/properties/qasr/', walkthroughs: '/properties/qasr/',
    properties_page: '/properties/', property_page: '/properties/qasr/', projects_page: '/projects/',
    services_page: '/services/', about_page: '/about/', collection_page: '/collection/',
    agent_page: '/agent-access/', contact_page: '/contact/', find_home: '/find-your-home/',
    legal_privacy: '/privacy/', legal_accessibility: '/accessibility/', notfound: '/this-page-does-not-exist/',
  };

  const groupsBox = document.getElementById('groups');
  const groupCards = [];
  for (const group of contentGroups) {
    const card = el('div', { class: 'ad-card' }, [el('div', { class: 'ad-card-h', text: group.name })]);
    const table = el('table', { class: 'ad-table' });
    const tbody = el('tbody');
    const trs = [];
    for (const key of group.keys) {
      const meta = contentSchemas[key];
      if (!meta) continue;
      const tr = el('tr', { class: 'clickable', 'data-page': pageFor[key] ?? '', onclick: () => openEditor(key) }, [
        el('td', { text: meta.title, style: 'font-weight:400' }),
        el('td', { text: meta.description || '', style: 'color:var(--taupe-d)' }),
      ]);
      tbody.appendChild(tr);
      trs.push(tr);
    }
    table.appendChild(tbody);
    card.appendChild(table);
    groupsBox.appendChild(card);
    groupCards.push({ card, trs });
  }

  /* ?page=/about/ — arriving from the public site's "Edit this page"
     pill: show only the content screens that build that page. */
  const pagePath = new URLSearchParams(location.search).get('page');
  if (pagePath) {
    const gold = 'style="color:var(--gold)"';
    /* Detail pages share one editor: any /properties/<x>/ maps to the
       property-page screens; journal entries live in the Journal. */
    let lookup = pagePath;
    let special = null;
    if (/^\/properties\/[^/]+\/$/.test(pagePath)) lookup = '/properties/qasr/';
    if (/^\/journal\/[^/]+\/$/.test(pagePath)) special =
      `Journal entries are written and edited in <a href="/admin/blog/" ${gold}>Journal</a>. <a href="/admin/content/" ${gold}>Show all site content</a>`;

    let any = false;
    if (!special) {
      for (const { card, trs } of groupCards) {
        let visible = 0;
        for (const tr of trs) {
          const hit = tr.dataset.page === lookup;
          tr.style.display = hit ? '' : 'none';
          if (hit) visible++;
        }
        card.style.display = visible ? '' : 'none';
        if (visible) any = true;
      }
    }
    const sectionsLink = `<a href="/admin/sections/?page=${encodeURIComponent(pagePath)}" ${gold}>Add a section to this page →</a>`;
    const msg = special
      ? special
      : any
        ? `Showing what builds <b>${pagePath}</b>. <a href="/admin/content/" ${gold}>Show everything</a> · ${sectionsLink}`
        : `Nothing in Site Content matches <b>${pagePath}</b> — if it's one of your own pages, its hero is edited in <a href="/admin/pages/" ${gold}>Pages</a> and its body in ${sectionsLink.replace(' →', '')}. <a href="/admin/content/" ${gold}>Show all site content</a>`;
    groupsBox.insertBefore(
      el('div', { class: 'ad-card', style: 'border-left:3px solid var(--gold)' }, [
        el('p', { class: 'ad-sub', style: 'max-width:none;margin:0', html: msg }),
      ]),
      groupsBox.firstChild,
    );
  }

  async function openEditor(key) {
    const meta = contentSchemas[key];
    const { data, error } = await supabase.from('site_content').select('data').eq('key', key).maybeSingle();
    currentKey = key;
    currentData = data?.data ?? seed[key] ?? {};
    if (error) console.error(error);
    document.getElementById('editTitle').textContent = meta.title;
    document.getElementById('editDesc').textContent = meta.description || '';
    const viewBtn = document.getElementById('viewBtn');
    viewBtn.style.display = pageFor[key] ? '' : 'none';
    viewBtn.href = pageFor[key] || '/';
    buildForm(document.getElementById('contentForm'), meta.schema, currentData);
    indexView.style.display = 'none';
    editView.style.display = '';
    window.scrollTo(0, 0);
    history.replaceState(null, '', '?key=' + key);
    setPreview(pageFor[key] || '/');
  }

  /* ── Live preview ── the page itself sits beside the form and refreshes
     the moment a save lands (the site is server-rendered, so a refresh IS
     the live site). Desktop is scaled to fit; mobile renders true-width. */
  const editWrap = document.getElementById('editWrap');
  const prevBtn = document.getElementById('prevBtn');
  const prevFrame = document.getElementById('prevFrame');
  const prevIfr = document.getElementById('prevIfr');
  let prevUrl = '';
  let prevMode = 'desktop';

  function fitPreview() {
    if (!editWrap.classList.contains('show-prev')) return;
    const target = prevMode === 'mobile' ? 390 : 1280;
    const box = prevFrame.getBoundingClientRect();
    if (!box.width) return;
    const s = Math.min(1, box.width / target);
    prevIfr.style.width = target + 'px';
    prevIfr.style.height = Math.round(box.height / s) + 'px';
    prevIfr.style.transform = `scale(${s})`;
    prevIfr.style.left = Math.max(0, Math.round((box.width - target * s) / 2)) + 'px';
  }

  /* The edge caches public pages (s-maxage=60 + SWR, see middleware.js),
     so a plain reload right after a save can show the stale version. A
     unique query per load makes every preview an edge miss — the editor
     always sees the fresh render, ahead of the public cache. */
  const bust = (url) => url + (url.includes('?') ? '&' : '?') + '_preview=' + Date.now();

  function setPreview(url) {
    prevUrl = url;
    if (!editWrap.classList.contains('show-prev')) return;
    fitPreview();
    prevIfr.src = bust(url);
  }

  function reloadPreview() {
    if (!editWrap.classList.contains('show-prev') || !prevUrl) return;
    prevIfr.src = bust(prevUrl);
  }

  function applyPreviewState(on) {
    editWrap.classList.toggle('show-prev', on);
    prevBtn.textContent = on ? 'Hide preview' : 'Show preview';
    try { localStorage.setItem('adPrev', on ? '1' : '0'); } catch {}
    if (on && prevUrl) {
      fitPreview();
      if (!prevIfr.getAttribute('src')) prevIfr.src = bust(prevUrl);
    }
  }

  prevBtn.addEventListener('click', () => applyPreviewState(!editWrap.classList.contains('show-prev')));
  document.getElementById('prevReload').addEventListener('click', reloadPreview);
  for (const btn of document.querySelectorAll('.ad-prev-mode[data-pw]')) {
    btn.addEventListener('click', () => {
      prevMode = btn.dataset.pw;
      document.querySelectorAll('.ad-prev-mode[data-pw]').forEach((b) => b.classList.toggle('on', b === btn));
      fitPreview();
    });
  }
  window.addEventListener('resize', fitPreview);
  let wantPrev = true;
  try { wantPrev = localStorage.getItem('adPrev') !== '0'; } catch {}
  applyPreviewState(wantPrev);

  document.getElementById('backBtn').addEventListener('click', () => {
    editView.style.display = 'none';
    indexView.style.display = '';
    history.replaceState(null, '', location.pathname);
  });

  /* ── Version history ── every save snapshots the outgoing version into
     rows keyed `_history:<key>:<iso>` (same table, same admin-only RLS;
     the public site fetches exact keys so history rows never leak).
     Fifteen versions are kept per section. */
  async function editorEmail() {
    try {
      const { getClerk } = await import('../../lib/admin/client.js');
      const clerk = await getClerk();
      return clerk?.user?.primaryEmailAddress?.emailAddress || 'admin';
    } catch { return 'admin'; }
  }

  async function snapshot(key, data) {
    if (!data || !Object.keys(data).length) return;
    const stamp = new Date().toISOString();
    await supabase.from('site_content').upsert({
      key: `_history:${key}:${stamp}`,
      data: { data, saved_at: stamp, by: await editorEmail() },
    });
    const { data: rows } = await supabase.from('site_content').select('key')
      .like('key', `_history:${key}:%`).order('key', { ascending: false });
    const stale = (rows ?? []).slice(15).map((r) => r.key);
    if (stale.length) await supabase.from('site_content').delete().in('key', stale);
  }

  const histPanel = document.getElementById('histPanel');
  const histRows = document.getElementById('histRows');
  document.getElementById('histBtn').addEventListener('click', async () => {
    const open = histPanel.style.display !== 'none';
    histPanel.style.display = open ? 'none' : '';
    if (open) return;
    histRows.textContent = 'Loading…';
    const { data: rows, error } = await supabase.from('site_content').select('key, data')
      .like('key', `_history:${currentKey}:%`).order('key', { ascending: false });
    if (error) { histRows.textContent = error.message; return; }
    histRows.textContent = '';
    if (!rows?.length) {
      histRows.appendChild(el('p', { class: 'ad-sub', style: 'margin:0', text: 'No earlier versions yet — they appear here after your next save.' }));
      return;
    }
    const table = el('table', { class: 'ad-table' });
    const tbody = el('tbody');
    for (const row of rows) {
      const when = new Date(row.data.saved_at).toLocaleString('en-AU', { dateStyle: 'medium', timeStyle: 'short' });
      tbody.appendChild(el('tr', {}, [
        el('td', { text: when, style: 'white-space:nowrap' }),
        el('td', { text: row.data.by || '', style: 'color:var(--taupe-d)' }),
        el('td', { style: 'text-align:right' }, [
          el('button', { class: 'ad-btn ad-btn-ghost', type: 'button', text: 'Restore', onclick: async () => {
            if (!confirm(`Restore the version from ${when}? The current version is kept in history.`)) return;
            await snapshot(currentKey, currentData);
            const { error: e2 } = await supabase.from('site_content').upsert({ key: currentKey, data: row.data.data });
            if (e2) return toast(e2.message, true);
            toast('Restored — live on the website now');
            histPanel.style.display = 'none';
            openEditor(currentKey);
          } }),
        ]),
      ]));
    }
    table.appendChild(tbody);
    histRows.appendChild(table);
  });

  saveBar(document.getElementById('contentForm'), document.getElementById('saveBar'), async () => {
    const data = readForm(document.getElementById('contentForm'), contentSchemas[currentKey].schema, currentData);
    await snapshot(currentKey, currentData);
    const { error } = await supabase.from('site_content').upsert({ key: currentKey, data });
    if (error) throw error;
    currentData = data;
    reloadPreview();
  });

  document.getElementById('resetBtn').addEventListener('click', async () => {
    if (!currentKey) return;
    if (!confirm('Reset this section to the original text and images it launched with? Your edits to this section will be lost.')) return;
    const { error } = await supabase.from('site_content').delete().eq('key', currentKey);
    if (error) return toast(error.message, true);
    toast('Reset to original — live on the website now');
    openEditor(currentKey);
  });

  const startKey = new URLSearchParams(location.search).get('key');
  if (startKey && contentSchemas[startKey]) openEditor(startKey);
</script>
