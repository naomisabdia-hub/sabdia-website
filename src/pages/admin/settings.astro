---
import AdminShell from '../../layouts/AdminShell.astro';
export const prerender = true;
---
<AdminShell title="Settings" active="settings">
  <div class="ad-hdr">
    <div>
      <h1 class="ad-h1">Settings</h1>
      <p class="ad-sub">Company details, social links, search defaults, and portal users.</p>
    </div>
  </div>

  <div class="ad-card" id="healthCard" style="margin-bottom:28px">
    <div class="ad-card-h">Website health</div>
    <p class="ad-sub" style="margin-bottom:8px">The services around the website — green is on, amber needs a one-time setup. None of these change the website itself.</p>
    <div id="healthRows"><div class="ad-empty" style="padding:18px 0">Checking…</div></div>
  </div>

  <div class="ad-form" id="settingsForm"></div>
  <div class="ad-savebar" id="saveBar">
    <button class="ad-btn ad-btn-gold" data-save>Save settings</button>
    <span class="ad-dirty">Unsaved changes</span>
  </div>

  <div class="ad-card" style="margin-top:28px" id="pwCard">
    <div class="ad-card-h">Your password</div>
    <p class="ad-sub" style="margin-bottom:16px">Set or change the password for your own sign-in. (You can always use the email-link option on the login page instead.)</p>
    <form class="ad-form" id="pwForm" style="max-width:380px">
      <div class="ad-fg">
        <label class="ad-fl" for="newPw">New password</label>
        <input class="ad-fi" type="password" id="newPw" autocomplete="new-password" minlength="8" required>
      </div>
      <button class="ad-btn" type="submit">Update password</button>
    </form>
  </div>

  <div class="ad-card" style="margin-top:28px" id="usersCard">
    <div class="ad-card-h">Team access</div>
    <p class="ad-sub" style="margin-bottom:16px" id="usersHelp">Who can sign in to this portal. <b>Editors</b> can change content and properties; <b>Admins</b> can also manage the team.</p>
    <table class="ad-table" id="usersTable">
      <thead><tr><th>Email</th><th>Role</th><th>Added</th><th></th></tr></thead>
      <tbody></tbody>
    </table>
    <form class="ad-form" id="addUserForm" style="margin-top:18px;display:none">
      <div class="ad-frow3">
        <div class="ad-fg">
          <label class="ad-fl" for="nuEmail">Email</label>
          <input class="ad-fi" type="email" id="nuEmail" placeholder="teammate@sabdia.com.au" required>
        </div>
        <div class="ad-fg">
          <label class="ad-fl" for="nuRole">Role</label>
          <select class="ad-fsel" id="nuRole">
            <option value="editor">Editor</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="ad-fg">
          <label class="ad-fl">&nbsp;</label>
          <button class="ad-btn ad-btn-gold" type="submit">Add team member</button>
        </div>
      </div>
    </form>
  </div>
  <div class="ad-card" style="margin-top:28px" id="auditCard">
    <div class="ad-card-h">Full site audit</div>
    <p class="ad-sub" style="margin-bottom:14px">Crawls the live website and reports broken pages and images, missing image descriptions, and weak search listings.</p>
    <button class="ad-btn ad-btn-gold" id="auditBtn" type="button">Run audit</button>
    <div id="auditOut" style="margin-top:14px"></div>
  </div>

  <div class="ad-card" style="margin-top:28px" id="trashCard">
    <div class="ad-card-h">Trash</div>
    <p class="ad-sub" style="margin-bottom:16px">Deleted properties and pages rest here — restore them any time, or empty them for good.</p>
    <div id="trashRows"><div class="ad-empty" style="padding:12px 0">Loading…</div></div>
  </div>

</AdminShell>

<script>
  import { supabase, requireAuth, el, fmtDate, toast, clerkMode } from '../../lib/admin/client.js';
  import { buildForm, readForm, saveBar } from '../../lib/admin/forms.js';
  import { contentSchemas } from '../../lib/admin/schemas.js';
  import seed from '../../lib/seed-content.json';

  const me = await requireAuth();

  // Clerk manages passwords when it is active.
  if (clerkMode) document.getElementById('pwCard').style.display = 'none';

  // ── Website health ── live config status from /api/status, plus the
  // domain check the browser can do itself. Booleans only, no secrets.
  (async () => {
    const box = document.getElementById('healthRows');
    const row = (on, title, detail) =>
      el('div', { class: 'ad-health-row' }, [
        el('span', { class: `ad-health-dot ${on ? 'on' : 'off'}` }),
        el('div', {}, [
          el('div', { class: 'ad-health-t', text: title }),
          el('div', { class: 'ad-health-d', html: detail }),
        ]),
      ]);
    const rows = [];

    const host = location.hostname;
    if (host !== 'localhost' && host !== '127.0.0.1') {
      const onDomain = host.endsWith('sabdiaconstructions.com.au');
      rows.push(row(onDomain, 'Custom domain',
        onDomain
          ? 'The website is live on <code>sabdiaconstructions.com.au</code>.'
          : `The website is still on its temporary address (<code>${host}</code>) — until the domain points here, visitors and Google find the old site. Fix: in the domain's DNS (currently at Wix), point <code>www</code> at Vercel per Vercel → Project → Settings → Domains.`));
    }

    try {
      const { accessToken } = await import('../../lib/admin/client.js');
      const res = await fetch('/api/status', { headers: { Authorization: `Bearer ${await accessToken()}` } });
      if (res.ok) {
        const s = await res.json();
        rows.push(row(s.emailAlerts, 'Email alerts for new enquiries',
          s.emailAlerts
            ? 'A copy of every enquiry is emailed the moment it arrives.'
            : 'Enquiries are saved in the Leads Inbox but nobody is emailed. Fix: create a free API key at resend.com, then in Vercel → Project → Settings → Environment Variables add <code>RESEND_API_KEY</code> and <code>CONTACT_EMAIL</code> (where alerts should go) and redeploy.'));
        rows.push(row(s.replySending, 'Replying to leads from the inbox',
          s.replySending
            ? 'Replies send from your verified Sabdia address.'
            : 'Needs the domain verified at resend.com and <code>CONTACT_FROM</code> set (e.g. <code>Sabdia &lt;hello@sabdiaconstructions.com.au&gt;</code>) — otherwise replies would go out from a generic address and land in spam.'));
        rows.push(row(s.analytics, 'Visitor analytics',
          s.analytics
            ? 'Google Analytics is counting visits.'
            : 'No visitor counting yet. Fix: create a free GA4 property at analytics.google.com, then add its ID as <code>PUBLIC_GA4_ID</code> in Vercel and redeploy — the website is already wired for it.'));
      }
    } catch { /* leave whatever rendered */ }

    box.innerHTML = '';
    if (rows.length) for (const r of rows) box.appendChild(r);
    else box.appendChild(el('div', { class: 'ad-health-d', text: 'Health check unavailable right now.' }));
  })();

  const schema = contentSchemas.settings.schema;
  const { data } = await supabase.from('site_content').select('data').eq('key', 'settings').maybeSingle();
  let current = data?.data ?? seed.settings;
  buildForm(document.getElementById('settingsForm'), schema, current);

  saveBar(document.getElementById('settingsForm'), document.getElementById('saveBar'), async () => {
    current = readForm(document.getElementById('settingsForm'), schema, current);
    const { error } = await supabase.from('site_content').upsert({ key: 'settings', data: current });
    if (error) throw error;
  });

  document.getElementById('pwForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const { error } = await supabase.auth.updateUser({ password: document.getElementById('newPw').value });
    if (error) return toast(error.message, true);
    document.getElementById('newPw').value = '';
    toast('Password updated');
  });

  const isAdmin = me.role === 'admin';
  const addForm = document.getElementById('addUserForm');
  addForm.style.display = isAdmin ? '' : 'none';
  if (isAdmin) {
    document.getElementById('usersHelp').innerHTML +=
      clerkMode
        ? ' New teammates: add their email below, then they sign in at <b>/admin/login/</b> with that email.'
        : ' New teammates: add their email below, then they use “Email me a sign-in link” at <b>/admin/login/</b>.';
  }

  async function loadUsers() {
    const { data: users } = await supabase.from('admin_users').select('*').order('created_at');
    const tbody = document.querySelector('#usersTable tbody');
    tbody.innerHTML = '';
    for (const u of users ?? []) {
      tbody.appendChild(el('tr', {}, [
        el('td', { text: u.email }),
        el('td', { text: u.role }),
        el('td', { text: fmtDate(u.created_at) }),
        el('td', { style: 'text-align:right' }, [
          isAdmin && u.email !== me.user?.primaryEmailAddress?.emailAddress && u.email !== (me.user?.email ?? '')
            ? el('button', { class: 'ad-btn ad-btn-danger', text: 'Remove', style: 'padding:6px 14px', onclick: async () => {
                if (!confirm(`Remove ${u.email} from the portal? They will no longer be able to sign in.`)) return;
                const { error } = await supabase.from('admin_users').delete().eq('email', u.email);
                if (error) return toast(error.message, true);
                toast('Access removed');
                loadUsers();
              } })
            : null,
        ]),
      ]));
    }
  }

  addForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('nuEmail').value.trim().toLowerCase();
    const role = document.getElementById('nuRole').value;
    const { error } = await supabase.from('admin_users').insert({ email, role });
    if (error) return toast(error.message.includes('policy') ? 'Could not add — run the team-access update (clerk-auth.sql) in Supabase first.' : error.message, true);
    toast(`${email} can now sign in`);
    document.getElementById('nuEmail').value = '';
    loadUsers();
  });

  await loadUsers();
  // ── Trash ── deleted properties/pages live as `_trash:` rows.
  async function loadTrash() {
    const box = document.getElementById('trashRows');
    const { data: rows, error } = await supabase.from('site_content').select('key, data')
      .like('key', '_trash:%').order('key', { ascending: false });
    box.textContent = '';
    if (error) { box.textContent = error.message; return; }
    if (!rows?.length) {
      box.appendChild(el('div', { class: 'ad-empty', style: 'padding:12px 0', text: 'Trash is empty.' }));
      return;
    }
    const table = el('table', { class: 'ad-table' });
    const tbody = el('tbody');
    for (const row of rows) {
      const d = row.data;
      tbody.appendChild(el('tr', {}, [
        el('td', { text: d.kind === 'property' ? 'Property' : 'Page', style: 'white-space:nowrap;color:var(--taupe-d)' }),
        el('td', { text: d.label, style: 'font-weight:400' }),
        el('td', { text: new Date(d.deleted_at).toLocaleString('en-AU', { dateStyle: 'medium', timeStyle: 'short' }), style: 'white-space:nowrap' }),
        el('td', { style: 'text-align:right;white-space:nowrap' }, [
          el('button', { class: 'ad-btn ad-btn-ghost', type: 'button', text: 'Restore', onclick: async () => {
            try {
              if (d.kind === 'property') {
                const copy = { ...d.row };
                delete copy.id; delete copy.created_at; delete copy.updated_at;
                copy.published = false; // restored as a draft, never straight onto the site
                const { error: e } = await supabase.from('properties').insert(copy);
                if (e) throw e;
              } else {
                const { data: cur } = await supabase.from('site_content').select('data').eq('key', 'custom_pages').maybeSingle();
                const doc = cur?.data ?? { pages: [] };
                doc.pages = [...(doc.pages ?? []).filter((x) => x.slug !== d.row.slug), { ...d.row, published: false }];
                const { error: e } = await supabase.from('site_content').upsert({ key: 'custom_pages', data: doc });
                if (e) throw e;
              }
              await supabase.from('site_content').delete().eq('key', row.key);
              toast(`Restored as a draft — tick Published when ready`);
              loadTrash();
            } catch (e) { toast(e.message, true); }
          } }),
          el('button', { class: 'ad-btn ad-btn-danger', type: 'button', text: 'Delete forever', onclick: async () => {
            if (!confirm(`Permanently delete “${d.label}”? This really cannot be undone.`)) return;
            await supabase.from('site_content').delete().eq('key', row.key);
            loadTrash();
          } }),
        ]),
      ]));
    }
    table.appendChild(tbody);
    box.appendChild(table);
  }

  // ── Full site audit ──
  document.getElementById('auditBtn').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const out = document.getElementById('auditOut');
    btn.disabled = true; btn.textContent = 'Auditing… (about a minute)';
    out.textContent = '';
    try {
      const { accessToken } = await import('../../lib/admin/client.js');
      const res = await fetch('/api/site-audit', { headers: { Authorization: `Bearer ${await accessToken()}` } });
      const r = await res.json();
      if (!res.ok) throw new Error(r.error || `HTTP ${res.status}`);
      out.appendChild(el('p', { class: 'ad-sub', style: 'margin:0 0 10px', text:
        `${r.pagesChecked} pages and ${r.assetsChecked} images checked on ${r.base}` }));
      if (!r.issues.length) {
        out.appendChild(el('div', { class: 'ad-empty', style: 'padding:10px 0', text: 'No issues found — the site is clean. ✨' }));
      } else {
        const table = el('table', { class: 'ad-table' });
        const tbody = el('tbody');
        for (const i of r.issues.slice(0, 120)) {
          tbody.appendChild(el('tr', {}, [
            el('td', { text: i.kind, style: 'white-space:nowrap;color:var(--taupe-d)' }),
            el('td', { text: i.page, style: 'white-space:nowrap' }),
            el('td', { text: i.detail }),
          ]));
        }
        table.appendChild(tbody);
        out.appendChild(table);
        if (r.issues.length > 120) out.appendChild(el('p', { class: 'ad-sub', text: `…and ${r.issues.length - 120} more.` }));
      }
    } catch (err) { toast(err.message, true); }
    btn.disabled = false; btn.textContent = 'Run audit';
  });

  loadTrash();
</script>
