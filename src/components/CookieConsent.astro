---
/**
 * Cookie notice — rendered only when GA4 is actually switched on.
 *
 * Nothing else on the public site stores anything in a visitor's browser
 * beyond the loader's per-session flag and the staff edit pill, so with
 * PUBLIC_GA4_ID unset there is nothing to ask about and no banner appears.
 * When it is set, Google Consent Mode v2 (in Base.astro) starts denied and
 * analytics_storage is only granted after an explicit Accept — so the
 * default state for a visitor who ignores the notice is no tracking, which
 * is what the Privacy Policy promises.
 *
 * The choice lives in localStorage rather than a cookie: asking about
 * cookies by setting one is a poor look, and it need not travel to the
 * server.
 */
---
<div id="ckNotice" class="ck" hidden>
  <p class="ck-t">
    We use analytics cookies to understand how this site is used. They are
    off until you accept. See our <a href="/privacy/">Privacy Policy</a>.
  </p>
  <div class="ck-btns">
    <button type="button" class="ck-b ck-decline" data-ck="denied">Decline</button>
    <button type="button" class="ck-b ck-accept" data-ck="granted">Accept</button>
  </div>
</div>

<style>
  .ck {
    position: fixed;
    left: clamp(14px, 3vw, 28px);
    bottom: clamp(14px, 3vw, 28px);
    z-index: 900;
    max-width: 420px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    padding: 18px 20px;
    background: var(--dark, #1F1B14);
    border: 1px solid rgba(168, 135, 74, 0.28);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.3);
    /* Slides in only once the opening animation has had its moment. */
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .ck.on { opacity: 1; transform: none; }
  .ck-t {
    flex: 1 1 210px;
    margin: 0;
    font-size: 11.5px;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(253, 251, 246, 0.62);
  }
  .ck-t a { color: var(--gold2, #C4A870); text-decoration: none; border-bottom: 1px solid rgba(196, 168, 112, 0.4); }
  .ck-t a:hover { color: #fff; }
  .ck-btns { display: flex; gap: 8px; flex-shrink: 0; }
  .ck-b {
    font: inherit;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 10px 16px;
    cursor: pointer;
    background: transparent;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .ck-decline { border: 1px solid rgba(253, 251, 246, 0.22); color: rgba(253, 251, 246, 0.6); }
  .ck-decline:hover { border-color: rgba(253, 251, 246, 0.5); color: #fff; }
  .ck-accept { border: 1px solid var(--gold2, #C4A870); background: var(--gold2, #C4A870); color: #1F1B14; }
  .ck-accept:hover { background: #fff; border-color: #fff; }
  .ck-b:focus-visible { outline: 2px solid var(--gold2, #C4A870); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .ck { transition: none; }
  }
  @media (max-width: 520px) {
    .ck { left: 12px; right: 12px; max-width: none; }
  }
</style>

<script is:inline>
  /* Inline and one-time: bound to document, not re-run per page-load, so
     ClientRouter navigations never stack a second handler. */
  (() => {
    const KEY = 'sabdia:consent';
    const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
    const write = (v) => { try { localStorage.setItem(KEY, v); } catch {} };

    const el = document.getElementById('ckNotice');
    if (!el) return;

    if (!read()) {
      el.hidden = false;
      /* After the opening sequence, so the notice never competes with the
         first frame of the hero. */
      setTimeout(() => el.classList.add('on'), 1400);
    }

    el.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-ck]');
      if (!btn) return;
      const choice = btn.getAttribute('data-ck');
      write(choice);
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', { analytics_storage: choice });
      }
      el.classList.remove('on');
      setTimeout(() => { el.hidden = true; }, 500);
    });
  })();
</script>
