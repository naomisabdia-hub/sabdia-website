        "paragraph-3": {
          "type": "paragraph",
          "settings": {
            "text": "Since 2013, Sabdia Constructions has designed, developed and built luxury residences across Brisbane's inner suburbs. Design-led and delivered in-house, each home is drawn, approved, constructed and finished by the one team."
          }
        },
        "paragraph-4": {
          "type": "paragraph",
          "settings": {
            "text": "More than 100 custom residences and multiple HIA awards on, the standard has not moved. Founder Muhammad Sabdia and Construction Manager Stephen Orazio lead every project from the first sketch to handover."
          }
        },
        "paragraph-5": {
          "type": "paragraph",
          "settings": {
            "text": "Materials are chosen for the house alone, natural stone, warm timber and honed travertine among them, and applied with the attention that makes a home both timeless and enduring."
          }
        },
        "value-6": {
          "type": "value",
          "settings": {
            "n": "i.",
            "title": "Design-Led",
            "desc": "Every residence is drawn in-house, for its site and the way it will be lived in."
          }
        },
        "value-7": {
          "type": "value",
          "settings": {
            "n": "ii.",
            "title": "Meticulous Craftsmanship",
            "desc": "Custom joinery, hand-laid stone and considered detailing in every room."
          }
        },
        "value-8": {
          "type": "value",
          "settings": {
            "n": "iii.",
            "title": "Timeless and Enduring",
            "desc": "Premium materials, carefully selected, so the home is as right in twenty years as on handover day."
          }
        }
